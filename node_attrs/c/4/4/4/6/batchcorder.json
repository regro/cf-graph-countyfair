  "linux_64_meta_yaml": {
    "about": {
      "description": "batchcorder caches an Arrow record-batch stream so it can be replayed\nmultiple times. Arrow streams are single-pass by nature; batchcorder\nrecords the batches once and hands out fresh readers over the recorded\ndata, so a stream that would otherwise be consumed by its first reader\ncan be iterated repeatedly.\n\nThe recording layer is implemented in Rust (arrow-rs + PyO3) and exposed\nas a CPython stable-ABI extension.",
      "dev_url": "https://github.com/mesejo/batchcorder",
      "doc_url": "https://batchcorder.readthedocs.io/",
      "home": "https://github.com/mesejo/batchcorder",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Rust-backed caching of Arrow record-batch streams for repeated replay"
    },
    "build": {
      "number": "1",
      "script": {
        "content": "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n",
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "PYTHONUTF8": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "rxm7706"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "batchcorder",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses"
          ],
          "host": [
            "python",
            "maturin >=1.7,<2.0",
            "pip",
            "python-abi3"
          ],
          "run": [
            "python",
            "pyarrow >=18"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "batchcorder"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": "abi3audit $SP_DIR/batchcorder/_batchcorder.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
          }
        ],
        "version": "0.1.3"
      }
    ],
