  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.1.3\"\n\npackage:\n  name: batchcorder\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/b/batchcorder/batchcorder-${{ version }}.tar.gz\n  sha256: bd74b90c83d146bf1bbf4582c1e7e04b312fe17df8bf1b034c0ba90532bf2b14\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      PYTHONUTF8: \"1\"\n    content:\n      - if: unix\n        then: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        else: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          %PYTHON% -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.7,<2.0\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1.7,<2.0\n    - pip\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n    - pyarrow >=18\n\ntests:\n  - python:\n      imports:\n        - batchcorder\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/batchcorder/_batchcorder.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\batchcorder\\_batchcorder.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Rust-backed caching of Arrow record-batch streams for repeated replay\n  description: |\n    batchcorder caches an Arrow record-batch stream so it can be replayed\n    multiple times. Arrow streams are single-pass by nature; batchcorder\n    records the batches once and hands out fresh readers over the recorded\n    data, so a stream that would otherwise be consumed by its first reader\n    can be iterated repeatedly.\n\n    The recording layer is implemented in Rust (arrow-rs + PyO3) and exposed\n    as a CPython stable-ABI extension.\n  homepage: https://github.com/mesejo/batchcorder\n  repository: https://github.com/mesejo/batchcorder\n  documentation: https://batchcorder.readthedocs.io\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
