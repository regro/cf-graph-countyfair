  "raw_meta_yaml": "context:\n  version: \"0.3.0\"\n\npackage:\n  name: rattler\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/conda/rattler/archive/rattler-bin-v${{ version }}.tar.gz\n    sha256: 44af9e748b8e76f9fa6fd06af342d510395bb768f4610ad7fe49300344681c25\n  - url: https://github.com/baszalmstra/libsolv/archive/068739980a909f39b647b9a96146e58e80741d1e.tar.gz\n    target_directory: crates/rattler_libsolv_c/libsolv\n    sha256: 4cf3e8a09e6710b5452be43c103aef9d33a08f31db1f5f870492045697d53161\n\nbuild:\n  number: 0\n  script:\n    env:\n      # Use cmake to build aws-lc-sys, because conda's CFLAGS inject -O2 which\n      # overrides the -O0 required by jitterentropy-base.c, causing a build failure.\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - export OPENSSL_DIR=$PREFIX\n      - if: ppc64le\n        then:\n          # rust-lld, which rustc uses by default, cannot handle the inline-PLT\n          # relocations gcc emits for ppc64le (R_PPC64_PLT16_HA, R_PPC64_PLTSEQ,\n          # R_PPC64_PLTCALL) in the vendored libsolv objects. gcc honors the last\n          # -fuse-ld, so this falls back to the GNU bfd linker. It has to go into\n          # RUSTFLAGS rather than CARGO_BUILD_RUSTFLAGS: cargo-auditable passes its\n          # own flags via CARGO_ENCODED_RUSTFLAGS, which shadows the config-level\n          # CARGO_BUILD_RUSTFLAGS but preserves RUSTFLAGS.\n          - export RUSTFLAGS=\"${RUSTFLAGS:-${CARGO_BUILD_RUSTFLAGS:-}} -C link-arg=-fuse-ld=bfd\"\n          # aws-lc-sys' cmake build does not assemble aesp8-ppc.S/ghashp8-ppc.S when\n          # cross-compiling, leaving aes_hw_* and gcm_*_p8 undefined. Its cc builder\n          # does compile them, and the jitterentropy problem that made us pick cmake\n          # in the first place does not apply here - that source is not part of the\n          # ppc64le file list.\n          - unset AWS_LC_SYS_CMAKE_BUILDER\n      - cd crates/rattler-bin\n      - cargo-bundle-licenses --format yaml --output ../../THIRDPARTY.yml\n      - cargo auditable install --no-track --locked --features native-tls,s3,gcs --no-default-features --root ${{ PREFIX }} --path .\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/etc/pixi/rattler\n          - touch $PREFIX/etc/pixi/rattler/global-ignore-conda-prefix\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          # cargo does not pass LDFLAGS to the final link, so the binary carries no\n          # rpath until rattler-build relinks it at packaging time. Running it here\n          # - under qemu when cross-compiling - needs this to find libssl.\n          - export LD_LIBRARY_PATH=\"$PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\n          - $PREFIX/bin/rattler completion --shell zsh > $PREFIX/share/zsh/site-functions/_rattler\n          - $PREFIX/bin/rattler completion --shell bash > $PREFIX/share/bash-completion/completions/rattler\n          - $PREFIX/bin/rattler completion --shell fish > $PREFIX/share/fish/vendor_completions.d/rattler.fish\n        else:\n          - mkdir %PREFIX%\\etc\\pixi\\rattler\n          - touch %PREFIX%\\etc\\pixi\\rattler\\global-ignore-conda-prefix\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - if: unix\n      then: make\n  host:\n    - if: linux\n      then:\n        - openssl\n\ntests:\n  - script:\n      - rattler --version\n  - package_contents:\n      bin:\n        - rattler\n      files:\n        - etc/pixi/rattler/global-ignore-conda-prefix\n        - if: unix\n          then:\n            - share/bash-completion/completions/rattler\n            - share/fish/vendor_completions.d/rattler.fish\n            - share/zsh/site-functions/_rattler\n      strict: true\n\nabout:\n  homepage: https://github.com/conda/rattler\n  documentation: https://docs.rs/crate/rattler-bin\n  summary: Rust binary for common Conda operations\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE\n    - crates/rattler_libsolv_c/libsolv/LICENSE.BSD\n    - THIRDPARTY.yml\n  repository: https://github.com/conda/rattler/tree/main/crates/rattler-bin\n\nextra:\n  recipe-maintainers:\n    - baszalmstra\n    - pavelzw\n",
