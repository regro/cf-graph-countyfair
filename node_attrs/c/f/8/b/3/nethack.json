  "linux_64_meta_yaml": {
    "about": {
      "description": "NetHack is a single player dungeon exploration game that runs on a\nwide variety of computer systems, with a variety of graphical and\ntext interfaces all using the same game engine. Unlike many other\nDungeons & Dragons-inspired games, the emphasis in NetHack is on\ndiscovering the detail of the dungeon and not simply killing\neverything in sight.",
      "dev_url": "https://github.com/NetHack/NetHack",
      "doc_url": "https://nethackwiki.com/",
      "home": "https://www.nethack.org/",
      "license": "NGPL",
      "license_family": "NGPL",
      "license_file": "dat/license",
      "summary": "A classic terminal-based roguelike dungeon exploration game"
    },
    "build": {
      "number": "6",
      "script": {
        "env": {
          "LUA_VERSION": "5.4.8"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "tdejager"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "nethack",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "make",
            "groff"
          ],
          "host": [
            "lua ==5.4.8",
            "ncurses"
          ],
          "run": []
        },
        "tests": [
          {
            "script": [
              "test -f $PREFIX/bin/nethack",
              "test -f $PREFIX/share/nethack/nethack",
              "test -f $PREFIX/share/nethack/recover",
              "test -f $PREFIX/share/nethack/nhdat",
              "test -f $PREFIX/share/nethack/sysconf",
              "test -f $PREFIX/share/nethack/license",
              "nethack --version"
            ]
          }
        ],
        "version": "5.0.0"
      }
    ],
