  "raw_meta_yaml": "context:\n  version: \"0.23.1\"\n  build_number: 1\n\nrecipe:\n  name: libpsl-packages\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/rockdaboot/libpsl/releases/download/${{ version }}/libpsl-${{ version }}.tar.gz\n  sha256: 8fbb03054556498ba9c4cc48fcaa36a4483748c6504a65bdb9ba348f555b0e56\n\nbuild:\n  number: ${{ build_number }}\n\noutputs:\n  - package:\n      name: libpsl\n      version: ${{ version }}\n    build:\n      script: build\n      files:\n        - ${{ \"Library/\" if win }}include/libpsl.h\n        - ${{ \"Library/\" if win }}lib/pkgconfig/libpsl.pc\n        - if: linux\n          then:\n            - lib/libpsl.so*\n        - if: osx\n          then:\n            - lib/libpsl*.dylib\n        - if: win\n          then:\n            - Library/bin/psl-*.dll\n            - Library/lib/psl.lib\n    requirements:\n      run_exports:\n        # Just a guess\n        - ${{ pin_subpackage('libpsl', upper_bound='x.x') }}\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('cxx') }}\n        - ninja\n        - pkg-config\n        - meson\n      host:\n        - if: not (win and arm64)\n          then:\n            - icu\n    tests:\n      - script:\n          - if: unix\n            then:\n              - test -f ${PREFIX}/include/libpsl.h\n              - test -f ${PREFIX}/lib/pkgconfig/libpsl.pc\n              - test -f ${PREFIX}/lib/libpsl${SHLIB_EXT}\n              - test ! -f ${PREFIX}/lib/libpsl.a\n          - if: win\n            then:\n              - if not exist %LIBRARY_PREFIX%\\include\\libpsl.h (exit 1)\n              - if not exist %LIBRARY_PREFIX%\\lib\\pkgconfig\\libpsl.pc (exit 1)\n              - if not exist %LIBRARY_PREFIX%\\bin\\psl-*.dll (exit 1)\n              - if not exist %LIBRARY_PREFIX%\\lib\\psl.lib (exit 1)\n              - if exist %LIBRARY_PREFIX%\\lib\\libpsl.a (exit 1)\n  - package:\n      name: libpsl-static\n      version: ${{ version }}\n    build:\n      script: build\n      files:\n        - ${{ \"Library/\" if win }}lib/libpsl.a\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('cxx') }}\n        - ninja\n        - pkg-config\n        - meson\n      run:\n        - ${{ pin_subpackage('libpsl', exact=True) }}\n    tests:\n      - script:\n          - if: unix\n            then:\n              - test -f ${PREFIX}/lib/libpsl.a\n          - if: win\n            then:\n              - if not exist %LIBRARY_PREFIX%\\lib\\libpsl.a (exit 1)\nabout:\n  homepage: https://github.com/rockdaboot/libpsl\n  repository: https://github.com/rockdaboot/libpsl\n  license: MIT\n  license_family: MIT\n  license_file: LICENSE\n  summary: A C library to handle the Public Suffix List\n\nextra:\n  recipe-maintainers:\n    - tschoonj\n    - JohanMabille\n",
