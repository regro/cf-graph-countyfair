  "raw_meta_yaml": "context:\n  version: \"3.12.1\"\n\npackage:\n  name: html-to-markdown-cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/kreuzberg-dev/html-to-markdown/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 23a6e1bbfd71089c45680c062eb6d4d2dc046338fba7d14e3b5bd487953ced3a\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if win else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on Windows\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd crates/html-to-markdown-cli\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate manpage and shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/html-to-markdown --generate-man             > \"$PREFIX\"/share/man/man1/html-to-markdown.1'\n              - '\"$PREFIX\"/bin/html-to-markdown --generate-completion bash > \"$PREFIX\"/share/bash-completion/completions/html-to-markdown'\n              - '\"$PREFIX\"/bin/html-to-markdown --generate-completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/html-to-markdown.fish'\n              - '\"$PREFIX\"/bin/html-to-markdown --generate-completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_html-to-markdown'\n        else:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate manpage and shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\html-to-markdown.exe --generate-man             > \"%LIBRARY_PREFIX%\"\\share\\man\\man1\\html-to-markdown.1'\n              - '\"%LIBRARY_BIN%\"\\html-to-markdown.exe --generate-completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\html-to-markdown'\n              - '\"%LIBRARY_BIN%\"\\html-to-markdown.exe --generate-completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\html-to-markdown.fish'\n              - '\"%LIBRARY_BIN%\"\\html-to-markdown.exe --generate-completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_html-to-markdown'\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: win\n      then: cmake\n\ntests:\n  - script:\n      - html-to-markdown --help\n      - html-to-markdown --version\n  - package_contents:\n      bin:\n        - html-to-markdown\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/man/man1/html-to-markdown.1\n            - share/bash-completion/completions/html-to-markdown\n            - share/fish/vendor_completions.d/html-to-markdown.fish\n            - share/zsh/site-functions/_html-to-markdown\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/man/man1/html-to-markdown.1\n            - Library/share/bash-completion/completions/html-to-markdown\n            - Library/share/fish/vendor_completions.d/html-to-markdown.fish\n            - Library/share/zsh/site-functions/_html-to-markdown\n      strict: true\n\nabout:\n  summary: A fast, powerful HTML to Markdown converter\n  description: |\n    Command-line interface for html-to-markdown, a high-performance\n    HTML to Markdown converter with comprehensive customization options.\n    Uses the html5ever parser for standards-compliant HTML processing.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://docs.html-to-markdown.kreuzberg.dev/\n  repository: https://github.com/kreuzberg-dev/html-to-markdown\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
