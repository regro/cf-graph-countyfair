  "raw_meta_yaml": "context:\n  name: s3manager\n  version: \"0.8.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/cloudlena/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 4580e4613ef6f241f6a812a4ed73d36ce0ca2fc44c4387a4090e9a42f658cd88\n    target_directory: src\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    # github.com/cloudlena/adapters is Apache-2.0 licensed (see\n    # https://github.com/cloudlena/adapters/blob/HEAD/LICENSE), but its LICENSE\n    # file lacks the canonical Apache-2.0 header so go-licenses cannot\n    # auto-classify it. Ignore it during go-licenses scan and copy the LICENSE\n    # in manually so it still ships with the package.\n    - go-licenses save ./ --save_path ../library_licenses --ignore github.com/cloudlena/s3manager --ignore github.com/cloudlena/adapters\n    - if: win\n      then:\n        - for /d %%D in (\"%GOMODCACHE%\\github.com\\cloudlena\\adapters@*\") do xcopy /Y /I \"%%D\\LICENSE\" \"..\\library_licenses\\github.com\\cloudlena\\adapters\\\"\n        - go build -v -buildmode=pie -trimpath -modcacherw -o %LIBRARY_BIN%\\s3manager.exe -ldflags=\"-s\" ./main.go\n      else:\n        - mkdir -p ../library_licenses/github.com/cloudlena/adapters\n        - cp \"$(go env GOMODCACHE)\"/github.com/cloudlena/adapters@*/LICENSE ../library_licenses/github.com/cloudlena/adapters/LICENSE\n        - go build -v -buildmode=pie -trimpath -modcacherw -o $PREFIX/bin/s3manager -ldflags=\"-s -w\" ./main.go\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n\ntests:\n  - script:\n      - if: win\n        then:\n          # s3manager.exe exits non-zero on missing config; chain with `&` so cmd's\n          # errorlevel after the redirect is not checked, then findstr enforces\n          # the expected message.\n          - s3manager.exe > output.txt 2>&1 & findstr /c:\"no S3 instances configured\" output.txt\n        else: s3manager 2>&1 | grep -q \"no S3 instances configured\"\n\nabout:\n  homepage: https://github.com/cloudlena/s3manager\n  summary: A Web GUI for your S3 buckets\n  license: Apache-2.0\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  repository: https://github.com/cloudlena/s3manager\n\nextra:\n  recipe-maintainers:\n    - delsner\n    - janjagusch\n",
