  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.0\"\n\npackage:\n  name: h5pyd\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/h/h5pyd/h5pyd-${{ version }}.tar.gz\n  sha256: 9c50bfc004e9fa1ea1742d45a989b12f3719097d1e18c14250cf60af66a99959\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - hsinfo = h5pyd._apps.hsinfo:main\n      - hsls = h5pyd._apps.hsls:main\n      - hstouch = h5pyd._apps.hstouch:main\n      - hsacl = h5pyd._apps.hsacl:main\n      - hsdel = h5pyd._apps.hsdel:main\n      - hsrm = h5pyd._apps.hsdel:main\n      - hsget = h5pyd._apps.hsget:main\n      - hsload = h5pyd._apps.hsload:main\n      - hsconfigure = h5pyd._apps.hsconfigure:main\n      - hscopy = h5pyd._apps.hscopy:main\n      - hscp = h5pyd._apps.hscopy:main\n      - hsmv = h5pyd._apps.hsmv:main\n      - hsdiff = h5pyd._apps.hsdiff:main\n      - hsstat = h5pyd._apps.hsstat:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numpy >=2.0.0\n    - h5json >=2.0.0\n    - requests-unixsocket\n    - pytz\n    - packaging\n\ntests:\n  - python:\n      imports:\n        - h5pyd\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - hsinfo --help\n      - hsls --help\n      - hstouch --help\n      - hsacl --help\n      - hsdel --help\n      - hsrm --help\n      - hsget --help\n      - hscopy --help\n      - hscp --help\n      - hsstat --help\n      # Non-zero return.\n      # - hsload --help\n      # - hsconfigure --help\n      # - hsmv --help\n      # - hsdiff --help\n\nabout:\n  summary: h5py compatible client lib for HDF REST API\n  license: LicenseRef-HDF5\n  license_file: COPYING\n  homepage: https://pypi.org