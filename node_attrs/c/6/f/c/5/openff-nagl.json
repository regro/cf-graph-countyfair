  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.12\"\n  version: \"0.6.0\"\n\nrecipe:\n  name: openff-nagl-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/openforcefield/openff-nagl/archive/v${{ version }}.tar.gz\n  sha256: d984e3a30153be926f31b2fbe24ee19720f2ecee870ecb0b7e4737d8fdb96642\n\nbuild:\n  number: 1\n\noutputs:\n  - package:\n      name: openff-nagl-base\n    build:\n      noarch: python\n      script:\n        file: build_base.sh\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n        - setuptools-scm\n      run:\n        - python >=${{ python_min }}\n        - click\n        - click-option-group\n        - tqdm\n        - openff-toolkit-base >=0.11.0\n        - openff-units\n        - pyyaml\n        - pydantic =2\n        - pytorch >=2.6\n        - pytorch-lightning\n        - rdkit\n        - rich\n      run_constraints:\n        - dgl >=1.0,<=3\n        - openeye-toolkits\n    tests:\n      - python:\n          imports:\n            - openff.nagl\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n  - package:\n      name: openff-nagl\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        - openff-nagl-models >=0.1.0\n        - ${{ pin_subpackage('openff-nagl-base', exact=True) }}\n    tests:\n      - python:\n          imports:\n            - openff.nagl\n          pip_check: false\n          python_version: ${{ python_min }}.*\n        files:\n          recipe:\n            - test_nagl.py\n        script:\n          - python test_nagl.py\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: A library for applying graph convolutional neural networks to molecules\n  homepage: https://openforcefield.org/\n  repository: https://github.com/openforcefield/openff-nagl\n\nextra:\n  feedstock-name: openff-nagl\n  recipe-maintainers:\n    - mattwthompson\n    - j-wags\n    - lilyminium\n",
