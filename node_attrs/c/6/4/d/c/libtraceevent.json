      "doc_url": "https://www.trace-cmd.org/Documentation/libtraceevent/",
      "home": "https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/",
      "license": "LGPL-2.1-only AND GPL-2.0-only",
      "license_family": "LGPL-2.1-only AND GPL-2.0-only",
      "license_file": "LICENSES/LGPL-2.1",
      "summary": "Linux kernel trace event library"
    },
    "build": {
      "number": "0",
