        "weak": [
          "libtraceevent"
        ]
      },
      "script": [
        "make -j\"${CPU_COUNT}\" \\\n  prefix=\"${PREFIX}\" \\\n  libdir_relative=lib \\\n  pkgconfig_dir=\"${PREFIX}/lib/pkgconfig\" \\\n  LDCONFIG=false \\\n  EXTRA_CFLAGS=\"${CFLAGS} -I${SRC_DIR}/uapi-shim\" \\\n  install\n",
        "rm \"${PREFIX}/lib/libtraceevent.a\""
      ]
    },
