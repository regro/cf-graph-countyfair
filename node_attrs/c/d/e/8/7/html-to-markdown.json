  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"3.12.2\"\n  python_min: '3.10'\n\npackage:\n  name: html-to-markdown\n  version: ${{ version }}\n\nsource:\n  # Upstream PyPI sdist (3.5.x) is broken: workspace declares a path dep on\n  # crates/html-to-markdown/ but the directory is not in the tarball, so\n  # `cargo metadata` fails before the maturin build can start. The GitHub\n  # tag tarball ships the full workspace. Same class as SKILL.md G5.\n  url: https://github.com/kreuzberg-dev/html-to-markdown/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 56efa733612d0c99cce024270c27010793da0bc26cb5d44883dbae9db0d09f08\n\nbuild:\n  number: 0\n  script:\n    env:\n      # Per conda-forge.org/docs/maintainer/example_recipes/rust/ — recommended\n      # for any Rust build. maturin invokes cargo build and inherits these.\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # GH source has no root-level pyproject.toml (the sdist synthesizes one);\n      # the maturin entrypoint lives at packages/python/. cargo-bundle-licenses\n      # runs at the workspace root so it sees all crates.\n      - if: unix\n        then: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          ${{ PYTHON }} -m pip install ./packages/python -vv --no-deps --no-build-isolation\n        else: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          %PYTHON% -m pip install .\\packages\\python -vv --no-deps --no-build-isolation\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1.9,<2\n\n    - ${{ stdlib('c') }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ compiler(\"c\") }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - maturin >=1,<2\n    - pip\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - html_to_markdown\n      pip_check: true\n  - requirements:\n      run:\n        - pip\n        - python\n    script:\n      - pip check\n      - \"python -c \\\"import html_to_markdown\\\"\"\n\nabout:\n  summary: High-performance HTML to Markdown converter powered by Rust with a clean Python API\n  license: MIT\n  license_file:\n    - LICENSE\n    - crates/html-to-markdown-py/src/LICENSE\n    - THIRDPARTY.yml\n  homepage: https://pypi.org/project/html-to-markdown/\n  repository: https://github.com/kreuzberg-dev/html-to-markdown\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
