  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: dynaphopy\n  version: \"1.19.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: bba34b6a4c28dc82935718a98956b077ecd72754f3f68828e9510f5017c8a8ac\n  patches:\n    - setup.patch\n    - phonopy.patch\n\nbuild:\n  number: 1\n  skip: win or match(python, \"<3.11\")\n  script: ${{ PYTHON }} -m pip install . -vv\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then: python\n    - if: build_platform != target_platform\n      then: cross-python_${{ target_platform }}\n    - if: build_platform != target_platform\n      then: numpy\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n  host:\n    - python\n    - pip\n    - numpy\n    - setuptools\n  run:\n    - python\n    - pip\n    - phonopy\n    - scipy\n    - matplotlib-base\n    - seekpath\n\ntests:\n  - python:\n      imports:\n        - dynaphopy\n      pip_check: true\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Phonon Analysis from Molecular Dynamics Data\n  description: |\n    Software to calculate crystal microscopic anharmonic properties\n    from molecular dynamics (MD) using the normal-mode-decomposition\n    technique. These properties include the phonon frequency shifts and\n    linewidths, as well as the renormalized force constanst and thermal\n    properties by using quasiparticle theory. This code includes\n    interfaces for MD outputs from VASP and LAMMPS. PHONOPY code is used\n    to obtain harmonic phonon modes.\n  homepage: http://abelcarreras.github.io/DynaPhoPy/\n  repository: https://github.com/abelcarreras/DynaPhoPy\n  documentation: http://abelcarreras.github.io/DynaPhoPy/\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
