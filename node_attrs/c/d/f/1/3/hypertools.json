    "about": {
      "description": "HyperTools is a Python library for visualizing and manipulating\nhigh-dimensional data. It provides a unified interface for dimensionality\nreduction, data alignment, clustering, and visualization, built on\nmatplotlib, plotly, scikit-learn, and pydata-wrangler. Optional extras\n(the interactive plotly backend, text embeddings, extra forecasters, Lab\nStreaming Layer input, and more) are installed from PyPI, as a few of\ntheir dependencies are not yet available on conda-forge; the base package\nis fully functional without them.",
      "dev_url": "https://github.com/ContextLab/hypertools",
      "doc_url": "https://hypertools.readthedocs.io/",
      "home": "https://github.com/ContextLab/hypertools",
      "license": "MIT AND Apache-2.0 AND OFL-1.1",
      "license_family": "MIT AND Apache-2.0 AND OFL-1.1",
      "license_file": "LICENSE",
      "summary": "A python package for visualizing and manipulating high-dimensional data"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
