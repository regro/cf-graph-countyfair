  "raw_meta_yaml": "context:\n  version: \"1.6.3\"\n\npackage:\n  name: timg-hzeller\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/hzeller/timg/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 59c908867f18c81106385a43065c232e63236e120d5b2596b179ce56340d7b01\n  patches:\n    - patches/0001-remove-conflicting-getopt-declaration.patch\n\nbuild:\n  number: 0\n  skip:\n    - win\n\nrequirements:\n  build:\n    - cmake\n    - ninja\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - pkg-config\n    - pandoc\n  host:\n    - libdeflate\n    - libsixel\n    - libjpeg-turbo\n    - libexif\n    - graphicsmagick\n    - librsvg\n    - cairo\n    # pkg-config resolves the full dependency chain at configure time, so the\n    # headers and .pc files of transitive deps must be present too. The libfoo\n    # packages pulled in automatically ship only the runtime libraries.\n    - expat\n    - xorg-xorgproto\n    - glib\n    - poppler\n    - ffmpeg\n  run:\n    # Everything else timg links against is pinned automatically by the\n    # run_exports of the corresponding host dependency; graphicsmagick is the\n    # one that does not define any, so it has to be listed explicitly.\n    - graphicsmagick\n  ignore_run_exports:\n    by_name:\n      # expat is a configure-time only dependency, needed so that pkg-config\n      # can resolve fontconfig's Requires; timg never links against it.\n      - libexpat\n\ntests:\n  - script:\n      - timg --version\n\nabout:\n  homepage: https://github.com/hzeller/timg\n  summary: Terminal image and video viewer (Sixel, Kitty, iTerm2, block graphics)\n  description: |\n    timg displays images, animated GIFs and videos in the terminal. On terminals\n    that implement the Sixel protocol, the Kitty Graphics Protocol, or the iTerm2\n    Graphics Protocol, images are shown in full resolution. On regular terminals,\n    images are rendered using 24-bit color unicode block characters.\n  # timg itself is GPL-2.0-only, but it compiles in two header-only libraries\n  # from third_party/: qoi (MIT) and stb_image (MIT OR Unlicense; MIT elected\n  # here). Their licence texts live inside the headers themselves, so those are\n  # packaged directly. third_party/stb/stb_image_resize2.h is NOT included, as\n  # it is guarded by WITH_TIMG_STB_RESIZE and swscale is used for resizing.\n  license: GPL-2.0-only AND MIT\n  license_file:\n    - LICENSE\n    - third_party/qoi/qoi.h\n    - third_party/stb/stb_image.h\n  documentation: https://timg.sh/\n  repository: https://github.com/hzeller/timg\n\nextra:\n  recipe-maintainers:\n    - pmav99\n",
  "req": {
    "__set__": true,
    "elements": [
