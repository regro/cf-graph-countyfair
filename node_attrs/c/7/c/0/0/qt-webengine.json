pkg-config\n      else:\n        - winflexbison\n        - m2-gperf\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - if: build_platform != target_platform\n      then: qt6-main ${{ version }}.*\n  host:\n    - qt6-main ${{ version }}.*\n    - if: linux\n      then:\n        - dbus\n        - alsa-lib\n        - expat\n        - fontconfig\n        - libcups\n        - libdrm\n        - libgbm\n        - libgl-devel\n        - libglx-devel\n        - libxcb\n        - libxkbcommon\n        - libxkbfile\n        - nspr\n        - nss\n    - if: unix\n      then:\n        - lcms2\n        - freetype\n    - glib\n    - spirv-headers\n    - spirv-tools\n    - html5lib\n    - harfbuzz\n    - libevent\n    - libtiff\n    - libpng\n    - if: unix\n      then:\n        - libopus\n        - libvpx\n    - if: linux\n      then:\n        - libudev\n        - libxkbfile\n        - libopengl-devel\n        - xorg-libxshmfence\n    - if: not osx\n      then:\n        - libvulkan-headers\n        - libvulkan-loader\n    - libxml2-devel\n    - libxslt\n    - openjpeg\n    - re2\n    - snappy\n    - minizip\n    - zlib\n  run:\n    - qt6-main ${{ version }}.*\n  run_exports:\n    - ${{ pin_subpackage('qt6-webengine', upper_bound='x.x') }}\n\ntests:\n  - script:\n      - if: unix\n        then:\n          - test -d $PREFIX/include/qt6/QtWebEngineWidgets\n          - test -d $PREFIX/include/qt6/QtPdfWidgets\n          - test -f $PREFIX/lib/libQt6WebEngineWidgets${SHLIB_EXT}\n          - test -f $PREFIX/lib/libQt6PdfWidgets${SHLIB_EXT}\n        else:\n          - if not exist %PREFIX%\\\\Library\\\\include\\\\qt6\\\\QtWebEngineWidgets exit 1\n          - if not exist %PREFIX%\\\\Library\\\\lib\\\\Qt6WebEngineWidgets.lib exit 1\n          - if not exist %PREFIX%\\\\Library\\\\bin\\\\Qt6WebEngineWidgets.dll exit 1\n    requirements:\n      run:\n        - ${{ stdlib(\"c\") }}\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n   