  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"3.19\"\n  python_check_max: \"3.14\"\n  cov_run: coverage run --source=idna --branch --append\n  cov_fail_under: \"93\"\n\npackage:\n  name: idna\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/idna/idna-${{ version }}.tar.gz\n  sha256: 5e0811a4383b21dc5838069f801c4fb62113b7447663d2530d2bd6e77b49bf15\n\nbuild:\n  noarch: python\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vvv --no-deps --no-build-isolation --disable-pip-version-check\n  python:\n    entry_points:\n      - idna = idna.cli:main\n\nrequirements:\n  host:\n    - flit-core >=3.11,<5\n    - python ${{ python_min }}.*\n    - pip\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports: idna\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - hypothesis\n        - python ${{ python_min }}.*\n        - pytest >=8.3.2\n        - pytest-cov\n    script:\n      - ${{ cov_run }} -m idna --help\n      - ${{ cov_run }} -m idna.cli --help\n      - ${{ cov_run }} -m idna --version\n      - idna --version | ${{ \"grep -iE\" if unix else \"findstr /c\" }} \"idna ${{ version | replace('.', '\\\\.') }}($| )\"\n      - ${{ cov_run }} -m pytest -vv --tb=long --color=yes\n      - coverage report --show-missing --skip-covered --fail-under=${{ cov_fail_under }}\n\nabout:\n  homepage: https://pypi.org/project/idna\n  repository: https://github.com/kjd/idna\n  license: BSD-3-Clause\n  license_file: LICENSE.md\n  summary: Internationalized Domain Names in Applications (IDNA).\n  description: |\n    A library to support the Internationalised Domain Names in Applications\n    (IDNA) protocol as specified in RFC 5891. This version of the prot