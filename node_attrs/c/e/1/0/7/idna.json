                "pytest-cov"
              ]
            },
            "script": [
              "${{ cov_run }} -m idna --help",
              "${{ cov_run }} -m idna.cli --help",
              "${{ cov_run }} -m idna --version",
              "idna --version | ${{ \"grep -iE\" if unix else \"findstr /c\" }} \"idna ${{ version | replace('.', '\\\\.') }}($| )\"",
