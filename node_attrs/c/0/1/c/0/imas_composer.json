  "linux_64_meta_yaml": {
    "about": {
      "description": "IMAS Composer provides a clean, declarative API for mapping DIII-D diagnostic\nand analysis data (stored in MDSplus) to standardized IMAS v3.41.0 data\nstructures (IDS - Interface Data Structures). It handles requirement\nidentification, data transformation, COCOS conversions, and composition.\n",
      "dev_url": "https://github.com/GA-FDP/imas_composer",
      "doc_url": "https://github.com/GA-FDP/imas_composer/blob/main/README.md",
      "home": "https://github.com/GA-FDP/imas_composer",
      "license": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A Python library for converting DIII-D MDSplus data to IMAS format"
    },
    "build": {
      "noarch": "python",
      "number": "0"
    },
    "extra": {
      "recipe-maintainers": [
        "arewedreaming",
        "modestmc",
        "smithsp",
        "sammuli"
      ]
    },
    "outputs": [
      {
        "build": {
          "entry_points": [
            "iri-cake-viewer = imas_composer.plots.iri_cake_viewer:main"
          ],
          "noarch": "python"
        },
        "name": "imas_composer",
        "requirements": {
          "host": [
            "python 3.10",
            "pip",
            "setuptools >=61.0",
            "wheel"
          ],
          "run": [
            "python >=3.10",
            "numpy >=1.20",
            "pyyaml >=5.4",
            "awkward >=2.0"
          ]
        },
        "script": "install_base.sh",
        "test": {
          "commands": [
            "pip check"
          ],
          "imports": [
            "imas_composer",
            "imas_composer.ids"
          ],
          "requires": [
            "python 3.10",
            "pip"
          ]
        }
      },
      {
        "build": {
          "noarch": "python"
        },
        "name": "imas_composer_plots",
        "requirements": {
          "host": [
            "python 3.10"
          ],
          "run": [
            "python >=3.10",
            "imas_composer",
            "pyqtgraph",
            "pyside6",
            "scipy",
            "contourpy",
            "pyodbc",
            "freetds",
            "mdsplus",
            "omas"
          ]
        },
        "test": {
          "commands": [
            "iri-cake-viewer --help"
          ],
          "imports": [
            "imas_composer.plots"
          ],
          "requires": [
            "python 3.10"
          ]
        }
      }
    ],
