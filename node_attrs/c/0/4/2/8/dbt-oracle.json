  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.12.0\"\n\npackage:\n  name: dbt-oracle\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/dbt-oracle/dbt_oracle-${{ version }}.tar.gz\n  sha256: 0deb9d4f2ce5a27354a3480e8604a1f0dc911aeda776d874a3e7606de35affaa\n\nbuild:\n  noarch: python\n  number: 0\n  script: python -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=77.0\n    - wheel\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - dbt-common >=1.1.0,<2.0\n    - dbt-adapters >=1.2.1,<2.0\n    - dbt-core >=1.12,<1.13\n    - oracledb\n    # Not declared upstream, but required by the bundled\n    # `create-pem-from-p12` helper script.\n    - cryptography\n\ntests:\n  - python:\n      imports:\n        - dbt.adapters.oracle\n        - dbt.include.oracle\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - python -c \"from dbt.adapters.oracle import Plugin\"\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n  - if: unix\n    then:\n      script:\n        - create-pem-from-p12 --help\n      requirements:\n        run:\n          - python ${{ python_min }}.*\n  - package_contents:\n      site_packages:\n        - dbt/adapters/oracle/__init__.py\n        - dbt/include/oracle/dbt_project.yml\n\nabout:\n  homepage: https://github.com/oracle/dbt-oracle\n  summary: dbt (data build tool) adapter for Oracle Autonomous Database\n  description: |\n    dbt-oracle implements dbt (data build tool) functionality for the Oracle\n    Database. It supports Oracle Autonomous Database, both in the cloud and\n    on-premises, as well as Oracle Database 19c and later, using the\n    python-oracledb driver.\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  documentation: https://docs.getdbt.com/reference/warehouse-profiles/oracle-profile\n  repository: https://github.com/oracle/dbt-oracle\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
