      "doc_url": "https://herdr.dev/docs",
      "home": "https://herdr.dev/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Agent multiplexer that lives in your terminal"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --path=. --root=\"${PREFIX}\" --no-track --locked --bins --target-dir=target",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml",
          "mkdir -p \\\n  \"${PREFIX}/share/bash-completion/completions\" \\\n  \"${PREFIX}/share/zsh/site-functions\" \\\n  \"${PREFIX}/share/fish/vendor_completions.d\" \\\n  \"${PREFIX}/share/elvish/lib\" \\\n  \"${PREFIX}/share/herdr/completions\"\n",
          "herdr completion bash > \"${PREFIX}/share/bash-completion/completions/herdr\"",
          "herdr completion zsh > \"${PREFIX}/share/zsh/site-functions/_herdr\"",
          "herdr completion fish > \"${PREFIX}/share/fish/vendor_completions.d/herdr.fish\"",
          "herdr completion elvish > \"${PREFIX}/share/elvish/lib/herdr.elv\"",
          "herdr completion powershell > \"${PREFIX}/share/herdr/completions/herdr.ps1\""
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "brush"
      }
    },
