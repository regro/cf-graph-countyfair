  "linux_64_meta_yaml": {
    "about": {
      "description": "umoci is a tool that allows for high-level modification of an OCI image\nlayout and its tagged images. It can create new images from scratch,\nunpack images to OCI runtime bundles and repack them, generate runtime\nconfigurations, and otherwise manipulate OCI images without requiring\nroot privileges or a container runtime daemon.",
      "dev_url": "https://github.com/opencontainers/umoci",
      "home": "https://umo.ci/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "COPYING",
      "summary": "A tool for modifying Open Container images"
    },
    "build": {
      "number": "1",
      "script": [
        "go-licenses save ./cmd/umoci --save_path=library_licenses",
        "make docs",
        "COMMIT_HASH=\"$(curl -s \"https://api.github.com/repos/opencontainers/umoci/commits/v${{ version }}\" | jq -r '.sha')\"",
        "go build -o=\"$PREFIX\"/bin/umoci -v -buildmode=pie -ldflags=\"-s -w -X github.com/opencontainers/umoci.gitCommit=${COMMIT_HASH}\" -trimpath ./cmd/umoci",
        "mkdir -p \"$PREFIX\"/share/man/man1",
        "cp doc/man/*.1 \"$PREFIX\"/share/man/man1/"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "umoci",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses",
            "go-md2man",
            "make"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "umoci --help",
              "umoci --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "umoci"
              ],
              "files": [
                "share/man/man1/umoci*.1"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.6.0"
      }
    ],
    "package": {
      "name": "umoci",
      "version": "0.6.0"
    },
