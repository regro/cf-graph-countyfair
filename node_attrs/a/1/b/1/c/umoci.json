  "raw_meta_yaml": "context:\n  version: \"0.6.0\"\n\npackage:\n  name: umoci\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/opencontainers/umoci/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 400a26c5f7ac06e40af907255e0e23407237d950e78e8d7c9043a1ad46da9ae5\n\nbuild:\n  number: 1\n  script:\n    - go-licenses save ./cmd/umoci --save_path=library_licenses\n    # upstream ref: https://github.com/opencontainers/umoci/blob/main/Makefile\n    - make docs\n    - COMMIT_HASH=\"$(curl -s \"https://api.github.com/repos/opencontainers/umoci/commits/v${{ version }}\" | jq -r '.sha')\"\n    - go build -o=\"$PREFIX\"/bin/umoci -v -buildmode=pie -ldflags=\"-s -w -X github.com/opencontainers/umoci.gitCommit=${COMMIT_HASH}\" -trimpath ./cmd/umoci\n    # generate man pages\n    - mkdir -p \"$PREFIX\"/share/man/man1\n    - cp doc/man/*.1 \"$PREFIX\"/share/man/man1/\n  skip: win # cf. https://github.com/opencontainers/umoci/issues/607 \n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n    - go-md2man\n    - make\n\ntests:\n  - script:\n      - umoci --help\n      - umoci --version\n  - package_contents:\n      bin:\n        - umoci\n      files:\n        - if: unix\n          then:\n            - share/man/man1/umoci*.1\n      strict: true\n\nabout:\n  summary: A tool for modifying Open Container images\n  description: |\n    umoci is a tool that allows for high-level modification of an OCI image\n    layout and its tagged images. It can create new images from scratch,\n    unpack images to OCI runtime bundles and repack them, generate runtime\n    configurations, and otherwise manipulate OCI images without requiring\n    root privileges or a container runtime daemon.\n  license: Apache-2.0\n  license_file:\n    - COPYING\n    - library_licenses/\n  homepage: https://umo.ci\n  repository: https://github.com/opencontainers/umoci\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
