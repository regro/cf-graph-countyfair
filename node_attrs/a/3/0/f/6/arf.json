  "linux_64_meta_yaml": {
    "about": {
      "description": "arf is a cross-platform R console written in Rust. It is a single binary\nwith no runtime dependencies, offering Vi/Emacs editing modes, multiline\nediting with proper indentation, auto-matching brackets and quotes, tab\ncompletion for R objects/functions/file paths, fzf-style history search,\ncustomizable keyboard shortcuts, a fuzzy help browser, tree-sitter based\nsyntax highlighting, reprex mode, shell mode, and an IPC server for AI\nagent and CI integration. It also integrates with\n[rig](https://r-lib.github.io/rig/) to switch R versions on the fly.",
      "dev_url": "https://github.com/eitsupi/arf",
      "home": "https://github.com/eitsupi/arf",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.md",
      "summary": "Alternative R Frontend — a cross-platform R console written in Rust"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd crates/arf-console",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/arf completions bash > \"$PREFIX\"/share/bash-completion/completions/arf",
          "\"$PREFIX\"/bin/arf completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/arf.fish",
          "\"$PREFIX\"/bin/arf completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_arf",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "arf",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "arf --help",
              "arf --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "arf"
              ],
              "files": [
                "share/bash-completion/completions/arf",
                "share/fish/vendor_completions.d/arf.fish",
                "share/zsh/site-functions/_arf"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.5.1"
      }
    ],
