  "raw_meta_yaml": "context:\n  version: \"0.5.1\"\n\npackage:\n  name: arf\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/eitsupi/arf/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: cc745c4a2411c9eee3eaeef31c70f7ebed75e28277624b95d602ac8efc068f93\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # instruct `cc` crate to use clang-cl natively to compile build-time tools intended to be run on the host when cross-compiling from `win_64`\n      AR_x86_64_pc_windows_msvc: llvm-lib\n      CC_x86_64_pc_windows_msvc: clang-cl\n      CXX_x86_64_pc_windows_msvc: clang-cl\n    content:\n      - cd crates/arf-console\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/arf completions bash > \"$PREFIX\"/share/bash-completion/completions/arf'\n              - '\"$PREFIX\"/bin/arf completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/arf.fish'\n              - '\"$PREFIX\"/bin/arf completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_arf'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\arf.exe completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\arf'\n              - '\"%LIBRARY_BIN%\"\\arf.exe completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\arf.fish'\n              - '\"%LIBRARY_BIN%\"\\arf.exe completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_arf'\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - arf --help\n      - arf --version\n  - package_contents:\n      bin:\n        - arf\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/arf\n            - share/fish/vendor_completions.d/arf.fish\n            - share/zsh/site-functions/_arf\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/arf\n            - Library/share/fish/vendor_completions.d/arf.fish\n            - Library/share/zsh/site-functions/_arf\n      strict: true\n\nabout:\n  summary: Alternative R Frontend — a cross-platform R console written in Rust\n  description: |\n    arf is a cross-platform R console written in Rust. It is a single binary\n    with no runtime dependencies, offering Vi/Emacs editing modes, multiline\n    editing with proper indentation, auto-matching brackets and quotes, tab\n    completion for R objects/functions/file paths, fzf-style history search,\n    customizable keyboard shortcuts, a fuzzy help browser, tree-sitter based\n    syntax highlighting, reprex mode, shell mode, and an IPC server for AI\n    agent and CI integration. It also integrates with\n    [rig](https://r-lib.github.io/rig/) to switch R versions on the fly.\n  license: MIT\n  license_file:\n    - LICENSE.md\n    - THIRDPARTY.yml\n  homepage: https://github.com/eitsupi/arf\n  repository: https://github.com/eitsupi/arf\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
