  "raw_meta_yaml": "context:\n  version: \"22.1.8\"\n\npackage:\n  name: lldb\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-${{ version|replace(\".rc\", \"-rc\") }}.tar.gz\n  sha256: ad18b70e287954c3d62bc7e0b86e7b7af2adf87bcfce21c15fe717f101d7aace\n  patches:\n    # Fix Python and Mac support\n    - if: unix\n      then: patches/0001-Remove-linking-liblldb-to-libpython.patch\n    # https://github.com/llvm/llvm-project/issues/59449\n    # allows for compiling with older SDKs\n    - patches/0002-Define-CPU_SUBTYPE_ARM64E-if-not-available.patch\n    # This is needed due to c-f's remove of pid_t in Python: https://github.com/conda-forge/python-feedstock/pull/767\n    - if: win\n      then:\n        - patches/0003-Don-t-define-NO_PID_T-where-Python-is-patched.patch\n        - patches/0004-fix-file-extension-on-windows.patch\n    - if: linux\n      then:\n        # https://github.com/llvm/llvm-project/issues/221704\n        - patches/0005-lldb-also-build-libedit-integration-with-stable-ABI.patch\n        - patches/0006-disable-python-libedit-bits.patch\n        - patches/0007-allow-unresolved-symbols.patch\n\nbuild:\n  number: 1\n  python:\n    version_independent: ${{ is_abi3 }}\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"cxx\") }}\n    - cmake >=3.4.3\n    - ninja\n    - if: build_platform != host_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - swig\n        - zlib\n        - llvmdev ==${{ version }}\n        - clangdev ==${{ version }}\n  host:\n    - python\n    # we're linking to `libpython3.{so,dylib}`\n    - libpython\n    - if: is_abi3\n      then:  python-abi3\n    - llvm ==${{ version }}\n    - llvmdev ==${{ version }}\n    - clangdev ==${{ version }}\n    - libclang-cpp ==${{ version }}\n    - swig\n    - libxml2-devel\n    - liblzma-devel\n    - zlib\n    - zstd\n    - six\n    - if: unix\n      then:\n        - libedit\n        - ncurses\n  run:\n    - python\n    # waiting for run-export, c.f. https://github.com/conda-forge/python-feedstock/pull/928 (+backports)\n    - libpython\n    - six\n    - if: osx\n      # we need to do this manually because clang_bootstrap has no run-export\n      then: libcxx >=${{ version }}\n  run_constraints:\n    - llvmdev ==${{ version }}\n    - clangdev ==${{ version }}\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - lldb\n  - script:\n      - lldb --version\n      - lldb-argdumper --version\n      - lldb-dap --version\n      - lldb-instr --version\n      # can't test without running mcp server\n      # - lldb-mcp --version\n      - lldb-server --version\n      - yaml2macho-core --version\n  - requirements:\n      run:\n        - abi3audit\n    script:\n      - if: unix\n        then: abi3audit $SP_DIR/lldb/native/_lldb.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else: abi3audit %SP_DIR%/lldb/native/_lldb.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\n\nabout:\n  homepage: http://llvm.org/\n  repository: https://github.com/llvm/llvm-project\n  license: Apache-2.0 WITH LLVM-exception\n  license_file: lldb/LICENSE.TXT\n  summary: The LLVM Debugger\n\nextra:\n  recipe-maintainers:\n    - isuruf\n    - h-vetinari\n    - xhochy\n",
