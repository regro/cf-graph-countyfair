  "osx_arm64_meta_yaml": {
    "about": {
      "description": "just is a handy way to save and run project-specific commands.\n\nCommands, called recipes, are stored in a file called justfile with syntax\ninspired by make.",
      "dev_url": "https://github.com/casey/just",
      "doc_url": "https://just.systems/man/en/",
      "home": "https://github.com/casey/just",
      "license": "CC0-1.0",
      "license_family": "CC0-1.0",
      "license_file": "LICENSE",
      "summary": "just is a handy way to save and run project-specific commands."
    },
    "build": {
      "number": "2",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d $PREFIX/share/man/man1",
          "$PREFIX/bin/just --completions bash > $PREFIX/share/bash-completion/completions/just",
          "$PREFIX/bin/just --completions zsh > $PREFIX/share/zsh/site-functions/_just",
          "$PREFIX/bin/just --completions fish > $PREFIX/share/fish/vendor_completions.d/just.fish",
          "$PREFIX/bin/just --man > $PREFIX/share/man/man1/just.1"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "dbast"
      ]
    },
