  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.58.0\"\n\npackage:\n  name: just\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/casey/just/archive/${{ version }}.tar.gz\n  sha256: c8a36e6e9397f2fdfcb0cc246fcdb790b52a784f3c8cabc0d8baeb031852a148\n\nbuild:\n  number: 2\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d $PREFIX/share/man/man1\n          - $PREFIX/bin/just --completions bash > $PREFIX/share/bash-completion/completions/just\n          - $PREFIX/bin/just --completions zsh > $PREFIX/share/zsh/site-functions/_just\n          - $PREFIX/bin/just --completions fish > $PREFIX/share/fish/vendor_completions.d/just.fish\n          - $PREFIX/bin/just --man > $PREFIX/share/man/man1/just.1\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script: just --help\n  - package_contents:\n      bin:\n        - just\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/just\n            - share/zsh/site-functions/_just\n            - share/fish/vendor_completions.d/just.fish\n            - share/man/man1/just.1\n      strict: true\n\nabout:\n  homepage: https://github.com/casey/just\n  summary: just is a handy way to save and run project-specific commands.\n  description: |\n    just is a handy way to save and run project-specific commands.\n\n    Commands, called recipes, are stored in a file called justfile with syntax\n    inspired by make.\n  license: CC0-1.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://just.systems/man/en/\n  repository: https://github.com/casey/just\n\nextra:\n  recipe-maintainers:\n    - dbast\n",
