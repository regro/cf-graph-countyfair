  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.16.0\"\n  python_min: \"3.12\"\n\npackage:\n  name: pyvista-js\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pyvista-js/pyvista_js-${{ version }}.tar.gz\n  sha256: a4eb92eec98c2ceacaabe9de81fe4c5e7c11fc174896eadffcf8ca9142d1330c\n  patches:\n    - patches/0001-build-renderer.js-with-esbuild-directly.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - pyvista-js = pyvista_js._cli:cli_main\n\nrequirements:\n  build:\n    # bundles ts/renderer.ts into src/pyvista_js/templates/renderer.js;\n    # emits plain JS, so the output stays noarch\n    - esbuild\n  host:\n    - python ${{ python_min }}.*\n    - hatch-build-scripts\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<3.15\n    - jinja2 >=3.0.1,<4.0.1\n    - lazy-loader >=0.4.1,<1.0.1\n    - numpy >=2.0.1,<3.0.1\n    - typer >=0.9.1,<1.0.1\n\ntests:\n  - python:\n      imports:\n        - pyvista_js\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - pyvista-js --help\n\nabout:\n  summary: PyVista-like API for vtk.js\n  license: BSD-3-Clause\n  license_file: LICENSE\n  homepage: https://github.com/tkoyama010/pyvista-js\n  documentation: https://github.com/tkoyama010/pyvista-js\n\nextra:\n  recipe-maintainers:\n    - larsoner\n    - tkoyama010\n",
