          "libasdf"
        ]
      },
      "script": [
        "cat > linker-syms.map <<'EOF'\n{\n  local:\n    _init;\n    _fini;\n};\nEOF\n",
        "export LDFLAGS=\"${LDFLAGS} -Wl,--version-script=${SRC_DIR}/linker-syms.map\"",
        "./configure --prefix=\"${PREFIX}\" --disable-docs",
        "make -j${CPU_COUNT}",
        "if [[ \"${CONDA_BUILD_CROSS_COMPILATION:-}\" != \"1\" || \"${CROSSCOMPILING_EMULATOR:-}\" != \"\" ]]; then\n    make check || (cat tests/test-suite.log && exit 1)\nfi\n",
        "make install"
      ]
    },
