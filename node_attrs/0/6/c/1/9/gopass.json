  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.17.0\"\n\npackage:\n  name: gopass\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/gopasspw/gopass/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: ce004c82b65ffac44de2991020843828b38bb510909506f2fa0f40bec05b7c75\n\nbuild:\n  number: 0\n  script:\n    - make build\n    # go-licenses misreads filippo.io/nistec/internal/fiat's README as a\n    # BSD-1-Clause license file, a type it does not know about. The module's\n    # real LICENSE is still saved, via filippo.io/nistec itself.\n    - go-licenses save . --save_path license-files --ignore filippo.io/nistec/internal/fiat\n    - if: unix\n      then: make install\n    # `make install` needs unix `install`, so place the executable by hand on\n    # Windows. rattler-build, unlike conda-build, does not pre-create the\n    # prefix layout, so the target directory has to be made first.\n    - if: win\n      then:\n        - if not exist \"%PREFIX%\\Library\\bin\" mkdir \"%PREFIX%\\Library\\bin\"\n        - copy gopass \"%PREFIX%\\Library\\bin\\gopass.exe\"\n    # Clear out cache to avoid file not removable warnings\n    - if: unix\n      then: chmod -R u+w $(go env GOPATH) && rm -r $(go env GOPATH)\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n    - make\n\ntests:\n  - script: gopass --help\n\nabout:\n  homepage: https://www.gopass.pw\n  license: MIT\n  license_file:\n    - LICENSE\n    - license-files/**\n  summary: The slightly more awesome standard unix password manager for teams.\n  repository: https://github.com/gopasspw/gopass\n\nextra:\n  recipe-maintainers:\n    - anjos\n",
  "req": {
