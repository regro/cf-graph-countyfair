  "linux_64_meta_yaml": {
    "about": {
      "description": "Merge Gatekeeper adds merge control on top of GitHub's branch protection.\nRunning as a single check for every Pull Request, it inspects all the other\nCI jobs kicked off for that PR and only succeeds once they have all\ncompleted successfully. This makes branch protection work for monorepos,\nwhere jobs are triggered conditionally on the files a PR touches and cannot\nbe listed up front as required checks.",
      "dev_url": "https://github.com/upsidr/merge-gatekeeper",
      "doc_url": "https://pkg.go.dev/github.com/upsidr/merge-gatekeeper",
      "home": "https://github.com/upsidr/merge-gatekeeper",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "src/LICENSE",
      "summary": "Merge Gatekeeper provides extra control for Pull Request management"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/merge-gatekeeper --save_path ../library_licenses --ignore github.com/inconshreveable/mousetrap",
        "go build -v -o $PREFIX/bin/merge-gatekeeper -ldflags=\"-s -w -X main.version=v${{ version }}\" ./cmd/merge-gatekeeper"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "merge-gatekeeper",
        "requirements": {
          "build": [
