  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 2.1.1\n\npackage:\n  name: coastseg\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/C/CoastSeg/coastseg-${{ version }}.tar.gz\n  sha256: 1d078cafc5b3dbb3145a1fa44f5b3beb4c2b1332be5632babe4edc63d88cb536\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<3.13\n    - gdal\n    # temporary pin needed because leafmap relies on ipyvuetify, but since conda-forge's ipyvuetify 3.0.0 build still pins ipyvue <2,\n    # but it needs ipyvue >=3, this causes the Python metadata to be inconsistent (pip check fails). Remove this ceiling once \n    # conda-forge/ipyvuetify-feedstock fixes its ipyvue\n    - ipyvuetify <3\n    - aiohttp\n    - onnxruntime\n    - chardet\n    - dask-core\n    - coastsat-package >=0.5.0\n    - geojson\n    - h5py\n    - jupyterlab >=3.0.0\n    - leafmap\n    - nest-asyncio\n    - pooch\n    - protobuf\n    - pytmd >=3.0.9,<4\n    - xarray\n    - pytz\n    - netcdf4\n    - geopandas\n    - timescale >=0.1.1\ntests:\n  - python:\n      imports:\n        - coastseg\n        - coastseg.extracted_shoreline\n        - coastseg.zoo_model\n        - coastseg.common\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n\nabout:\n  homepage: https://github.com/SatelliteShorelines/CoastSeg\n  summary: An interactive python package for satellite derived shoreline workflows\n  license: GPL-3.0-only\n  license_file: LICENSE\n  documentation: https://satelliteshorelines.github.io/CoastSeg/\n  repository: https://github.com/SatelliteShorelines/CoastSeg\n\nextra:\n  recipe-maintainers:\n    - 2320sharon\n    - ocefpaf\n",
