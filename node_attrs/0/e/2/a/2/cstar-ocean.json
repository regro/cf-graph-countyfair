  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.13.5\"\n  python_min: \"3.12\"\n\nrecipe:\n  name: cstar-ocean-suite\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/c/cstar-ocean/cstar_ocean-${{ version }}.tar.gz\n    sha256: d5d1dc160642c7a8c31770c24758dd0e2988df0107a3760ac329cc3738b7833a\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: cstar-ocean\n      version: ${{ version }}\n\n    build:\n      # noarch; not solvable on Windows today (roms-tools -> xesmf/esmf has no\n      # win-64 build) but will work there as soon as the deps become available\n      noarch: python\n      script: python -m pip install . -vv --no-deps --no-build-isolation\n      python:\n        entry_points:\n          - cstar = cstar.cli.cli:main\n\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools >=61.0.0\n        - wheel\n        - setuptools-scm >=7.0\n        - check-manifest\n      run:\n        - python >=${{ python_min }}\n        - fakeredis <2.35\n        - networkx >=3.6.1\n        - psutil >=7.2.2\n        - pydantic >=2.13\n        - pydantic-settings >=2.13\n        - python-dateutil >=2.8.2\n        - pytimeparse >=1.1.8\n        - python-dotenv\n        - pyyaml >=6.0,<7\n        - f90nml >=1.4\n        - numpy >2.0,<2.4\n        - roms-tools >=4.0.1,<5\n        - typer <=0.25\n\n    tests:\n      - python:\n          imports:\n            - cstar\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - script:\n          - cstar --version\n\n    about:\n      homepage: https://www.cworthy.org\n      repository: https://github.com/CWorthy-ocean/C-Star\n      documentation: https://c-star.readthedocs.io\n      summary: Computational systems for tracking ocean carbon\n      description: |\n        C-Star automates the setup and execution of reproducible ocean-carbon\n        modeling workflows (ROMS-MARBL and related regional ocean/biogeochemistry\n        simulations) via a blueprint-driven, orchestration-aware Python API and\n        command-line tool.\n      license: Apache-2.0\n      license_file: LICENSE\n\n  - package:\n      name: cstar-ocean-standalone\n      version: ${{ version }}\n\n    build:\n      # metapackage (no code): the toolchain deps below resolve to their\n      # platform-specific variants at install time\n      noarch: generic\n\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"cstar-ocean\", exact=True) }}\n        - c-compiler\n        - cxx-compiler\n        - fortran-compiler\n        - make\n        - cmake\n        # mpich-mpicc/mpich-mpifort pin the exact mpich build plus the\n        # activation package providing the compiler its wrappers hardcode;\n        # bare mpich + raw compilers 2.0 can otherwise solve to a broken\n        # mpicc on osx-arm64 (conda-forge/mpich-feedstock#142)\n        - mpich\n        - mpich-mpicc\n        - mpich-mpifort\n        - netcdf-fortran\n        - libpnetcdf\n        # ucla-roms Makefiles require GNU-flavored rsync; macOS system rsync lacks the needed flags\n        - rsync\n\n    tests:\n      - script:\n          # the point of this metapackage is a working toolchain next to cstar\n          - cstar --version\n          - gfortran --version\n          - mpirun --version\n          # these exec the wrappers' underlying compilers, catching a broken\n          # mpicc/mpif90 (conda-forge/mpich-feedstock#142)\n          - mpicc --version\n          - mpif90 --version\n          - cmake --version\n          - make --version\n          - rsync --version\n          - nf-config --version\n\n    about:\n      homepage: https://www.cworthy.org\n      repository: https://github.com/CWorthy-ocean/C-Star\n      documentation: https://c-star.readthedocs.io\n      summary: >-\n        C-Star with a full conda-provided build toolchain for laptops/workstations\n        (HPC users should use system modules instead)\n      license: Apache-2.0\n      license_file: LICENSE\n\nabout:\n  homepage: https://www.cworthy.org\n  repository: https://github.com/CWorthy-ocean/C-Star\n  documentation: https://c-star.readthedocs.io\n  summary: Computational systems for tracking ocean carbon\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  # multi-output recipe: infrastructure needs the feedstock name to be explicit\n  feedstock-name: cstar-ocean\n  recipe-maintainers:\n    - ScottEilerman\n",
