      "description": "quax implements multiple dispatch over abstract array types in JAX. It lets\nyou write ordinary JAX code against array-like objects - symbolic zeros,\narrays with units, structured matrices, quantised tensors - and have that\ncode keep working through jit, grad and the other JAX transformations, by\nrouting operations through custom interpreters.",
      "dev_url": "https://github.com/nstarman/quax",
      "home": "https://github.com/nstarman/quax",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Multiple dispatch in JAX via custom interpreters"
    },
    "build": {
      "noarch": "python",
      "number": "0",
