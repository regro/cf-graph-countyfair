  "raw_meta_yaml": "context:\n  version: \"2.3.0\"\n\nrecipe:\n  name: jrl-cmakemodules\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jrl-umi3218/jrl-cmakemodules/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 840cfba922b9589695ee3da4da3f9472ceeefe8fe4bccbb7ed3e885d1ca978cf\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: jrl-cmakemodules\n    build:\n      noarch: generic\n      script:\n        - if: win\n          then: build.bat\n          else: build.sh\n    requirements:\n      build:\n        - cmake\n        - ninja\n      run:\n        - if: unix\n          then: __unix\n          else: __win\n    tests:\n      # test package contents\n      - package_contents:\n          files:\n            - if: unix\n              then:\n                - share/cmake/jrl-cmakemodules/v2/modules/jrl.cmake\n            - if: win\n              then:\n                - Library/share/cmake/jrl-cmakemodules/v2/modules/jrl.cmake\n      # cmake-package-check doesn't work on Windows\n      # It create an issue when rattler build want to remove test directory\n      - if: unix\n        then:\n          - script:\n              - cmake-package-check jrl-cmakemodules --target jrl-cmakemodules::jrl-cmakemodules\n            requirements:\n              run:\n                - cmake-package-check\n                - ${{ compiler('c') }}\n                - ${{ compiler('cxx') }}\n  - package:\n      name: jrl-cmakemodules-scripts\n    build:\n      noarch: python\n      script: pip install ./v2/scripts -v\n      python:\n        entry_points:\n          - jrl-release = jrl_release:main\n    requirements:\n      host:\n        - pip\n        - python ${{ python_min }}.*\n        - setuptools\n      run:\n        - python >=${{ python_min }}\n        - tomlkit >=0.11.0\n        - ruamel.yaml >=0.17.0\n        - rich >=12.0.0\n        - packaging >=21.0\n        - cmake-parser >=0.1.0\n    tests:\n      - script:\n          - jrl-release --help\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/jrl-umi3218/jrl-cmakemodules\n  summary: \"CMake utility toolbox.\"\n  description: |\n    `jrl-cmakemodules` provide functions to factorize and write more reliable CMake code.\n    It is used by teams at CNRS, LAAS/HPP, JRL and INRIA, but can be integrated in any project.\n  license: BSD-3-Clause\n  license_file: v2/LICENSE\n  documentation: https://simplejson.readthedocs.io/\n  repository: https://github.com/jrl-umi3218/jrl-cmakemodules/\n\nextra:\n  recipe-maintainers:\n    - jorisv\n",
