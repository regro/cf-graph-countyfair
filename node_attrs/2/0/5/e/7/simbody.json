  "raw_meta_yaml": "{% set version = \"3.8\" %}\n\npackage:\n    name: simbody\n    version: \"{{ version }}\"\n\nsource:\n    fn: Simbody-{{ version }}.tar.gz\n    url: https://github.com/simbody/simbody/archive/Simbody-{{ version }}.tar.gz\n    sha256: ea71b0206f54a6b4d1714a20e145ba3f39a8298aed1718742b18b6d5ea0261dd\n    patches:\n      # Use conda-forge's freeglut instead of the bundled Windows binaries.\n      - 0001-use-system-freeglut-on-windows.patch\n      # Use conda-forge's lodepng instead of the bundled 2010 snapshot.\n      - 0002-use-system-lodepng.patch\n      # Fix the installed pkg-config version and Windows BLAS link flags.\n      - 0003-fix-pkg-config-metadata.patch\n      # Conda supplies external Windows DLLs on PATH, so do not copy target DLLs.\n      - 0004-skip-runtime-dll-copy-with-external-libs.patch\n\nbuild:\n    number: 1\n    run_exports:\n        - {{ pin_subpackage('simbody', max_pin='x.x') }}\n    # Xmu and Xi are needed only for CMake's Linux GLUT feature check;\n    # Simbody does not link against them directly.\n    ignore_run_exports:\n        - xorg-libxmu  # [linux]\n        - xorg-libxi  # [linux]\n    # NOTE : This is needed to ensure the paths to Simbody's binaries, like\n    # simbody-visualizer, are corrected.\n    detect_binary_files_with_prefix: true\n\n# NOTE: This installs Simbody and the optional visualizer on Linux, Windows,\n# and OSX. On Windows, we build against the openblas available in conda-forge,\n# which includes lapack, because the other blas/lapack packages do not provide\n# import libraries (*.lib). We use conda-forge's FreeGLUT on Linux and Windows;\n# macOS provides a GLUT framework.\n# https://github.com/AnacondaRecipes/r-rgl-feedstock/blob/master/recipe/meta.yaml#L48-L67\nrequirements:\n    build:\n        - cmake >=3.21\n        - ninja  # [win]\n        - make  # [unix]\n        - doxygen\n        - {{ compiler('c') }}\n        - {{ stdlib('c') }}\n        - {{ compiler('cxx') }}\n    host:\n        - openblas  # [win]\n        - libblas  # [not win]\n        - liblapack  # [not win]\n        - libgl-devel  # [linux]\n        - libglu  # [linux]\n        - freeglut  # [not osx]\n        - xorg-libxmu  # [linux]\n        - xorg-libxi  # [linux]\n        - lodepng\n    run:\n        - openblas  # [win]\n        # Keep downstreams compatible after removing Simbody's vendored dirent.h.\n        # See https://github.com/conda-forge/simbody-feedstock/issues/39.\n        - dirent  # [win]\ntest:\n  commands:\n    - test -f $PREFIX/libexec/simbody/simbody-visualizer              # [linux]\n    - test -f $PREFIX/libexec/simbody/simbody-visualizer.app/Contents/MacOS/simbody-visualizer  # [osx]\n    - if not exist %LIBRARY_BIN%\\\\simbody-visualizer.exe exit 1       # [win]\n    - test -f $PREFIX/include/simbody/Simbody.h                       # [unix]\n    - test -f $PREFIX/include/simbody/SimTKcommon.h                   # [unix]\n    - test -f $PREFIX/include/simbody/SimTKlapack.h                   # [unix]\n    - test -f $PREFIX/include/simbody/SimTKmath.h                     # [unix]\n    - test -f $PREFIX/include/simbody/SimTKsimbody_aux.h              # [unix]\n    - test -f $PREFIX/include/simbody/SimTKsimbody.h                  # [unix]\n    - if not exist %LIBRARY_INC%\\\\Simbody.h exit 1                    # [win]\n    - if not exist %LIBRARY_INC%\\\\SimTKcommon.h exit 1                # [win]\n    - if not exist %LIBRARY_INC%\\\\SimTKlapack.h exit 1                # [win]\n    - if not exist %LIBRARY_INC%\\\\SimTKmath.h exit 1                  # [win]\n    - if not exist %LIBRARY_INC%\\\\SimTKsimbody_aux.h exit 1           # [win]\n    - if not exist %LIBRARY_INC%\\\\SimTKsimbody.h exit 1               # [win]\n    - test -f $PREFIX/lib/libSimTKcommon.so                           # [linux]\n    - test -f $PREFIX/lib/libSimTKmath.so                             # [linux]\n    - test -f $PREFIX/lib/libSimTKsimbody.so                          # [linux]\n    - test -f $PREFIX/lib/libSimTKcommon.dylib                        # [osx]\n    - test -f $PREFIX/lib/libSimTKmath.dylib                          # [osx]\n    - test -f $PREFIX/lib/libSimTKsimbody.dylib                       # [osx]\n    - if not exist %LIBRARY_BIN%\\\\SimTKcommon.dll exit 1              # [win]\n    - if not exist %LIBRARY_BIN%\\\\SimTKmath.dll exit 1                # [win]\n    - if not exist %LIBRARY_BIN%\\\\SimTKsimbody.dll exit 1             # [win]\n    # Regression test for https://github.com/conda-forge/simbody-feedstock/issues/39.\n    # Check Simbody's own file list because the runtime dirent package provides\n    # the replacement header in the combined test environment.\n    - findstr /i /c:\"Library/include/dirent.h\" \"%PREFIX%\\\\conda-meta\\\\simbody-{{ version }}-*.json\" >nul && exit /b 1 || ver >nul  # [win]\n    - if exist %LIBRARY_BIN%\\\\glut32.dll exit 1                  # [win]\n    # Installed CMake metadata must not retain a conda-build prefix.\n    - if grep -R -E '(_h_env_|conda-bld)' $PREFIX/lib/cmake/simbody; then exit 1; fi  # [unix]\n    - findstr /s /m /c:\"_h_env_\" /c:\"conda-bld\" \"%LIBRARY_PREFIX%\\lib\\cmake\\simbody\\*\" >nul && exit /b 1 || ver >nul  # [win]\n    # Unix targets may export portable BLAS::BLAS/LAPACK::LAPACK names, but\n    # must not hard-code a provider or library path.\n    - if grep -E '(lib(open)?blas|liblapack|libblis|openblas)' $PREFIX/lib/cmake/simbody/SimbodyTargets.cmake; then exit 1; fi  # [unix]\n    - pkg-config --atleast-version=3.8 simbody\n    - findstr /c:\"-lopenblas\" \"%LIBRARY_LIB%\\pkgconfig\\simbody.pc\" >nul || exit /b 1  # [win]\n    - findstr /c:\"-lliblapack\" \"%LIBRARY_LIB%\\pkgconfig\\simbody.pc\" >nul && exit /b 1 || ver >nul  # [win]\n    - findstr /c:\"-llibblas\" \"%LIBRARY_LIB%\\pkgconfig\\simbody.pc\" >nul && exit /b 1 || ver >nul  # [win]\n  files:\n    - test\n  requires:\n    - cmake >=3.21\n    - make  # [unix]\n    - ninja  # [win]\n    - pkg-config\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n\nabout:\n    home: https://simtk.org/home/simbody\n    license: Apache-2.0\n    license_file:\n        # Retain the notices for third-party sources embedded in Simbody.\n        - LICENSE.txt\n        - SimTKcommon/Random/etc/LICENSE.txt\n        - SimTKmath/Integrators/src/CPodes/sundials/LICENSE.txt\n        - SimTKmath/Integrators/src/CPodes/sundials/src/cpodes/LICENSE.txt\n        - SimTKmath/Optimizers/src/IpOpt/LICENSE.txt\n        - SimTKmath/Optimizers/src/c-cmaes/LICENSE\n        - SimTKmath/Optimizers/src/c-cmaes/simmath_license_note.txt\n        # Includes the embedded TinyXML Zlib license notice.\n        - doc/debian/copyright\n    dev_url: https://github.com/simbody/simbody\n    doc_url: https://simbody.github.io\n    summary: >\n        High-performance C++ multibody dynamics/physics library for simulating\n        articulated biomechanical and mechanical systems like vehicles, robots,\n        and the human skeleton.\n\nextra:\n    recipe-maintainers:\n        - moorepants\n        - chrisdembia\n",
