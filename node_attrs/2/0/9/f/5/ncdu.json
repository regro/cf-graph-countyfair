  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: ncdu\n  version: \"2.9.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://dev.yorhel.nl/download/${{ name }}-${{ version }}.tar.gz\n  sha256: e91135281cb66569f2ca4c0bac277246991e7e52524c0ca8cba3de5c8e81cec9\n\nbuild:\n  number: 0\n  skip: win or ppc64le\n  script:\n    file: build\n    env:\n      # The libc floor to compile against. Passing the variant means the\n      # binary's actual floor and the __glibc/__osx bound stdlib(\"c\")\n      # declares are the same number rather than two kept in sync by hand.\n      # default(\"\") keeps the win-64 render working, where the recipe is\n      # skipped and c_stdlib_version is undefined; build.sh rejects an empty\n      # value, so a real platform missing it fails loudly rather than\n      # producing a truncated target triple.\n      CONDA_C_STDLIB_VERSION: ${{ c_stdlib_version | default(\"\") }}\n\nrequirements:\n  build:\n    # zig bundles its own clang and never invokes a host C compiler, so this\n    # is likely droppable; it is kept because verifying that needs a macOS CI\n    # run, and the macOS legs of this recipe have been the fragile ones.\n    - if: osx\n      then:\n        - ${{ compiler('c') }}\n    # Needed even though zig is self-contained: this supplies the package's\n    # __glibc/__osx floor, which must match build.sh's -Dtarget triples.\n    - ${{ stdlib(\"c\") }}\n    - zig >=0.15.2,<0.16\n    - pkg-config\n  host:\n    - ncurses\n    - zstd\n\ntests:\n  - script:\n      - ncdu --version\n  - package_contents:\n      # The whole payload is these two files, so strict costs nothing.\n      strict: true\n      bin:\n        - ncdu\n      files:\n        - share/man/man1/ncdu.1\n\nabout:\n  license: MIT\n  license_file: LICENSES/MIT.txt\n  summary: NCurses Disk Usage\n  description: |\n    Ncdu is a disk usage analyzer with an ncurses interface. It is designed to\n    find space hogs on a remote server where you don't have an entire graphical\n    setup available, but it is a useful tool even on regular desktop systems.\n    Ncdu aims to be fast, simple and easy to use, and should be able to run\n    in any minimal POSIX-like environment with ncurses installed.\n  homepage: https://dev.yorhel.nl/ncdu\n  repository: https://g.blicky.net/ncdu.git/\n  documentation: https://dev.yorhel.nl/ncdu/man\n\nextra:\n  recipe-maintainers:\n    - chrisburr\n    - carlodri\n",
