  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 0.18.1\n\npackage:\n  name: openairclim\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/o/openairclim/openairclim-${{ version }}.tar.gz\n  sha256: 277e8463168360c590dbde469e44419e1238c5967c0213c6294b03ef8030d975\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - oac-run = openairclim.__main__:main\n      - oac-gui = openairclim.gui.__main__:main\n      - oac-download-data = openairclim.repository:main\n      - oac-download-zenodo = openairclim.utils.download_zenodo:main\n      - oac-create-artificial-inventories = openairclim.utils.create_artificial_inventories:main\n      - oac-create-time-evolution = openairclim.utils.create_time_evolution:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - joblib\n    - numpy\n    - pandas <3\n    - matplotlib-base\n    - pint\n    - xarray\n    - netcdf4\n    - scipy\n    - deepmerge\n    - ambiance\n    - pydantic\n    - platformdirs\n    - requests\n    # Extra: gui\n    - panel\n    - param\n\ntests:\n  - python:\n      imports:\n        - openairclim\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - oac-run --help\n      - oac-gui --help\n      - oac-download-data --help\n      - oac-download-zenodo --help\n      - oac-create-artificial-inventories --help\n      - oac-create-time-evolution --help\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://openairclim.org/\n  documentation: https://openairclim.org/\n  repository: https://github.com/dlr-pa/oac\n  summary: 'A response model for aviation climate effects'\n  description: |\n    OpenAirClim is an open-source response model for quantifying the CO2 and\n    non-CO2 climate effects of air traffic emissions, built for Python 3.11+.\n\nextra:\n  recipe-maintainers:\n    - liammegill\n    - stefan-voelk\n",
