  "raw_meta_yaml": "{% set name = \"pyca\" %}\n{% set version = \"3.3.3\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  - url: https://github.com/slaclab/{{ name }}/archive/{{ version }}.tar.gz\n    sha256: f163b092f64499a15f832682c371e624e46196708e42df6483eec163596d6769\n    patches:\n      # Drop setuptools_dso as a build dependency: build pyca as a plain\n      # setuptools Extension linked directly against epics-base's libca/libCom\n      # instead of the private copy previously bundled by epicscorelibs.\n      - patch/no_setuptools_dso.patch\n  - path: src\n\nbuild:\n  number: 3\n  script: {{ PYTHON }} -m pip install . -vv\n  skip: true  # [win]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n  host:\n    - python\n    - epics-base {{ epics_base }}\n    - numpy\n    - pip\n    - setuptools\n    - setuptools_scm\n  run:\n    - python\n    # pyca compiles/links directly against epics-base's headers/libca/libCom\n    # (see recipe/patch/no_setuptools_dso.patch) rather than merely using it\n    # at runtime through a stable ABI-versioned interface, so an exact match\n    # on the epics-base build actually used at build time is required here -\n    # epics-base's own run_exports (a version range bound only) is not\n    # sufficient to guarantee ABI/soname compatibility between builds.\n    - {{ pin_compatible('epics-base', exact=True) }}\n    - numpy >=1.24\ntest:\n  imports:\n    - pyca\n    - psp\n\nabout:\n  home: https://github.com/slaclab/pyca\n  license: LicenseRef-BSD-3-Clause-SLAC\n  license_family: BSD\n  license_file: LICENSE.md\n  summary: PyCA - lightweight bindings for Python applications to access EPICS PVs.\n\n  description: |\n    PyCA (Python Channel Access) is a module that offers lightweight\n    bindings for Python applications to access EPICS PVs. It acts as\n    a channel access client, much like pyepics. The intention of the\n    module is to provide better performance for embedded applications,\n    rather than to provide an interactive interface. The most significant\n    gains will be found when monitoring large waveforms that need to be\n    processed before exposing them the Python layer.\n  dev_url: https://github.com/slaclab/pyca\n\nextra:\n  recipe-maintainers:\n    - conda-forge/pcdsdevices\n",
