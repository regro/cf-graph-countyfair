  "linux_64_meta_yaml": {
    "about": {
      "description": "Flux Mirror is a CLI for mirroring Helm charts, OCI artifacts and\ncontainer images between registries using a declarative approach. The\nintended use case is feeding an internal mirror registry that backs Flux\nOCIRepository and Kubernetes Deployments, so clusters never reach out to\nupstream registries at reconcile time.",
      "dev_url": "https://github.com/fluxcd/flux-mirror",
      "doc_url": "https://github.com/fluxcd/flux-mirror/tree/main/docs",
      "home": "https://github.com/fluxcd/flux-mirror",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "Mirror Helm charts and OCI artifacts between registries based on a declarative YAML config"
    },
    "build": {
      "number": "1",
      "script": [
        "cd src",
        "go-licenses save ./cmd/flux-mirror --save_path ../library_licenses --ignore github.com/cyberphone/json-canonicalization --ignore github.com/in-toto/attestation --ignore github.com/in-toto/in-toto-golang",
        "go build -v -o $PREFIX/bin/flux-mirror -ldflags=\"-s -w -X main.VERSION=${{ version }}\" ./cmd/flux-mirror",
        "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
        "$PREFIX/bin/flux-mirror completion zsh > $PREFIX/share/zsh/site-functions/_flux-mirror",
        "$PREFIX/bin/flux-mirror completion bash > $PREFIX/share/bash-completion/completions/flux-mirror",
        "$PREFIX/bin/flux-mirror completion fish > $PREFIX/share/fish/vendor_completions.d/flux-mirror.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "aaronlionsheep"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "flux-mirror",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": "flux-mirror version"
          },
          {
            "package_contents": {
              "bin": [
                "flux-mirror"
              ],
              "files": [
                "share/bash-completion/completions/flux-mirror",
                "share/fish/vendor_completions.d/flux-mirror.fish",
                "share/zsh/site-functions/_flux-mirror"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.8.0"
      }
    ],
