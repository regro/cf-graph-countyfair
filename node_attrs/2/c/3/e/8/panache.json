  "linux_64_meta_yaml": {
    "about": {
      "description": "Panache is a language server, formatter, and linter for Markdown, Quarto,\nand R Markdown. It is built for fast, reliable formatting, linting, and\nlanguage services across syntax that many generic Markdown tools struggle\nwith, including fenced divs, grid tables, definition lists, citations, and\ninline footnotes.\n\nPanache is designed to follow Pandoc’s syntax closely and cover its full\nrange of Markdown dialects (flavors) and extensions, to be able to handle\nanything from simple CommonMark to complex Quarto documents with embedded\ncode chunks and fenced divs. It is flexible and can be used in your editor,\non the command line, and in CI, with consistent behavior across all\nenvironments.",
      "dev_url": "https://github.com/jolars/panache",
      "home": "https://panache.bz/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A language server, formatter, and linter for Markdown, Quarto, and R Markdown, built in Rust with a lossless CST parser and support for external formatters and linters on code blocks."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bin=panache",
          "mkdir -p \"$PREFIX\"/share/man/man1 \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "cp target/man/panache.1            \"$PREFIX\"/share/man/man1/panache.1",
          "cp target/completions/panache.bash \"$PREFIX\"/share/bash-completion/completions/panache",
          "cp target/completions/panache.fish \"$PREFIX\"/share/fish/vendor_completions.d/panache.fish",
          "cp target/completions/_panache     \"$PREFIX\"/share/zsh/site-functions/_panache",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "panache",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "panache --help",
              "panache --version"
            ]
          },
          {
