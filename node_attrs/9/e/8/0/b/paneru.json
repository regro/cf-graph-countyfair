  "meta_yaml": {
    "about": {
      "description": "Paneru is a MacOS window manager that arranges windows on an infinite strip, extending to the right. A core principle is that opening a new window will never cause existing windows to resize, maintaining your layout stability.",
      "dev_url": "https://github.com/karinushka/paneru",
      "home": "https://github.com/karinushka/paneru",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.txt",
      "summary": "A sliding, tiling window manager for MacOS."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml",
          "cargo auditable install -j ${CPU_COUNT} --root \"${PREFIX}\" --path . --locked --no-track"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "XhstormR"
      ]
    },
