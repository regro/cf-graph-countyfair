  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"5.11.1\"\n  python_check_max: \"3.14\"\n  grep: ${{ 'grep -iE' if unix else 'findstr /c' }}\n\npackage:\n  name: nbformat\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/n/nbformat/nbformat-${{ version }}.tar.gz\n  sha256: 32d4521c68c6e7d5b29c76defaeed9f42ea733142b9b19f88277ce10390b9c4d\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n  python:\n    entry_points:\n      - jupyter-trust = nbformat.sign:TrustNotebookApp.launch_instance\n\nrequirements:\n  host:\n    - hatch-nodejs-version\n    - hatchling >=1.5\n    - pip\n    - python ${{ python_min }}.*\n  run:\n    - jsonschema >=2.6\n    - jupyter_core >=4.12,!=5.0.*\n    - python >=${{ python_min }}\n    - python-fastjsonschema >=2.15\n    - traitlets >=5.1\n\ntests:\n  - python:\n      imports: nbformat\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - pip list | ${{ grep }} nbformat\n      - pip list | ${{ grep }} 'nbformat\\s*${{ version | replace('.', '\\.') }}'\n      - python -c \"v = __import__('nbformat').__version__; print(v); assert v == '${{ version }}'\"\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - pep440\n        - pytest\n        - pytest-cov\n        - python ${{ python_min }}.*\n        - testpath\n    script:\n      - python -c \"v = __import__('nbformat').__version__; print(v); assert v == '${{ version }}'\"\n      - jupyter trust --version\n      - jupyter-trust --help\n      - coverage run --source=nbformat --branch -m pytest -vv\n      - coverage report --show-missing --skip-covered --fail-under=76\n\nabout:\n  license: BSD-3-Clause\n  summary: The Jupyter Notebook format\n  description: |-\n    This package contains the base implementation of the Jupyter Notebook format,\n    and Python APIs for working with notebooks.\n  license_file: LICENSE\n  homepage: https://jupyter.org\n  repository: https://github.com/jupyter/nbformat\n  documentation: https://nbformat.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - jakirkham\n    - minrk\n    - pelson\n    - takluyver\n    - ocefpaf\n    - mpacer\n    - bollwyvl\n",
