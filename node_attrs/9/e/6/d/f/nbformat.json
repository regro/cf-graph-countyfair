    "about": {
      "description": "This package contains the base implementation of the Jupyter Notebook format,\nand Python APIs for working with notebooks.",
      "dev_url": "https://github.com/jupyter/nbformat",
      "doc_url": "https://nbformat.readthedocs.io/",
      "home": "https://jupyter.org/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "The Jupyter Notebook format"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check"
    },
    "extra": {
      "recipe-maintainers": [
        "jakirkham",
        "minrk",
        "pelson",
        "takluyver",
        "ocefpaf",
        "mpacer",
        "bollwyvl"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "nbformat",
        "requirements": {
          "build": [],
          "host": [
            "hatch-nodejs-version",
            "hatchling >=1.5",
            "pip",
            "python 3.10.*"
          ],
          "run": [
            "jsonschema >=2.6",
            "jupyter_core >=4.12,!=5.0.*",
            "python >=3.10",
            "python-fastjsonschema >=2.15",
            "traitlets >=5.1"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "nbformat"
              ],
              "python_version": [
                "3.10.*",
                "3.14.*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "pip",
                "python 3.10.*"
              ]
            },
            "script": [
              "pip list | ${{ grep }} nbformat",
              "pip list | ${{ grep }} 'nbformat\\s*${{ version | replace('.', '\\.') }}'",
              "python -c \"v = __import__('nbformat').__version__; print(v); assert v == '${{ version }}'\""
            ]
          },
          {
            "files": {
              "source": [
                "tests/"
              ]
            },
            "requirements": {
              "run": [
                "pep440",
                "pytest",
                "pytest-cov",
                "python 3.10.*",
                "testpath"
              ]
            },
            "script": [
              "python -c \"v = __import__('nbformat').__version__; print(v); assert v == '${{ version }}'\"",
              "jupyter trust --version",
              "jupyter-trust --help",
              "coverage run --source=nbformat --branch -m pytest -vv",
              "coverage report --show-missing --skip-covered --fail-under=76"
            ]
          }
        ],
        "version": "5.11.1"
      }
    ],
