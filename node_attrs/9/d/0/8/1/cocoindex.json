  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.0.22\"\n  python_min: \"3.11\"\n\npackage:\n  name: cocoindex\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/cocoindex/cocoindex-${{ version }}.tar.gz\n  sha256: 851d6d0fe4db227691c84107597f59b222ad28c62431c497a5d7b28f92a08b98\n\nbuild:\n  number: 0\n  script:\n    env:\n      # PEP 540 UTF-8 mode — forces Python to use UTF-8 for all I/O\n      # regardless of Windows codepage. Without this the win Azure leg\n      # fails inside `pip install` with\n      # `Error reading output: ... stream did not contain valid UTF-8`\n      # because rattler-build captures pip's stdout and tries to UTF-8\n      # decode it; Windows console codepage (cp1252) breaks the decode\n      # when cargo/maturin/pip emit non-ASCII characters (license names,\n      # package descriptions, paths with accents).\n      PYTHONUTF8: \"1\"\n      # Per conda-forge.org/docs/maintainer/example_recipes/rust/ — STRIP +\n      # fat LTO are the recommended defaults for Rust builds. The abi3\n      # matrix collapse below (skip + version_independent on is_abi3) means\n      # we pay this LTO cost ONCE per platform, not once per Python version,\n      # which keeps the Windows Azure leg inside the 6h timeout.\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then: |\n          export CFLAGS=\"${CFLAGS:-} -D_BSD_SOURCE -D_DEFAULT_SOURCE\"\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n        else: |\n          cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n          ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  # abi3 matrix collapse — rustworkx-feedstock pattern (chosen over the\n  # `is_abi3 and not is_python_min` form used by tree-sitter feedstocks\n  # because conda-smithy mis-aligns the zip-keyed is_python_min flag when\n  # python_min is overridden upward from the pinning's default 3.10).\n  # Cargo.toml declares pyo3 abi3-py311 so a single CPython-stable-ABI wheel\n  # works across Python ≥3.11. Build once at python_min, ship one artifact\n  # per platform.\n  skip: not (match(python, python_min ~ \".*\") and is_abi3)\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - cargo-bundle-licenses\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1.10.0,<2.0\n  host:\n    - python\n    - pip\n    - maturin >=1.10.0,<2.0\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n    - typing_extensions >=4.12\n    - click >=8.1.8\n    - rich >=14.0.0\n    - python-dotenv >=1.1.0\n    - watchdog >=6.0.0\n    - numpy >=1.23.2\n    - psutil >=7.2.1\n    - msgspec >=0.19.0\n\ntests:\n  - python:\n      imports:\n        - cocoindex\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: not win\n    then:\n      - script:\n          - cocoindex --help\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/cocoindex/_internal/core.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%\\cocoindex\\_internal\\core.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://cocoindex.io/\n  repository: https://github.com/cocoindex-io/cocoindex\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Incremental indexing engine for AI agents — keeps derived indexes fresh from source updates with minimal recomputation.\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
