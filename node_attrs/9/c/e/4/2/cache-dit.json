  "raw_meta_yaml": "# This is a recipe for cache-dit, a PyTorch-native Inference Engine\n# for Diffusion Transformers with cache, parallelism, quantization and CPU offload.\n# The base package is pure Python; CUDA extensions are optional (built only with\n# CACHE_DIT_BUILD_SVDQUANT=1) and not included in this noarch recipe.\n\ncontext:\n  version: \"1.5.2\"\n\npackage:\n  name: cache-dit\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/vipshop/cache-dit/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 2df8ee8f136d2c96932f24e901b899ef5e776788ba45f924c392785c5c428eb4\n\nbuild:\n  number: 0\n  python:\n    entry_points:\n      - cache-dit-metrics=cache_dit.metrics:main\n      - cache-dit-generate=cache_dit.generate:entrypoint\n      - cache-dit-convert=cache_dit.quantization.converter:main\n  noarch: python\n  script:\n    - export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_CACHE_DIT=${{ version }}\n    - python -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n    - setuptools-scm\n  run:\n    - python >=${{ python_min }}\n    - packaging\n    - pyyaml\n    - pytorch >=2.7.1\n    - diffusers >=0.36.0\n    - transformers >=4.55.2\n\ntests:\n  - python:\n      imports:\n        - cache_dit\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # This needs additional, optional dependencies\n      # - cache-dit-metrics --help\n      - cache-dit-generate --help\n      - cache-dit-convert --help\n\nabout:\n  homepage: https://github.com/vipshop/cache-dit\n  summary: \"A PyTorch-native Inference Engine with Cache, Parallelism, Quantization and CPU Offload for DiTs.\"\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
