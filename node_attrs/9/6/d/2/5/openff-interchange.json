  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  org: openforcefield\n  name: openff-interchange\n  version: \"0.5.4\"\n\nrecipe:\n  name: openff-interchange-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/${{ org }}/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3498736ebda6c49cd82a379a9635b3818a412d3604b405bc54a95023195cff83\n\nbuild:\n  number: 3\n\noutputs:\n  - package:\n      name: openff-interchange-base\n    build:\n      noarch: python\n      script:\n        file: build_base.sh\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n        - setuptools_scm\n      run:\n        - python >=${{ python_min }}\n        - numpy <2.6\n        - pydantic >=2.13  # negotiable\n        - openff-toolkit-base >=0.18,<0.20\n        - openff-units >=0.4.0\n        - openff-utilities >=0.1.5\n      run_constraints:\n        - foyer =1\n        - jax >=0.3\n        - jaxlib >=0.3\n        - lammps >=2023.08.02\n        - smirnoff-plugins >=2024.07.0\n    tests:\n      - python:\n          imports:\n            - openff.interchange\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - python --version\n  - package:\n      name: openff-interchange\n    build:\n      noarch: python\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - setuptools\n        - setuptools_scm\n      run:\n        - python >=${{ python_min }}\n        - openmm =8\n        - ${{ pin_subpackage('openff-interchange-base', exact=True) }}\n        - openff-toolkit >=0.18.0,<0.20\n        - openff-packmol\n        - pyedr\n    tests:\n      - python:\n          imports:\n            - openff.interchange\n          pip_check: false\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - files:\n          recipe:\n            - test_stack_imports.py\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n            - packmol\n        script:\n          - python test_stack_imports.py\n          - which packmol  # doesn't seem to be a packmol --version or similar help command\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: A project (and object) for storing, manipulating, and converting molecular mechanics data.\n  homepage: https://openforcefield.org/\n  repository: https://github.com/openforcefield/openff-interchange\n\nextra:\n  feedstock-name: openff-interchange\n  recipe-maintainers:\n    - mattwthompson\n    - j-wags\n",
