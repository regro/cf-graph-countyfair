  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.0.7\"\n\npackage:\n  name: pyavd-utils\n  version: ${{ version }}\n\nsource:\n  # No sdist is published to PyPI (only wheels), so we build from the tagged\n  # GitHub release of the actual source repository instead.\n  url: https://github.com/aristanetworks/pyavd-utils/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d84ee7ed10c50a2717eb7f21319f9a220f8c18edf71b06e59a064e0557d718a0\n\nbuild:\n  number: 1\n  skip: is_abi3 and not is_python_min\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n  host:\n    - if: is_abi3\n      then: python-abi3\n    - python\n    - pip\n    - setuptools >=71.0\n    - setuptools-rust >=1.12.0\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - pyavd_utils\n        - pyavd_utils.passwords\n        - pyavd_utils.validation\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n      pip_check: true\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/pyavd_utils/passwords.abi3.so $SP_DIR/pyavd_utils/validation.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/pyavd_utils/passwords.pyd %SP_DIR%/pyavd_utils/validation.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/aristanetworks/pyavd-utils\n  summary: Rust based utilities used by PyAVD\n  description: |\n    pyavd-utils provides Rust-accelerated utilities (password hashing and\n    schema validation) used internally by PyAVD, Arista's Python library\n    for AVD (Ansible Validated Designs) data models. It is not intended to\n    be used directly and may not follow semantic versioning.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - pyavd_utils/THIRD_PARTY_LICENSES.txt\n    - THIRDPARTY.yml\n  repository: https://github.com/aristanetworks/pyavd-utils\n\nextra:\n  recipe-maintainers:\n    - pb01ka\n",
