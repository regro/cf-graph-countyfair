  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: cppTango\n  version: \"10.3.3\"\n  soversion: \"10.3\"\n\nrecipe:\n  name: cpptango-split\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.com/tango-controls/${{ name }}/-/releases/${{ version }}/downloads/${{ name }}-with-submodules-${{ version }}.tar.gz\n  sha256: ce76c424ed39d24ee24561c17e0596ee4099f29ebfcff9027621d46868c1564a\n\nbuild:\n  number: 0\n\noutputs:\n  - staging:\n      name: cpptango-build\n    requirements:\n      build:\n        - cmake\n        - ninja\n        - if: unix\n          then:\n            - pkg-config\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n        - if: build_platform != target_platform\n          then:\n            - omniorb >=4.3.0,<4.4.0a0\n      host:\n        - omniorb >=4.3.0,<4.4.0a0\n        # Keep this explicit even though omniorb depends on it so the\n        # runtime dependency is preserved on macOS through run_exports.\n        - omniorb-libs\n        - cppzmq\n        - zeromq\n        - tango-idl\n        - libjpeg-turbo\n        - if: unix\n          then:\n            - libopentelemetry-cpp\n    build:\n      script:\n        env:\n          CPPTANGO_VERSION: ${{ version }}\n        file: build\n\n  - package:\n      name: cpptango\n    inherit: cpptango-build\n    build:\n      files:\n        - if: unix\n          then:\n            - lib/pkgconfig/tango.pc\n            - lib/cmake/tango/**\n            - include/tango/**\n        - if: linux\n          then:\n            - lib/libtango.so\n            - lib/libtango.so.${{ soversion }}\n            - lib/libtango.so.${{ version }}\n        - if: osx\n          then:\n            - lib/libtango*.dylib\n        - if: win\n          then:\n            - Library/bin/tango.*\n            - Library/include/tango/**\n            - Library/lib/tango.lib\n            - Library/lib/pkgconfig/tango.pc\n            - Library/lib/cmake/tango/**\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage('cpptango', upper_bound='x.x') }}\n    tests:\n      - package_contents:\n          lib:\n            - tango\n          include:\n            - tango/tango.h\n            - tango/idl/tango.h\n          files:\n            - if: unix\n              then:\n                - lib/pkgconfig/tango.pc\n                - lib/cmake/tango/TangoConfig.cmake\n              else:\n                - Library/lib/pkgconfig/tango.pc\n                - Library/lib/cmake/tango/TangoConfig.cmake\n                - Library/bin/tango.pdb\n\n  - package:\n      name: cpptango-dbg\n    inherit:\n      from: cpptango-build\n      run_exports: false\n    build:\n      skip:\n        - not linux\n      dynamic_linking:\n        # Prevent dbg file to be modified\n        # Will raise CRC mismatch otherwise!\n        binary_relocation: false\n      files:\n        - lib/libtango.so.${{ version }}.dbg\n    requirements:\n      run:\n        - ${{ pin_subpackage('cpptango', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - lib/libtango.so.${{ version }}.dbg\n\nabout:\n  homepage: https://www.tango-controls.org\n  license: LGPL-3.0-or-later\n  license_file: LICENSE\n  summary: Tango-Controls C++ library\n  description: |\n    This is the Tango-Controls C++ library (a.k.a. cppTango).\n    Tango-Controls is a software toolkit for building control systems.\n  repository: https://gitlab.com/tango-controls/cppTango\n  documentation: https://tango-controls.gitlab.io/cppTango/\n\nextra:\n  feedstock-name: cpptango\n  recipe-maintainers:\n    - beenje\n    - bourtemb\n    - yamatveev\n",
