    "about": {
      "description": "xkbcomp is the X Keyboard (XKB) keymap compiler. The X server invokes it\nat runtime to translate the keyboard description data shipped by\nxkeyboard-config into the compiled keymap used by the running server.\n",
      "dev_url": "https://gitlab.freedesktop.org/xorg/app/xkbcomp",
      "home": "https://www.x.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "COPYING",
      "summary": "Compile XKB keyboard description from source to a compiled keymap"
    },
    "build": {
      "number": "0"
    },
