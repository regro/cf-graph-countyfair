  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: impact-t\n  version: \"3.1.5\"\n  build: 0\n  # mpi variants get a build string so packages can depend on them explicitly:\n  # `pkg * mpi_mpich_*` for mpich, `pkg * mpi_*` for any mpi, `pkg * nompi_*` for no mpi\n  mpi_prefix: ${{ \"nompi\" if mpi == \"nompi\" else \"mpi_\" ~ mpi }}\n  # Redefine microarch_level from the build matrix as an integer\n  microarch_level: ${{ microarch_level | default(1) | int }}\n  # Build number encodes solver priority: openmpi beats mpich/nompi (+100),\n  # and within each mpi variant a higher microarch level wins (+0..3).\n  # Incrementing `build` (x1000) outranks everything from prior builds.\n  #   nompi/mpich v1: 0    v3 (AVX2): 2    v4 (AVX512): 3\n  #   openmpi    v1: 100   v3 (AVX2): 102  v4 (AVX512): 103\n  build_number: ${{ 1000 * build + (100 if mpi == \"openmpi\" else 0) + microarch_level - 1 }}\n  # gcc/clang -march= name for the microarch level (x86-64, x86-64-v3,\n  # x86-64-v4); empty on non-x86_64 platforms\n  build_arch: ${{ \"x86-64-v\" ~ microarch_level if linux and x86_64 and microarch_level > 1 else \"\" }}\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/impact-lbl/IMPACT-T/archive/v${{ version }}.tar.gz\n  sha256: 482836efe1ff436e3f3ce4af35be3410a051aa410491f864425f3f6fd2d68210\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ mpi_prefix }}_h${{ hash }}_${{ build_number }}\n  skip:\n    - win\n  script:\n    file: build.sh\n    env:\n      BUILD_MICROARCH: ${{ build_arch }}\n\nrequirements:\n  build:\n    - make\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"fortran\") }}\n    - if: linux and x86_64\n      # NOTE: this is here for targeting AVX512 and lower (see\n      # https://conda-forge.org/docs/maintainer/knowledge_base/#microarch)\n      then: x86_64-microarch-level ==${{ microarch_level }}\n    - cmake\n    - if: mpi == \"openmpi\" and build_platform != target_platform\n      then: openmpi\n  host:\n    - if: mpi != \"nompi\"\n      then: ${{ mpi }}\n    - fftw * ${{ mpi_prefix }}*\n  run:\n    - if: mpi != \"nompi\"\n      then: ${{ mpi }}\n  run_exports:\n    - if: mpi != \"nompi\"\n      then: ${{ name }} * ${{ mpi_prefix }}_*\n\ntests:\n  - script:\n      - which ImpactTexe\n      - if: mpi != \"nompi\"\n        then: which ImpactTexe-mpi\n\nabout:\n  homepage: https://github.com/impact-lbl/IMPACT-T\n  license: BSD-3-Clause-LBNL\n  license_file: src/license.txt\n  summary: IMPACT-T, A 3D Parallel Particle Tracking Code in Time Domain\n  description: |\n    IMPACT-T is a fully three-dimensional program to track relativistic\n    charged particles taking into account space charge forces,\n    short-range longitudinal and transverse wakefields, coherent\n    synchrotron radiation (CSR) wakefield in accelerators.\n  documentation: https://github.com/impact-lbl/IMPACT-T/tree/master/doc\n  repository: https://github.com/impact-lbl/IMPACT-T\n\nextra:\n  feedstock-name: impact-t\n  recipe-maintainers:\n    - ken-lauer\n    - hhslepicka\n    - ChristopherMayes\n",
