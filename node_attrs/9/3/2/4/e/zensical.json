  "raw_meta_yaml": "context:\n  version: \"0.0.60\"\n\npackage:\n  name: zensical\n  version: ${{ version }}\n\nsource:\n  - url: https://pypi.org/packages/source/z/zensical/zensical-${{ version }}.tar.gz\n    sha256: f83cf6afb1388c3ebd377df0309bafbbdf39b6aff55276a75b161e817e72dd6c\n  - url: https://raw.githubusercontent.com/zensical/ui/refs/heads/master/LICENSE\n    sha256: ac044e6db7ba08069f635afc1759b0ae11a7d47f79144a4ccdd16fc94ba47d1e\n    file_name: LICENSE-zensical-ui\n\nbuild:\n  python:\n    version_independent: true\n    entry_points:\n      - zensical=zensical.main:cli\n  skip:\n    - not (match(python, python_min ~ \".*\") and is_abi3)\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO: cargo-auditable-wrapper${{ '' if unix else '.bat' }}\n    content:\n      - if: unix\n        then:\n          - cp ${RECIPE_DIR}/cargo-auditable-wrapper.sh ${BUILD_PREFIX}/bin/cargo-auditable-wrapper\n        else:\n          - copy %RECIPE_DIR%\\cargo-auditable-wrapper.bat %BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\n      - python -m pip install . -vv\n      - cargo-bundle-licenses --format yaml --output ./THIRD_PARTY.yml\n  number: 0\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.8,<2.0\n  host:\n    - python\n    - python-abi3\n    - pip\n    - maturin >=1.8,<2.0\n  run:\n    - python\n    - click >=8.1.8\n    - deepmerge >=2.0\n    - markdown >=3.7\n    - pygments >=2.20\n    - pymdown-extensions >=11.0\n    - pyyaml >=6.0.2\n    - tomli >=2.4.0\n    - jinja2 >=3.1\n\ntests:\n  - python:\n      imports:\n        - zensical\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - package_contents:\n      site_packages:\n        - zensical/bootstrap/.github/workflows/docs.yml\n        - zensical-${{ version }}.dist-info/*\n\n  - script:\n      content:\n        - if: win\n          then: abi3audit %SP_DIR%\\zensical\\zensical.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/zensical/zensical.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n    requirements:\n      run:\n        - abi3audit\n  - script:\n      - zensical --version\n\nabout:\n  homepage: https://zensical.org\n  summary: A modern static site generator by the creators of Material for MkDocs\n  description: |\n    Write your documentation in Markdown and create a professional static site for your Open Source or commercial project in minutes – searchable, customizable, more than 60 languages, for all devices.\n  license: MIT\n  license_file:\n    - LICENSE.md\n    - THIRD_PARTY.yml\n    - python/zensical/templates/.icons/fontawesome/LICENSE.txt\n    - python/zensical/templates/.icons/material/LICENSE\n    - python/zensical/templates/.icons/octicons/LICENSE\n    - python/zensical/templates/.icons/simple/LICENSE.md\n    - python/zensical/templates/.icons/lucide/LICENSE\n    - python/zensical/templates/assets/javascripts/LICENSE\n    - LICENSE-zensical-ui\n  documentation: https://zensical.org\n  repository: https://github.com/zensical/zensical\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
