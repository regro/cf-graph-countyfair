            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [
            "python",
            "python-abi3",
            "pip",
            "maturin >=1.8,<2.0"
          ],
          "run": [
            "python",
            "click >=8.1.8",
