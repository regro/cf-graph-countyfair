  "raw_meta_yaml": "context:\n  version: \"1.0.2\"\n\npackage:\n  name: tiara2\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/shwenyu/Tiara2/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 13c590221e454f516aab0952636a3372fa817190545e0167817d90bd00315f76\n    target_directory: source\n\nbuild:\n  noarch: python\n  python:\n    entry_points:\n      - tiara2-classify = tiara.cli:main\n      - tiara2-download-models = tiara.cli:download_main\n  script: cd source && ${{ PYTHON }} -m pip install . --no-deps --no-build-isolation -vv\n  number: 0\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=68,<81\n    - wheel\n  run:\n    - python >=${{ python_min }},<3.11\n    - numpy ==1.26.4\n    - pytorch >=2.4.1,<2.14\n    - scikit-learn ==1.5.1\n    - joblib ==1.4.2\n    - numba ==0.58.1\n    - llvmlite ==0.41.1\n    - scipy >=1.15,<1.16\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - tiara\n        - tiara.api\n        - tiara.hierarchical.biosignal_multi_expert\n      pip_check: true\n  - script:\n      - tiara2-classify --show-config\n      - tiara2-download-models --help\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n\nabout:\n  homepage: https://github.com/shwenyu/Tiara2\n  summary: DNA contig classification with automatic BioSignal routing\n  description: |\n    Tiara2 is a reusable DNA contig classifier that combines a hierarchical\n    multi-objective base model with a length-aware BioSignal residual expert.\n    It provides a single command-line and Python interface with automatic\n    routing for eukaryotic, prokaryotic, and organelle classification.\n  license: MIT\n  license_file: source/LICENSE\n  documentation: https://github.com/shwenyu/Tiara2#readme\n  repository: https://github.com/shwenyu/Tiara2\n\nextra:\n  recipe-maintainers:\n    - shwenyu\n",
