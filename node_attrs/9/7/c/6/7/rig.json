  "linux_64_meta_yaml": {
    "about": {
      "description": "rig is a CLI to install, remove, configure, and switch between multiple\nversions of R. It works on macOS, Windows and Linux, supports symbolic\nversion names (e.g. `release`, `devel`, `oldrel`), lets you run multiple\nR versions in parallel via quick links, and integrates with the\nRStudio and Positron IDEs.",
      "dev_url": "https://github.com/r-lib/rig",
      "home": "https://r-lib.github.io/rig/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "The R Installation Manager"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins --target-dir=target",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "find target -name rig.bash -exec cp \\{\\} \"$PREFIX\"/share/bash-completion/completions/rig \\;",
          "find target -name rig.fish -exec cp \\{\\} \"$PREFIX\"/share/fish/vendor_completions.d/rig.fish \\;",
          "find target -name _rig     -exec cp \\{\\} \"$PREFIX\"/share/zsh/site-functions/_rig \\;",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "rig",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "rig --help",
              "rig --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "rig"
              ],
              "files": [
                "share/bash-completion/completions/rig",
                "share/fish/vendor_completions.d/rig.fish",
                "share/zsh/site-functions/_rig"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.8.1"
      }
    ],
