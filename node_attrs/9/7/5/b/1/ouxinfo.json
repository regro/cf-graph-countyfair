    "about": {
      "description": "OUxInfo is a high-performance Shannon entropy estimator for Python with a C++\nbackend. It implements k-nearest-neighbor (KSG/Kozachenko-Leonenko) algorithms\nwith a Chebyshev-metric k-d tree and OpenMP parallelization. Designed for\ninformation-theoretic causal inference: transfer entropy, mutual information,\ninformation flow, and KL divergence.",
      "dev_url": "https://github.com/htymjun/OUxInfo",
      "doc_url": "https://htymjun.github.io/OUxInfo",
      "home": "https://github.com/htymjun/OUxInfo",
