  "linux_64_meta_yaml": {
    "about": {
      "description": "complgen is a command line program that takes a .usage file as input and\noutputs a standalone, distributable shell completion script.\n\nOne grammar file can be compiled for popular shells like bash, fish, zsh\nand PowerShell, freeing you from having to reimplement logic for each of\nthe shells separately. complgen grammars are declarative and\nshell-agnostic, unless you need to reach for a shell-specific behavior.\nIts strong suit is in handling complex subcommands completion and sourcing\ncandidates from external, run-time shell commands.",
      "dev_url": "https://github.com/adaszko/complgen",
      "home": "https://github.com/adaszko/complgen",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "LICENSE",
      "summary": "Declarative bash/fish/zsh/pwsh completions without writing shell scripts"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "COMPLGEN_VERSION": "0.11.0"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "complgen",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "complgen --help",
              "complgen --version",
              "printf 'hello world;\\n' > hello.usage",
              "complgen --bash hello.bash hello.usage",
              "complgen --fish hello.fish hello.usage",
              "complgen --zsh _hello hello.usage",
              "complgen --pwsh hello.pwsh hello.usage"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "complgen"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.11.0"
      }
    ],
