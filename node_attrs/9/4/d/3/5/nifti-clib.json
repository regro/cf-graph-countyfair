  "raw_meta_yaml": "context:\n  version: \"3.0.1\"\n\npackage:\n  name: nifti-clib\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/NIFTI-Imaging/nifti_clib/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 868b611b5f8a3a73809436c9072db50db4975615905f0bd5fb7b1432e6d24b37\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ \"jom\" if win else \"make\" }}\n    - cmake\n  host:\n    - expat\n    - zlib\n  run_exports:\n    - ${{ pin_subpackage(\"nifti-clib\", upper_bound=\"x\") }}\n\ntests:\n  - package_contents:\n      include:\n        - ${{ \"nifti/nifticdf.h\" if not win }}  # disabled on Windows because `USE_NIFTICDF_CODE=OFF`\n        - nifti/nifti1.h\n        - nifti/nifti1_io.h\n        - nifti/nifti2.h\n        - nifti/nifti2_io.h\n        - nifti/znzlib.h\n      lib:\n        - ${{ \"nifticdf\" if not win }}  # disabled on Windows because `USE_NIFTICDF_CODE=OFF`\n        - cifti\n        - niftiio\n        - nifti2\n        - znz\n  - script:\n      - ${{ \"nifti_stats -help\" if not win }}  # disabled on Windows because `USE_NIFTICDF_CODE=OFF`\n      - nifti1_tool -help\n      - nifti_tool -help\n      - cifti_tool -help\n      - afni_xml_tool -help\n\nabout:\n  homepage: https://nifti-imaging.github.io\n  documentation: https://nifti.nimh.nih.gov\n  repository: https://github.com/NIFTI-Imaging/nifti_clib\n  license: LicenseRef-scancode-public-domain\n  license_file: LICENSE\n  summary: 'C libraries for NIFTI support'\n  description: |\n    `Nifti_clib` is a set of i/o libraries for reading and writing files in the nifti-1,\n    nifti-2, and (to some degree) cifti file formats.  These libraries provide api's\n    for binary file format for storing medical image data, e.g. magnetic resonance\n    image (MRI) and functional MRI (fMRI) brain images.\n\nextra:\n  recipe-maintainers:\n    - eunos-1128\n",
