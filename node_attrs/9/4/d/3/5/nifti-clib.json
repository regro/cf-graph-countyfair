    "about": {
      "description": "`Nifti_clib` is a set of i/o libraries for reading and writing files in the nifti-1,\nnifti-2, and (to some degree) cifti file formats.  These libraries provide api's\nfor binary file format for storing medical image data, e.g. magnetic resonance\nimage (MRI) and functional MRI (fMRI) brain images.",
      "dev_url": "https://github.com/NIFTI-Imaging/nifti_clib",
      "doc_url": "https://nifti.nimh.nih.gov/",
      "home": "https://nifti-imaging.github.io/",
      "license": "LicenseRef-scancode-public-domain",
      "license_family": "LicenseRef-scancode-public-domain",
      "license_file": "LICENSE",
      "summary": "C libraries for NIFTI support"
