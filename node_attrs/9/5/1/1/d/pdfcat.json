  "linux_64_meta_yaml": {
    "about": {
      "description": "pdfcat is a high-performance command-line utility that merges PDF files into\na single document without quality loss. It supports direct PDF object copying\n(no re-rendering), page range extraction, page rotation, bookmarks, custom\nmetadata, configurable compression levels, and parallel loading of input\nfiles.",
      "dev_url": "https://github.com/pdfcat/pdfcat",
      "home": "https://github.com/pdfcat/pdfcat",
      "license": "AGPL-3.0-only",
      "license_family": "AGPL-3.0-only",
      "license_file": "LICENSE",
      "summary": "Concatenate PDF files into a single document"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cd crates/pdfcat-cli",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/man/man1",
          "MAN_PAGE=$(find \"$SRC_DIR/target\" -name pdfcat.1 | head -1) && test -n \"$MAN_PAGE\" || { echo \"pdfcat.1 not found in $SRC_DIR/target\"; exit 1; } && cp \"$MAN_PAGE\" \"$PREFIX/share/man/man1/pdfcat.1\"",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pdfcat",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "pdfcat --help",
              "pdfcat --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "pdfcat"
              ],
              "files": [
                "share/man/man1/pdfcat.1"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.0.0b9"
      }
    ],
