  "raw_meta_yaml": "context:\n  # conda requires PEP 440-style versions; the upstream tag uses '-beta.' notation\n  version: \"1.0.0b9\"\n  tag: \"1.0.0-beta.9\"\n\npackage:\n  name: pdfcat\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/pdfcat/pdfcat/archive/refs/tags/v${{ tag }}.tar.gz\n  sha256: 5a549821f70986d95f8dc20c8434a8df72e8a1e65c65c30afed7bd575e6c8765\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd crates/pdfcat-cli\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n          # copy man page\n          - mkdir -p \"$PREFIX\"/share/man/man1\n          - 'MAN_PAGE=$(find \"$SRC_DIR/target\" -name pdfcat.1 | head -1) && test -n \"$MAN_PAGE\" || { echo \"pdfcat.1 not found in $SRC_DIR/target\"; exit 1; } && cp \"$MAN_PAGE\" \"$PREFIX/share/man/man1/pdfcat.1\"'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # copy man page\n          - mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1\n          - powershell -Command \"$f = (Get-ChildItem -Path \\\"$env:SRC_DIR\\target\\\" -Filter 'pdfcat.1' -Recurse | Select-Object -First 1); if ($null -eq $f) { throw 'pdfcat.1 not found under $env:SRC_DIR\\target' }; Copy-Item $f.FullName -Destination \\\"%LIBRARY_PREFIX%\\share\\man\\man1\\pdfcat.1\\\"\"\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - pdfcat --help\n      - pdfcat --version\n  - package_contents:\n      bin:\n        - pdfcat\n      files:\n        - if: unix\n          then:\n            - share/man/man1/pdfcat.1\n        - if: win\n          then:\n            - Library/share/man/man1/pdfcat.1\n      strict: true\n\nabout:\n  summary: Concatenate PDF files into a single document\n  description: |\n    pdfcat is a high-performance command-line utility that merges PDF files into\n    a single document without quality loss. It supports direct PDF object copying\n    (no re-rendering), page range extraction, page rotation, bookmarks, custom\n    metadata, configurable compression levels, and parallel loading of input\n    files.\n  license: AGPL-3.0-only\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/pdfcat/pdfcat\n  repository: https://github.com/pdfcat/pdfcat\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
