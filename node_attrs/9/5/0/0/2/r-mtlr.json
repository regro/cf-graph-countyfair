  "raw_meta_yaml": "{% set version = \"0.2.2\" %}\n{% set posix = 'm2-' if win else '' %}\n\npackage:\n  name: r-mtlr\n  version: \"{{ version|replace('-', '_') }}\"\n\nsource:\n  url:\n    - {{ cran_mirror }}/src/contrib/MTLR_{{ version }}.tar.gz\n    - {{ cran_mirror }}/src/contrib/Archive/MTLR/MTLR_{{ version }}.tar.gz\n  sha256: aae7aac80f7abf4b579430f434930f2d83175f1ab2258d4478475027845740ed\n\nbuild:\n  number: 0\n  rpaths:\n    - lib/R/lib/\n    - lib/\n  missing_dso_whitelist:\n    - '*/R.dll'        # [win]\n    - '*/Rblas.dll'    # [win]\n    - '*/Rlapack.dll'  # [win]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}              # [not win]\n    - {{ stdlib(\"c\") }}                # [not win]\n    - {{ compiler('m2w64_c') }}        # [win]\n    - {{ stdlib('m2w64_c') }}          # [win]\n    - {{ compiler('cxx') }}            # [not win]\n    - {{ compiler('m2w64_cxx') }}      # [win]\n    - {{ posix }}filesystem        # [win]\n    - {{ posix }}make\n    - {{ posix }}sed               # [win]\n    - {{ posix }}coreutils         # [win]\n    - {{ posix }}zip               # [win]\n    - cross-r-base {{ r_base }}    # [build_platform != target_platform]\n  host:\n    - r-base\n    - r-rcpp >=0.12.18\n    - r-rcpparmadillo\n    - r-rlang\n    - r-survival >=3.0.0\n    - libblas\n    - liblapack\n  run:\n    - r-base\n    - r-rcpp >=0.12.18\n    - r-rcpparmadillo\n    - r-rlang\n    - r-survival >=3.0.0\n\ntest:\n  commands:\n    - $R -e \"library('MTLR')\"           # [not win]\n    - \"\\\"%R%\\\" -e \\\"library('MTLR')\\\"\"  # [win]\n\nabout:\n  home: https://github.com/haiderstats/MTLR\n  license: GPL-2.0-only\n  summary: An implementation of Multi-Task Logistic Regression (MTLR) for R. This package is based on the method proposed by Yu et al. (2011) which utilized MTLR for generating individual survival curves by learning feature weights which vary across time. This model was further extended to account for left and interval\n    censored data.\n