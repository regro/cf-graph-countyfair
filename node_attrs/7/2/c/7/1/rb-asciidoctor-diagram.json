    "about": {
      "description": "A family of Asciidoctor extensions that generate images from a broad range of\nembedded plain text diagram descriptions, including PlantUML, ditaa, Kroki,\nand many others. The extension supports AsciiToSVG, BlockDiag (BlockDiag,\nSeqDiag, ActDiag, NwDiag), Ditaa, Erd, GraphViz, Mermaid, Msc, PlantUML,\nShaape, SvgBob, Syntrax, UMLet, Vega, Vega-Lite and WaveDrom.",
      "dev_url": "https://github.com/asciidoctor/asciidoctor-diagram",
      "doc_url": "https://docs.asciidoctor.org/diagram-extension/latest/",
      "home": "https://github.com/asciidoctor/asciidoctor-diagram",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE.txt",
      "summary": "Asciidoctor diagramming extension"
    },
    "build": {
      "noarch": "generic",
      "number": "0",
      "script": [
        "gem install -N -l -V --norc --ignore-dependencies asciidoctor-diagram-${{ version }}.gem",
        "gem unpack asciidoctor-diagram-${{ version }}.gem",
        "cp asciidoctor-diagram-${{ version }}/LICENSE.txt ."
      ]
    },
    "extra": {
