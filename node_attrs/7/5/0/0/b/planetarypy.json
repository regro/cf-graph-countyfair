  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: planetarypy\n  version: \"0.83.0\"\n  python_min: \"3.11\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: a7ab11c30e9a1cffda75713f24da7eeb52fe11e49ed50d0c2f8335d95102324f\n\nbuild:\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - plp = planetarypy.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - astropy-base\n    - typer >=0.9\n    - numpy\n    - pandas\n    - pyarrow\n    - pooch\n    - pvl\n    - lxml\n    - python-dateutil\n    - requests\n    - tomlkit\n    - tqdm\n    - yarl\n    - loguru\n    - python-duckdb\n    - rasterio\n    - pyproj\n    - rioxarray\n    - matplotlib-base\n    - rich\n    - shapely\n    - antimeridian\n    - pdr\n    - pillow\n    # SPICE is a flagship feature and conda has no \"extras\" mechanism, so the\n    # pip [spice] extra (spiceypy + scipy) ships in the conda package directly.\n    - spiceypy\n    - scipy\n\ntests:\n  - python:\n      imports:\n        - planetarypy\n        - planetarypy.constants\n        - planetarypy.pds\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      pip_check: true\n  - script:\n      - plp --help\n\nabout:\n  homepage: https://github.com/planetarypy/planetarypy\n  summary: Python tools for planetary science data access — PDS indexes, SPICE kernels, instrument data, and per-body constants\n  license: BSD-3-Clause\n  license_file: LICENSE\n  repository: https://github.com/planetarypy/planetarypy\n  documentation: https://michaelaye.github.io/planetarypy\n\nextra:\n  recipe-maintainers:\n    - michaelaye\n    - cjtu\n",
