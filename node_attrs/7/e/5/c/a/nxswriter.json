    "about": {
      "description": "NXSDataWriter is a Tango server which stores NeXuS Data in H5 files\nand/or publishes (meta)data to blissdata redis server.\nThe server provides storing data from other Tango devices,\nvarious databases as well as passed by a user client via JSON strings\nand python snippets.",
      "dev_url": "https://github.com/nexdatas/nxsdatawriter",
      "home": "https://github.com/nexdatas/nxsdatawriter",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "COPYRIGHT",
      "summary": "NeXus Data Writer tango server"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": [
        "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation",
        "${{ PYTHON }} -m unittest test.EFileH5Cpp_test",
        "${{ PYTHON }} -m unittest test.EFileH5PY_test"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "jkotan"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "nxswriter",
        "requirements": {
          "build": [],
          "host": [
            "python 3.10.*",
            "setuptools >=61",
            "pip",
            "wheel",
            "numpy",
            "nxstools >=4.29.0"
          ],
          "run": [
