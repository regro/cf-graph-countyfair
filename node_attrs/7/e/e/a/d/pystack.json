  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: pystack\n  version: \"1.7.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/pystack-${{ version }}.tar.gz\n  sha256: 1469ffcabcad89ef7e591ee6f4e11610e9e36caa5efb4fb0db599b92e5dbb072\n  patches:\n    - disable-lto.patch\n\nbuild:\n  number: 1\n  skip: not linux\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - pystack=pystack.__main__:main\n\nrequirements:\n  ignore_run_exports:\n    by_name:\n      # Both packages are required for cmake to find elfutils libraries\n      # but are reported are overdepending\n      - libzlib\n      - liblzma\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - make\n    - pkg-config\n  host:\n    - elfutils\n    - zlib\n    - liblzma-devel\n    - python\n    - scikit-build-core >=0.9\n    - nanobind >=1.8\n    - pip\n  run:\n    - python\n\ntests:\n  - python:\n      pip_check: true\n      imports:\n        - pystack\n  - script:\n      - pystack --help\n\nabout:\n  summary: Analysis of the stack of remote python processes\n  description: |\n    PyStack is a tool that uses forbidden magic to let you\n    inspect the stack frames of a running Python process or\n    a Python core dump.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/bloomberg/pystack\n  repository: https://github.com/bloomberg/pystack\n  documentation: https://bloomberg.github.io/pystack/\n\nextra:\n  recipe-maintainers:\n    - beenje\n",
