  "linux_64_meta_yaml": {
    "about": {
      "description": "Puffin is a massively parallel numerical solver for an unaveraged, 3D FEL\nsystem of equations, written in Fortran 90 using MPI and OpenMP. Puffin is\nan 'unaveraged' FEL code - meaning it is absent of the slowly varying\nenvelope approximation (SVEA) and wiggler period averaging approximations.\nIt does not utilize a 'slicing' model of the beam phase space and radiation\nfield, and instead utilizes an algorithm which is much more similar to a\nParticle-In-Cell (PIC) code methodology.",
      "dev_url": "https://github.com/UKFELs/Puffin",
      "doc_url": "https://ukfels.github.io/puffinDocs/",
      "home": "https://github.com/UKFELs/Puffin",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE.txt",
      "summary": "Puffin (Parallel Unaveraged Fel INtegrator) simulates a Free Electron Laser (FEL)."
    },
    "build": {
      "number": "1"
    },
    "extra": {
      "recipe-maintainers": [
        "mightylorenzo",
        "ken-lauer"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "puffin",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "cxx_compiler_stub",
            "fortran_compiler_stub",
            "cmake",
            "make"
          ],
          "host": [
            "mpich",
            "hdf5 1.14.6.* mpi_mpich_*",
            "fftw * mpi_mpich_*",
            "libgomp"
          ],
          "run": [
            "mpich"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "puffin"
              ],
              "files": [
                "share/puffin/examples/**/*"
              ]
            }
          },
          {
            "files": {
              "source": [
                "test/inputs/"
              ]
            },
            "script": {
              "content": [
                "cd test",
                "mpiexec -n 2 puffin inputs/f1main.in",
                "test -f inputs/f1main_aperp_0.h5",
                "test -f inputs/f1main_aperp_2.h5",
                "test -f inputs/f1main_electrons_2.h5",
                "test -f inputs/f1main_integrated_2.h5"
              ],
              "env": {
                "HYDRA_LAUNCHER": "fork",
                "OMPI_ALLOW_RUN_AS_ROOT": "1",
                "OMPI_ALLOW_RUN_AS_ROOT_CONFIRM": "1",
                "OMPI_MCA_btl": "self,tcp",
                "OMP_NUM_THREADS": "1",
                "PRTE_MCA_rmaps_default_mapping_policy": ":oversubscribe"
              }
            }
          }
        ],
        "version": "1.9.1"
      },
