  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"4.33\"\n\nrecipe:\n  name: libev-split\n  version: ${{ version }}\n\nsource:\n  url: https://dist.schmorp.de/libev/Attic/libev-${{ version }}.tar.gz\n  sha256: 507eb7b8d1015fbec5b935f34ebed15bf346bed04a11ab82b8eee848c4205aea\n  patches:\n    - if: win\n      then:\n        - event-timeval-win.patch\n        - windows-shared.patch\n\nbuild:\n  number: 3\n\noutputs:\n  - staging:\n      name: libev-build\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - gnuconfig\n        - if: win\n          then: autotools_clang_conda\n          else: make\n    build:\n      script:\n        - if: win\n          then: build.bat\n          else: build.sh\n\n  - package:\n      name: libev\n    inherit: libev-build\n    build:\n      files:\n        - if: win\n          then:\n            - Library/bin/ev-*.dll\n            - Library/lib/ev.lib\n            - Library/include/ev.h\n            - Library/include/ev++.h\n          else:\n            - include/ev.h\n            - include/ev++.h\n            - if: linux\n              then: lib/libev.so*\n              else: lib/libev*.dylib\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage('libev', upper_bound='x.x') }}\n    tests:\n      - if: win\n        then:\n          package_contents:\n            files:\n              - Library/include/ev.h\n              - Library/include/ev++.h\n              - Library/bin/ev-*.dll\n              - Library/lib/ev.lib\n        else:\n          package_contents:\n            include:\n              - ev.h\n              - ev++.h\n            lib:\n              - ev\n\n  - package:\n      name: libev-static\n    inherit: libev-build\n    build:\n      files:\n        - if: win\n          then: Library/lib/ev_static.lib\n          else: lib/libev.a\n    requirements:\n      run:\n        - ${{ pin_subpackage('libev', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - if: win\n              then: Library/lib/ev_static.lib\n              else: lib/libev.a\n\n  # Compatibility wrapper for programs using the libevent event loop.\n  # Keep it separate to avoid clobbering libevent.\n  - package:\n      name: libev-libevent\n    inherit: libev-build\n    build:\n      skip: win\n      files:\n        - include/event.h\n    requirements:\n      run:\n        - ${{ pin_subpackage('libev', exact=True) }}\n      run_constraints:\n        - libevent ==9999999999\n    tests:\n      - package_contents:\n          include:\n            - event.h\n\nabout:\n  homepage: https://software.schmorp.de/pkg/libev.html\n  license: BSD-2-Clause OR GPL-2.0-or-later\n  license_file: LICENSE\n  summary: A full-featured and high-performance event loop loosely modeled after libevent\n\nextra:\n  recipe-maintainers:\n    - petercable\n    - carlodri\n    - wolfv\n",
