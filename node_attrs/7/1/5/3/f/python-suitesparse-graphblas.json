  "linux_64_meta_yaml": {
    "about": {
      "description": "Python CFFI binding around SuiteSparse::GraphBLAS. This is a base package that exposes\nonly the low level CFFI API bindings and symbols. This package is shared by the syntax\nbindings pygraphblas and python-graphblas.\n",
      "dev_url": "https://github.com/GraphBLAS/python-suitesparse-graphblas",
      "home": "https://github.com/GraphBLAS/python-suitesparse-graphblas",
      "license": "Apache-2.0",
      "license_family": "Apache",
      "license_file": "LICENSE",
      "summary": "Python CFFI binding around SuiteSparse::GraphBLAS"
    },
    "build": {
      "number": "0",
      "script": [
        "PYTHON -c \"import pathlib; pathlib.Path('suitesparse_graphblas/utils.c').unlink(missing_ok=True)\"",
        "PYTHON -m pip install . -vv"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "jim22k",
        "eriknw",
        "michelp"
      ]
    },
    "package": {
      "name": "python-suitesparse-graphblas",
      "version": "10.5.0.0"
    },
    "requirements": {
      "build": [
        "c_compiler_stub",
        "c_stdlib_stub"
      ],
      "host": [
        "python",
        "pip",
        "setuptools >=77",
        "setuptools-git-versioning",
        "cffi",
        "cython",
        "graphblas =10.5.0",
        "numpy"
      ],
      "run": [
        "python",
        "cffi",
        "numpy >=1.24"
      ]
    },
    "schema_version": 0,
    "source": {
      "sha256": "66aec95b05bc6ebb2c85d4f41ff906ec954db51d95158e1b168056dfd475d683",
      "url": "https://files.pythonhosted.org/packages/source/s/suitesparse_graphblas/suitesparse_graphblas-10.5.0.0.tar.gz"
    },
    "test": {
      "commands": [
        "pip check",
        "python -c \"import platform ; print(platform.machine())\"",
        "python -c \"from suitesparse_graphblas import lib, ffi\"",
        "python -c \"import suitesparse_graphblas as s; from suitesparse_graphblas import lib, ffi; s.initialize(); p = ffi.new('int32_t*'); assert lib.GrB_Global_get_INT32(lib.GrB_GLOBAL, p, lib.GxB_LIBRARY_OPENMP) == lib.GrB_SUCCESS; assert p[0], 'libgraphblas was built without OpenMP'\"",
        "pytest -v --pyargs suitesparse_graphblas"
      ],
      "imports": [
        "suitesparse_graphblas"
      ],
      "requires": [
        "pip",
        "pytest"
      ]
    }
  },
