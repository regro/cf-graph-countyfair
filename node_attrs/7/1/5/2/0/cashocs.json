  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: cashocs\n  version: \"2.10.1\"\n  fenics_version: 2019.1.*\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/sblauth/cashocs/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 36edd06e46920dfec6adc0b80973320adf35635afe07c854f283faee63c0df04\n  \nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv\n  python:\n    entry_points:\n      - cashocs-convert = cashocs._cli:convert\n      - cashocs-extract_mesh = cashocs._cli:extract_mesh\n\nrequirements:\n  host:\n    - pip\n    - setuptools\n    - python ${{ python_min }}.*\n  run:\n    - numpy\n    - meshio >=4.1.0\n    - python >=${{ python_min }}\n    - gmsh >=4.8\n    - typing_extensions\n    - openssh\n    - fenics ${{ fenics_version }}\n    - matplotlib-base\n    - scipy\n    - libblas * *openblas\n    - liblapack * *openblas\n\ntests:\n  - script:\n    - python -c \"import cashocs;print(cashocs.__version__)\"\n    - cashocs-convert --help\n    - pytest tests/ -vv\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n    files:\n      source:\n        - tests/\n        \n  - script:\n    - python -c \"import cashocs;print(cashocs.__version__)\"\n    - cashocs-convert --help\n    - pytest tests/ -vv\n    requirements:\n      run:\n        - python\n        - pytest\n    files:\n      source:\n        - tests/\n\nabout:\n  summary: Computational Adjoint-Based Shape Optimization and Optimal Control Software\n  license: GPL-3.0-or-later\n  license_file: COPYING\n  description: cashocs is a software for automatically solving PDE constrained shape optimization and optimal control problems.\n  homepage: https://github.com/sblauth/cashocs\n  repository: https://github.com/sblauth/cashocs\n  documentation: https://cashocs.readthedocs.io/en/stable/\n\nextra:\n  recipe-maintainers:\n    - sblauth\n",
