  "raw_meta_yaml": "context:\n  version: \"2.52.2\"\n\npackage:\n  name: spider_cli\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/spider-rs/spider/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 130a9d6040a05a3c4d219fcd296f7f20ba6f7c90a8e18914b7d0f647db7908fa\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if host_platform == \"win-arm64\" else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on `win-arm64`\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # instruct `cc` crate to use clang-cl natively to compile build-time tools intended to be run on the host when cross-compiling from `win_64`\n      AR_x86_64_pc_windows_msvc: llvm-lib\n      CC_x86_64_pc_windows_msvc: clang-cl\n      CXX_x86_64_pc_windows_msvc: clang-cl\n    content:\n      - cd spider_cli\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: unix\n      then: pkg-config\n    - if: win\n      then: cmake\n  host:\n    - if: linux\n      then: openssl\n\ntests:\n  - script:\n      - spider --help\n      - spider --version\n  - package_contents:\n      bin:\n        - spider\n      strict: true\n\nabout:\n  summary: spider (web crawler) CLI for high-performance website scraping.\n  description: |\n    A fast command-line spider (web crawler) written in Rust for high-performance website scraping. Optionally allows to provide an API key for spider.cloud to\n    use their hosted services.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://spider.cloud/\n  documentation: https://github.com/spider-rs/spider/tree/main/spider_cli\n  repository: https://github.com/spider-rs/spider\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
