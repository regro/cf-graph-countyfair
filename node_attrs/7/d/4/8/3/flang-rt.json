  "raw_meta_yaml": "{% set version = \"23.1.1\" %}\n{% set major = version.split(\".\")[0] %}\n{% set win_target_triple = \"aarch64-pc-windows-msvc\" if target_platform == \"win-arm64\" else \"x86_64-pc-windows-msvc\" %}\n\npackage:\n  name: flang-rt-split\n  version: {{ version }}\n\nsource:\n  url: https://github.com/llvm/llvm-project/archive/refs/tags/llvmorg-{{ version.replace(\".rc\", \"-rc\") }}.tar.gz\n  sha256: 851b3d701a4fbdd9f69536d4acda578469e810ca7056687d6556443f5fd39557\n\nbuild:\n  number: 0\n  # intentionally only windows (main target) & linux (debuggability)\n  skip: true  # [osx]\n\nrequirements:\n  build:\n    - cmake\n    - ninja\n    - python *\n    - {{ stdlib('c') }}\n    - {{ compiler('c') }}\n    - {{ compiler('cxx') }}\n    - flang =={{ version }}\n    # only to avoid pulling in newer rc's which have a different SONAME\n    - libllvm{{ major }} =={{ version }}\n    # flang looks for libmlir relative to its binary; since we're only\n    # doing native compilation here, accept this inaccuracy\n    - mlir =={{ version }}\n    - lit\n  host:\n    - clangdev =={{ version }}\n    - compiler-rt =={{ version }}\n    - llvmdev =={{ version }}\n    - mlir =={{ version }}\n    - libxml2-devel\n    - zlib\n    - zstd\n\noutputs:\n  - name: libflang-rt\n    build:\n      # not supported on windows yet, see\n      # https://github.com/llvm/llvm-project/issues/134186\n      skip: true  # [win]\n    files:\n      - lib/libflang_rt.runtime.so  # [linux]\n    requirements:\n      build:\n        # for strong run-exports\n        - {{ stdlib('c') }}\n      run_constrained:\n        # avoid old flang runtime\n        - libflang <0.0a0\n    test:\n      commands:\n        # shared library; copied from target-specific location\n        - test -f $PREFIX/lib/libflang_rt.runtime.so    # [linux]\n\n  - name: flang-rt_{{ target_platform }}\n    build:\n      noarch: generic\n    files:\n      - lib/clang/{{ major }}/lib/x86_64-unknown-linux-gnu/libflang_rt.runtime.a                # [linux]\n      - lib/clang/{{ major }}/lib/x86_64-unknown-linux-gnu/libflang_rt.runtime.so               # [linux]\n      # corresponding to different flavours of the MSVC runtime, i.e. `/MD`, `/MDd`, `/MT`, `/MTd`\n      - Library/lib/clang/{{ major }}/lib/{{ win_target_triple }}/flang_rt.runtime.static.lib    # [win]\n      - Library/lib/clang/{{ major }}/lib/{{ win_target_triple }}/flang_rt.runtime.dynamic.lib   # [win]\n      - Library/lib/clang/{{ major }}/lib/{{ win_target_triple }}/flang_rt.runtime.static_dbg.lib    # [win]\n      - Library/lib/clang/{{ major }}/lib/{{ win_target_triple }}/flang_rt.runtime.dynamic_dbg.lib   # [win]\n    requirements:\n      build:\n        # for strong run-exports\n        - {{ stdlib('c') }}     # [linux]\n      host:\n        - clangdev =={{ version }}\n        - compiler-rt =={{ version }}\n        - llvmdev =={{ version }}\n        - mlir =={{ version }}\n      run:\n        - clangdev =={{ version }}\n        - flang =={{ version }}\n    test:\n      commands:\n        # target-specific runtime library location (default for flang)\n        - test -f $PREFIX/lib/clang/{{ major }}/lib/x86_64-unknown-linux-gnu/libflang_rt.runtime.a                      # [linux]\n        - test -f $PREFIX/lib/clang/{{ major }}/lib/x86_64-unknown-linux-gnu/libflang_rt.runtime.so                     # [linux]\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\lib\\{{ win_target_triple }}\\flang_rt.runtime.static.lib exit 1    # [win]\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\lib\\{{ win_target_triple }}\\flang_rt.runtime.dynamic.lib exit 1   # [win]\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\lib\\{{ win_target_triple }}\\flang_rt.runtime.static_dbg.lib exit 1    # [win]\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\lib\\{{ win_target_triple }}\\flang_rt.runtime.dynamic_dbg.lib exit 1   # [win]\n\n  - name: llvm-openmp-fortran\n    build:\n      # restricted to Windows for now\n      skip: true  # [not win]\n      run_exports:\n        strong:\n          - llvm-openmp >={{ version }}\n    files:\n      - Library/lib/clang/{{ major }}/finclude/flang/{{ win_target_triple }}\n    requirements:\n      host:\n        - llvm-openmp {{ version }}\n        - {{ pin_subpackage(\"flang-rt_\" ~ target_platform, exact=True) }}\n      run:\n        - llvm-openmp {{ version }}\n        - {{ pin_subpackage(\"flang-rt_\" ~ target_platform, exact=True) }}\n    test:\n      commands:\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\finclude\\flang\\{{ win_target_triple }}\\omp_lib.mod exit 1\n        - if not exist %LIBRARY_LIB%\\clang\\{{ major }}\\finclude\\flang\\{{ win_target_triple }}\\omp_lib_kinds.mod exit 1\n\nabout:\n  home: https://flang.llvm.org\n  license: Apache-2.0\n  license_file: flang/LICENSE.TXT\n  summary: Flang is a Fortran compiler targeting LLVM.\n  dev_url: https://github.com/llvm/llvm-project\n\nextra:\n  recipe-maintainers:\n    - conda-forge/flang\n    - h-vetinari\n  feedstock-name: flang-rt\n",
