  "raw_meta_yaml": "{% set name = \"hugo\" %}\n{% set version = \"0.166.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/gohugoio/{{ name }}/archive/v{{ version }}.tar.gz\n  sha256: 599566b8270a0872061f43564d81961a5f1a02857022078d1fcb3a601189f573\n\nbuild:\n  number: 0\n  binary_relocation: false\n  # Hugo binaries are statically linked on Windows, so the\n  # following silences some warnings from conda-forge about\n  # already exported DSOs.\n  ignore_run_exports:\n    - libstdcxx  # [win]\n    - libwinpthread  # [win]\n    - libgcc  # [win]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}                    # [not (win and arm64)]\n    - {{ compiler('cxx') }}                  # [not (win and arm64)]\n    - {{ stdlib(\"c\") }}                      # [not (win and arm64)]\n    - {{ compiler('go-cgo') }} >=1.27        # [not (win and arm64)]\n    - {{ compiler('go-nocgo') }}             # [win and arm64]\n    - go-licenses\n\ntest:\n  commands:\n    - hugo help\n    - hugo version\n\nabout:\n  home: https://gohugo.io/\n  dev_url: https://github.com/gohugoio/hugo\n  summary: The extended version of the Hugo static site generator – the world's fastest framework for building websites.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n    - dbast\n    - agriyakhetarpal\n",
