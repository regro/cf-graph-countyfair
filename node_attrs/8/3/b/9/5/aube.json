      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Aube — a fast Node.js package manager"
    },
    "build": {
      "number": "2",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let schema = (\n  open --raw crates/aube-resolver/build.rs\n  | parse --regex 'const PRIMER_DATA_SCHEMA: u32 = (?<schema>\\d+);'\n  | get --optional 0.schema\n)\n\nif ($schema | is-empty) {\n  error make { msg: 'Failed to parse PRIMER_DATA_SCHEMA from crates/aube-resolver/build.rs' }\n}\n\nnode ...[\n  scripts/generate-primer.mjs\n  --top=($env.AUBE_PRIMER_TOP)\n  --versions=($env.AUBE_PRIMER_VERSION_CAP)\n  --out=($\"crates/aube-resolver/data/primer-top($env.AUBE_PRIMER_TOP)-v($env.AUBE_PRIMER_VERSION_CAP)-s($schema).rkyv.json\")\n  --popular-names-out=crates/aube-resolver/data/popular-top100000-v1.json\n]\n",
          "cd crates/aube",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --target=($env.CARGO_BUILD_TARGET)",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
