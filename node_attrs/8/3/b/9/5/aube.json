  "raw_meta_yaml": "context:\n  version: \"2.2.13\"\n\npackage:\n  name: aube\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/aube/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f01c1c13ed3107bbba8a834eb3bcb9574a6b812edfcb757e2799225e66c0faa3\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if host_platform == \"win-arm64\" else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on `win-arm64`\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # instruct `cc` crate to use clang-cl natively to compile build-time tools intended to be run on the host when cross-compiling from `win_64`\n      AR_x86_64_pc_windows_msvc: llvm-lib\n      CC_x86_64_pc_windows_msvc: clang-cl\n      CXX_x86_64_pc_windows_msvc: clang-cl\n    content:\n      - cd crates/aube\n      - if: unix\n        then:\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins --target=\"$CARGO_BUILD_TARGET\"\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/aube completion bash > \"$PREFIX\"/share/bash-completion/completions/aube'\n              - '\"$PREFIX\"/bin/aube completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/aube.fish'\n              - '\"$PREFIX\"/bin/aube completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_aube'\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins --target=\"%CARGO_BUILD_TARGET%\"\n          - if: build_platform == host_platform\n            then:\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d   mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - if not exist \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions          mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\aube.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\aube'\n              - '\"%LIBRARY_BIN%\"\\aube.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\aube.fish'\n              - '\"%LIBRARY_BIN%\"\\aube.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_aube'\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - clang\n    - cmake\n    - libclang\n    - make\n    - ninja\n    - pkg-config\n  host:\n    - usage\n\ntests:\n  - script:\n      - aube --help\n      - aube --version\n      - aubr --help\n      - aubr --version\n      - aubx --help\n      - aubx --version\n  - package_contents:\n      bin:\n        - aube\n        - aubr\n        - aubx\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/aube\n            - share/fish/vendor_completions.d/aube.fish\n            - share/zsh/site-functions/_aube\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/aube\n            - Library/share/fish/vendor_completions.d/aube.fish\n            - Library/share/zsh/site-functions/_aube\n      strict: true\n\nabout:\n  summary: Aube — a fast Node.js package manager\n  description: |\n    Aube installs automatically when you run a script. It has the tightest\n    security defaults of any Node.js package manager and is the only one\n    with a lifecycle-script jail. Aube drops into existing projects using\n    their existing lockfiles (`pnpm-lock.yaml`, `package-lock.json`,\n    `npm-shrinkwrap.json`, `yarn.lock` and `bun.lock`).\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://aube.jdx.dev\n  repository: https://github.com/jdx/aube\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
