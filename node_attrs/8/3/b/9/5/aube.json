  "raw_meta_yaml": "context:\n  version: \"2.2.13\"\n\npackage:\n  name: aube\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/jdx/aube/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: f01c1c13ed3107bbba8a834eb3bcb9574a6b812edfcb757e2799225e66c0faa3\n\nbuild:\n  number: 2\n  script:\n    env:\n      AUBE_PRIMER_TOP: \"2000\"\n      AUBE_PRIMER_VERSION_CAP: \"100\"\n      AUBE_REQUIRE_PRIMER: \"1\"\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if host_platform == \"win-arm64\" else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on `win-arm64`\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      # instruct `cc` crate to use clang-cl natively to compile build-time tools intended to be run on the host when cross-compiling from `win_64`\n      AR_x86_64_pc_windows_msvc: llvm-lib\n      CC_x86_64_pc_windows_msvc: clang-cl\n      CXX_x86_64_pc_windows_msvc: clang-cl\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # generate metadata primer, cf. https://github.com/aubepkg/aube/blob/main/.github/workflows/release.yml\n      - |\n        let schema = (\n          open --raw crates/aube-resolver/build.rs\n          | parse --regex 'const PRIMER_DATA_SCHEMA: u32 = (?<schema>\\d+);'\n          | get --optional 0.schema\n        )\n\n        if ($schema | is-empty) {\n          error make { msg: 'Failed to parse PRIMER_DATA_SCHEMA from crates/aube-resolver/build.rs' }\n        }\n\n        node ...[\n          scripts/generate-primer.mjs\n          --top=($env.AUBE_PRIMER_TOP)\n          --versions=($env.AUBE_PRIMER_VERSION_CAP)\n          --out=($\"crates/aube-resolver/data/primer-top($env.AUBE_PRIMER_TOP)-v($env.AUBE_PRIMER_VERSION_CAP)-s($schema).rkyv.json\")\n          --popular-names-out=crates/aube-resolver/data/popular-top100000-v1.json\n        ]\n      # build main app and generate license data\n      - cd crates/aube\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --target=($env.CARGO_BUILD_TARGET)\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = $prefix | path join bin/aube\n          - ^$bin completion bash | save ($prefix | path join share/bash-completion/completions/aube)\n          - ^$bin completion fish | save ($prefix | path join share/fish/vendor_completions.d/aube.fish)\n          - ^$bin completion zsh  | save ($prefix | path join share/zsh/site-functions/_aube)\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - clang\n    - cmake\n    - libclang\n    - make\n    - ninja\n    - nodejs\n    - nushell\n    - pkg-config\n\ntests:\n  - script:\n      - aube --help\n      - aube --version\n      - aubr --help\n      - aubr --version\n      - aubx --help\n      - aubx --version\n  - package_contents:\n      bin:\n        - aube\n        - aubr\n        - aubx\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/aube\n            - share/fish/vendor_completions.d/aube.fish\n            - share/zsh/site-functions/_aube\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/aube\n            - Library/share/fish/vendor_completions.d/aube.fish\n            - Library/share/zsh/site-functions/_aube\n      strict: true\n\nabout:\n  summary: Aube — a fast Node.js package manager\n  description: |\n    Aube installs automatically when you run a script. It has the tightest\n    security defaults of any Node.js package manager and is the only one\n    with a lifecycle-script jail. Aube drops into existing projects using\n    their existing lockfiles (`pnpm-lock.yaml`, `package-lock.json`,\n    `npm-shrinkwrap.json`, `yarn.lock` and `bun.lock`).\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://aube.jdx.dev\n  repository: https://github.com/jdx/aube\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
