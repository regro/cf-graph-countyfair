  "linux_64_meta_yaml": {
    "about": {
      "description": "Aube installs automatically when you run a script. It has the tightest\nsecurity defaults of any Node.js package manager and is the only one\nwith a lifecycle-script jail. Aube drops into existing projects using\ntheir existing lockfiles (`pnpm-lock.yaml`, `package-lock.json`,\n`npm-shrinkwrap.json`, `yarn.lock` and `bun.lock`).",
      "dev_url": "https://github.com/jdx/aube",
      "home": "https://aube.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Aube — a fast Node.js package manager"
    },
    "build": {
      "number": "2",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "let schema = (\n  open --raw crates/aube-resolver/build.rs\n  | parse --regex 'const PRIMER_DATA_SCHEMA: u32 = (?<schema>\\d+);'\n  | get --optional 0.schema\n)\n\nif ($schema | is-empty) {\n  error make { msg: 'Failed to parse PRIMER_DATA_SCHEMA from crates/aube-resolver/build.rs' }\n}\n\nnode ...[\n  scripts/generate-primer.mjs\n  --top=($env.AUBE_PRIMER_TOP)\n  --versions=($env.AUBE_PRIMER_VERSION_CAP)\n  --out=($\"crates/aube-resolver/data/primer-top($env.AUBE_PRIMER_TOP)-v($env.AUBE_PRIMER_VERSION_CAP)-s($schema).rkyv.json\")\n  --popular-names-out=crates/aube-resolver/data/popular-top100000-v1.json\n]\n",
          "cd crates/aube",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins --target=($env.CARGO_BUILD_TARGET)",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml",
          "mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions",
          "let bin = $prefix | path join bin/aube",
          "^$bin completion bash | save ($prefix | path join share/bash-completion/completions/aube)",
          "^$bin completion fish | save ($prefix | path join share/fish/vendor_completions.d/aube.fish)",
          "^$bin completion zsh  | save ($prefix | path join share/zsh/site-functions/_aube)"
        ],
        "env": {
          "AR_x86_64_pc_windows_msvc": "llvm-lib",
          "AUBE_PRIMER_TOP": "2000",
          "AUBE_PRIMER_VERSION_CAP": "100",
          "AUBE_REQUIRE_PRIMER": "1",
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "CC_x86_64_pc_windows_msvc": "clang-cl",
          "CXX_x86_64_pc_windows_msvc": "clang-cl"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "aube",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "clang",
            "cmake",
            "libclang",
            "make",
            "ninja",
            "nodejs",
            "nushell",
            "pkg-config"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "aube --help",
              "aube --version",
              "aubr --help",
              "aubr --version",
              "aubx --help",
              "aubx --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "aube",
                "aubr",
                "aubx"
              ],
              "files": [
                "share/bash-completion/completions/aube",
                "share/fish/vendor_completions.d/aube.fish",
                "share/zsh/site-functions/_aube"
              ],
              "strict": true
            }
          }
        ],
        "version": "2.2.13"
      }
    ],
