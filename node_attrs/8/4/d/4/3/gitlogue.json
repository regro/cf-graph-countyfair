  "raw_meta_yaml": "context:\n  version: \"0.11.0\"\n\npackage:\n  name: gitlogue\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/unhappychoice/gitlogue/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: cf0814005bd39c02b7c48d385a258e2e4e1fd57980bb57db72ecb490494de06c\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - export LIBGIT2_NO_VENDOR=1 OPENSSL_NO_VENDOR=1\n          - cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins\n      - if: win\n        then:\n          - cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - make\n    - pkg-config\n  host:\n    - if: unix\n      then: libgit2\n\ntests:\n  - script:\n      - gitlogue --help\n      - gitlogue --version\n  - package_contents:\n      bin:\n        - gitlogue\n      strict: true\n\nabout:\n  summary: A cinematic Git commit replay tool for the terminal\n  description: |\n    Gitlogue is a terminal-based screensaver that replays Git commits as if a\n    ghost developer were typing each change by hand. It provides realistic\n    typing animations, syntax highlighting, and file tree transitions.\n  license: ISC\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/unhappychoice/gitlogue\n  documentation: https://github.com/unhappychoice/gitlogue/tree/main/docs\n  repository: https://github.com/unhappychoice/gitlogue\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
