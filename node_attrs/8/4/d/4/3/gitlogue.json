  "linux_64_meta_yaml": {
    "about": {
      "description": "Gitlogue is a terminal-based screensaver that replays Git commits as if a\nghost developer were typing each change by hand. It provides realistic\ntyping animations, syntax highlighting, and file tree transitions.",
      "dev_url": "https://github.com/unhappychoice/gitlogue",
      "doc_url": "https://github.com/unhappychoice/gitlogue/tree/main/docs",
      "home": "https://github.com/unhappychoice/gitlogue",
      "license": "ISC",
      "license_family": "ISC",
      "license_file": "LICENSE",
      "summary": "A cinematic Git commit replay tool for the terminal"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export LIBGIT2_NO_VENDOR=1 OPENSSL_NO_VENDOR=1",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "gitlogue",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "cmake",
            "make",
            "pkg-config"
          ],
          "host": [
            "libgit2"
          ],
          "run": []
        },
        "tests": [
          {
