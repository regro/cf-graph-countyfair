  "raw_meta_yaml": "{% set name = \"mmgsuite\" %}\n{% set version = \"5.8.0\" %}\n\npackage:\n  name: {{ name }}\n  version: {{ version }}\n\nsource:\n  fn: {{ name }}_{{ version }}.tar.gz\n  url: https://github.com/MmgTools/mmg/archive/refs/tags/v{{ version }}.tar.gz\n  sha256: 686eaab84de79c072f3aedf26cd11ced44c84b435d51ce34e016ad203172922f\n  patches:\n    - patchs/0001-Add-Option-to-deactivate-the-CPack-directives.patch\n\nbuild:\n  number: 15\n  string: \"vtk_h{{ PKG_HASH }}_{{ PKG_BUILDNUM }}\"  # [use_vtk == \"ON\"]\n  ignore_run_exports_from:   # [use_vtk != \"ON\"]\n    - {{ compiler('cxx') }}  # [use_vtk != \"ON\"]\n    - {{ compiler('c') }}    # [use_vtk != \"ON\"]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - ninja\n    - git\n    - setuptools-scm\n  host:\n    - libscotch              # [not win]\n    - iscd-commons           # [not win]\n    - iscd-linearelasticity  # [not win]\n    - vtk-base               # [use_vtk == \"ON\"]\n  run:\n    - libscotch              # [not win]\n    - iscd-commons           # [not win]\n    - iscd-linearelasticity  # [not win]\n    - vtk-base               # [use_vtk == \"ON\"]\n\ntest:\n  source_files:\n    - libexamples/mmg3d/io_generic_and_get_adja/cube.vtu  # [use_vtk == \"ON\"]\n  commands:\n    # Target executables cannot run while cross-compiling (for example,\n    # osx-arm64 packages are built on osx-64 CI workers).\n    - mmgs_O3 -h  || true  # [unix and build_platform == target_platform]\n    - mmg2d_O3 -h || true  # [unix and build_platform == target_platform]\n    - mmg3d_O3 -h || true  # [unix and build_platform == target_platform]\n    - mmg3d_O3 libexamples/mmg3d/io_generic_and_get_adja/cube.vtu -out cube.mesh  # [use_vtk == \"ON\" and build_platform == target_platform]\n    - test -f $PREFIX/lib/libmmg.so  # [linux]\n    - test -f $PREFIX/lib/libmmg.dylib  # [osx]\n    - test -f $PREFIX/include/mmg/libmmg.h  # [not win]\n    - test -f $PREFIX/include/mmg/libmmgf.h  # [not win and not arm64]\n\nabout:\n  home: https://www.mmgtools.org/mmg-open-source-consortium\n  license: LGPL-3.0-only\n  license_family: LGPL\n  license_file: LICENSE\n  summary: 'mmg - Surface and volume remeshers'\n  description: |\n    open source software for bidimensional and tridimensional surface and volume remeshing\n  doc_url: https://www.mmgtools.org/mmg-remesher-try-mmg/mmg-remesher-tutorials\n  dev_url: https://github.com/MmgTools/mmg\n\nextra:\n  recipe-maintainers:\n    - ldallolio\n    - fbordeu\n",
