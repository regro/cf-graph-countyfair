  "raw_meta_yaml": "context:\n  name: glycin\n  version: \"2.2.0\"\n  version_majmin: ${{ (version | split('.'))[:2] | join('.') }}\n\nrecipe:\n  name: glycin_and_loaders\n  version: ${{ version }}\n\nsource:\n  url: https://download.gnome.org/sources/glycin/${{ version_majmin }}/glycin-${{ version }}.tar.xz\n  sha256: a0bf173bf9302b508eb58255b64eb8e46dc345ac92b0d883ce33f5fc47acc068\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: ${{ name|lower }}\n    build:\n      script:\n        interpreter: brush\n        content:\n          - if: osx\n            then: export LDFLAGS=\"${LDFLAGS//-Wl,-dead_strip_dylibs/}\"\n          - |\n            meson setup ${MESON_ARGS} \\\n                --prefix=\"${LIBRARY_PREFIX:-${PREFIX}}\" \\\n                --default-library=shared \\\n                --wrap-mode=nofallback \\\n                -Dvapi=false \\\n                -Dtests=false \\\n                -Dglycin-thumbnailer=false \\\n                -Dglycin-loaders=false \\\n                -Dlibglycin=true \\\n                -Dlibglycin-gtk4=false \\\n                builddir\n            ninja -v -C builddir -j \"${CPU_COUNT}\"\n          - ninja -C builddir install -j \"${CPU_COUNT}\"\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - brush\n        - gobject-introspection\n        - meson >=0.63.0\n        - ninja\n        - pkg-config\n        - rust\n      host:\n        - expat\n        - freetype\n        - glib\n        - gobject-introspection\n        - zlib\n        - if: linux\n          then:\n            - libseccomp\n            - fontconfig\n      run_exports:\n        - ${{ pin_subpackage('glycin', upper_bound='x.x') }}\n      ignore_run_exports:\n        by_name:\n          - libexpat\n          - libfreetype6\n          - libzlib\n    tests:\n      - package_contents:\n          lib:\n            - if: not win\n              then: libglycin-2\n          files:\n            - if: win\n              then: Library/bin/glycin-2-0.dll\n\n  - package:\n      name: ${{ name|lower }}-loaders\n    build:\n      skip:\n        - not linux\n      script: |\n        meson setup ${MESON_ARGS} \\\n            --prefix=$PREFIX \\\n            --default-library=shared \\\n            --wrap-mode=nofallback \\\n            -Dvapi=false \\\n            -Dtests=false \\\n            -Dglycin-thumbnailer=false \\\n            -Dglycin-loaders=true \\\n            -Dlibglycin=false \\\n            -Dlibglycin-gtk4=false \\\n            builddir\n        ninja -v -C builddir -j ${CPU_COUNT}\n        ninja -C builddir install -j ${CPU_COUNT}\n        # Set GLYCIN_DATA_DIR to use loaders from conda environment\n        mkdir -p $PREFIX/etc/conda/activate.d\n        echo 'export GLYCIN_DATA_DIR=\"$CONDA_PREFIX/share\"' > $PREFIX/etc/conda/activate.d/glycin-loaders.sh\n        mkdir -p $PREFIX/etc/conda/deactivate.d\n        echo 'unset GLYCIN_DATA_DIR' > $PREFIX/etc/conda/deactivate.d/glycin-loaders.sh\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - gettext\n        - gobject-introspection\n        - meson >=0.63.0\n        - ninja\n        - pkg-config\n        - rust\n      host:\n        - cairo\n        - expat\n        - freetype\n        - glib\n        - gobject-introspection\n        - libheif\n        - libjxl\n        - librsvg\n        - libxml2-devel\n        - xorg-xorgproto\n        - libseccomp\n        - zlib\n      run_exports:\n        - ${{ pin_subpackage('glycin-loaders', upper_bound='x.x') }}\n      ignore_run_exports:\n        by_name:\n          - libexpat\n          - libfreetype6\n          - libxml2-16\n          - libzlib\n          - libseccomp\n    tests:\n      - package_contents:\n          files:\n            - libexec/glycin-loaders/2+/glycin-heif\n            - libexec/glycin-loaders/2+/glycin-image-rs\n            - libexec/glycin-loaders/2+/glycin-jxl\n            - libexec/glycin-loaders/2+/glycin-svg\n\n  - package:\n      name: ${{ name|lower }}-gtk4\n    build:\n      script:\n        interpreter: brush\n        content:\n          - if: osx\n            then: export LDFLAGS=\"${LDFLAGS//-Wl,-dead_strip_dylibs/}\"\n          - |\n            meson setup ${MESON_ARGS} \\\n                --prefix=\"${LIBRARY_PREFIX:-${PREFIX}}\" \\\n                --default-library=shared \\\n                --wrap-mode=nofallback \\\n                -Dvapi=false \\\n                -Dtests=false \\\n                -Dglycin-thumbnailer=false \\\n                -Dglycin-loaders=false \\\n                -Dlibglycin=false \\\n                -Dlibglycin-gtk4=true \\\n                builddir\n            ninja -v -C builddir -j \"${CPU_COUNT}\"\n          - ninja -C builddir install -j \"${CPU_COUNT}\"\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - brush\n        - gobject-introspection\n        - meson >=0.63.0\n        - ninja\n        - pkg-config\n        - rust\n      host:\n        - ${{ pin_subpackage('glycin', exact=True) }}\n        - expat\n        - freetype\n        - glib\n        - gobject-introspection\n        - gtk4 >= 4.16.0\n        - zlib\n        - if: linux\n          then:\n            - libseccomp\n      run:\n        - ${{ pin_subpackage('glycin', exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage('glycin-gtk4', upper_bound='x.x') }}\n      ignore_run_exports:\n        by_name:\n          - libexpat\n          - libfreetype6\n          - libzlib\n          - libseccomp\n    tests:\n      - package_contents:\n          lib:\n            - if: not win\n              then: libglycin-gtk4-2\n          files:\n            - if: win\n              then: Library/bin/glycin-gtk4-2-0.dll\n\nabout:\n  homepage: https://gitlab.gnome.org/GNOME/glycin\n  summary: \"Sandboxed and extendable image loading\"\n  description: |\n    Glycin allows to decode, edit, and create images and\n    read metadata. The decoding happens in sandboxed modular\n    image loaders and editors.\n  license: LGPL-2.1-or-later\n  license_file: LICENSE-LGPL-2.1\n  repository: https://gitlab.gnome.org/GNOME/glycin\n\nextra:\n  recipe-maintainers:\n    - haecker-felix\n    - danyeaw\n    - Hofer-Julian\n",
