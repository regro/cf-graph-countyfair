    "about": {
      "description": "Glycin allows to decode, edit, and create images and\nread metadata. The decoding happens in sandboxed modular\nimage loaders and editors.",
      "dev_url": "https://gitlab.gnome.org/GNOME/glycin",
      "home": "https://gitlab.gnome.org/GNOME/glycin",
      "license": "LGPL-2.1-or-later",
      "license_family": "LGPL-2.1-or-later",
      "license_file": "LICENSE-LGPL-2.1",
      "summary": "Sandboxed and extendable image loading"
    },
    "build": {
      "number": "0",
      "run_exports": {
        "weak": [
          "glycin"
        ]
      },
      "script": {
        "content": [
          "meson setup ${MESON_ARGS} \\\n    --prefix=\"${LIBRARY_PREFIX:-${PREFIX}}\" \\\n    --default-library=shared \\\n    --wrap-mode=nofallback \\\n    -Dvapi=false \\\n    -Dtests=false \\\n    -Dglycin-thumbnailer=false \\\n    -Dglycin-loaders=false \\\n    -Dlibglycin=true \\\n    -Dlibglycin-gtk4=false \\\n    builddir\nninja -v -C builddir -j \"${CPU_COUNT}\"\n",
          "ninja -C builddir install -j \"${CPU_COUNT}\""
        ],
        "interpreter": "brush"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "haecker-felix",
