      "license_file": "github.com/git-lfs/git-lfs/LICENSE.md",
      "summary": "An open source Git extension for versioning large files"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "${{ 'set -x' if unix else '@echo on' }}",
          "cd github.com/git-lfs/git-lfs",
          "env -u GOARCH go generate ./commands",
          "go build -v -ldflags \"-w -s\" -o \"$PREFIX/bin/git-lfs\"",
          "go-licenses save . --save_path=${{ SRC_DIR }}/license_files || true",
          "mkdir -p \"${PREFIX}/share/bash-completion/completions\" \"${PREFIX}/share/fish/vendor_completions.d\" \"${PREFIX}/share/zsh/site-functions\"",
          "ls t/fixtures/completions",
          "cp t/fixtures/completions/git-lfs-completion.bash \"${PREFIX}/share/bash-completion/completions/git-lfs\"",
          "cp t/fixtures/completions/git-lfs-completion.fish \"${PREFIX}/share/fish/vendor_completions.d/git-lfs.fish\"",
          "cp t/fixtures/completions/git-lfs-completion.zsh  \"${PREFIX}/share/zsh/site-functions/_git-lfs\""
        ],
        "env": {
          "GOFLAGS": "-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=vendor -modcacherw"
        }
      }
    },
    "extra": {
