  "raw_meta_yaml": "{% set version = \"0.5.1\" %}\n\npackage:\n  name: smspp-project\n  version: {{ version }}\n\nsource:\n  url: https://gitlab.com/smspp/smspp-project/-/releases/{{ version }}/downloads/smspp-project-{{ version }}.tar.gz\n  sha256: 2a0527040e383f4bbb7ff0516d835bfbe6920d15306f8c35d93a0f786e210fb9\n\nbuild:\n  number: 4\n  run_exports:\n    - {{ pin_subpackage('smspp-project', max_pin='x.x.x') }}\n\nrequirements:\n  build:\n    - {{ compiler('cxx') }}\n    - {{ stdlib('c') }}\n    - cmake >=3.15\n    - make  # [unix]\n    - pkgconfig  # [unix]\n    - ninja  # [win]\n    - highs >=1.10.0\n  host:\n    - libgomp  # [linux]\n    - llvm-openmp   # [unix]\n    - llvm-openmp  # [win and mpi != \"msmpi\"]\n    - intel-openmp  # [win and mpi == \"msmpi\"]\n    - openblas\n    - libboost-devel\n    - libboost-mpi >={{ libboost_devel }}\n    - netcdf-cxx4\n    - netcdf-cxx4 * nompi_*\n    - libnetcdf\n    - libnetcdf * nompi_*\n    - hdf5\n    - hdf5 * nompi_*\n    - libaec  # [unix]\n    - openssl  # [unix]\n    - libcurl  # [unix]\n    - bzip2\n    - zlib\n    - eigen\n    - {{ mpi }}\n    - coin-or-utils\n    - coin-or-clp\n    - coin-or-osi\n    # - scip >=9.2.3\n    - highs >=1.10.0\n    - lemon\n    - stopt >=6.3  # [win]\n    - stopt >=5.16  # [unix]\n    - getopt-win32  # [win]\n    - mkl-devel  # [win]\n    - zstd  # [win]\n    - winpthreads-devel  # [win and mpi != \"msmpi\"]\n    - pthreads-win32  # [win and mpi == \"msmpi\"]\n  run:\n    - libopenblas  # [unix]\n    - msmpi  # [win and mpi == \"msmpi\"]\n    - pthreads-win32  # [win and mpi == \"msmpi\"]\n\ntest:\n  source_files:\n    - tools\n  commands:\n    - ucblock_solver --help\n    - investmentblock_solver --help\n    - |\n      cd tools/ucblock_solver/examples\n      cp ../config/BSCfg.txt BSCfg.txt\n      ucblock_solver Bus_Test.nc4 -S BSCfg.txt\n      cd ../../..\n    - |\n      cd tools/investmentblock_solver\n      cp config/BSPar.txt BSPar.txt\n      cp config/BSCfg.txt BSCfg.txt\n    