  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.1\"\n\npackage:\n  name: invoice2data\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/invoice2data/invoice2data-${{ version }}.tar.gz\n  sha256: d98dd4b7f36388c044b8ae53c82de4a50454eedff6608f9d3cdcf2bbf52c4832\n\nbuild:\n  # Pure-Python: invoice2data's mypyc compilation is opt-in\n  # (INVOICE2DATA_COMPILE_MYPYC=1, off by default), so a plain pip install needs\n  # no compiler and the package can ship noarch.\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - invoice2data = invoice2data.__main__:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - click >=8.0.1\n    - python-dateutil >=2.8\n    - pyyaml >=6.0\n    - regex >=2024.4.16\n\ntests:\n  - python:\n      imports:\n        - invoice2data\n        - invoice2data.extract\n        - invoice2data.input\n        - invoice2data.output\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - invoice2data --help\n\nabout:\n  homepage: https://github.com/invoice-x/invoice2data\n  summary: Python parser to extract data from pdf invoice\n  description: |\n    A command-line tool and Python library to automate extraction of data from\n    PDF invoices, using a flexible YAML/JSON template system, pluggable input\n    backends (pypdfium2 by default, plus pdftotext, OCR and others) and\n    CSV / JSON / XML output.\n  license: MIT\n  license_file: LICENSE.md\n  documentation: https://invoice2data.readthedocs.io\n  repository: https://github.com/invoice-x/invoice2data\n\nextra:\n  recipe-maintainers:\n    - bosd\n",
