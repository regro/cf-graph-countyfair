  "raw_meta_yaml": "context:\n  version: \"0.4.101\"\n\npackage:\n  name: flyctl\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/superfly/flyctl/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 55fac27166b8be47309a6e5980671f367c787a1ae1eefa2c6515c6ffe668628b\n\nbuild:\n  number: 0\n  script:\n    - go-licenses save . --save_path=library_licenses --ignore=github.com/in-toto/attestation/go/v1 --ignore=github.com/in-toto/in-toto-golang --ignore=github.com/jmespath/go-jmespath --ignore=github.com/launchdarkly/go-jsonstream/v3 --ignore=github.com/launchdarkly/go-sdk-common/v3\n    - if: unix\n      then:\n        - BUILD_TIME=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n        - SHORT_COMMIT_HASH=\"$(curl -s \"https://api.github.com/repos/superfly/flyctl/commits/v${{ version }}\" | jq -r '.sha' | cut -c 1-7)\"\n        - go build -v -o \"$PREFIX\"/bin/flyctl -ldflags=\"-s -w -X github.com/superfly/flyctl/internal/buildinfo.buildVersion=${{ version }} -X github.com/superfly/flyctl/internal/buildinfo.buildDate=${BUILD_TIME} -X github.com/superfly/flyctl/internal/buildinfo.commit=${SHORT_COMMIT_HASH}\" -trimpath -tags production .\n        # generate shell completions\n        - if: build_platform == host_platform\n          then:\n            - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n            - '\"$PREFIX\"/bin/flyctl completion bash > \"$PREFIX\"/share/bash-completion/completions/flyctl'\n            - '\"$PREFIX\"/bin/flyctl completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/flyctl.fish'\n            - '\"$PREFIX\"/bin/flyctl completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_flyctl'\n    - if: win\n      then:\n        - for /f \"usebackq delims=\" %%T in (`powershell -Command \"[DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')\"`) do set BUILD_TIME=%%T\n        - for /f \"usebackq delims=\" %%T in (`powershell -Command \"((Invoke-RestMethod 'https://api.github.com/repos/superfly/flyctl/commits/v${{ version }}').sha).Substring(0, 7)\"`) do set SHORT_COMMIT_HASH=%%T\n        - go build -v -o \"%LIBRARY_BIN%\"\\flyctl.exe -ldflags=\"-s -w -X github.com/superfly/flyctl/internal/buildinfo.buildVersion=${{ version }} -X github.com/superfly/flyctl/internal/buildinfo.buildDate=%BUILD_TIME% -X github.com/superfly/flyctl/internal/buildinfo.commit=%SHORT_COMMIT_HASH%\" -trimpath -tags production\n          .\n        # generate shell completions\n        - if: build_platform == host_platform\n          then:\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n            - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n            - '\"%LIBRARY_BIN%\"\\flyctl.exe completion bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\flyctl'\n            - '\"%LIBRARY_BIN%\"\\flyctl.exe completion fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\flyctl.fish'\n            - '\"%LIBRARY_BIN%\"\\flyctl.exe completion zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_flyctl'\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - flyctl help\n      - flyctl version\n  - package_contents:\n      bin:\n        - flyctl\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/flyctl\n            - share/fish/vendor_completions.d/flyctl.fish\n            - share/zsh/site-functions/_flyctl\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/flyctl\n            - Library/share/fish/vendor_completions.d/flyctl.fish\n            - Library/share/zsh/site-functions/_flyctl\n      strict: true\n\nabout:\n  summary: CLI for deploying and managing applications on fly.io\n  description: |\n    flyctl is the command-line interface for the fly.io platform for\n    deploying and running applications on scalable hardware-isolated sandboxes.\n    Use flyctl to launch apps, manage deployments, scale machines, handle\n    secrets, configure networking, and more.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n  homepage: https://fly.io\n  repository: https://github.com/superfly/flyctl\n  documentation: https://fly.io/docs/flyctl/\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
