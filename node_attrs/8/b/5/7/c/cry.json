  "raw_meta_yaml": "context:\n  version: \"1.7\"\n\npackage:\n  name: cry\n  version: ${{ version }}\n\nsource:\n  url: http://nuclear.llnl.gov/simulation/cry_v${{ version }}.tar.gz\n  sha256: dcee2428f81cba113f82e0c7c42f4d85bff4b8530e5ab5c82c059bed3e570c20\n  patches:\n    - 0001-add-libCRY-so-fPIC-and-remove-default-test-target.patch\n\nbuild:\n  script:\n    - ln -s \"${AR}\" \"${BUILD_PREFIX}/bin/ar\" # Fix hardcoded assumption \"ar\"\n    - make -j${CPU_COUNT} CXX=$CXX\n    - cp lib/libCRY.* ${PREFIX}/lib/\n    - rm ${PREFIX}/lib/*.a\n    - mkdir -p ${PREFIX}/include/cry && cp src/*.h ${PREFIX}/include/cry/\n  number: 1\n  skip:\n    - win\n    - osx\n\nrequirements:\n  build:\n    - ${{ compiler(\"cxx\") }}\n    - ${{ stdlib(\"c\") }}\n    - make\n  run_exports:\n    - ${{ pin_subpackage(\"cry\", upper_bound=\"x.x\") }}\n\ntests:\n  - package_contents:\n      lib:\n        - CRY\n      include:\n        - cry/CRYAbsFunction.h\n        - cry/CRYAbsParameter.h\n        - cry/CRYBinning.h\n        - cry/CRYCosLatitudeFunction.h\n        - cry/CRYData.h\n        - cry/CRYFunctionDict.h\n        - cry/CRYGenerator.h\n        - cry/CRYParamI.h\n        - cry/CRYParameter.h\n        - cry/CRYParticle.h\n        - cry/CRYPdf.h\n        - cry/CRYPrimary.h\n        - cry/CRYPrimarySpectrumFunction.h\n        - cry/CRYSetup.h\n        - cry/CRYUtils.h\n        - cry/CRYWeightFunc.h\n      files:\n        - etc/conda/test-files/cry/0/*\n      strict: true\n  - script:\n    - cd test && $CXX testMain.cc -o testMain -I${PREFIX}/include/cry -L${PREFIX}/lib -lCRY\n    - ./testMain ./setup.file 100\n    requirements:\n      run:\n        - ${{ compiler(\"cxx\") }}\n    files:\n      source:\n        - data/\n        - test/\n\nabout:\n  homepage: https://nuclear.llnl.gov/simulation/main.html\n  summary: 'Correlated cosmic-ray particle showers generator'\n  description: |\n    The CRY software library generates correlated cosmic-ray particle shower distributions at one of three\n    elevations (sea level, 2100 m, and 11300 m) for use as input to transport and detector simulation codes.\n  license: BSD-3-Clause\n  license_file: src/COPYRIGHT.TXT\n\nextra:\n  recipe-maintainers:\n    - utk4r-sh\n    - GiacomoXT\n    - vvsagar\n    - AlexanderHeidelbach\n",
