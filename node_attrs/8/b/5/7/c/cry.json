    "about": {
      "description": "The CRY software library generates correlated cosmic-ray particle shower distributions at one of three\nelevations (sea level, 2100 m, and 11300 m) for use as input to transport and detector simulation codes.",
      "home": "https://nuclear.llnl.gov/simulation/main.html",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "src/COPYRIGHT.TXT",
      "summary": "Correlated cosmic-ray particle showers generator"
    },
    "build": {
      "number": "1",
      "run_exports": {
        "weak": [
          "cry"
        ]
      },
      "script": [
        "ln -s \"${AR}\" \"${BUILD_PREFIX}/bin/ar\"",
        "make -j${CPU_COUNT} CXX=$CXX",
        "cp lib/libCRY.* ${PREFIX}/lib/",
        "rm ${PREFIX}/lib/*.a",
        "mkdir -p ${PREFIX}/include/cry && cp src/*.h ${PREFIX}/include/cry/"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "utk4r-sh",
        "GiacomoXT",
        "vvsagar",
        "AlexanderHeidelbach"
      ]
    },
