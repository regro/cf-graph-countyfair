  "linux_64_meta_yaml": {
    "about": {
      "description": "C-Reduce is a tool that takes a large C or C++ program that has a\nproperty of interest (such as triggering a compiler bug) and\nautomatically produces a much smaller C/C++ program that has the same\nproperty. It is intended for use by people who discover and report\nbugs in compilers and other tools that process C/C++ code.",
      "dev_url": "https://github.com/csmith-project/creduce",
      "home": "https://github.com/csmith-project/creduce",
      "license": "NCSA",
      "license_family": "NCSA",
      "license_file": "COPYING",
      "summary": "C-Reduce, a C and C++ program reducer"
    },
    "build": {
      "number": "0",
      "script": [
        "export CFLAGS=\"${CFLAGS:-} -std=gnu17\"",
        "export CXXFLAGS=\"${CXXFLAGS:-} -std=c++17\"",
        "cp \"$BUILD_PREFIX/share/gnuconfig/config.sub\" autoconf/config.sub",
        "cp \"$BUILD_PREFIX/share/gnuconfig/config.guess\" autoconf/config.guess",
        "./configure --prefix=\"$PREFIX\"",
        "make -j${CPU_COUNT}",
        "make check",
        "make install"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "user202729"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "creduce",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "cxx_compiler_stub",
            "c_stdlib_stub",
            "make",
            "flex",
            "gnuconfig"
          ],
          "host": [
            "perl",
            "perl-exporter-lite",
            "perl-file-which",
            "perl-getopt-tabular",
            "perl-regexp-common",
            "zlib",
            "llvmdev 9.*",
            "clangdev 9.*"
          ],
          "run": [
            "libllvm9 9.*",
            "perl-exporter-lite",
            "perl-file-which",
            "perl-getopt-tabular",
            "perl-regexp-common"
          ]
        },
        "tests": [
          {
            "script": [
              "creduce --version",
              "$PREFIX/libexec/clang_delta --version"
            ]
          }
        ],
        "version": "2.10.0"
      }
    ],
