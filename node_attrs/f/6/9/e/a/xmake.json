  "raw_meta_yaml": "context:\n  version: \"3.1.1\"\n\npackage:\n  name: xmake\n  version: ${{ version }}\n\nsource:\n  git: https://github.com/xmake-io/xmake.git\n  tag: v${{ version }}\n  patches:\n    - 0001-use-system-lua-lz4-and-tbox.patch\n    - 0002-support-conda-clang-on-windows.patch\n    - 0003-detect-conda-libraries-on-windows.patch\n    - 0004-build-internal-libs-shared.patch\n    - 0005-use-system-xxhash.patch\n    - 0006-avoid-duplicate-is-cygpty-symbol.patch\n    - 0007-honor-macosx-deployment-target.patch\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - pkg-config\n    - if: unix\n      then:\n        - ninja\n    - if: linux\n      then:\n        - patchelf\n    - if: win\n      then:\n        - autotools_clang_conda\n        - m2-sed\n  host:\n    - lua 5.4.*\n    - lz4-c\n    - tbox >=1.8.2 *_1\n    - xxhash >=0.8.3,<0.9\n    - if: unix\n      then:\n        - ncurses\n        - readline\n  run:\n    - lua >=5.4,<5.5.0a0\n    - tbox >=1.8.2 *_1\n\ntests:\n  - script:\n      - if: win\n        then:\n          - set \"COLORTERM=color256\"\n          - call xmake --version\n          - call xrepo --version\n          - call xmake lua -c \"assert(hash.strhash64('xmake'))\"\n        else:\n          - xmake --version\n          - xrepo --version\n          - xmake lua -c \"assert(hash.strhash64('xmake'))\"\n      - if: osx\n        then:\n          - test -f \"$PREFIX/lib/libsv.dylib\"\n          - test -f \"$PREFIX/lib/libxmake.dylib\"\n          - test ! -e \"$PREFIX/lib/libsv.a\"\n          - test ! -e \"$PREFIX/lib/libxmake.a\"\n          - otool -L \"$PREFIX/bin/xmake\" | grep -q '@rpath/libxmake.dylib'\n          - otool -L \"$PREFIX/lib/libxmake.dylib\" | grep -q '@rpath/libsv.dylib'\n\nabout:\n  homepage: https://xmake.io\n  summary: A cross-platform build utility based on Lua\n  description: |\n    XMake is a lightweight, cross-platform build utility based on Lua. It uses\n    xmake.lua files to describe project builds and includes a built-in package\n    manager for C and C++ dependencies.\n  license: Apache-2.0 AND Unlicense\n  license_file:\n    - LICENSE.md\n    - NOTICE.md\n    - core/src/sv/sv/UNLICENSE\n  documentation: https://xmake.io/guide/\n  repository: https://github.com/xmake-io/xmake\n\nextra:\n  recipe-maintainers:\n    - luadebug\n",
