  "raw_meta_yaml": "context:\n  version: \"0.24.0\"\n\npackage:\n  name: iwe\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/iwe-org/iwe/archive/refs/tags/iwe-v${{ version }}.tar.gz\n  sha256: 498ce8a553809c48e055909dbe409c052c40362ac69ae3a600c71ead84d211b0\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --path=./crates/iwe  --root=\"$PREFIX\" --no-track --locked --bins\n          - cargo auditable install --path=./crates/iwec --root=\"$PREFIX\" --no-track --locked --bins\n          - cargo auditable install --path=./crates/iwes --root=\"$PREFIX\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions\n              - '\"$PREFIX\"/bin/iwe completions bash > \"$PREFIX\"/share/bash-completion/completions/iwe'\n              - '\"$PREFIX\"/bin/iwe completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/iwe.fish'\n              - '\"$PREFIX\"/bin/iwe completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_iwe'\n      - if: win\n        then:\n          - cargo auditable install --path=./crates/iwe  --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          - cargo auditable install --path=./crates/iwec --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          - cargo auditable install --path=./crates/iwes --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins\n          # generate shell completions\n          - if: build_platform == host_platform\n            then:\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\n              - mkdir \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\n              - '\"%LIBRARY_BIN%\"\\iwe.exe completions bash > \"%LIBRARY_PREFIX%\"\\share\\bash-completion\\completions\\iwe'\n              - '\"%LIBRARY_BIN%\"\\iwe.exe completions fish > \"%LIBRARY_PREFIX%\"\\share\\fish\\vendor_completions.d\\iwe.fish'\n              - '\"%LIBRARY_BIN%\"\\iwe.exe completions zsh  > \"%LIBRARY_PREFIX%\"\\share\\zsh\\site-functions\\_iwe'\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - iwe --help\n      - iwe --version\n  - package_contents:\n      bin:\n        - iwe\n        - iwec\n        - iwes\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/iwe\n            - share/fish/vendor_completions.d/iwe.fish\n            - share/zsh/site-functions/_iwe\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/iwe\n            - Library/share/fish/vendor_completions.d/iwe.fish\n            - Library/share/zsh/site-functions/_iwe\n      strict: true\n\nabout:\n  summary: IWE – Markdown memory system for you and your AI Agents\n  description: |\n    IWE is a knowledge graph system that serves as a \"second brain\" for humans\n    and AI agents. It organizes notes hierarchically and makes them accessible\n    through CLI tools and LSP for editor integration (VS Code, Neovim, Zed,\n    Helix etc.).\n  license: Apache-2.0\n  license_file:\n    - LICENSE-APACHE\n    - THIRDPARTY.yml\n  homepage: https://iwe.org\n  documentation: https://iwe.md/docs/\n  repository: https://github.com/iwe-org/iwe\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
