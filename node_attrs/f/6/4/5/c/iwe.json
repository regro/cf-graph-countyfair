  "linux_64_meta_yaml": {
    "about": {
      "description": "IWE is a knowledge graph system that serves as a \"second brain\" for humans\nand AI agents. It organizes notes hierarchically and makes them accessible\nthrough CLI tools and LSP for editor integration (VS Code, Neovim, Zed,\nHelix etc.).",
      "dev_url": "https://github.com/iwe-org/iwe",
      "doc_url": "https://iwe.md/docs/",
      "home": "https://iwe.org/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE-APACHE",
      "summary": "IWE – Markdown memory system for you and your AI Agents"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --path=./crates/iwe  --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo auditable install --path=./crates/iwec --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo auditable install --path=./crates/iwes --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/iwe completions bash > \"$PREFIX\"/share/bash-completion/completions/iwe",
          "\"$PREFIX\"/bin/iwe completions fish > \"$PREFIX\"/share/fish/vendor_completions.d/iwe.fish",
          "\"$PREFIX\"/bin/iwe completions zsh  > \"$PREFIX\"/share/zsh/site-functions/_iwe",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "iwe",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "iwe --help",
              "iwe --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "iwe",
                "iwec",
                "iwes"
              ],
              "files": [
                "share/bash-completion/completions/iwe",
                "share/fish/vendor_completions.d/iwe.fish",
                "share/zsh/site-functions/_iwe"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.24.0"
      }
    ],
