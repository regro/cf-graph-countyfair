    "about": {
      "description": "mkdocs-kroki-plugin is a MkDocs plugin that renders text-based diagrams\nthrough a Kroki server. It supports a wide range of diagram languages\n(PlantUML, Mermaid, GraphViz, BlockDiag, D2, C4 and more), can embed\ndiagrams from external files, and provides display sizing, background\ncolor and theme-aware styling options.",
      "dev_url": "https://github.com/AVATEAM-IT-SYSTEMHAUS/mkdocs-kroki-plugin",
      "doc_url": "https://github.com/AVATEAM-IT-SYSTEMHAUS/mkdocs-kroki-plugin#readme",
      "home": "https://github.com/AVATEAM-IT-SYSTEMHAUS/mkdocs-kroki-plugin",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "MkDocs plugin for Kroki diagrams"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "julian-belina"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "mkdocs-kroki-plugin",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "hatchling",
            "pip"
          ],
          "run": [
            "python >=3.11",
            "defusedxml >=0.7.1",
            "httpx >=0.24.0",
            "mkdocs >=1.5.0,<=1.6.1",
            "properdocs",
            "result >=0.17.0"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "kroki",
                "kroki.plugin"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "script": "python -c \"from importlib.metadata import entry_points; assert any(ep.name == 'kroki' for ep in entry_points(group='mkdocs.plugins')), 'kroki plugin entry point is not registered'\""
          }
        ],
        "version": "1.7.0"
      }
    ],
