    "test": {
      "commands": [
        "test -f $PREFIX/lib/libXau.so",
        "test -f $PREFIX/lib/libXau.dylib",
        "if not exist %PREFIX%/Library/lib/libXau.dll.a exit /b 1",
        "if not exist %PREFIX%/Library/bin/msys-Xau-*.dll exit /b 1",
        "if not exist \"%LIBRARY_INC%\\X11\\Xauth.h\" exit /b 1",
        "if not exist \"%LIBRARY_LIB%\\Xau.lib\" exit /b 1",
        "if not exist \"%LIBRARY_LIB%\\pkgconfig\\xau.pc\" exit /b 1",
        "if not exist \"%LIBRARY_BIN%\\Xau-6.dll\" exit /b 1",
        "call %CC% /nologo /MD /W4 /I\"%LIBRARY_INC%\" test_xau.c /link /LIBPATH:\"%LIBRARY_LIB%\" Xau.lib /OUT:test_xau.exe",
        "dumpbin /imports test_xau.exe | findstr /I /C:\"Xau-6.dll\"",
        "test_xau.exe",
        "dumpbin /headers test_xau.exe | findstr /I /C:\"AA64 machine (ARM64)\"",
        "dumpbin /headers \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /I /C:\"AA64 machine (ARM64)\"",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\Xau.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauDisposeAuth.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauFileName.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauGetAuthByAddr.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauGetBestAuthByAddr.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauLockAuth.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauReadAuth.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauUnlockAuth.3\" exit /b 1",
        "if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\XauWriteAuth.3\" exit /b 1",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauDisposeAuth\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauFileName\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauGetAuthByAddr\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauGetBestAuthByAddr\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauLockAuth\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauReadAuth\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauUnlockAuth\"",
        "dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"XauWriteAuth\""
      ],
