  "raw_meta_yaml": "# win-arm64 uses Meson, while the other platforms still use Autotools.\n# Ideally, all platforms should migrate to the upstream Meson build.\n{% set xorg_name = \"libXau\" %}\n{% set xorg_category = \"lib\" %}\n{% set name = \"xorg-\" ~ xorg_name %}\n{% set version = \"1.0.12\" %}\n{% set sha256 = \"74d0e4dfa3d39ad8939e99bda37f5967aba528211076828464d2777d477fc0fb\" %}\n{% set am_version = \"1.16\" %} # keep synchronized with build.sh\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://www.x.org/releases/individual/{{ xorg_category }}/{{ xorg_name }}-{{ version }}.tar.xz\n  sha256: {{ sha256 }}\n  patches:\n    - 0001-meson-add-Windows-DLL-exports.patch  # [target_platform == \"win-arm64\"]\n\nbuild:\n  number: 2\n  script: call \"%RECIPE_DIR%\\build-arm64.bat\"  # [target_platform == \"win-arm64\"]\n  detect_binary_files_with_prefix: true\n  run_exports:\n    - {{ pin_subpackage(name|lower) }}\n\nrequirements:\n  build:\n    - m2-autoconf                   # [win and target_platform != \"win-arm64\"]\n    - m2-automake{{ am_version }}   # [win and target_platform != \"win-arm64\"]\n    - m2-libtool                    # [win and target_platform != \"win-arm64\"]\n    - m2-pkg-config                 # [win and target_platform != \"win-arm64\"]\n    - pkg-config                    # [not win]\n    - m2-base                       # [win and target_platform != \"win-arm64\"]\n    - gnuconfig  # [unix]\n    - {{ compiler(\"c\") }}           # [unix or target_platform == \"win-arm64\"]\n    - {{ stdlib(\"c\") }}             # [unix or target_platform == \"win-arm64\"]\n    - {{ compiler(\"m2w64_c\") }}     # [win and target_platform != \"win-arm64\"]\n    - {{ stdlib(\"m2w64_c\") }}       # [win and target_platform != \"win-arm64\"]\n    - meson                          # [target_platform == \"win-arm64\"]\n    - ninja                          # [target_platform == \"win-arm64\"]\n    - m2-sed                         # [target_platform == \"win-arm64\"]\n    - make                           # [target_platform != \"win-arm64\"]\n    - gettext                       # [unix]\n  host:\n    - xorg-util-macros              # [target_platform != \"win-arm64\"]\n    - xorg-xorgproto\n\ntest:\n  requires:\n    - {{ compiler(\"c\") }}  # [target_platform == \"win-arm64\"]\n    - xorg-xorgproto       # [target_platform == \"win-arm64\"]\n  files:\n    - test_xau.c  # [target_platform == \"win-arm64\"]\n  commands:\n    {% set lib_idents = [ \"Xau\" ] %}\n    {% for lib_ident in lib_idents %}\n    - test -f $PREFIX/lib/lib{{ lib_ident }}.dylib  # [osx]\n    - test -f $PREFIX/lib/lib{{ lib_ident }}.so  # [linux]\n    - if not exist %PREFIX%/Library/lib/lib{{ lib_ident }}.dll.a exit /b 1  # [win and target_platform != \"win-arm64\"]\n    - if not exist %PREFIX%/Library/bin/msys-{{ lib_ident }}-*.dll exit /b 1  # [win and target_platform != \"win-arm64\"]\n    {% endfor %}\n    - if not exist \"%LIBRARY_INC%\\X11\\Xauth.h\" exit /b 1  # [target_platform == \"win-arm64\"]\n    - if not exist \"%LIBRARY_LIB%\\Xau.lib\" exit /b 1  # [target_platform == \"win-arm64\"]\n    - if not exist \"%LIBRARY_LIB%\\pkgconfig\\xau.pc\" exit /b 1  # [target_platform == \"win-arm64\"]\n    - if not exist \"%LIBRARY_BIN%\\Xau-6.dll\" exit /b 1  # [target_platform == \"win-arm64\"]\n    - call %CC% /nologo /MD /W4 /I\"%LIBRARY_INC%\" test_xau.c /link /LIBPATH:\"%LIBRARY_LIB%\" Xau.lib /OUT:test_xau.exe  # [target_platform == \"win-arm64\"]\n    - dumpbin /imports test_xau.exe | findstr /I /C:\"Xau-6.dll\"  # [target_platform == \"win-arm64\"]\n    - test_xau.exe  # [target_platform == \"win-arm64\"]\n    - dumpbin /headers test_xau.exe | findstr /I /C:\"AA64 machine (ARM64)\"  # [target_platform == \"win-arm64\"]\n    - dumpbin /headers \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /I /C:\"AA64 machine (ARM64)\"  # [target_platform == \"win-arm64\"]\n    {% set manpages = [ \"Xau\", \"XauDisposeAuth\", \"XauFileName\", \"XauGetAuthByAddr\", \"XauGetBestAuthByAddr\", \"XauLockAuth\", \"XauReadAuth\", \"XauUnlockAuth\", \"XauWriteAuth\" ] %}\n    {% for manpage in manpages %}\n    - if not exist \"%LIBRARY_PREFIX%\\share\\man\\man3\\{{ manpage }}.3\" exit /b 1  # [target_platform == \"win-arm64\"]\n    {% endfor %}\n    {% set exports = [ \"XauDisposeAuth\", \"XauFileName\", \"XauGetAuthByAddr\", \"XauGetBestAuthByAddr\", \"XauLockAuth\", \"XauReadAuth\", \"XauUnlockAuth\", \"XauWriteAuth\" ] %}\n    {% for export in exports %}\n    - dumpbin /exports \"%LIBRARY_BIN%\\Xau-6.dll\" | findstr /C:\"{{ export }}\"  # [target_platform == \"win-arm64\"]\n    {% endfor %}\n\nabout:\n  home: https://www.x.org/\n  dev_url: https://gitlab.freedesktop.org/xorg/lib/libxau\n  license: MIT\n  license_family: MIT\n  license_file: COPYING\n  summary: 'A simple X Windows authentication protocol.'\n\nextra:\n  recipe-maintainers:\n    - pkgw\n",
