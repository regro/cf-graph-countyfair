  "linux_64_meta_yaml": {
    "about": {
      "description": "multimark provides fast Python bindings to cmark-gfm, the C reference\nimplementation of CommonMark with GitHub Flavored Markdown extensions.\n\nIt exposes five output renderers — HTML, LaTeX, groff man, XML, and\nnormalized CommonMark — through a consistent, keyword-argument-based API.\nAll GFM extensions (tables, strikethrough, autolinks, task lists, tag\nfiltering) are supported, and raw HTML is safely stripped by default.",
      "dev_url": "https://github.com/posit-dev/multimark",
      "home": "https://github.com/posit-dev/multimark",
      "license": "MIT AND BSD-2-Clause",
      "license_family": "MIT AND BSD-2-Clause",
      "license_file": "LICENSE",
      "summary": "Python bindings to cmark-gfm — CommonMark parsing and rendering (HTML, LaTeX, man, XML, CommonMark)"
    },
    "build": {
      "number": "1",
      "script": {
        "content": "python -m pip install . -vv --no-deps --no-build-isolation",
        "env": {
          "SETUPTOOLS_SCM_PRETEND_VERSION": "0.3.2"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "rich-iannone",
        "timkpaine"
      ]
    },
    "outputs": [
      {
