  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\n# Adapted from https://github.com/conda-forge/vtk-feedstock/blob/main/recipe/meta.yaml\ncontext:\n  version: \"1.13.1\"\n  sha256: 02551d2412e15ef4ebe7f5177878e974bb6bc53ad27fdfde5e25897a9f2941f0\n  # PySide6 is the binding mne[full] installs; PyQt6 is opt-in via mne[full-pyqt6]\n  build_number: ${{ 200 if build_variant == \"pyside6\" else 100 }}\n\nrecipe:\n  name: mne-python\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/m/mne/mne-${{ version }}.tar.gz\n  sha256: ${{ sha256 }}\n\nbuild:\n  number: ${{ build_number }}\n\noutputs:\n  - package:\n      name: mne-base\n    build:\n      noarch: python\n      script: python -m pip install --no-deps . -vv\n      python:\n        entry_points:\n          - mne = mne.commands.utils:main\n\n    requirements:\n      build:\n        - if: build_platform != target_platform\n          then:\n            - python\n            - cross-python_${{ target_platform }}\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n        - hatch-vcs\n      run:\n        - python >=${{ python_min }}\n        - decorator >=5.1\n        - jinja2 >=3.1\n        - lazy_loader >=0.3\n        - matplotlib-base >=3.9\n        - numpy >=2.1,<3\n        - packaging\n        - pooch >=1.5\n        - scipy >=1.14\n        - tqdm >=4.66\n\n    tests:\n      - python:\n          imports:\n            - mne\n          pip_check: true\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n      - script:\n          - mne --version\n\n  - package:\n      name: mne\n    build:\n      noarch: python\n      # not `if osx`: inside a build string template the platform predicates are\n      # stuck on the machine running the render, so they ignore --build-platform\n      string: ${{ (build_platform | split(\"-\"))[0] }}_${{ build_variant }}_h${{ hash }}_${{ build_number }}\n\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n      run:\n        - python >=${{ python_min }}\n        # rattler's bound expressions are one segment shorter than conda-build's:\n        # this is the old max_pin=\"x.x.x.x\", i.e. >=1.13.0,<1.13.1.0a0\n        - ${{ pin_subpackage('mne-base', upper_bound=\"x.x.x\") }}\n        - if: osx\n          then:\n            - __osx\n            - pyobjc-framework-cocoa >=5.2.0  # for setting Dock icons etc\n        - antio >=0.5.0\n        - curryreader >=0.1.2\n        - darkdetect\n        - defusedxml\n        - dipy >=1.9\n        - edfio >=0.4.10\n        - eeglabio\n        - filelock >=3.18.0\n        - h5io >=0.2.4\n        - h5py >=2.4\n        - imageio >=2.6.1\n        - imageio-ffmpeg >=0.4.1\n        - ipyevents\n        - ipympl\n        - ipython >=2.0,!=8.7.0\n        - ipywidgets\n        - jamica >=0.3.0\n        - joblib >=0.8\n        - jupyter\n        - mffpy >=0.11.0\n        - mne-qt-browser >=0.6\n        - nest-asyncio2\n        - nibabel >=5.2\n        - nilearn >=0.10\n        - numba >=0.60\n        - openmeeg >=2.5.7\n        - pandas >=2.2,!=3.0.4\n        - pillow\n        - pyarrow\n        - pybv\n        - pymatreader\n        - pymef\n        - python-neo\n        - python-picard >=0.4\n        - pyvista >=0.44\n        - pyvistaqt >=0.11\n        - qdarkstyle >=3.2.2\n        - qtpy\n        - scikit-learn >=1.5\n        - sip\n        - snirf\n        - statsmodels >=0.6\n        - threadpoolctl\n        - traitlets\n        - trame <4\n        - trame-client <4\n        - trame-pyvista\n        - trame-server <4\n        - trame-vtk\n        - trame-vuetify !=3.2.3\n        - vtk >=9.2\n        - xlrd\n        - if: build_variant == \"pyqt6\"\n          then:\n            - pyqt6 !=6.6.0\n            - qt6-main !=6.6.0,!=6.7.0\n          else: pyside6 !=6.7.0,!=6.8.0,!=6.8.0.1,!=6.9.1\n\n    tests:\n      # One env rather than a python + script pair: solving this dependency set\n      # twice is what the version pins below are there to avoid\n      - script:\n          - pip check\n          - mne --version\n          - python -c \"import mne\"\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n            - pip\n            # Try to speed up the solver\n            - if: build_variant == \"pyqt6\"\n              then: pyqt6 =6.11.0\n              else: pyside6 =6.11.0\n            - qt6-main =6.11.0\n\nabout:\n  homepage: http://mne.tools\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: MNE-Python is a software for MEG and EEG data analysis.\n  description: |\n    The main package for MNE-Python is named `mne` in conda-forge and should\n    be suitable for most users. The conda recipe produces the following:\n\n    - `mne`: should be installed for full functionality including 3D visualization.\n    - `mne-base`: only pulls dependencies for basic functionality and 2D visualization.\n  documentation: http://mne.tools\n  repository: https://github.com/mne-tools/mne-python\n\nextra:\n  recipe-maintainers:\n    - larsoner\n    - christianbrodbeck\n    - hoechenberger\n",
