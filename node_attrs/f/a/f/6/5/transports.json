  "raw_meta_yaml": "context:\n  version: \"0.8.3\"\n\npackage:\n  name: transports\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/t/transports/transports-${{ version }}.tar.gz\n  sha256: 0ab95016cc1938bd2f52007fd0901cc93a0a9f25c48f28cd23df869edfa2c913\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    - if: unix\n      then:\n        - export PYO3_PYTHON=\"$PYTHON\"\n        - export RUSTFLAGS=\"\"\n      else:\n        - set \"PYO3_PYTHON=%PYTHON%\"\n        - set \"RUSTFLAGS=\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - hatchling\n        - hatch-js\n        - hatch-rs\n        - pnpm\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - rust-std-wasm32-unknown-unknown\n    - wasm-bindgen-cli ==0.2.126\n    - cargo-bundle-licenses\n    - if: linux\n      then:\n        - pkg-config\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-js\n    - hatch-rs\n    - pnpm\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n    - bigbrother >=0.1.4\n    - msgspec\n    - pydantic\n\ntests:\n  - python:\n      imports:\n        - transports\n      pip_check: true\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: unix\n          then: abi3audit $SP_DIR/transports/transports.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit %SP_DIR%/transports/transports.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Generic communication library\n  homepage: https://github.com/1kbgz/transports\n  repository: https://github.com/1kbgz/transports\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
