  "raw_meta_yaml": "context:\n  version: \"0.59.0\"\n\npackage:\n  name: flux-operator\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/controlplaneio-fluxcd/flux-operator/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 5eefde421c8c0fbb4f149356eeff731d1913c3b635fc4472c968a116d32ff5dc\n    target_directory: src\n  - url: https://raw.githubusercontent.com/in-toto/in-toto-golang/refs/heads/master/LICENSE\n    sha256: b5c26c8a2ad6dd7cac6646e470a32ee42d23c36124caac4e66c989b6545b2a44\n    file_name: LICENSE-in-toto-golang-1\n  - url: https://www.apache.org/licenses/LICENSE-2.0.txt\n    sha256: cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30\n    file_name: LICENSE-in-toto-golang-2\n  - url: https://raw.githubusercontent.com/cyberphone/json-canonicalization/refs/heads/master/LICENSE\n    sha256: 6821faaddedf2d78c95bb6d98b127e9e616097afd2f6bcc34389f000d13ab12d\n    file_name: LICENSE-json-canonicalization-1\n  - url: https://www.apache.org/licenses/LICENSE-2.0.txt\n    sha256: cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30\n    file_name: LICENSE-json-canonicalization-2\n  - url: https://raw.githubusercontent.com/in-toto/attestation/refs/heads/main/LICENSE\n    sha256: b3a6ac899861c2c28a1abd5c7ea8733fefaed6938d730e099c42671386032aeb\n    file_name: LICENSE-in-toto-attestation-1\n  - url: https://www.apache.org/licenses/LICENSE-2.0.txt\n    sha256: cfc7749b96f63bd31c3c42b5c471bf756814053e847c10f3eb003417bc523d30\n    file_name: LICENSE-in-toto-attestation-2\n\nbuild:\n  number: 1\n  skip:\n    - win # kustomize is not available on win-64\n  script:\n    - cd src\n    - go-licenses save ./cmd/cli --save_path ../library_licenses --ignore github.com/controlplaneio-fluxcd/flux-operator --ignore github.com/cyberphone/json-canonicalization --ignore github.com/in-toto/attestation --ignore github.com/in-toto/in-toto-golang\n    - if: unix\n      then:\n        - go build -v -o $PREFIX/bin/flux-operator -ldflags=\"-s -w -X main.VERSION=${{ version }}\" ./cmd/cli\n        - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n        - $PREFIX/bin/flux-operator completion zsh > $PREFIX/share/zsh/site-functions/_flux-operator\n        - $PREFIX/bin/flux-operator completion bash > $PREFIX/share/bash-completion/completions/flux-operator\n        - $PREFIX/bin/flux-operator completion fish > $PREFIX/share/fish/vendor_completions.d/flux-operator.fish\n      else: go build -v -o %LIBRARY_BIN%\\flux-operator.exe -ldflags=\"-s -w -X main.VERSION=${{ version }}\" ./cmd/cli\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script: flux-operator version --client\n  - package_contents:\n      bin:\n        - flux-operator\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/flux-operator\n            - share/fish/vendor_completions.d/flux-operator.fish\n            - share/zsh/site-functions/_flux-operator\n      strict: true\n\nabout:\n  homepage: https://fluxoperator.dev\n  summary: The Flux Operator CLI is a command line tool that allows you to manage the Flux Operator resources in your Kubernetes clusters.\n  description: |\n    The Flux Operator CLI is a command line tool that allows you to manage the\n    Flux Operator resources in your Kubernetes clusters. It provides a\n    convenient way to interact with the operator and perform various\n    operations.\n  license: AGPL-3.0-or-later\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-in-toto-golang-1\n    - LICENSE-in-toto-golang-2\n    - LICENSE-in-toto-attestation-1\n    - LICENSE-in-toto-attestation-2\n    - LICENSE-json-canonicalization-1\n    - LICENSE-json-canonicalization-2\n  documentation: https://fluxoperator.dev/docs/guides/cli/\n  repository: https://github.com/controlplaneio-fluxcd/flux-operator\n\nextra:\n  recipe-maintainers:\n    - aaronlionsheep\n",
