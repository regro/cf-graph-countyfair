  "raw_meta_yaml": "context:\n  name: \"medpython-etl\"\n  version: \"1.0.3\"\n  use_pypi: true\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  - if: use_pypi\n    then:\n      url: https://pypi.org/packages/source/${{ name[0] }}/${{ name | replace(\"-\", \"_\") }}/${{ name | replace(\"-\", \"_\") }}-${{ version }}.tar.gz\n      sha256: dab78595321e003dd6a9bca3bd783ecf2537af4ba78b9be14055aedf1fc095ad\n    else:\n      git: https://github.com/Medial-EarlySign/MR_Tools.git\n\nbuild:\n  noarch: python\n  number: 1\n  script:\n    - if: not use_pypi\n      then: cd RepoLoadUtils/common\n\n    - python -m pip install . --no-deps -vv\n\nrequirements:\n  host:\n    - python >=${{ python_min }}\n    - setuptools >=61.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - pandas\n    - numpy\n    - plotly\n\ntests:\n  - python:\n      imports:\n        - ETL_Infra\n      pip_check: true\n\nabout:\n  homepage: https://github.com/Medial-EarlySign/MR_Tools\n  documentation: https://medial-earlysign.github.io/MR_Wiki\n  repository: https://github.com/Medial-EarlySign/MR_Tools\n  summary: ETL logic and resources for MedPython\n  description: |\n    Medial EarlySign ETL Library \n  license: MIT\n  license_file:\n    - LICENCE\n\nextra:\n  recipe-maintainers:\n    - alonyado\n",
