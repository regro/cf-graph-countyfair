    "about": {
      "description": "EMD (Electron Microscopy Dataset) 1.0 is an HDF5 based file format\nwhich is designed to carry arbitrary data and metadata. emdfile is a\nPython package defining write and read functions and a set of classes\nwhich together interface between EMD 1.0 files and Python runtime\nobjects. The classes are designed to quickly build, save to, and read\nfrom filetree-like representations of data and metadata, and is built\non HDF5+h5py.",
      "dev_url": "https://github.com/py4dstem/emdfile",
      "doc_url": "https://emdatasets.com/format/",
      "home": "https://github.com/py4dstem/emdfile",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "LICENSE",
      "summary": "interfaces with EMD 1.0 files"
    },
    "build": {
      "noarch": "python",
      "number": "2",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "jan-janssen"
      ]
    },
