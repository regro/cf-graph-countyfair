  "raw_meta_yaml": "context:\n  version: \"1.0.4\"\n\npackage:\n  name: opfunu\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/o/opfunu/opfunu-${{ version }}.tar.gz\n  sha256: 1ae4e83f435c155d6a6ad28f6118d78df8c73d6827a59323167637d6a1d3bf07\n\nbuild:\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  number: 0\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.16.5\n    - matplotlib-base >=3.3.0\n    - pillow >=9.1.0\n    - requests >=2.27.0\n    # opfunu imports pkg_resources at runtime (cec_based/cec.py) for data-file\n    # lookups; setuptools removed pkg_resources in 82.0 (upstream's own\n    # deprecation warning recommends pinning <81)\n    - setuptools <81\n\ntests:\n  - python:\n      imports:\n        - opfunu\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/thieu1995/opfunu\n  summary: 'Opfunu: An Open-source Python Library for Optimization Benchmark Functions'\n  license: GPL-3.0-only\n  license_file: LICENSE\n  documentation: https://opfunu.readthedocs.io/\n  repository: https://github.com/thieu1995/opfunu\n\nextra:\n  recipe-maintainers:\n    - ChaiThere\n",
