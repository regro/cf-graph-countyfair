  "raw_meta_yaml": "context:\n  version: \"4.0.0\"\n\n# ==============================================================================\n# Source Configuration\n# ==============================================================================\nrecipe:\n  name: fastlowess-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/thisisamirv/lowess-project/archive/v${{ version }}.tar.gz\n  sha256: 56f277da4a7f5beeebe822f4827d33d35430087bc68b99e044dae76825d17c90\n\nbuild:\n  number: 0\n\n# ==============================================================================\n# Multi-Output Package Definitions (R, Python, C++)\n# ==============================================================================\noutputs:\n  # ----------------------------------------------------------------------------\n  # Output 1: R Package (r-rfastlowess)\n  # Windows: Conda's Rust host toolchain is MSVC by default, but Conda R on\n  # Windows is built with MinGW-w64 (GNU ABI). Makevars.win already targets\n  # x86_64-pc-windows-gnu, so we add the GNU std lib + m2w64 linker toolchain\n  # so cargo can cross-compile to match Conda R's ABI. LIBRARY_PATH points at\n  # m2w64-sysroot_win-64's nested CRT dir since m2w64-gcc's built-in search\n  # paths don't cover that layout.\n  # ----------------------------------------------------------------------------\n  - package:\n      name: r-rfastlowess\n    build:\n      dynamic_linking:\n        missing_dso_allowlist:\n          - \"*/libR.so\"\n      script:\n        - if: unix\n          then:\n            - cd bindings/r\n            - cd src && tar --extract --xz -f vendor.tar.xz && cd ..\n            - unset CARGO_BUILD_TARGET && R CMD INSTALL --build .\n        - if: win\n          then:\n            - cd bindings\\r\n            - cd src && xz -d -f vendor.tar.xz && tar --extract -f vendor.tar && cd ..\n            - set \"LIBRARY_PATH=%PREFIX%\\Library\\x86_64-w64-mingw32\\sysroot\\usr\\lib\" && set \"CARGO_BUILD_TARGET=\" && R CMD INSTALL --build .\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - if: win\n          then:\n            - rust-std-x86_64-pc-windows-gnu\n            - m2w64-toolchain\n            - m2w64-sysroot_win-64\n            - xz-tools\n            - make\n      host:\n        - r-base >=4.4\n      run:\n        - r-base >=4.4\n    tests:\n      - r:\n          libraries:\n            - rfastlowess\n\n  # ----------------------------------------------------------------------------\n  # Output 2: Python Package (fastlowess)\n  # ----------------------------------------------------------------------------\n  - package:\n      name: fastlowess\n    build:\n      skip:\n        - match(python, \"<3.8\")\n      script:\n        - if: unix\n          then:\n            - cd bindings/python\n            - $PYTHON -m pip install . -vv --no-build-isolation\n            - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n        - if: win\n          then:\n            - cd bindings\\python\n            - \"%PYTHON% -m pip install . -vv --no-build-isolation\"\n            - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n        - cargo-bundle-licenses\n      host:\n        - python\n        - pip\n        - maturin >=1.0,<2.0\n        - numpy >=1.20\n      run:\n        - python\n        - numpy >=1.20\n    tests:\n      - python:\n          imports:\n            - fastlowess\n          pip_check: true\n\n  # ----------------------------------------------------------------------------\n  # Output 3: C++ Library (libfastlowess)\n  # ----------------------------------------------------------------------------\n  - package:\n      name: libfastlowess\n    build:\n      script:\n        - cd bindings/cpp\n        - if: unix\n          then:\n            # Unset CARGO_BUILD_TARGET so cargo outputs to target/release instead of target/<triple>/release\n            - unset CARGO_BUILD_TARGET && cargo build --release\n        - if: win\n          then:\n            - set \"CARGO_BUILD_TARGET=\" && cargo build --release\n        - if: unix\n          then:\n            - mkdir -p $PREFIX/lib\n            - mkdir -p $PREFIX/include\n        - if: win\n          then:\n            - if not exist \"%PREFIX%\\Library\\lib\" mkdir \"%PREFIX%\\Library\\lib\"\n            - if not exist \"%PREFIX%\\Library\\bin\" mkdir \"%PREFIX%\\Library\\bin\"\n            - if not exist \"%PREFIX%\\Library\\include\" mkdir \"%PREFIX%\\Library\\include\"\n        - if: linux\n          then:\n            - find ../../target -name \"libfastlowess_cpp.so\" -type f -exec cp {} $PREFIX/lib/libfastlowess.so \\;\n        - if: osx\n          then:\n            - find ../../target -name \"libfastlowess_cpp.dylib\" -type f -exec cp {} $PREFIX/lib/libfastlowess.dylib \\;\n        - if: win\n          then:\n            - copy ..\\..\\target\\release\\fastlowess_cpp.dll \"%PREFIX%\\Library\\bin\\fastlowess.dll\"\n            - copy ..\\..\\target\\release\\fastlowess_cpp.dll.lib \"%PREFIX%\\Library\\lib\\fastlowess.lib\"\n        - if: unix\n          then:\n            - cp include/fastlowess.h $PREFIX/include/\n        - if: win\n          then:\n            - copy include\\fastlowess.h \"%PREFIX%\\Library\\include\\\"\n    requirements:\n      build:\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ${{ compiler('rust') }}\n    tests:\n      - package_contents:\n          include:\n            - fastlowess.h\n          lib:\n            - fastlowess\n\n# ==============================================================================\n# Package Metadata & Maintainers\n# ==============================================================================\nabout:\n  homepage: https://github.com/thisisamirv/lowess-project\n  license: MIT AND Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n  summary: High-performance LOWESS smoothing\n  description: The fastest, most robust, and most feature-complete language-agnostic LOWESS (Locally Weighted Scatterplot Smoothing) implementation.\n  documentation: https://lowess.readthedocs.io/\n  repository: https://github.com/thisisamirv/lowess-project\n\nextra:\n  recipe-maintainers:\n    - thisisamirv\n",
