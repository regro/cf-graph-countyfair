      "home": "http://luaposix.github.io/luaposix/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "This is a POSIX binding for LuaJIT, Lua 5.1, 5.2 and 5.3"
    },
    "build": {
      "number": "1"
    },
