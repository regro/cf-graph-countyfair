  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.1.10\"\n\npackage:\n  name: pyami-atlas\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyami-atlas/pyami_atlas-${{ version }}.tar.gz\n  sha256: 2c84630f74f71496b7fb872fb63458ee0ca8f4b23c4fadda79359695597b17c9\n  patches:\n    - patches/0001-drop-post-install-shared-scripts.patch\n    - patches/0002-guard-entrypoint-add-main.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    # upstream's pyproject.toml unconditionally declares an `ami_atlas`\n    # console script; strip it here since the intended entry point is\n    # `ami` (declared above), materialized via conda's own noarch\n    # entry-point mechanism, not pip's.\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n    - ${{ PYTHON }} -c \"import glob, os, sysconfig; [os.remove(f) for f in glob.glob(os.path.join(sysconfig.get_path('scripts'), 'ami_atlas*'))]\"\n  python:\n    entry_points:\n      - ami=pyAMI_atlas.__main__:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - pyami-core >=5.1.10\n\ntests:\n  - python:\n      imports:\n        - pyAMI_atlas\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - ami --help\n\nabout:\n  summary: Python ATLAS Metadata Interface (pyAMI) for ATLAS\n  homepage: https://atlas-ami.cern.ch/\n  repository: https://github.com/ami-team/pyAMI-atlas\n  documentation: https://atlas-ami.cern.ch/docs/pyAMI/\n  license: LGPL-3.0-or-later\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - kratsg\n",
