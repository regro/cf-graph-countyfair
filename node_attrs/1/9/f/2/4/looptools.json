  "linux_64_meta_yaml": {
    "about": {
      "description": "LoopTools is a package for evaluation of scalar and tensor one-loop integrals\nbased on the FF package by G.J. van Oldenborgh. It features an easy Fortran,\nC++, and Mathematica interface to the scalar one-loop functions of FF and\nin addition provides the 2-, 3-, and 4-point tensor coefficient functions.\n\nThe [publication](https://inspirehep.net/literature/474106) associated with\nLoopTools is: T. Hahn, M. Pérez-Victoria. Automated one-loop calculations\nin four and D dimensions, _Comput. Phys. Commun._ 118 (1999) 153.\nDOI: [10.1016/S0010-4655(98)00173-8](https://doi.org/10.1016/S0010-4655(98)00173-8)",
      "home": "https://feynarts.de/looptools/",
      "license": "GPL-3.0-only",
      "license_family": "GPL-3.0-only",
      "license_file": "COPYING",
      "summary": "LoopTools: A package for evaluation of scalar and tensor one-loop integrals"
    },
    "build": {
      "number": "5",
      "script": [
        "sed -i 's/mkdir /mkdir -p /g' makefile.in",
        "sed -i \"s|strip |$STRIP |g\" makefile.in",
        "sed -i 's/$LDFLAGS $CONF_LDFLAGS $FLDFLAGS/$LDFLAGS $CONF_LDFLAGS -lgfortran/g' configure",
        "cp $BUILD_PREFIX/share/gnuconfig/config.* .",
        "./configure --help",
        "./configure --prefix=$PREFIX",
        "make",
        "make install",
        "sed -i \"s|$BUILD_PREFIX|$PREFIX|g\" $PREFIX/bin/fcc",
        "mv $PREFIX/lib64/libooptools.a $PREFIX/lib/libooptools.a",
        "rm -rf build"
      ]
    },
    "extra": {
      "feedstock-name": "looptools",
      "recipe-maintainers": [
        "matthewfeickert"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "looptools-static",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "cxx_compiler_stub",
            "fortran_compiler_stub",
            "make",
            "pkg-config",
            "gnuconfig",
            "sed",
            "gawk"
          ],
          "host": [],
          "run": [
            "gxx"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "lt",
                "fcc",
                "f++"
              ],
              "files": [
                "lib/libooptools.a",
                "etc/conda/test-files/*"
              ],
              "include": [
                "looptools.h",
                "clooptools.h"
              ],
              "strict": true
            }
          },
          {
            "files": {
              "recipe": [
                "examples/"
              ]
            },
            "requirements": {
              "run": [
                "cxx_compiler_stub",
                "gfortran"
              ]
            },
            "script": [
              "lt 1",
              "fcc --help",
              "f++ --help",
              "cd examples",
              "$CXX example01.cpp -o example01 $CXXFLAGS $LDFLAGS -looptools -lgfortran",
              "./example01"
            ]
          }
        ],
        "version": "2.16"
      }
    ],
    "package": {
      "name": "looptools-static",
      "version": "2.16"
    },
