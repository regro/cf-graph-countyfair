  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: So3krates-torch\n  version: \"0.2.1\"\n\npackage:\n  name: ${{ name | lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/so3krates_torch-${{ version }}.tar.gz\n  sha256: ea51f6cfcc5471370474e964a50c12f4fd4c6871939ca90dd71952f0a37c76d4\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - torchkrates-jax2torch = so3krates_torch.cli.jax_to_torch:main\n      - torchkrates-torch2jax = so3krates_torch.cli.torch_to_jax:main\n      - torchkrates-eval = so3krates_torch.cli.run_eval:main\n      - torchkrates-metric = so3krates_torch.cli.run_metric:main\n      - torchkrates-train = so3krates_torch.cli.run_train:main\n      - torchkrates-preprocess = so3krates_torch.cli.run_preprocess:main\n      - torchkrates-create-lammps-model = so3krates_torch.cli.create_lammps_model:main\n      - torchkrates-merge = so3krates_torch.cli.run_merge:main\n      - torchkrates-tune-pme = so3krates_torch.cli.run_tune_pme:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - ase >=3.26.0\n    - h5py >=3.14.0\n    - matscipy >=0.8.0\n    - numpy >=1.26.4\n    - prettytable >=3.0.0\n    - pydantic >=2.0\n    - pyyaml >=6.0.2\n    - pytorch >=2.6.0\n    - torch-ema >=0.3.0\n    - pytorch_geometric ==2.7.0\n    - torchmetrics >=1.0.0\n    - jax\n    - flax\n    - ml-collections\n    - pandas >=1.5.0 \ntests:\n  - python:\n      imports:\n        - so3krates_torch\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python\n    script:\n      - torchkrates-jax2torch --help\n      - torchkrates-torch2jax --help\n      - torchkrates-eval --help\n      - torchkrates-metric --help\n      - tor