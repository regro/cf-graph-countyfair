  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: minizip\n  version: \"4.2.2\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/zlib-ng/minizip-ng/archive/${{ version }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 71af7b9799856d8b03619df3949e9c1be9703f8de0795af71399ba283cb27aac\n  patches:\n    - if: win\n      then: win_patch_output_name.patch\n    - if: win\n      then: gtest_shared_main.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - if: not win\n      then: make\n    - if: win\n      then: ninja\n    - if: not win\n      then: pkg-config\n  host:\n    - bzip2\n    - if: win\n      then: gtest\n    - if: not win\n      then: libiconv\n    - if: not win\n      then: openssl\n    - liblzma-devel\n    - zlib\n    - zstd\n  run_exports:\n    - ${{ pin_subpackage('minizip', upper_bound='x') }}\n  ignore_run_exports:\n    from_package:\n      - gtest\n\ntests:\n  - files:\n      recipe:\n        - if: target_platform == \"win-arm64\"\n          then: CMakeLists.txt\n        - if: target_platform == \"win-arm64\"\n          then: test_minizip.c\n    requirements:\n      run:\n        - if: target_platform == \"win-arm64\"\n          then: ${{ compiler('c') }}\n        - if: target_platform == \"win-arm64\"\n          then: cmake\n        - if: target_platform == \"win-arm64\"\n          then: zlib\n    script:\n      - if: unix\n        then: test -f $PREFIX/lib/libminizip${SHLIB_EXT}\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\libminizip.dll exit 1\n      - if: win\n        then: if not exist %LIBRARY_LIB%\\libminizip.lib exit 1\n      - if: target_platform == \"win-arm64\"\n        then: cmake -S . -B test-build -G \"NMake Makefiles\"\n      - if: target_platform == \"win-arm64\"\n        then: cmake --build test-build --config Release\n      - if: target_platform == \"win-arm64\"\n        then: test-build\\minizip_consumer.exe\n      - if: target_platform == \"win-arm64\"\n        then: dumpbin /headers test-build\\minizip_consumer.exe | findstr /c:\"AA64\"\n      - if: target_platform == \"win-arm64\"\n        then: dumpbin /headers %LIBRARY_BIN%\\libminizip.dll | findstr /c:\"AA64\"\n      - if: unix\n        then: test ! -f $PREFIX/lib/libminizip.a\n\nabout:\n  # http://zlib.net/zlib_license.html\n  license: Zlib\n  license_file: LICENSE\n  summary: minizip-ng is a zip manipulation library written in C.\n  description: |\n    minizip-ng is a zip manipulation library written in C\n  homepage: https://github.com/zlib-ng/minizip-ng\n  repository: https://github.com/zlib-ng/minizip-ng\n\nextra:\n  recipe-maintainers:\n    - akrherz\n",
