  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: mendeleev\n  version: 1.3.0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/${{ name }}-${{ version }}.tar.gz\n  sha256: 24e7bfd2981aedf5fe1ef7f0e4814d78005c47e57320a92097b3fd89313c21c5\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - element.py = mendeleev.cli:clielement\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - pyfiglet\n    - colorama\n    - sqlalchemy\n    - pandas\n    - numpy\n    - poetry\n    - setuptools <80\n  run:\n    - pint >=0.24.4,<0.25.0\n    - pydantic-core >=2.23.0,<3.0.0\n    - python >=${{ python_min }}\n    - pip\n    - numpy >=2.0.0,<3.0.0\n    - pandas >=2.1\n    - sqlalchemy >=1.4.0\n    - pyfiglet >=0.8.0.post1,<0.9.0\n    - colorama >=0.4.6,<0.5.0\n    - pygments >=2.11.2,<3.0.0\n    - deprecated >=1.2.14,<2.0.0\n    - pydantic >=2.12.0,<3.0.0\n    - setuptools <80\n\ntests:\n  - python:\n      imports:\n        - mendeleev\n      pip_check: true\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - element.py --help\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: A perdioc table of elements API and a database of atomic properties.\n  description: |\n    This package provides an API for accessing various properties\n    of elements from the periodic table of elements.\n  homepage: https://github.com/lmmentel/mendeleev\n  repository: https://github.com/lmmentel/mendeleev\n  documentation: http://mendeleev.readthedocs.org\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - lmmentel\n",
