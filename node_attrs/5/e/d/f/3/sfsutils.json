  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.0.1\"\n  python_min: \"3.11\"\n\npackage:\n  name: sfsutils\n  version: ${{ version }}\n\nsource:\n  # The PyPI distribution is 'sfsutils-popgen', as the bare 'sfsutils' name on PyPI belongs to an\n  # unrelated project. The import name and this conda package are 'sfsutils'.\n  url: https://pypi.org/packages/source/s/sfsutils-popgen/sfsutils_popgen-${{ version }}.tar.gz\n  sha256: 37ecc1a12f7fbc5a308e3282b1cbf345189fc136898215570d16b91b03b8e46b\n\nbuild:\n  noarch: python\n  number: 0\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - sfsutils = sfsutils.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - poetry-core\n  run:\n    - python >=${{ python_min }},<3.14\n    - matplotlib-base >=3.9,<4\n    - seaborn >=0.13.2,<1\n    - numpy >=1.24,<3\n    - pandas >=2.2.2,<3\n    - jsonpickle >=3,<4\n    - multiprocess >=0.70.12,<0.71\n    - tqdm >=4.60,<5\n    - biopython >=1.84,<2\n    - requests >=2.28\n    - scipy >=1.13,<2\n\ntests:\n  - python:\n      imports:\n        - sfsutils\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      pip_check: true\n  - script:\n      - sfsutils --help\n\nabout:\n  homepage: https://github.com/Sendrowski/SFSUtils\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  summary: SFS parsing with site filtration and annotation, from VCF, Zarr, or tree sequences\n  description: |\n    sfsutils parses site-frequency spectra (SFS) from VCF, VCF-Zarr, or tskit tree-sequence\n    input, with versatile stratification, ancestral-allele and site-degeneracy annotation, and\n    filtering. It also derives the joint SFS across several populations and the two-site SFS of\n    linked pairs of sites. The import name is `sfsutils`. On PyPI the distribution is named\n    `sfsutils-popgen`.\n  documentation: https://sfsutils.readthedocs.io/\n  repository: https://github.com/Sendrowski/SFSUtils\n\nextra:\n  recipe-maintainers:\n    - Sendrowski\n",
