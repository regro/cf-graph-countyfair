  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.37.4\"\n  extra_test_args:\n    # TODO: why does it fail?\n    - \"--deselect tests/test_freeimage.py::test_exr_write\"\n\npackage:\n  name: imageio\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/imageio/imageio-${{ version }}.tar.gz\n  sha256: e45cbc5e83502047fb138f7f585f7f105a136a57eea5f4b3cfc6ce1b52720bd3\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . --no-deps --ignore-installed -vvv\n  python:\n    entry_points:\n      - imageio_download_bin = imageio.__main__:download_bin_main\n      - imageio_remove_bin = imageio.__main__:remove_bin_main\n\nrequirements:\n  host:\n    - pip\n    - setuptools\n    - python ${{ python_min }}.*\n  run:\n    - python >=${{ python_min }}\n    - numpy\n    - pillow >=8.3.2\n\ntests:\n  - python:\n      imports:\n        - imageio\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - git\n        - pytest\n        - psutil\n        - tifffile\n        - gdal\n        - astropy-base\n        - freeimage\n        - fsspec\n        - requests\n        - av\n        - imageio-ffmpeg\n        # to load via libGL.so symlink\n        - libgl-devel\n    script:\n      - imageio_download_bin -h\n      - imageio_remove_bin -h\n      - pytest -sv tests/ ${{ extra_test_args|join(\" \") }}\n\nabout:\n  summary: A Python library for reading and writing image data\n  license: BSD-2-Clause\n  license_file: LICENSE\n  homepage: https://imageio.github.io\n  repository: https://github.com/imageio/imageio\n  documentation: https://imageio.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - anjos\n    - almarklein\n    - blink1073\n    - jni\n    - mgorny\n",
