  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.2.47\"\n\npackage:\n  name: opik\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/o/opik/opik-${{ version }}.tar.gz\n  sha256: a4aeb241a44ebf41f321407f40cb40377e5734402471cabe7d10d8cd2e79b25c\n  patches:\n    # opik's PyPI sdist is the comet-ml/opik monorepo sub-SDK; its setup.py reads\n    # ../../README.md (absent from the sdist). Patch long_description=\"\" so\n    # metadata generation succeeds. (Version comes from the VERSION env below.)\n    - patches/0001-neutralize-out-of-tree-readme.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: |\n    export VERSION=\"${PKG_VERSION}\"\n    ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - boto3-stubs >=1.34.110\n    - mypy-boto3-bedrock-runtime >=1.43.0,<1.44.0\n    - click\n    - httpx\n    - rapidfuzz >=3.0.0,<4.0.0\n    - litellm >=1.79.2,!=1.81.*,!=1.82.*,!=1.83.0,!=1.83.1,!=1.83.2,!=1.83.3,!=1.83.4,!=1.83.5,!=1.83.6\n    - openai\n    - pydantic-settings >=2.0.0,<3.0.0,!=2.9.0\n    - pydantic >=2.0.0,<3.0.0\n    - pytest\n    - rich\n    - sentry-sdk >=2.0.0\n    - tenacity\n    - tqdm\n    - uuid6\n    - jinja2\n    - watchfiles >=1.0.0,<2.0.0\n    - tree_sitter >=0.23,<1.0\n    - tree-sitter-javascript >=0.23,<1.0\n    - tree-sitter-typescript >=0.23,<1.0\n\ntests:\n  - python:\n      imports:\n        - opik\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://pypi.org/project/opik/\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Comet tool for logging and evaluating LLM traces\n  repository: https://github.com/comet-ml/opik\n  documentation: https://www.comet.com/docs/