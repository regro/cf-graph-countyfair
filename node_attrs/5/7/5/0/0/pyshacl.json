  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.40.1\"\n  summary: A Python validator for SHACL\n  cov_run: coverage run --branch --source=pyshacl --append\n\nrecipe:\n  name: pyshacl\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pyshacl/pyshacl-${{ version }}.tar.gz\n  sha256: 011e3cf1a68b31747cb762ba3d755ae1bdcc464c8fad0dc212a9adc550719552\n\nbuild:\n  number: 0\n  noarch: python\n\noutputs:\n  - package:\n      name: pyshacl\n    build:\n      script:\n        - ${{ PYTHON }} -m pip install . --no-deps -vv --no-build-isolation --disable-pip-version-check\n        - cd ${{ RECIPE_DIR }} && ${{ PYTHON }} clean_site_packages.py\n      python:\n        entry_points:\n          - pyshacl = pyshacl.cli:main\n          - pyshacl_rules = pyshacl.cli_rules:main\n          - pyshacl_server = pyshacl.http:cli\n          - pyshacl_validate = pyshacl.cli:main\n    requirements:\n      host:\n        - pip\n        - poetry-core >=2,<3\n        - python ${{ python_min }}.*\n      run:\n        - importlib-metadata >6\n        - owlrl >=7.6.2,<8\n        - packaging >=21.3\n        - prettytable >=3.7.0\n        - python >=${{ python_min }}\n        - rdflib-with-html >=7.3.0,<8.0\n    tests:\n      - python:\n          pip_check: true\n          python_version: ${{ python_min }}.*\n          imports:\n            - pyshacl\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - pyshacl --help\n\n  - package:\n      name: pyshacl-with-http\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"pyshacl\", exact=True) }}\n        - sanic >=22.12,<23\n        - sanic-cors 2.2.0.*\n        - sanic-ext >=23.3,<23.6\n    tests:\n      - python:\n          pip_check: true\n          python_version: ${{ python_min }}.*\n          imports:\n            - pyshacl\n            - pyshacl.sh_http\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - pyshacl --help\n    about:\n      summary: ${{ summary }} (with [http])\n\n  - package:\n      name: pyshacl-with-js\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"pyshacl\", exact=True) }}\n        - pyduktape2 >=0.5.0,<1\n    tests:\n      - python:\n          pip_check: true\n          python_version: ${{ python_min }}.*\n          imports:\n            - pyshacl\n            - pyshacl.extras.js.context\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - pyshacl --help\n    about:\n      summary: ${{ summary }} (with [js])\n\n  - package:\n      name: pyshacl-with-oxigraph\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"pyshacl\", exact=True) }}\n        - pyoxigraph >=0.5.6\n    tests:\n      - python:\n          pip_check: true\n          python_version: ${{ python_min }}.*\n          imports:\n            - pyshacl\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - pyshacl --help\n          - python -c \"from pyshacl.graph_abstraction import OxigraphDataGraph\"\n    about:\n      summary: ${{ summary }} (with [oxigraph])\n\n  - package:\n      name: pyshacl-with-all\n    build:\n      noarch: generic\n    requirements:\n      run:\n        - ${{ pin_subpackage(\"pyshacl-with-http\", exact=True) }}\n        - ${{ pin_subpackage(\"pyshacl-with-js\", exact=True) }}\n        - ${{ pin_subpackage(\"pyshacl-with-oxigraph\", exact=True) }}\n        - ${{ pin_subpackage(\"pyshacl\", exact=True) }}\n    tests:\n      - python:\n          pip_check: true\n          python_version: ${{ python_min }}.*\n          imports:\n            - pyshacl\n      - files:\n          source:\n            - test/\n        requirements:\n          run:\n            - python ${{ python_min }}.*\n            - pytest-cov\n        script:\n          - pyshacl --help\n          - ${{ cov_run }} -m pyshacl.cli --help\n          - ${{ cov_run }} -m pytest -vv --color=yes --tb=long -k \"not owl_imports\"\n          - coverage report --show-missing --skip-covered --fail-under=70\n    about:\n      summary: ${{ summary }} (with [all])\n\nabout:\n  license: Apache-2.0\n  license_file: LICENSE.txt\n  summary: ${{ summary }}\n  description: |\n    This is a pure Python module which allows for the validation of RDF graphs\n    against Shapes Constraint Language (SHACL) graphs. This module uses the\n    rdflib Python library for working with RDF and is dependent on the OWL-RL\n    Python module for OWL2 RL Profile-based expansion of data graphs.\n  homepage: https://pypi.org/project/pyshacl\n  repository: https://github.com/RDFLib/pySHACL\n\nextra:\n  feedstock-name: pyshacl\n  recipe-maintainers:\n    - bollwyvl\n    - satra\n",
