  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.12.0\"\n\npackage:\n  name: conda-pypi\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/c/conda-pypi/conda_pypi-${{ version }}.tar.gz\n  sha256: 8a07533ac47a15c4f3276da7e7d8cbc53a947aced76e1430964e2ec1b7b941a0\n\nbuild:\n  # can't be noarch because we can't place EXTERNALLY-MANAGED in stdlib (first level is site-packages)\n  # However, EXTERNALLY-MANAGED is temporarily disabled, so go back to noarch\n  noarch: python\n  number: 0\n  script:\n    - if: unix\n      then: set -x\n    - if: win\n      then: \"@ECHO ON\"\n    - ${{ PYTHON }} -m pip install . --no-deps --no-build-isolation -vv\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling >=1.26\n    - hatch-vcs >=0.2.0\n  run:\n    - python >=${{ python_min }}\n    - packaging\n    - unearth\n    - python-build\n    - python-installer >=1.0\n    - platformdirs\n    - conda-index >=0.12.0\n    - conda-package-streaming >=0.11\n  run_constraints:\n    # This is technically a `run` dependency (we do import it), but\n    # conda already depends on conda-pypi, so it creates a\n    # dependency cycle that complicates migrations\n    - conda >=26.1.0\n\ntests:\n  - python:\n      imports:\n        - conda_pypi\n        - conda_pypi.main\n      # pip check runs in the script test below, where ruamel.yaml can be\n      # pinned; python tests do not support extra requirements.\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        # conda 26.7.2 pip metadata requires ruamel-yaml <0.19, but the\n        # conda-forge conda package allows <0.20, so the solver can install\n        # ruamel.yaml 0.19.x and break pip check. Remove once conda's pip\n        # metadata allows ruamel.yaml 0.19.\n        - ruamel.yaml >=0.11.14,<0.19\n    script:\n      - pip check\n      - python -m conda pypi --help\n\nabout:\n  license: MIT\n  license_file: LICENSE\n  summary: Better PyPI interoperability for the conda ecosystem\n  homepage: https://github.com/conda/conda-pypi\n  repository: https://github.com/conda/conda-pypi\n  documentation: https://conda.github.io/conda-pypi\n\nextra:\n  recipe-maintainers:\n    - danyeaw\n    - ryanskeith\n    - jaimergp\n    - jezdez\n",
