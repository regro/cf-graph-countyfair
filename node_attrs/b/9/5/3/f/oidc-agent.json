            "make",
            "pkg-config",
            "sed",
            "help2man"
          ],
          "host": [
            "libsodium",
            "libcurl",
            "libmicrohttpd",
            "libqrencode"
          ],
          "run": [
            "jq"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "oidc-agent",
                "oidc-agent-service",
                "oidc-add",
                "oidc-gen",
                "oidc-keychain",
                "oidc-token",
                "oidc-tokensh"
              ]
            }
          },
          {
            "script": [
              "oidc-agent --version",
              "oidc-gen --help",
              "oidc-add --help",
              "oidc-token --help",
              "test -f \"${PREFIX}/lib/liboidc-agent.so.5\"",
              "grep -qF 'OIDC_AGENT=\"${OIDC_AGENT:-'\"${PREFIX}\"'/bin/oidc-agent}\"' \"${PREFIX}/bin/oidc-agent-service\"",
              "unset OIDC_AGENT && export TMPDIR=\"$(mktemp -d /tmp/oidc.XXXXXX)\" && eval \"$(oidc-agent-service start)\" && oidc-agent --status && oidc-agent-service stop"
            ]
          }
        ],
        "version": "5.3.8"
      }
    ],
