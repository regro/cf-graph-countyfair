  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"5.3.8\"\n\npackage:\n  name: oidc-agent\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/indigo-dc/oidc-agent/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 96d35f2abe3ccbdce8d1a8b4bb1dcb381c0d6c0ee8a51d4ee3d918323b5b4ef7\n  patches:\n    - 0001-Disable-oidc-prompt.patch\n\nbuild:\n  number: 0\n  # Upstream only builds the CLI tools on Windows against the MSYS2 POSIX\n  # runtime and recommends WSL instead, where the linux-64 package works.\n  skip:\n    - win\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - make\n    - pkg-config\n    - sed\n    - help2man\n  host:\n    - libsodium\n    - libcurl\n    - libmicrohttpd\n    - libqrencode\n    - if: osx\n      then: argp-standalone\n  run:\n    # used by oidc-agent-service\n    - jq\n\ntests:\n  - package_contents:\n      bin:\n        - oidc-agent\n        - oidc-agent-service\n        - oidc-add\n        - oidc-gen\n        - oidc-keychain\n        - oidc-token\n        - oidc-tokensh\n  - script:\n      - oidc-agent --version\n      - oidc-gen --help\n      - oidc-add --help\n      - oidc-token --help\n      - if: linux\n        then: test -f \"${PREFIX}/lib/liboidc-agent.so.5\"\n      - if: osx\n        then: test -f \"${PREFIX}/lib/liboidc-agent.5.dylib\"\n      # oidc-agent-service must start the oidc-agent of this environment\n      - grep -qF 'OIDC_AGENT=\"${OIDC_AGENT:-'\"${PREFIX}\"'/bin/oidc-agent}\"' \"${PREFIX}/bin/oidc-agent-service\"\n      - unset OIDC_AGENT && export TMPDIR=\"$(mktemp -d /tmp/oidc.XXXXXX)\" && eval \"$(oidc-agent-service start)\" && oidc-agent --status && oidc-agent-service stop\n\nabout:\n  homepage: https://indigo-dc.github.io/oidc-agent/\n  repository: https://github.com/indigo-dc/oidc-agent\n  documentation: https://indigo-dc.github.io/oidc-agent/\n  license: MIT\n  license_file: LICENSE\n  summary: Tools to manage OpenID Connect tokens from the command line\n\nextra:\n  recipe-maintainers:\n    - chrisburr\n",
