  "raw_meta_yaml": "context:\n  version: \"0.1.8\"\n\npackage:\n  name: rustfits\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/esheldon/rustfits/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 3e1750f3e39c3625392781c4178a948c31f3eec88daf7cdfa5917ee58ca5c279\n\nbuild:\n  number: 0\n  python:\n    version_independent: true\n  skip:\n    - is_abi3 and not is_python_min\n  script:\n    - if: unix\n      then:\n        - maturin build -v -j ${CPU_COUNT} --release --strip --manylinux off --interpreter=${PYTHON} --features pyo3/abi3-py${{ python_min|replace(\".\", \"\") }}\n        - ${PYTHON} -m pip install ${SRC_DIR}/target/wheels/rustfits*.whl --no-deps -vv --no-build-isolation\n      else:\n        - maturin build -v -j %CPU_COUNT% --release --strip --manylinux off --interpreter=%PYTHON% --features pyo3/abi3-py${{ python_min|replace(\".\", \"\") }}\n    # ^add this flag for cross-compile later maybe? -Zfeatures=itarget\n        - cd target/wheels\n        - chcp 65001\n        - set PYTHONUTF8=1\n        - set PYTHONIOENCODING=\"UTF-8\"\n        - set TMPDIR=tmpbuild_%PY_VER%\n        - FOR %%w in (*.whl) DO %PYTHON% -m pip install %%w --no-clean --no-deps -vv --no-build-isolation\n        - cd ..\n        - cd ..\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - python-abi3\n    - pip\n    - maturin >=1.7,<2.0a0\n  run:\n    - python\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - rustfits\n        - rustfits._rust\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - if: unix\n        then:\n          - abi3audit ${SP_DIR}/rustfits/*.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else:\n          - abi3audit %SP_DIR%/rustfits/_rust.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n    requirements:\n      run:\n        - abi3audit\n  # we run tests since they are fast...\n  - if: unix and target_platform != \"linux-aarch64\"\n    then:\n      script:\n        - pytest -vv tests\n      files:\n        source:\n          - tests/\n      requirements:\n        run:\n          - pytest\n          - astropy\n          - fitsio\n          - aioftp\n\nabout:\n  homepage: https://github.com/esheldon/rustfits\n  summary: A python FITS library with extension in rust\n  license: MIT OR Apache-2.0\n  license_file:\n    - LICENSE-MIT\n    - LICENSE-APACHE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - beckermr\n    - esheldon\n",
