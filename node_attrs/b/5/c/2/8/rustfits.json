  "linux_64_meta_yaml": {
    "about": {
      "home": "https://github.com/esheldon/rustfits",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-MIT",
      "summary": "A python FITS library with extension in rust"
    },
    "build": {
      "number": "0",
      "script": [
        "maturin build -v -j ${CPU_COUNT} --release --strip --manylinux off --interpreter=${PYTHON} --features pyo3/abi3-py${{ python_min|replace(\".\", \"\") }}",
        "${PYTHON} -m pip install ${SRC_DIR}/target/wheels/rustfits*.whl --no-deps -vv --no-build-isolation",
        "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "beckermr",
        "esheldon"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "rustfits",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses"
          ],
          "host": [
            "python",
            "python-abi3",
            "pip",
            "maturin >=1.7,<2.0a0"
          ],
          "run": [
            "python",
            "numpy"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "rustfits",
                "rustfits._rust"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": "abi3audit ${SP_DIR}/rustfits/*.so -s -v --assume-minimum-abi3 ${{ python_min }}"
          },
          {
            "files": {
              "source": [
                "tests/"
              ]
            },
            "requirements": {
              "run": [
                "pytest",
                "astropy",
                "fitsio",
                "aioftp"
              ]
            },
            "script": "pytest -vv tests"
          }
        ],
        "version": "0.1.8"
      }
    ],
