  "linux_64_meta_yaml": {
    "about": {
      "description": "`merman-cli` is a performant browserless Mermaid command-line renderer in Rust for SVG, PNG, JPG, PDF, and\nASCII/Unicode text output. The top-level command follows common `mmdc` workflows, while developer subcommands\nexpose merman's parse, layout, and render internals.",
      "dev_url": "https://github.com/Latias94/merman",
      "home": "https://github.com/Latias94/merman",
      "license": "MIT OR Apache-2.0",
      "license_family": "MIT OR Apache-2.0",
      "license_file": "LICENSE-MIT",
      "summary": "Mermaid.js, but headless, in Rust. Parse, layout and render diagrams to SVG/PNG/JPG/PDF/ASCII/Unicode."
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "cd crates/merman-cli",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "merman-cli",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "merman-cli --help",
              "merman-cli --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "merman-cli"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.7.0"
      }
    ],
    "package": {
      "name": "merman-cli",
