  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: '3.12'\n  version: 2026.9.9\n\npackage:\n  name: tifffile\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/t/tifffile/tifffile-${{ version }}.tar.gz\n  sha256: 5e5a0dfa16e6376bf062bc46e21b896fbfe895fcb47559af9c64b9b2d77bb4a0\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - tifffile = tifffile:main\n      - tiffcomment = tifffile.tiffcomment:main\n      - tiff2fsspec = tifffile.tiff2fsspec:main\n      - lsm2bin = tifffile.lsm2bin:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numpy >=2.1\n  run_constraints:\n    - matplotlib-base >=3.3\n    # zarr3 will now raise a value error\n    # those that need tifffile+zarr3 can\n    # install the corrrect combination\n    # https://github.com/cgohlke/tifffile/pull/296#issuecomment-2869132445\n    # - zarr <3\n\ntests:\n  - python:\n      imports:\n        - tifffile\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - tifffile --help\n      - tiffcomment --help\n      - tiff2fsspec --help\n      - lsm2bin --help\n\nabout:\n  summary: Read and write TIFF files\n  license: BSD-3-Clause\n  license_file: LICENSE\n  homepage: https://www.cgohlke.com\n  documentation: https://www.cgohlke.com/docs/tifffile/\n\nextra:\n  recipe-maintainers:\n    - blink1073\n    - ericpre\n    - jakirkham\n    - mrakitin\n    - ocefpaf\n    - stuarteberg\n",
