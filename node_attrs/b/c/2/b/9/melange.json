  "linux_64_meta_yaml": {
    "about": {
      "description": "melange is an OpenFGA-to-PostgreSQL authorization compiler. It transforms\nOpenFGA `.fga` authorization schemas into specialized PL/pgSQL functions, so\nthat fine-grained access control checks run directly in PostgreSQL as simple\nSQL function calls over a `melange_tuples` view you define on your domain\ntables. This removes the need for a separate authorization service or for\nsynchronizing relationship tuples, and keeps permission checks transactional\nand language agnostic.",
      "dev_url": "https://github.com/pthm/melange",
      "doc_url": "https://melange.sh/docs/",
      "home": "https://melange.sh/",
      "license": "MIT",
      "license_family": "MIT",
