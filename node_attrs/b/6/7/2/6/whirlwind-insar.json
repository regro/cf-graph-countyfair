  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.10.0\"\n\npackage:\n  name: whirlwind-insar\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/w/whirlwind-insar/whirlwind_insar-${{ version }}.tar.gz\n  sha256: 40c890a0235774b451abd82baf070947118314c754db9747bd842783f32b4e6b\n\nbuild:\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . --no-deps --no-build-isolation --disable-pip-version-check\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n  python:\n    # Single abi3 build (PyO3 abi3-py311): build once against python_min and run\n    # on any later CPython, instead of one build per python minor version.\n    version_independent: true\n    entry_points:\n      - whirlwind = whirlwind._climain:main\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - maturin >=1,<2\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-bundle-licenses\n  host:\n    - python ${{ python_min }}.*\n    - python-abi3 ${{ python_min }}.*\n    - pip\n    - maturin >=1,<2\n  run:\n    - python >=${{ python_min }}\n    - numpy >=1.21\n\ntests:\n  # version_independent builds once against python_min but installs on every\n  # later CPython, so exercise both ends of that range.\n  - python:\n      imports:\n        - whirlwind\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - whirlwind --help\n  # Catch any non-abi3 CPython API in the extension module: it is built once\n  # and loaded on every later Python, where a violation would only show up at\n  # runtime.\n  - requirements:\n      run:\n        - abi3audit\n        - python ${{ python_min }}.*\n    script:\n      - if: unix\n        then: abi3audit $SP_DIR/whirlwind/_native.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n        else: abi3audit %SP_DIR%/whirlwind/_native.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  summary: Fast Rust-backed 2D phase unwrapper for InSAR\n  license: BSD-3-Clause OR Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/scottstanie/whirlwind-insar\n  repository: https://github.com/scottstanie/whirlwind-insar\n  documentation: https://github.com/scottstanie/whirlwind-insar/tree/main/docs\n\nextra:\n  recipe-maintainers:\n    - scottstanie\n",
