      "description": "`sphinx-typst-math` is a Sphinx HTML math renderer for **native Typst math\nsyntax**. It sends each equation to the official Typst compiler through\n[`typst-py`](https://github.com/messense/typst-py), extracts the compiler's\nMathML, and places that MathML directly into Sphinx's HTML.",
      "dev_url": "https://github.com/munechika-koyo/sphinx-typst-math",
      "doc_url": "https://munechika-koyo.github.io/sphinx-typst-math/",
      "home": "https://github.com/munechika-koyo/sphinx-typst-math",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Render native Typst math as MathML in Sphinx HTML builds"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": {
        "content": "${{ PYTHON }} -m pip install . -vv",
        "env": {
          "SETUPTOOLS_SCM_PRETEND_VERSION": "0.1.0"
        }
      }
    },
