  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"2.3.0\"\n\npackage:\n  name: astrapy\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/a/astrapy/astrapy-${{ version }}.tar.gz\n  sha256: b62f02a0b5f4e2475dbd2cc097f5ae23f59193fe118f46d37a98dad3167b71c1\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - astrapy-repl = astrapy.repl:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - deprecation >=2.1.0,<2.2.dev0\n    - httpx >=0.25.2,<1\n    - h2 >=3,<5\n    - h11 >=0.16.0\n    - ipython >=8.0.0\n    - pymongo >=3\n    - toml >=0.10.2,<1.0.0\n    - typing_extensions >=4.0\n    - uuid6 >=2024.1.12\n\ntests:\n  - python:\n      imports:\n        - astrapy\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - astrapy-repl --help\n\nabout:\n  homepage: https://pypi.org/project/astrapy/\n  license: Apache-2.0\n  license_file: LICENSE.md\n  summary: A Python client for the Data API on DataStax Astra DB\n  repository: https://github.com/datastax/astrapy\n  documentation: https://docs.datastax.com/en/astra-db-serverless/api-reference/dataapiclient.html\n  description: |\n    AstraPy is a Pythonic client for the Data API on DataStax Astra DB,\n    providing both synchronous and asynchronous interfaces to work with\n    databases, collections, tables, documents, and vector search.\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
