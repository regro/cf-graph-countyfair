  "raw_meta_yaml": "{% set name = \"kraken\" %}\n{% set version = \"7.1.1\" %}\n\npackage:\n  name: \"kraken-ocr\"\n  version: \"{{ version }}\"\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/{{ name[0] }}/{{ name }}/{{ name }}-{{ version }}.tar.gz\n  sha256: 489079856742ad308a069321a62f89c4eecb008ef4529798a19ff8799ae875d5\n\nbuild:\n  # coremltools is unavailable on win-64 but required by kraken;\n  # Kraken 7.1.1 requires Python <3.14\n  skip: true  # [win or py >= 314]\n  script: {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  number: 0\n\nrequirements:\n  host:\n    - python\n    - hatchling\n    - versioningit\n    - pip\n  run:\n    - python\n    - jsonschema\n    - lxml\n    - requests\n    - click >=8.1,<8.3\n    - numpy\n    - pillow >=9.2.0\n    - regex\n    - scipy ==1.15.2\n    - protobuf >=3.0.0\n    - coremltools >=9.0,<10.dev0\n    - jinja2 >=3.1.6,<3.2.dev0\n    - torchvision >=0.5.0\n    - pytorch >=2.9.0,<=2.12\n    - scikit-learn >=1.7.2,<1.8.dev0\n    - scikit-image >=0.25.2,<0.26.dev0\n    - shapely >=2.1.2,<2.2.dev0\n    - pyarrow\n    - htrmopo >=0.5,>=0.5,<1.dev0\n    - lightning ==2.6.1\n    - torchmetrics >=1.1.0\n    - threadpoolctl >=3.6.0,<3.7.dev0\n    - platformdirs\n    - rich <14.1.0\n    - safetensors >=0.7.0,<0.8.dev0\n    - iso639-lang\n    - packaging\n    - pyvips\n\ntest:\n  imports:\n    - kraken\n  commands:\n    #- pip check # fails because kraken expects scipy >=1.15.3,<1.16.dev0 but conda-forge only provides 1.15.2\n    - kraken --help\n    - python -c \"import pyvips\" # Check that the Kraken PDF dependency is loadable (pyvips needs libvips.so)\n    - ketos --help\n  requires:\n    #- pip # pip check is currently disabled\n    - python\n\nabout:\n  home: https://kraken.re\n  summary: OCR/HTR engine for all the languages\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - IvoLeist\n",
