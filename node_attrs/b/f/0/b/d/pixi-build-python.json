  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\ncontext:\n  name: pixi-build-python\n  crate_name: pixi_build_python\n  version: \"0.8.6\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/prefix-dev/pixi/archive/refs/tags/${{ name }}-v${{ \n    version }}.tar.gz\n  sha256: 83e8810dfa0f310cf486cd2d4c13df7a38d4299678b09a8fb05486d367417057\n\nbuild:\n  number: 0\n  script:\n    env:\n      # Use cmake to build aws-lc-sys, because conda's CFLAGS inject -O2 which\n      # overrides the -O0 required by jitterentropy-base.c, causing a build failure.\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n    - if: osx and x86_64\n      then:\n          # use the default linker for osx-64 as we are hitting a bug with the conda-forge linker\n          # https://github.com/rust-lang/rust/issues/140686\n      - unset CARGO_TARGET_X86_64_APPLE_DARWIN_LINKER\n\n    - if: unix\n      then:\n      - export OPENSSL_DIR=\"$PREFIX\"\n    - if: linux\n      then:\n        # aws-lc-sys' cmake builder defaults to the \"Unix Makefiles\" generator, but the\n        # Linux build environment has no make; use the ninja generator instead.\n      - export CMAKE_GENERATOR=Ninja\n    - if: win\n      then:\n      - set CARGO_HOME=C:\\.cargo\n      - md %CARGO_HOME%\n    - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} \n      --path crates/${{ crate_name }} --no-default-features --features \n      native-tls\n    - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n  files:\n  - bin/${{ name }}\n  - bin/${{ name }}.exe\n\nrequirements:\n  build:\n  - ${{ compiler(\"rust\") }}\n  - ${{ stdlib(\"c\") }}\n  # for building aws-lc-sys\n  - cmake\n  - ninja\n  - cargo-bundle-licenses\n  - cargo-auditable\n  host:\n  - if: target_platform != 'win-arm64'\n    then: pkg-config\n  - if: unix\n    then: openssl\n  run:\n  - pixi-build-api-version >=7,<8\n\ntests:\n- script:\n  - if: build_platform == target_platform\n    then: ${{ name }} --help\n- package_contents:\n    bin:\n    - ${{ name }}\n\nabout:\n  homepage: https://github.com/prefix-dev/pixi\n  summary: A pixi build backend to build Python packages.\n  description: |\n    This package provides a build backend for pixi that allows building Python packages.\n  license: BSD-3-Clause\n  license_file:\n  - LICENSE\n  - THIRDPARTY.yml\n  documentation: \n    https://pixi.prefix.dev/latest/build/backends/pixi-build-python/\n  repository: https://github.com/prefix-dev/pixi\n\nextra:\n  recipe-maintainers:\n  - Hofer-Julian\n  - baszalmstra\n  - ruben-arts\n",
