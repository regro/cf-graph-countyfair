  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.1.0\"\n  python_min: \"3.10\"\n\npackage:\n  name: bpcmp\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/b/bpcmp/bpcmp-${{ version }}.tar.gz\n  sha256: 887b82dc2d6d982ac38d36f295c5c5ed2d2d28cf6f3461ca56934b8fb072ffd6\n  patches:\n    - remove-setuptools-scm.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - bpcmp = bpcmp.bpcmp:main\n      - bpdump = bpcmp.bpdump:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61.0\n    - setuptools-scm >=6.2\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - numpy\n    - adios2\n    - termcolor\n\ntests:\n  - python:\n      imports:\n        - bpcmp\n      # adios2 does not install Python dist-info metadata, so 'pip check'\n      # views adios2 as missing even though 'import adios2' works.\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - bpcmp --help\n      - bpdump --help\n\nabout:\n  summary: Comparison tool for ADIOS2 bp output\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  homepage: https://github.com/PrincetonUniversity/bpcmp\n  repository: https://github.com/PrincetonUniversity/bpcmp\n\nextra:\n  recipe-maintainers:\n    - jsachdev\n    - matthewfeickert\n",
