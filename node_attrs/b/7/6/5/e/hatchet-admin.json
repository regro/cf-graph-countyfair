  "raw_meta_yaml": "context:\n  version: \"0.105.22\"\n\npackage:\n  name: hatchet-admin\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/hatchet-dev/hatchet/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 1f5abe2c27476b65c23eabd3f6aaf7ec2336446b4775ef9b1eea21d31c8307ba\n    target_directory: src\n  - url: https://raw.githubusercontent.com/mattn/go-localereader/6bae6c923850ab5e0da9f36f69811ffe17064228/LICENSE\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n    file_name: LICENSE-go-localereader\n\nbuild:\n  number: 0\n  script:\n    - cd src/cmd/hatchet-admin\n    - go-licenses save . --save_path ../../../library_licenses --ignore github.com/mattn/go-localereader\n    - if: unix\n      then: go build -v -o $PREFIX/bin/hatchet-admin -ldflags=\"-s -w\"\n      else: go build -v -o %LIBRARY_BIN%\\hatchet-admin.exe -ldflags=\"-s -w\"\n\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script:\n      - hatchet-admin --help\n      - hatchet-admin --version\n  - package_contents:\n      bin:\n        - hatchet-admin\n      strict: true\n\nabout:\n  homepage: https://hatchet.run\n  summary: Hatchet Admin - administrative CLI for Hatchet workflow orchestration\n  description: |\n    Hatchet is an orchestration engine for background tasks, AI agents, and\n    durable workflows. This package provides the hatchet-admin CLI for\n    performing administrative tasks on a Hatchet instance.\n  license: MIT\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n    - LICENSE-go-localereader\n  documentation: https://docs.hatchet.run\n  repository: https://github.com/hatchet-dev/hatchet\n\nextra:\n  recipe-maintainers:\n    - xhochy\n",
