  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.2.2\"\n\npackage:\n  name: tomlq\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/cryptaliagy/tomlq/archive/${{ version }}.tar.gz\n  sha256: 2a9cff8827dd0d3213470e9a333645492c4d8fe0a733439cc42db4c7b1fc6292\n\nbuild:\n  number: 0\n  script:\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - if: unix\n      then: cargo auditable install --locked --path . --root ${{ PREFIX }} --no-track --features bin,json\n      else: cargo auditable install --locked --path . --root %PREFIX% --no-track --features bin,json\n    # Pixi: prevent CONDA_PREFIX from leaking into tq command\n    - if: win\n      then:\n        - 'mkdir \"%PREFIX%\\etc\\pixi\\tomlq\"'\n        - 'type nul > \"%PREFIX%\\etc\\pixi\\tomlq\\global-ignore-conda-prefix\"'\n      else:\n        - mkdir -p ${PREFIX}/etc/pixi/tomlq\n        - touch ${PREFIX}/etc/pixi/tomlq/global-ignore-conda-prefix\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - package_contents:\n      strict: true\n      bin:\n        - tq\n      files:\n        - etc/pixi/tomlq/global-ignore-conda-prefix\n  - script:\n      - tq --version\n      - tq --help\n\nabout:\n  summary: A tool for getting data from TOML files on the command line\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/cryptaliagy/tomlq\n  repository: https://github.com/cryptaliagy/tomlq\n  description: |\n    tq (tomlq) is a command-line tool for querying and extracting data from\n    TOML files, similar to jq for JSON.\n\nextra:\n  recipe-maintainers:\n    - trim21\n",
