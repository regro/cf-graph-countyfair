  "raw_meta_yaml": "context:\n  version: \"0.2.1\"\n\npackage:\n  name: git-xet\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/huggingface/xet-core/archive/refs/tags/git-xet-v${{ version }}.tar.gz\n  sha256: df2a90a8266918bf2aba35e22276c745d11bd9c39850410f78ebbf2b50d0c87c\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path git_xet\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path git_xet\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - pkgconf\n    - zlib\n    - if: win\n      then: nasm\n  host:\n    - libgit2\n    - openssl\n  run:\n    - git-lfs\n\ntests:\n  - package_contents:\n      bin:\n        - git-xet\n    strict: true\n  - script:\n      - git xet --version\n      - git init test-repo\n      - cd test-repo\n      - git xet track \"*.bin\"\n      # \"git xet track\" delegates to \"git lfs track\", which registers the\n      # pattern in .gitattributes.\n      - if: unix\n        then: grep -qF \"*.bin filter=lfs diff=lfs merge=lfs -text\" .gitattributes\n        else: findstr /c:\"*.bin filter=lfs diff=lfs merge=lfs -text\" .gitattributes\n\nabout:\n  homepage: https://github.com/huggingface/xet-core\n  summary: A Git LFS custom transfer agent for the Xet protocol\n  description: |\n    Git-Xet is a Git LFS custom transfer agent that implements upload and\n    download of files using the Xet protocol. Install git-xet, follow your\n    regular workflow to `git lfs track ...`, `git add ...`, `git commit ...`\n    and `git push`, and your files are uploaded to Hugging Face repos using\n    the Xet protocol. Enjoy the dedupe!\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/huggingface/xet-core\n\nextra:\n  recipe-maintainers:\n    - ruben-arts\n",
