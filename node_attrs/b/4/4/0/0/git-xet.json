  "linux_64_meta_yaml": {
    "about": {
      "description": "Git-Xet is a Git LFS custom transfer agent that implements upload and\ndownload of files using the Xet protocol. Install git-xet, follow your\nregular workflow to `git lfs track ...`, `git add ...`, `git commit ...`\nand `git push`, and your files are uploaded to Hugging Face repos using\nthe Xet protocol. Enjoy the dedupe!",
      "dev_url": "https://github.com/huggingface/xet-core",
      "home": "https://github.com/huggingface/xet-core",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "A Git LFS custom transfer agent for the Xet protocol"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path git_xet",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "ruben-arts"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "git-xet",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-bundle-licenses",
            "cargo-auditable",
            "pkgconf",
            "zlib"
          ],
          "host": [
            "libgit2",
            "openssl"
          ],
          "run": [
            "git-lfs"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "git-xet"
              ]
            }
          },
          {
            "script": [
              "git xet --version",
              "git init test-repo",
              "cd test-repo",
              "git xet track \"*.bin\"",
              "grep -qF \"*.bin filter=lfs diff=lfs merge=lfs -text\" .gitattributes"
            ]
          }
        ],
        "version": "0.2.1"
      }
    ],
