  "raw_meta_yaml": "context:\n  version: \"0.1.2\"\n  python_min: \"3.11\"\n\npackage:\n  name: nepenthe\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/n/nepenthe/nepenthe-${{ version }}.tar.gz\n  sha256: 79b7e3800cda97c363eea9cf092a4da1c3df047aad642762570fdd883bbbbf41\n\nbuild:\n  number: 2\n  python:\n    version_independent: true\n  script:\n    - if: unix\n      then: export PYO3_PYTHON=\"$PYTHON\"\n      else: set \"PYO3_PYTHON=%PYTHON%\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and match(python, '!=' ~ python_min)\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - hatchling\n        - hatch-rs\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - hatchling\n    - hatch-rs\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - nepenthe\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %SP_DIR%/nepenthe/nepenthe.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/nepenthe/nepenthe.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Forget your environment sorrows\n  homepage: https://github.com/Point72/nepenthe\n  repository: https://github.com/Point72/nepenthe\n\nextra:\n  recipe-maintainers:\n    - timkpaine\n",
