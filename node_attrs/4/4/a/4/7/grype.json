  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.118.0\"\n  go_mod: github.com/anchore/grype\n  go_cmd: ./cmd/grype\n  go_bin: ${{ \"$PREFIX/bin/grype\" if unix else \"%LIBRARY_BIN%\\\\grype.exe\" }}\n  go_build: go build -v -buildmode=pie -trimpath -modcacherw -ldflags=\"-X 'main.version=${{ version }}'\"\n  go_mod_mathutil: modernc.org/mathutil\n  go_mod_xz: github.com/xi2/xz\n  go_mod_magic: github.com/deitch/magic\n  go_mod_attestation: github.com/in-toto/attestation\n  license_ignores: ${{ go_mod }} ${{ go_mod_mathutil }} ${{ go_mod_xz }} ${{ go_mod_magic }} ${{ go_mod_attestation }}\n\npackage:\n  name: grype\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/anchore/grype/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 6963758836cd46fd019d4c5e2eb903ec26960c34814a35058ebea56971dc592c\n    target_directory: ${{ go_mod }}\n  - url: https://gitlab.com/cznic/mathutil/-/raw/b13e5b5643328f15fd2fcedc85f647f0d8f9180f/LICENSE  # v1.5.0\n    sha256: bfa9bf72a72ca009fd62a8f84fca3dca67e51d93af96352723646599898b6cf5\n    target_directory: library_licenses_manual/${{ go_mod_mathutil }}\n  - url: https://raw.githubusercontent.com/xi2/xz/48954b6210f8d154cb5f8484d3a3e1f83489309e/LICENSE\n    sha256: 5c640056d513f276d56635af7a0bed81cb7eac02a31b6e56d40c416557a8d8ce\n    target_directory: library_licenses_manual/${{ go_mod_xz }}\n  - url: https://raw.githubusercontent.com/deitch/magic/2def47b612f6f806d1e136bbec1c34fdefacf04a/LICENSE\n    sha256: 2423c6eb9948e617a61f7a2d1cb463c69d60e599fbae5931551631d2a8730838\n    target_directory: library_licenses_manual/${{ go_mod_magic }}\n  - url: https://raw.githubusercontent.com/in-toto/attestation/refs/tags/v1.2.0/LICENSE\n    sha256: b3a6ac899861c2c28a1abd5c7ea8733fefaed6938d730e099c42671386032aeb\n    target_directory: library_licenses_manual/${{ go_mod_attestation }}\n\nbuild:\n  number: 0\n  script:\n    - ${{ \"export\" if unix else \"set\" }} \"GOPATH=${{ SRC_DIR }}\"\n    - cd ${{ go_mod }}\n    - go-licenses save ${{ go_cmd }} --save_path \"${{ SRC_DIR }}/library_licenses\" {% for i in license_ignores | split %}--ignore ${{ i }} {% endfor %}\n    - ${{ go_build }} -o \"${{ go_bin }}\" ${{ go_cmd }}\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }}\n    - go-licenses\n\ntests:\n  - script:\n      - grype --version | ${{ \"grep\" if unix else \"findstr\" }} \"${{ version }}\"\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - ${{ go_mod }}/LICENSE\n    - library_licenses/\n    - library_licenses_manual/\n  summary: A vulnerability scanner for container images and filesystems\n  homepage: https://github.com/anchore/grype\n\nextra:\n  recipe-maintainers:\n    - janjagusch\n    - fhoehle\n",
