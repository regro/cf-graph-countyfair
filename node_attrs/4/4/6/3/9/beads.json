  "linux_64_meta_yaml": {
    "about": {
      "description": "Beads (bd) is a fast, local-first CLI issue tracker designed for software\nteams and AI agents. It stores issues alongside your code in a Dolt\n(MySQL-compatible) database, supports hierarchical issues, dependencies,\nmolecules (multi-step workflows), integrations with GitHub/GitLab/Jira/Linear,\nand MCP server support for AI agents.",
      "dev_url": "https://github.com/gastownhall/beads",
      "doc_url": "https://github.com/gastownhall/beads/tree/main/docs",
      "home": "https://github.com/gastownhall/beads",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "A developer-centric issue tracker that lives in your Git repo"
    },
    "build": {
      "number": "0",
      "script": [
        "go-licenses save ./cmd/bd --save_path=library_licenses --ignore=github.com/apache/arrow/go/arrow --ignore=github.com/apache/thrift/lib/go/thrift --ignore=github.com/dolthub/eventkit --ignore=github.com/dolthub/eventkit/transport/ga4 --ignore=github.com/kch42/buzhash --ignore=github.com/mattn/go-localereader",
        "DEFAULT_BRANCH=\"$(curl -s \"https://api.github.com/repos/gastownhall/beads\" | jq -r '.default_branch')\"",
        "COMMIT_HASH=\"$(curl -s \"https://api.github.com/repos/gastownhall/beads/commits/v${{ version }}\" | jq -r '.sha')\"",
        "SHORT_COMMIT_HASH=\"$(echo \"${COMMIT_HASH}\" | cut -c 1-7)\"",
        "go build -o=\"$PREFIX\"/bin/bd -v -ldflags=\"-s -w -X main.Branch=${DEFAULT_BRANCH} -X main.Build=${SHORT_COMMIT_HASH} -X main.Commit=${COMMIT_HASH} -X main.Version=${{ version }}\" -tags=gms_pure_go -trimpath ./cmd/bd",
        "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
        "\"$PREFIX\"/bin/bd completion bash > \"$PREFIX\"/share/bash-completion/completions/bd",
        "\"$PREFIX\"/bin/bd completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/bd.fish",
        "\"$PREFIX\"/bin/bd completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_bd",
        "cp -a library_licenses_2/. library_licenses/ && rm -rf library_licenses_2"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "maphew",
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "beads",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "go-cgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": {
              "content": [
                "bd --help",
                "bd --version"
              ],
              "env": {
                "BD_DISABLE_EVENT_FLUSH": "1",
                "BD_DISABLE_METRICS": "1",
                "BD_NO_DAEMON": "1",
                "BEADS_DOLT_AUTO_START": "0"
              }
            }
          },
          {
            "package_contents": {
              "bin": [
                "bd"
              ],
              "files": [
