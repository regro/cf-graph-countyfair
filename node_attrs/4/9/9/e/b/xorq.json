  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.4.2\"\n  python_min: '3.10'\n\npackage:\n  name: xorq\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/x/xorq/xorq-${{ version }}.tar.gz\n  sha256: 16c95f3dc256c6be41c99b5b9a2fe14b8a5fbee190fcbf386debac682a1b76dd\n  patches:\n    - patches/0001-strip-cli-tool-deps-for-conda-forge.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - xorq = xorq.cli:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<=3.14\n    - attrs >=24.1.0\n    - pyarrow >=18.0.0 #,<22\n    # xorq.flight.action imports pyarrow.flight unconditionally; conda-forge\n    # splits the runtime out so pyarrow alone may land pyarrow-core without\n    # libarrow_flight.so. Pin the runtime explicitly.\n    - libarrow-flight >=18.0.0 #,<22\n    - structlog >=24.2.0,<26\n    - python-cityhash >=0.4.7,<1\n    - pandas >=2.2.3,<3\n    - pyarrow-hotfix >=0.4,<1\n    - geoarrow-types >=0.2,<1\n    - pythran >=0.17.0\n    - setuptools\n    - atpublic >=5.1\n    - parsy >=2\n    - python-dateutil >=2.8.2\n    - pytz >=2022.7\n    - sqlglot >=23.4,!=26.32.0,<28.7.0\n    - tomlkit >=0.12\n    - toolz >=0.11\n    - typing_extensions >=4.3.0\n    - py-yaml12\n    - cloudpickle >=3.1.1\n    - envyaml >=1.10.211231\n    - xorq-datafusion ==0.2.10\n    - opentelemetry-sdk >=1.32.1\n    - opentelemetry-exporter-otlp >=1.32.1\n    - opentelemetry-exporter-otlp-proto-grpc >=1.32.1\n    - opentelemetry-exporter-prometheus >=0.55b1\n    - prometheus_client >=0.22.1\n    - cryptography >=45.0.3\n    - strenum >=0.4.15\n    - uv >=0.7.20\n    - rich >=13.9.4\n    - click >=8.0\n    # git-annex is only packaged on linux-64 (no osx-*, win-*, linux-aarch64\n    # conda-forge builds). xorq's git-annex-backed data sources only work on\n    # Linux as a result. Gate the dep so the staged-recipes OSX + Windows\n    # test environments solve cleanly.\n    # - if: linux\n    #   then:\n    #     - git-annex >=10.20250220\n    #     - __linux\n    - gitpython >=3.1.46\n    - textual >=1.0.0\n    - filelock >=3.13\n    - xorq-dasher >=0.1.1\n    # new hard dep in 0.3.36 (Rust/PyO3 Arrow record-batch cache);\n    # packaged alongside this bump as recipes/batchcorder.\n    #- batchcorder ==0.1.3\n\ntests:\n  - python:\n      imports:\n        - xorq\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pip\n    script:\n      - xorq --help\n\nabout:\n  summary: Data processing library built on top of Ibis and DataFusion to write multi-engine data workflows.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://www.xorq.dev/\n  documentation: https://docs.xorq.dev/\n\nextra:\n  recipe-maintainers:\n    - rxm7706\n",
