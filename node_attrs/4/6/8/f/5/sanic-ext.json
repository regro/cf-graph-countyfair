  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"25.12.0\"\n  # see https://github.com/sanic-org/sanic-ext/blob/v25.12.0/sanic_ext/bootstrap.py#L49\n  sanic_min: \"25.12.0\"\n\npackage:\n  name: sanic-ext\n  version: ${{ version }}\n\nsource:\n  - target_directory: dist\n    url: https://pypi.org/packages/source/s/sanic-ext/sanic_ext-${{ version }}.tar.gz\n    sha256: db6f5c8b880bb6b4cb73717b655b63aea4e77cf57825678ec74310fd69581ce1\n    patches:\n      - 0000-no-dupe-packages-find.diff\n  - target_directory: src\n    url: https://github.com/sanic-org/sanic-ext/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: f78f17d0e98148bc3610c0a3a34e946723436e96648ea93f4b89a5df0d80c584\n\nbuild:\n  number: 0\n  noarch: python\n  script:\n    - cd dist\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n    - pyyaml >=3.0.0\n  run_constraints:\n    - sanic >=${{ sanic_min }}\n\ntests:\n  - package_contents:\n      strict: true\n      files:\n        - etc/conda/test-files/sanic-ext/**\n      site_packages:\n        - sanic_ext/**\n        - sanic_ext-${{ version }}.dist-info/**\n  - files:\n      recipe:\n        - run_test.py\n      source:\n        - src/tests/\n        - src/pyproject.toml\n    requirements:\n      run:\n        - attrs\n        - jinja2\n        - msgspec\n        - pip\n        - pydantic >=2\n        - pytest-asyncio\n        - pytest-cov >=7.1\n        - pytest-xdist\n        - python ${{ python_min }}.*\n        - sanic\n        - sanic-testing\n    script:\n      # manual, as can't be imported without `sanic`\n      - pip check\n      - python run_test.py\n\nabout:\n  summary: Extend your Sanic installation with some core functionality.\n  license: MIT\n  license_file: dist/LICENSE\n  homepage: http://github.com/sanic-org/sanic-ext\n  documentation: https://sanic.dev/en/plugins/sanic-ext/getting-started.html\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
