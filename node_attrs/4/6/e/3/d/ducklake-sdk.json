      "summary": "Python SDK to interact with DuckLake."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "mkdir -p \"${BUILD_PREFIX}/bin\"",
          "cp \"${RECIPE_DIR}/cargo-auditable-wrapper.sh\" \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"",
          "export CARGO=\"cargo-auditable-wrapper\"",
          "cargo-bundle-licenses --format yaml --output THIRDPARTY.yml",
          "python -m pip install . --no-deps --ignore-installed -vv --no-build-isolation --disable-pip-version-check"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "borchero"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ducklake-sdk",
        "requirements": {
          "build": [
            "rust_compiler_stub",
            "c_stdlib_stub",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [
            "python",
            "python-abi3",
            "pip",
            "maturin >=1.7,<2"
          ],
          "run": [
            "python",
            "typing_extensions"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "ducklake"
              ],
              "python_version": [
                "3.11.*",
                "*"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "abi3audit"
              ]
            },
            "script": "abi3audit $SP_DIR/ducklake/_native.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}"
          }
        ],
        "version": "0.0.17"
      }
    ],
