  "raw_meta_yaml": "context:\n  version: \"0.0.17\"\n\npackage:\n  name: ducklake-sdk\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/d/ducklake-sdk/ducklake_sdk-${{ version }}.tar.gz\n  sha256: a69dfe6c2b2f9e1235e2d1cc84b990dc0fa99b60076af43548d7debfcf72d89c\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # Remove this wrapper once https://github.com/conda-forge/rust-activation-feedstock/pull/79 is merged\n      - if: unix\n        then:\n          - mkdir -p \"${BUILD_PREFIX}/bin\"\n          - cp \"${RECIPE_DIR}/cargo-auditable-wrapper.sh\" \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"\n          - export CARGO=\"cargo-auditable-wrapper\"\n        else:\n          - copy \"%RECIPE_DIR%\\cargo-auditable-wrapper.bat\" \"%BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\" || exit 1\n          - set CARGO=cargo-auditable-wrapper.bat\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - python -m pip install . --no-deps --ignore-installed -vv --no-build-isolation --disable-pip-version-check\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n  host:\n    - python\n    - if: is_abi3\n      then: python-abi3\n    - pip\n    - maturin >=1.7,<2\n  run:\n    - python\n    - typing_extensions\n  run_constraints:\n    - polars >=1.43.2\n    - sqlalchemy >=2\n\ntests:\n  - python:\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n      imports:\n        - ducklake\n      pip_check: true\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %SP_DIR%/ducklake/_native.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/ducklake/_native.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  homepage: https://github.com/borchero/ducklake-sdk\n  summary: Python SDK to interact with DuckLake.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://ducklake-sdk.readthedocs.io/\n  repository: https://github.com/borchero/ducklake-sdk\n\nextra:\n  recipe-maintainers:\n    - borchero\n",
