  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"2.2.1\"\n\nrecipe:\n  name: libhdbpp-split\n  version: ${{ version }}\n\nsource:\n  url: https://gitlab.com/tango-controls/hdbpp/libhdbpp/-/archive/${{ version }}/libhdbpp-${{ version }}.tar.gz\n  sha256: 98dac5d6fe2c76473347867671d6c0801407ee5c3c2f71519b8229476afa4799\n\nbuild:\n  number: 0\n  skip: win\n\noutputs:\n  - staging:\n      name: libhdbpp-build\n    requirements:\n      ignore_run_exports:\n        from_package:\n          - libhdbpp\n      build:\n        - cmake\n        - ninja\n        - if: unix\n          then:\n            - pkg-config\n        - ${{ stdlib('c') }}\n        - ${{ compiler('cxx') }}\n      host:\n        - cppzmq\n        - cpptango\n        - omniorb-libs\n    build:\n      script:\n        env:\n          LIBHDBPP_VERSION: ${{ version }}\n        file: build\n\n  - package:\n      name: libhdbpp\n    inherit: libhdbpp-build\n    build:\n      files:\n        - if: linux\n          then:\n            - lib/libhdb++.so\n            - lib/libhdb++.so.2\n            - lib/libhdb++.so.${{ version }}\n        - if: osx\n          then:\n            - lib/libhdb++*.dylib\n        - if: unix\n          then:\n            - lib/cmake/libhdbpp/**\n            - include/hdb++/**\n    requirements:\n      run_exports:\n        - ${{ pin_subpackage('libhdbpp', upper_bound='x.x') }}\n      # Library doesn't link against cpptango (only headers used)\n      ignore_run_exports:\n        from_package:\n          - cpptango\n    tests:\n      - package_contents:\n          lib:\n            - hdb++\n          include:\n            - hdb++/AbstractDB.h\n          files:\n            - if: unix\n              then:\n                - lib/cmake/libhdbpp/libhdbppConfig.cmake\n\n  - package:\n      name: libhdbpp-dbg\n    inherit:\n      from: libhdbpp-build\n      run_exports: false\n    build:\n      skip:\n        - not linux\n      dynamic_linking:\n        # Prevent dbg file to be modified\n        # Will raise CRC mismatch otherwise!\n        binary_relocation: false\n      files:\n        - lib/libhdb++.so.${{ version }}.dbg\n    requirements:\n      run:\n        - ${{ pin_subpackage('libhdbpp', exact=True) }}\n    tests:\n      - package_contents:\n          files:\n            - lib/libhdb++.so.${{ version }}.dbg\n\nabout:\n  license: LGPL-3.0-or-later\n  license_file: COPYING.LESSER\n  summary: Interface library for HDB++ archiving system.\n  description: |\n    HDB++ is an archiving system for Tango-Controls.\n    libhdbpp provides an abstract means to archive data events to a Cassandra database,\n    MySQL database, or potentially other database backends.\n  homepage: https://www.tango-controls.org\n  repository: https://gitlab.com/tango-controls/hdbpp/libhdbpp\n  documentation: https://tango-controls.readthedocs.io/en/latest/Explanation/archiving/hdbpp.html\n\nextra:\n  feedstock-name: libhdbpp\n  recipe-maintainers:\n    - beenje\n",
