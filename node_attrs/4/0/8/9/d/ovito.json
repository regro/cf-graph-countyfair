  "raw_meta_yaml": "{% set name = \"ovito\" %}\n{% set version = \"3.16.0\" %}\n{% set sha256 = \"663d0ff34d2c5679d8b293bedeb12cf3c72f5c679561ba81ffceb0531e103003\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  - url: https://gitlab.com/stuko/{{ name }}/-/archive/v{{ version }}/{{ name }}-v{{ version }}.tar.gz\n    sha256: {{ sha256 }}\n  - url: https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz\n    sha256: eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3\n    folder: src/3rdparty/zstd\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - make  # [unix]\n    - sphinx\n    - sphinx_rtd_theme\n    - qt6-main                              # [build_platform != target_platform]\n  host:\n    - libboost-headers\n    - ffmpeg\n    - libnetcdf\n    - qt6-main\n    - zlib\n    - zstd\n    - libssh\n    - xorg-libxext  # [linux]\n    - libgl-devel  # [linux]\n    \n    # conda-forge's qt6-main is built with Vulkan support (QT_FEATURE_vulkan=1) and depends on\n    # libvulkan-loader at runtime. But Qt's headers additionally require <vulkan/vulkan.h> to be\n    # present at *application* build time: QVulkanInstance and QRhiVulkanInitParams are declared\n    # only under \"#if QT_CONFIG(vulkan) && __has_include(<vulkan/vulkan.h>)\". Without this\n    # build-time-only package, our QT_CONFIG(vulkan) code paths fail to compile.\n    # This applies to macOS too, where qt6-main enables Vulkan via MoltenVK, even though OVITO\n    # selects the Metal backend there at runtime. Windows is unaffected: our Vulkan code paths\n    # are guarded by !defined(Q_OS_WIN).\n    - libvulkan-headers  # [not win]\n\n    # SLI file format reader of OVITO uses SQLite:\n    - libsqlite\n\n    # VASP HD5 file format reader of OVITO uses HDF5:\n    - hdf5\n  run_constrained:\n    - menuinst >=1.4.17  # [win]\ntest:\n  commands:\n    - command -v ovito  # [unix]\n    - where ovito  # [win]\n    - if not exist %PREFIX%\\\\Menu\\\\ovito.json exit 1  # [win]\n    - if not exist %PREFIX%\\\\Menu\\\\ovito.ico exit 1  # [win]\n\nabout:\n  home: https://www.ovito.org\n  license: GPL-3.0-or-later\n  license_file: {{ environ[\"RECIPE_DIR\"] }}/LICENSE.txt\n  summary: Scientific visualization and analysis software for atomistic simulation data\n  description: |\n    OVITO is a scientific visualization and analysis software for\n    atomistic and particle simulation data. It helps scientists gain\n    better insights into materials phenomena and physical processes.\n    This package provides the OVITO Basic desktop application without the Python modules.\n    For all features, use the licensed OVITO Pro version.\n    OVITO is being developed by OVITO GmbH, Germany. \n    The developers offer a separate conda package that also includes the OVITO Python module.\n  doc_url: https://www.ovito.org/docs/current/\n  dev_url: https://gitlab.com/stuko/ovito\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n    - ericpre\n    - stukowski\n",
