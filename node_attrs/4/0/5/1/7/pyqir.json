  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.12.5\"\n  llvm_version: \"20.1\"\n\npackage:\n  name: pyqir\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/qir-alliance/pyqir/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 170c4b981d5f6a48d8678c5dd519d915d57ab53f864830319cfeb5a78b732d77\n  patches:\n    - if: win\n      then: use-dynamic-msvc-runtime.patch\n\nbuild:\n  number: 0\n  skip: not (match(python, python_min ~ \".*\") and is_abi3)\n  python:\n    version_independent: ${{ is_abi3 }}\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1.10.2,<1.11\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - pip\n    - if: is_abi3\n      then:\n        - python-abi3\n    - maturin >=1.10.2,<1.11\n    - llvmdev ${{ llvm_version }}.*\n    - if: win\n      then:\n        - libxml2-devel\n        - zlib\n        - zstd\n  run:\n    - python\n    - libllvm20 ${{ llvm_version }}.*\n\ntests:\n  - python:\n      imports:\n        - pyqir\n        - pyqir.qis\n        - pyqir.rt\n      python_version:\n        - if: is_abi3\n          then: ${{ python_min ~ \".*\" }}\n        - \"*\"\n  - files:\n      source:\n        - pyqir/tests\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n    script:\n      - python -c \"from pyqir import BasicQisBuilder, SimpleModule; m = SimpleModule('conda_forge_smoke', 1, 1); q = BasicQisBuilder(m.builder); q.h(m.qubits[0]); assert '__quantum__qis__h__body' in m.ir()\"\n      - cd pyqir && pytest -q tests\n  - if: is_abi3\n    then:\n      requirements:\n        run:\n          - abi3audit\n      script:\n        - if: win\n          then: abi3audit %PREFIX%/Lib/site-packages/pyqir/_native.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else:\n            - export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")\n            - abi3audit $SP_DIR/pyqir/_native.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n\nabout:\n  homepage: https://github.com/qir-alliance/pyqir\n  summary: PyQIR parses, generates and evaluates the Quantum Intermediate Representation.\n  description: |\n    PyQIR is a set of Python APIs for generating, parsing, and evaluating\n    Quantum Intermediate Representation (QIR). It provides a Python API for\n    integrating the QIR toolchain into Python-based frontends.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  documentation: https://www.qir-alliance.org/pyqir/\n  repository: https://github.com/qir-alliance/pyqir\n\nextra:\n  recipe-maintainers:\n    - basnijholt\n",
