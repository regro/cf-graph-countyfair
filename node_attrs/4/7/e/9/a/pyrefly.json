  "raw_meta_yaml": "context:\n  version: \"1.3.0\"\n\npackage:\n  name: pyrefly\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/facebook/pyrefly/archive/refs/tags/${{ version }}.tar.gz\n  sha256: f26552aae8957d6924319034eadd69830f2442685fc4e696c97e777c827a4082\n  patches:\n    # https://github.com/facebook/pyrefly/pull/4884\n    - 0001-completion.patch\n\nbuild:\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # Tell `pixi global` to not set CONDA_PREFIX during activation\n      # https://pixi.sh/dev/global_tools/introduction/#opt-out-of-conda_prefix\n      - if: win\n        then:\n          - if not exist \"%PREFIX%\\\\etc\\\\pixi\\\\pyrefly\" mkdir \"%PREFIX%\\\\etc\\\\pixi\\\\pyrefly\"\n          - type nul > \"%PREFIX%\\\\etc\\\\pixi\\\\pyrefly\\\\global-ignore-conda-prefix\"\n        else:\n          - mkdir -p \"${PREFIX}/etc/pixi/pyrefly\"\n          - touch \"${PREFIX}/etc/pixi/pyrefly/global-ignore-conda-prefix\"\n      - cd pyrefly\n      # `CFLAGS` & co. hold the target flags, which break cc-rs when it compiles build\n      # dependencies for the build platform. The rust activation exports per-target\n      # `CFLAGS_<triple>` etc., so cc-rs picks the right ones itself.\n      - if: unix\n        then: unset CFLAGS CPPFLAGS CXXFLAGS\n      # `rust-lld` cannot handle the relocations gcc emits for power8, so link with bfd\n      - if: target_platform == \"linux-ppc64le\"\n        then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS:-} -C link-self-contained=no -C link-arg=-fuse-ld=bfd\"\n      # `cargo install` ignores the `CARGO_BUILD_TARGET` set by the rust activation,\n      # so the target triple has to be passed explicitly to cross compile.\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --target ${CARGO_BUILD_TARGET} --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --target %CARGO_BUILD_TARGET% --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/pyrefly completion --shell zsh > $PREFIX/share/zsh/site-functions/_pyrefly\n          - $PREFIX/bin/pyrefly completion --shell bash > $PREFIX/share/bash-completion/completions/pyrefly\n          - $PREFIX/bin/pyrefly completion --shell fish > $PREFIX/share/fish/vendor_completions.d/pyrefly.fish\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    # no `make` on win-arm64, and nothing in the build actually invokes it there\n    - if: not win\n      then: make\n\ntests:\n  - script: pyrefly --help\n  - package_contents:\n      files:\n        - etc/pixi/pyrefly/global-ignore-conda-prefix\n        - if: unix\n          then:\n            - share/zsh/site-functions/_pyrefly\n            - share/bash-completion/completions/pyrefly\n            - share/fish/vendor_completions.d/pyrefly.fish\n      bin:\n        - pyrefly\n      strict: true\n\nabout:\n  homepage: http://pyrefly.org\n  summary: A fast type checker and IDE for Python\n  description: |\n    Pyrefly is a fast type checker for Python. It's designed to replace the existing Pyre type checker at Meta by the end of 2025. This README describes basic usage. See the Pyrefly website for full documentation and a tool for checking code.\n  license: MIT\n  license_file:\n    - LICENSE\n    - pyrefly/THIRDPARTY.yml\n  documentation: https://pyrefly.org/en/docs/\n  repository: https://github.com/facebook/pyrefly\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
