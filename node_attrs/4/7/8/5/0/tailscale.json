  "osx_arm64_meta_yaml": {
    "about": {
      "dev_url": "https://github.com/tailscale/tailscale",
      "doc_url": "https://tailscale.com/docs",
      "home": "https://tailscale.com/",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "The easiest, most secure way to use WireGuard and 2FA."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "let version_short = \"${{ version }}\"",
          "let version_git_hash = git ls-remote https://github.com/tailscale/tailscale.git refs/tags/v($version_short)^{} | split row -r '\\s+' | get 0",
          "let version_long = $version_short + \"-t\" + ($version_git_hash | str substring 0..8)",
          "let ldflags = $\"-s -w -X tailscale.com/version.longStamp=($version_long) -X tailscale.com/version.shortStamp=($version_short) -X tailscale.com/version.gitCommitStamp=($version_git_hash)\"",
          "let target_directory = ($env.PREFIX)/bin/",
          "go build -v -buildvcs=false -ldflags $ldflags -o $target_directory ./cmd/tailscale",
          "go-licenses save ./cmd/tailscale --save_path ./thirdparty --ignore github.com/golang/freetype --ignore github.com/jmespath/go-jmespath",
          "mkdir ./thirdparty/github.com/golang/freetype ./thirdparty/github.com/jmespath/go-jmespath",
          "cp LICENSE-golang-freetype ./thirdparty/github.com/golang/freetype/LICENSE",
          "cp LICENSE-go-jmespath ./thirdparty/github.com/jmespath/go-jmespath/LICENSE",
          "mkdir ($env.PREFIX)/share/bash-completion/completions ($env.PREFIX)/share/zsh/site-functions ($env.PREFIX)/share/fish/vendor_completions.d",
          "^$\"($env.PREFIX)/bin/tailscale\" completion bash | save ($env.PREFIX)/share/bash-completion/completions/tailscale",
          "^$\"($env.PREFIX)/bin/tailscale\" completion zsh | save ($env.PREFIX)/share/zsh/site-functions/_tailscale",
          "^$\"($env.PREFIX)/bin/tailscale\" completion fish | save ($env.PREFIX)/share/fish/vendor_completions.d/tailscale.fish"
        ],
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "borchero",
