  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.27.1\"\n\npackage:\n  name: go-${{ go_variant_str }}-compiler\n  version: ${{ version }}\n\nsource:\n  # needed for autotick bot autoupdates\n  url: https://dl.google.com/go/go${{ version }}.src.tar.gz\n  sha256: 4e408abae126d916b6164627193f2c54f0e3ca1312d693b86db45f862ab238b1\n\nbuild:\n  number: 0\n\nrequirements:\n  run:\n    - go-${{ go_variant_str }}_${{ target_platform }} ${{ version }}.*\n\ntests:\n  - script:\n      # telemetry counter files are written asynchronously into $HOME, which\n      # races with the test directory cleanup\n      - go telemetry off\n      - go help\n      - if: unix\n        then: test \"$CONDA_GO_COMPILER\" = \"1\"\n        else: if not \"%CONDA_GO_COMPILER%\"==\"1\" exit /b 1\n\nabout:\n  license: BSD-3-Clause\n  license_file: LICENSE.txt\n  summary: A metapackage to select a Go compiler (not for use in recipes)\n  homepage: https://conda-forge.org\n\nextra:\n  feedstock-name: go-compiler\n  recipe-maintainers:\n    - conda-forge/go\n",
  "req": {
    "__set__": true,
    "elements": [
      "go-cgo_linux-64",
      "go-cgo_linux-aarch64",
      "go-cgo_linux-ppc64le",
