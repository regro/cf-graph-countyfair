  "raw_meta_yaml": "context:\n  name: sops\n  version: \"3.13.3\"\n\npackage:\n  name: go-${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - target_directory: src\n    url: https://github.com/getsops/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 49811c5ed80f6b4d4e98cef98e3f7378406aa692fd773dfb72ad1b4dfb940448\n\nbuild:\n  number: 0\n  script:\n    - cd src\n    - go mod tidy\n    - go-licenses save . --save_path ../library_licenses\n    - if: not win\n      then:\n        - go build -v -o $PREFIX/bin/sops ./cmd/sops\n        # Clear out cache to avoid file not removable warnings\n        - chmod -R u+w $(go env GOPATH) && rm -r $(go env GOPATH)\n      else:\n        - go build -v -o %LIBRARY_BIN%\\sops.exe .\\cmd\\sops\n\nrequirements:\n  build:\n    - ${{ compiler('go-nocgo') }} >=1.22.7\n    - go-licenses\n\ntests:\n  - script:\n      - if: not win\n        then: which sops\n        else: where sops\n      - sops --help\n\nabout:\n  homepage: https://github.com/getsops/sops/\n  license: MPL-2.0\n  license_file:\n    - src/LICENSE\n    - library_licenses/\n  summary: sops manages JSON, YAML and BINARY documents to be encrypted or decrypted.\n  description: |\n    SOPS is an editor of encrypted files that supports YAML, JSON, ENV, INI and BINARY formats and encrypts with AWS KMS, GCP KMS, Azure Key Vault, age, and PGP.\n\nextra:\n  recipe-maintainers:\n    - xhochy\n    - fhoehle\n",
