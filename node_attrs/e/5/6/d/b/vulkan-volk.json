  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.4.357.0\"\n\npackage:\n  # The name \"volk\" is already used by another conda-forge package.\n  name: vulkan-volk\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/zeux/volk/archive/refs/tags/vulkan-sdk-${{ version }}.tar.gz\n  sha256: 6400c7b23e24d17e4f04bac49b55b06c4e87677d33398e90344743ec73560ca6\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ stdlib(\"c\") }}\n    - cmake\n    - if: win\n      then: ninja\n    - if: unix\n      then: make\n  host:\n    - libvulkan-headers\n    - libvulkan-loader\n\ntests:\n  - package_contents:\n      include:\n        - volk.h\n        - volk.c\n      files:\n        - if: win\n          then: Library/lib/volk.lib\n          else: lib/libvolk.a\n\nabout:\n  homepage: https://github.com/zeux/volk\n  repository: https://github.com/zeux/volk\n  summary: Meta-loader for Vulkan\n  description: |\n    volk allows applications to dynamically load Vulkan entrypoints without\n    linking to the Vulkan loader. It also simplifies loading extension\n    entrypoints and can load entrypoints directly from a driver.\n  license: MIT\n  license_file: LICENSE.md\n\nextra:\n  recipe-maintainers:\n    - hmaarrfk\n    - eunos-1128\n",
