  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.9.0\"\n\npackage:\n  name: pytest-pilot\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/p/pytest-pilot/pytest_pilot-${{ version }}.tar.gz\n  sha256: c438041025424f586caa3a2d7ec7f79310189693e236211755367d869aa5f1f2\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    # setup.py imports pkg_resources, which setuptools removed in 82.0.0\n    - setuptools <82\n    - setuptools_scm\n    - six\n  run:\n    - python >=${{ python_min }}\n    # pytest plugin (pytest11 entry point); pytest_pilot imports pytest at\n    # import time, so it is a hard runtime dep even though upstream omits it\n    # from install_requires.\n    - pytest\n\ntests:\n  - python:\n      imports:\n        - pytest_pilot\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  homepage: https://github.com/smarie/python-pytest-pilot\n  repository: https://github.com/smarie/python-pytest-pilot\n  documentation: https://smarie.github.io/python-pytest-pilot/\n  summary: Slice in your test base thanks to powerful markers.\n  license: BSD-3-Clause\n  license_file: LICENSE\n\nextra:\n  recipe-maintainers:\n    - killua156\n    - mgorny\n",
