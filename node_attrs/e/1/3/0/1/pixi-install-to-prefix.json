  "linux_64_meta_yaml": {
    "about": {
      "description": "Pixi installs your environments to `.pixi/envs/<env-name>` by default. If you want to install your environment to an arbitrary location on your system, you can use `pixi-install-to-prefix`.",
      "dev_url": "https://github.com/pavelzw/pixi-install-to-prefix",
      "home": "https://github.com/pavelzw/pixi-install-to-prefix",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Install pixi environments to an arbitrary prefix"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export OPENSSL_DIR=$PREFIX",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "1",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw",
        "ytausch"
      ]
    },
