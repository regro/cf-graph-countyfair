  "raw_meta_yaml": "context:\n  version: \"2.24.2\"\n\npackage:\n  name: pitchfork\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/jdx/pitchfork/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: bdbb8e8e6a3c87603b4ae1e81353ca9c173f6f34cddafacc5f4cac46e779cb1a\n\nbuild:\n  number: 1\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build web UI assets (`ui/dist`)\n      - aube install   --dir=ui\n      - aube run build --dir=ui\n      # build main app and generate license data\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = $prefix | path join bin/pitchfork\n          - ^$bin completion bash | save ($prefix | path join share/bash-completion/completions/pitchfork)\n          - ^$bin completion fish | save ($prefix | path join share/fish/vendor_completions.d/pitchfork.fish)\n          - ^$bin completion zsh  | save ($prefix | path join share/zsh/site-functions/_pitchfork)\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - aube\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - nodejs\n    - nushell\n  host:\n    - usage\n\ntests:\n  - script:\n      - pitchfork --help\n      - pitchfork --version\n  - package_contents:\n      bin:\n        - pitchfork\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/pitchfork\n            - share/fish/vendor_completions.d/pitchfork.fish\n            - share/zsh/site-functions/_pitchfork\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/pitchfork\n            - Library/share/fish/vendor_completions.d/pitchfork.fish\n            - Library/share/zsh/site-functions/_pitchfork\n      strict: true\n\nabout:\n  summary: Daemons with DX\n  description: |\n    Pitchfork is a CLI for managing daemons with a focus on developer experience.\n    It can start daemons only once, auto start/stop them via a shell hook when\n    entering/leaving a project directory, perform readiness checks (delay,\n    output regex, HTTP endpoint, TCP port, or custom command), manage\n    dependencies with topological start ordering, watch files to auto-restart\n    daemons, schedule recurring tasks via cron, run lifecycle hooks, enforce\n    resource limits, and expose an interactive TUI as well as a browser-based\n    web UI and an MCP server for AI assistants.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://pitchfork.jdx.dev\n  repository: https://github.com/jdx/pitchfork\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
