  "win_64_meta_yaml": {
    "about": {
      "description": "Pitchfork is a CLI for managing daemons with a focus on developer experience.\nIt can start daemons only once, auto start/stop them via a shell hook when\nentering/leaving a project directory, perform readiness checks (delay,\noutput regex, HTTP endpoint, TCP port, or custom command), manage\ndependencies with topological start ordering, watch files to auto-restart\ndaemons, schedule recurring tasks via cron, run lifecycle hooks, enforce\nresource limits, and expose an interactive TUI as well as a browser-based\nweb UI and an MCP server for AI assistants.",
      "dev_url": "https://github.com/jdx/pitchfork",
      "home": "https://pitchfork.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Daemons with DX"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX",
          "aube install   --dir=ui",
          "aube run build --dir=ui",
          "cargo auditable install --path=. --root=($prefix) --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "nu"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
