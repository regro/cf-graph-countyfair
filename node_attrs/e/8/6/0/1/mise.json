    "build": {
      "number": "1",
      "script": {
        "content": [
          "export LIBCLANG_PATH=\"$BUILD_PREFIX\"/lib",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins --no-default-features --features=${{ base_features }}${{ extra_features }}",
          "mkdir -p \"$PREFIX\"/lib",
          "echo 'message = \"${{ self_update_msg }}\"' > \"$PREFIX\"/lib/mise-self-update-instructions.toml",
          "mkdir -p \"$PREFIX\"/share/man/man1",
          "cp man/man1/mise.1 \"$PREFIX\"/share/man/man1/mise.1",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/mise completion bash > \"$PREFIX\"/share/bash-completion/completions/mise",
          "\"$PREFIX\"/bin/mise completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/mise.fish",
          "\"$PREFIX\"/bin/mise completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_mise",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml",
          "powershell -Command \"cp (gci $env:BUILD_PREFIX\\Library\\bin\\libclang-*.dll)[0] $env:BUILD_PREFIX\\Library\\bin\\libclang.dll\"",
          "set \"LIBCLANG_PATH=%BUILD_PREFIX%\\Library\\bin\"",
          "cargo auditable install --path=. --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins --no-default-features --features=${{ base_features }}${{ extra_features }}",
          "cargo auditable install --path=crates\\mise-shim --root=\"%LIBRARY_PREFIX%\" --no-track --locked --bins",
          "if not exist \"%LIBRARY_PREFIX%\"\\lib mkdir \"%LIBRARY_PREFIX%\"\\lib",
          "echo message = \"${{ self_update_msg }}\"> \"%LIBRARY_PREFIX%\"\\lib\\mise-self-update-instructions.toml",
          "if not exist \"%LIBRARY_PREFIX%\"\\share\\man\\man1 mkdir \"%LIBRARY_PREFIX%\"\\share\\man\\man1",
          "powershell -Command \"Copy-Item -Path 'man/man1/mise.1' -Destination '%LIBRARY_PREFIX%\\share\\man\\man1\\mise.1'\""
