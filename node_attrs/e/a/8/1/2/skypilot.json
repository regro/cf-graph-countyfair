  "raw_meta_yaml": "context:\n  version: \"0.13.0\"\n\nrecipe:\n  name: skypilot-split\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/skypilot/skypilot-${{ version }}.tar.gz\n  sha256: 0bd0c59a649d59fa21f1093534318e6c2f50b30e10fb3f54f4d702acf2615fb7\n  patches:\n    # pip-check looks for casbin, which was renamed to pycasin upstrean.\n    - casbin_is_pycasbin.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - sky  =  sky.cli:cli\n\noutputs:\n  - package:\n      name: skypilot\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools >=58.0\n        - pip\n      run:\n        - python >=${{ python_min }}\n        - aiofiles\n        - aiohttp >=3.13.3\n        - aiosqlite\n        - alembic >=1.8.0\n        - anyio\n        - asyncpg\n        - bcrypt ==4.0.1\n        - cachetools\n        - pycasbin\n        - click >=7.0,<8.2.0\n        - colorama\n        - cryptography\n        - fastapi\n        - filelock >=3.15.0\n        - gitpython\n        - greenlet\n        - httpx\n        - ijson\n        - jinja2 >=3.0\n        - jsonschema\n        - networkx\n        - orjson\n        - packaging\n        - pandas >=1.3.0\n        - paramiko\n        - passlib\n        - pendulum\n        - pip\n        - prettytable >=2.0.0\n        - prometheus_client >=0.8.0\n        - psutil\n        - psycopg2-binary\n        - pulp\n        - pydantic !=2.0,!=2.1.*,!=2.2.*,!=2.3.*,!=2.4.*,<3,>2\n        - pyjwt\n        - python-dotenv\n        - python-multipart\n        - pyyaml >3.13,!=5.4.*\n        - requests\n        - rich\n        - setproctitle\n        - setuptools\n        - sqlalchemy >=2.0.16\n        - sqlalchemy_adapter\n        - tabulate\n        - tqdm\n        - types-paramiko\n        - typing_extensions\n        - uvicorn >=0.33.0,<0.36.0\n        - wheel >=0.46.3\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          imports:\n            - sky\n          pip_check: true\n\n# There are more than 30 extras options:\n# aws, azure, cloudflare, coreweave, cudo, do, docker, fluidstack, gcp, huggingface, hyperbolic,\n# ibm, kubernetes, lambda, mithril, nebius, oci, paperspace, primeintellect, remote, runpod, scp,\n# seeweb, server, shadeform, slurm, ssh, vast, vastdata, verda, vsphere, yotta.\n# I will aggregate them all into one until we have better tools to handle optional dependencies updates.\n# NB: There are some extras that differ! What a nightmare to install!!\n# I'll use what the solver can return here prioritizing updates dependencies.\n\n  - package:\n      name: skypilot-extras\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - setuptools\n        - pip\n      run:\n        - ${{ pin_subpackage('skypilot', exact=True) }}\n        - awscli >=1.27.10\n        - azure-common\n        - azure-core >=1.24.0\n        - azure-core >=1.31.0\n        - azure-identity>=1.19.0\n        - azure-mgmt-compute >=33.0.0\n        # NB: Missing version of dependency on conda-forge.\n        # - azure-cli >=2.65.0,<2.87.0\n        # - azure-mgmt-network >=27.0.0\n        - azure-storage-blob >=12.23.1\n        - boto3 >=1.26.1\n        - botocore >=1.29.10\n        - colorama <0.4.7\n        - docker-py\n        - google-api-python-client >=2.69.0\n        - google-cloud-storage\n        - grpcio >=1.63.0\n        - huggingface_hub >=1.5\n        - ibm-cloud-sdk-core\n        - ibm-cos-sdk\n        - ibm-platform-services >=0.48.0\n        - msgraph-sdk\n        - msrestazure\n        - oci\n        - passlib\n        - protobuf >=5.29.6,<7.0.0\n        - pycares<5\n        - pydantic !=2.0.*,!=2.1.*,!=2.2.*,!=2.3.*,!=2.4.*,<3,>2\n        - pyjwt\n        - pyopenssl >=23.2.0\n        - python-dateutil\n        - python-dotenv\n        - python-hostlist\n        - python-kubernetes !=32.0.0,<36.0.0,>=20.0.0\n        - python-multipart\n        - pyvmomi ==8.0.1.0.2\n        - pyyaml !=5.4.*,>3.13\n        - ray-core >=2.6.1\n        - sqlalchemy_adapter\n        - tomli\n        - websockets\n        # Not on conda-forge.\n        # - cudo-compute >=0.1.10\n        # - ecsapi ==0.4.0\n        # - ibm-vpc\n        # - nebius >=0.3.59\n        # - pydo >=0.3.0\n        # - runpod >=1.6.1\n        # - vastai-sdk >=0.1.12\n\n    tests:\n      - python:\n          python_version:\n            - ${{ python_min }}.*\n            - \"*\"\n          pip_check: true\n          imports:\n            - sky\n\nabout:\n  summary: \"SkyPilot: An intercloud broker for the clouds\"\n  homepage: https://github.com/skypilot-org/skypilot\n  repository: https://github.com/skypilot-org/skypilot\n  documentation: https://docs.skypilot.co/en/latest/\n  license: Apache-2.0\n  license_file: LICENSE\n\nextra:\n  feedstock_name: skypilot\n  recipe-maintainers:\n    - rsignell\n    - ocefpaf\n    - maresb\n",
