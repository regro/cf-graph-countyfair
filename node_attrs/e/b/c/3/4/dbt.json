  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: dbt-core\n  version: 1.12.4\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/dbt_core-${{ version }}.tar.gz\n  sha256: cf869cac339eb9d108181fc5b9bce0a467917e0515b48498e9d49311c82375b8\n  patches:\n    - 0001-drop-experimental-parser-hard-dep.patch\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - dbt = dbt.cli.main:cli\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n  run:\n    - python >=${{ python_min }}\n    - agate >=1.7.0,<1.15\n    - jinja2 >=3.1.3,<4\n    - mashumaro >=3.9,<3.18\n    - click >=8.3.0,<9.0\n    - jsonschema >=4.19.1,<5.0\n    - networkx >=2.3,<4.0\n    - protobuf >=6.0,<8.0\n    - requests <3.0.0\n    - snowplow-tracker >=1.0.2,<2.0\n    - pathspec >=0.9,<1.1\n    - sqlparse >=0.5.5,<0.7.0\n    - dbt-extractor >=0.5.0,<=0.6\n    - dbt-common >=1.37.5,<2.0\n    - dbt-adapters >=1.24.5,<2.0\n    - dbt-protos >=1.0.514,<2.0\n    - pydantic <3\n    - packaging >20.9\n    - pytz >=2015.7\n    - pyyaml >=6.0\n    - daff >=1.3.46\n    - typing_extensions >=4.4\n    - python-dotenv >=1.2\n    - metricflow >=0.211.0,<1.0\n    - opentelemetry-api >=1.26,<2.0\n  run_constraints:\n    # dbt-core's pyproject.toml lists dbt-core-experimental-parser as an\n    # unconditional dependency, but it is never imported as a Python module --\n    # dbt-core only shells out to it (dbt/parser/fusion.py) as an external CLI\n    # binary, and only when the user explicitly opts in with --use-v2-parser /\n    # DBT_ENGINE_USE_V2_PARSER (default off). If it's missing, dbt-core raises\n    # a clear, actionable error only on that opt-in path; everything else\n    # (import dbt, parse, run, etc.) works normally without it.\n    #\n    # It's also not yet packaged for conda-forge: it's a Rust binary whose\n    # upstream sdist doesn't build from source (see\n    # https://github.com/conda-forge/staged-recipes/pull/34267 for the\n    # in-progress, contested wheel-repackaging attempt). Rather than block\n    # dbt-core 1.12.x entirely on that being resolved, constrain the version\n    # here (for anyone who does install it) without requiring it. Promote\n    # this back to a hard `run` dependency once that package exists on\n    # conda-forge and the packaging story there has matured.\n    - dbt-core-experimental-parser >=2.0.0b1,<3\ntests:\n  - python:\n      imports:\n        - dbt\n        - dbt.adapters\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      - dbt --help\n\nabout:\n  summary: With dbt, data analysts and engineers can build analytics the way engineers build applications.\n  license: Apache-2.0\n  license_file: LICENSE\n  homepage: https://github.com/dbt-labs/dbt-core\n\nextra:\n  feedstock-name: dbt\n  recipe-maintainers:\n    - rxm7706\n    - drewbanin\n    - jthandy\n    - maresb\n    - thewchan\n    - zaneselvans\n",
