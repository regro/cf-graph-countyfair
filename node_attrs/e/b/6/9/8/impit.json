  "raw_meta_yaml": "context:\n  version: \"0.14.1\"\n\npackage:\n  name: impit\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/impit/impit-${{ version }}.tar.gz\n  sha256: 85e771493ba9ce2131dcaf3b0ec7da6da8bd8aa5f6de1d71d400c93ba17a640b\n\nbuild:\n  number: 0\n  script:\n    # reqwest's http3 feature (used by impit) is gated behind this cfg flag.\n    # Setting it here works on all platforms, unlike an inline `env` prefix.\n    env:\n      RUSTFLAGS: \"--cfg reqwest_unstable\"\n      CARGO_HTTP_MULTIPLEXING: \"false\"\n    content:\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  build:\n    - perl\n    - make\n    - cargo-bundle-licenses\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin >=1,<2\n  host:\n    - python\n    - maturin >=1,<2\n    - pip\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - impit\n      pip_check: true\n\nabout:\n  summary: A library for making HTTP requests through browser impersonation\n  license: Apache-2.0\n  license_file:\n    - LICENSE.md\n    - THIRDPARTY.yml\n  homepage: https://apify.github.io/impit/python/\n  repository: https://github.com/apify/impit\n  documentation: https://apify.github.io/impit/python/\n\nextra:\n  recipe-maintainers:\n    - Pijukatel\n",
