  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  python_min: \"3.12\"\n  version: \"3.26.2\"\n\npackage:\n  name: openquake.engine\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/o/openquake.engine/openquake_engine-${{ version }}.tar.gz\n  sha256: 82644c4279735d38e83d764114a56e5992127b541b032d4eda859bc3e8717a26\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - oq = openquake.commands.__main__:oq\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=79.0\n    - pip\n  run:\n    - python >=${{ python_min }}\n    - alpha-shapes >=1.1.0\n    - decorator >=5.1.1\n    - django >=4.2,<5\n    - django-cors-headers >=4.3.1\n    - docutils\n    - fiona\n    - gdal\n    - geopandas >=1.1.4\n    - h3-py >=4.4\n    - h5py >=3.13\n    - matplotlib-base\n    - numba >=0.61.2,<0.62.dev0\n    - numpy >=2\n    - pandas >=2\n    - pillow >=12\n    - psutil\n    - pyproj\n    - pyzmq >=26\n    - requests\n    - scipy\n    - shapely\n    - toml >=0.10.2\n\ntests:\n  - python:\n      imports:\n        - openquake._unc\n        - openquake._unc.processing\n      # This library is pinned too tight upstream as if it was an app.\n      # As far as I could test there is no reason for that and everything works.\n      # While pip-check false is bad, this package is \"end-of-stack\" and it is\n      # unlikely to break anything downstream.\n      pip_check: false\n      python_version:\n        - ${{ python_min }}.*\n        - '*'\n  - requirements:\n      run:\n        - pip\n        - python ${{ python_min }}.*\n    script:\n      - oq --help\n\nabout:\n  summary: Computes earthquake hazard and risk.\n  license: AGPL-3.0-only\n  license_file:\n    - LICENSE\n  homepage: https://github.com/gem/oq-engine\n\nextra:\n  recipe-maintainers:\n    - cbworden\n    - emthompson-usgs\n    - mhearne-usgs\n    - ocefpaf\n",
