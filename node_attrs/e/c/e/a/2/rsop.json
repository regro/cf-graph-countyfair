e\\fish\\vendor_completions.d\\rsop.fish\")\n          - for /f \"usebackq delims=\" %%f in (`dir /s /b ..\\target\\_rsop`)     do (copy \"%%f\" \"%LIBRARY_PREFIX%\\share\\zsh\\site-functions\\_rsop\")\n          - for /f \"usebackq delims=\" %%f in (`dir /s /b ..\\target\\rsop*.1`)   do (copy \"%%f\" \"%LIBRARY_PREFIX%\\share\\man\\man1\\\")\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - rsop --help\n      - rsop version\n      - rsopv --help\n      - rsopv version\n  - package_contents:\n      bin:\n        - rsop\n        - rsopv\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/rsop\n            - share/fish/vendor_completions.d/rsop.fish\n            - share/zsh/site-functions/_rsop\n            - share/man/man1/rsop*.1\n        - if: win\n          then:\n            - Library/share/bash-completion/completions/rsop\n            - Library/share/fish/vendor_completions.d/rsop.fish\n            - Library/share/zsh/site-functions/_rsop\n            - Library/share/man/man1/rsop*.1\n      strict: true\n\nabout:\n  summary: Stateless OpenPGP (SOP) CLI tool\n  description: |\n    rsop is a \"Stateless OpenPGP\" (SOP) CLI tool. It exposes a simple,\n    standardized CLI interface to perform a set of common OpenPGP operations.\n  license: CC0-1.0\n  license_file:\n    - LICENSES/CC0-1.0.txt\n    - THIRDPARTY.yml\n  homepage: https://codeberg.org/heiko/rsop\n  repository: https://codeberg.org/heiko/rsop\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
