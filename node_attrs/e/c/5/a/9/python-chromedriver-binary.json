  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"155.0.8050.0.0\"\n  chromedriver_version: ${{ (version | split(\".\"))[0:4] | join(\".\") }}\n  python_check_max: \"3.14\"\n\npackage:\n  name: python-chromedriver-binary\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/danielkaiser/python-chromedriver-binary/archive/v${{ version }}.tar.gz\n    sha256: 653be70a86bf415f8c58012f310a1c4267aa60675a3723b4450e7baf3d535ac0\n  - if: target_platform == \"linux-64\"\n    then:\n      url: https://edgedl.me.gvt1.com/edgedl/chrome/chrome-for-testing/${{ chromedriver_version }}/linux64/chromedriver-linux64.zip\n      sha256: f4d4da7178839d095b690ca0683568f37819c9dfb89fdb7da7f2a10eb4452437\n  - if: target_platform == \"osx-64\"\n    then:\n      url: https://edgedl.me.gvt1.com/edgedl/chrome/chrome-for-testing/${{ chromedriver_version }}/mac-x64/chromedriver-mac-x64.zip\n      sha256: 41f380961959d98e24a5c7afb043e99f7910a30963215e95375b07791c59ce85\n  - if: target_platform == \"osx-arm64\"\n    then:\n      url: https://edgedl.me.gvt1.com/edgedl/chrome/chrome-for-testing/${{ chromedriver_version }}/mac-arm64/chromedriver-mac-arm64.zip\n      sha256: 8323d93bbee36efd4cff35fc0117af87a7457b018436143c26a2f5912992b5e8\n  - if: target_platform == \"win-64\"\n    then:\n      url: https://edgedl.me.gvt1.com/edgedl/chrome/chrome-for-testing/${{ chromedriver_version }}/win32/chromedriver-win32.zip\n      sha256: 58b3b1e5bd3e223593fd61423ce2b6371cd56f0775591cc2f9dc7bd09b27ecdc\n\nbuild:\n  number: 0\n  dynamic_linking:\n    binary_relocation: ${{ not osx }}\n  python:\n    version_independent: true\n    entry_points:\n      - chromedriver-path = chromedriver_binary.utils:print_chromedriver_path\n  script:\n    - if: not win\n      then:\n        - chmod +x chromedriver\n      else:\n        # see https://conda-forge.zulipchat.com/#narrow/channel/457337-general/topic/.60pip.20install.60.20failing.20on.20Windows.20today/with/603912616\n        - set PIP_USE_DEPRECATED=legacy-certs\n        - set PYTHONHASHSEED=0\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n\nrequirements:\n  host:\n    - pip\n    - python ${{ python_min }}.*\n    - setuptools\n  run:\n    - python >=${{ python_min }}\n\ntests:\n  - python:\n      imports: chromedriver_binary\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - requirements:\n      run:\n        - python ${{ python_min }}.*\n    script:\n      file: run_test.py\n\nabout:\n  homepage: https://pypi.org/project/chromedriver-binary\n  repository: https://github.com/danielkaiser/python-chromedriver-binary\n  license: MIT\n  license_file:\n    - LICENSE\n    - LICENSE.chromedriver\n    - THIRD_PARTY_NOTICES.chromedriver\n  summary: Downloads and installs the chromedriver binary version\n  description: |\n    Downloads and installs the chromedriver binary for automated\n    testing of webapps. The installer supports Linux, MacOS and Windows\n    operating systems.\n\nextra:\n  recipe-maintainers:\n    - williamjamir\n    - bollwyvl\n",
