  "raw_meta_yaml": "context:\n  version: \"0.2.0\"\n\npackage:\n  name: meteo_si\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/maahn/meteo_si/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7c53e3be8389290cb8cdcfd1e9007b88be2364f37482e19e3549724b4d49e7c6\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools >=64\n  run:\n    - python >=${{ python_min }}\n    - numpy\n\ntests:\n  - python:\n      imports:\n        - meteo_si\n        - meteo_si.atmosphere\n        - meteo_si.density\n        - meteo_si.humidity\n        - meteo_si.temperature\n        - meteo_si.wind\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      # --pyargs runs the test suite that ships inside the installed\n      # package (meteo_si.tests is included by the project's own\n      # packages.find config) rather than against a copied source tree,\n      # so there's no risk of a local `meteo_si/` test directory\n      # shadowing the actually-installed package during collection.\n      - pytest --pyargs meteo_si.tests -v\n    requirements:\n      run:\n        - python ${{ python_min }}.*\n        - pytest\n\nabout:\n  homepage: https://github.com/maahn/meteo_si\n  license: MIT\n  license_file: LICENSE\n  summary: Meteo SI is a collection of meteorological formulas\n  documentation: https://meteo-si.readthedocs.io/en/latest/\n  repository: https://github.com/maahn/meteo_si\n\nextra:\n  recipe-maintainers:\n    - maahn\n",
