  "linux_64_meta_yaml": {
    "about": {
      "description": "The Stripe CLI is a developer tool to help build, test, and manage your\nintegration with Stripe directly from the command line. With it you can\nsecurely test webhooks without relying on third-party software, trigger\nwebhook events to conveniently test your integration, tail your API\nrequest logs in real-time, and create, retrieve, update, or delete API\nobjects.",
      "dev_url": "https://github.com/stripe/stripe-cli",
      "doc_url": "https://docs.stripe.com/stripe-cli",
      "home": "https://github.com/stripe/stripe-cli",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "src/LICENSE",
      "summary": "A command-line tool for Stripe"
    },
    "build": {
      "number": "0",
      "script": [
        "cd src",
        "go-licenses save ./cmd/stripe --save_path ../library_licenses",
        "go build -v -o $PREFIX/bin/stripe -ldflags=\"-s -w -X github.com/stripe/stripe-cli/pkg/version.Version=${{ version }}\" ./cmd/stripe",
        "mkdir -p $PREFIX/share/bash-completion/completions $PREFIX/share/zsh/site-functions $PREFIX/share/fish/vendor_completions.d",
        "$PREFIX/bin/stripe completion --shell bash --write-to-stdout > $PREFIX/share/bash-completion/completions/stripe",
        "$PREFIX/bin/stripe completion --shell zsh --write-to-stdout > $PREFIX/share/zsh/site-functions/_stripe",
        "$PREFIX/bin/stripe completion --shell fish --write-to-stdout > $PREFIX/share/fish/vendor_completions.d/stripe.fish"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "stripe-cli",
        "requirements": {
          "build": [
            "go-nocgo_compiler_stub",
            "go-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "stripe --help",
              "stripe --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "stripe"
              ],
              "files": [
                "share/bash-completion/completions/stripe",
                "share/zsh/site-functions/_stripe",
                "share/fish/vendor_completions.d/stripe.fish"
              ],
              "strict": true
            }
          }
        ],
        "version": "1.44.1"
      }
    ],
