      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "An extremely fast Python type checker and language server, written in Rust."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "mkdir -p \"${PREFIX}/etc/pixi/ty\"",
          "touch \"${PREFIX}/etc/pixi/ty/global-ignore-conda-prefix\"",
          "cd ruff/crates/ty",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ../../../THIRDPARTY.yml",
          "mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d",
          "$PREFIX/bin/ty generate-shell-completion zsh > $PREFIX/share/zsh/site-functions/_ty",
          "$PREFIX/bin/ty generate-shell-completion bash > $PREFIX/share/bash-completion/completions/ty",
          "$PREFIX/bin/ty generate-shell-completion fish > $PREFIX/share/fish/vendor_completions.d/ty.fish"
        ]
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
