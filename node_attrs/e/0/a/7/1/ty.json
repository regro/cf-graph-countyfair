  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.0.80\"\n\npackage:\n  name: ty\n  version: ${{ version }}\n\nsource:\n  # this also contains the ruff source code in contrast to https://github.com/astral-sh/ty/archive/refs/tags/${{ version }}.tar.gz\n  url: https://github.com/astral-sh/ty/releases/download/${{ version }}/source.tar.gz\n  sha256: a039d7e66d362e1707fc494f2c69dfdd2eb5333dc8fa9ad582edc125932fa5fa\n\nbuild:\n  number: 0\n  script:\n    env:\n      JEMALLOC_SYS_WITH_LG_PAGE: ${{ '16' if (aarch64 or ppc64le) else '' }}\n    content:\n      # Tell `pixi global` to not set CONDA_PREFIX during activation\n      # https://pixi.sh/dev/global_tools/introduction/#opt-out-of-conda_prefix\n      - if: win\n        then:\n          - if not exist \"%PREFIX%\\\\etc\\\\pixi\" mkdir \"%PREFIX%\\\\etc\\\\pixi\\\\ty\"\n          - type nul > \"%PREFIX%\\\\etc\\\\pixi\\\\ty\\\\global-ignore-conda-prefix\"\n        else:\n          - mkdir -p \"${PREFIX}/etc/pixi/ty\"\n          - touch \"${PREFIX}/etc/pixi/ty/global-ignore-conda-prefix\"\n      # rust-lld cannot handle some ppc64le relocations emitted by the jemalloc\n      # C sources, so fall back to the bfd linker there\n      - if: target_platform == \"linux-ppc64le\"\n        then: export CARGO_BUILD_RUSTFLAGS=\"${CARGO_BUILD_RUSTFLAGS:-} -C link-arg=-fuse-ld=bfd\"\n      # `zip` (with the `zstd` feature) is a build dependency of `ty_vendored`, so cargo\n      # compiles the `zstd-sys` C sources for the build platform too. cc-rs accumulates\n      # the flags of `CFLAGS` into both compiles, which makes the build platform compiler\n      # choke on the target's `-mcpu=power8` / `-mabi=lp64d`. Pass them via `TARGET_CFLAGS`\n      # instead, which cc-rs only applies to the target compile.\n      - if: build_platform != target_platform\n        then:\n          - export TARGET_CFLAGS=\"${CFLAGS}\"\n          - unset CFLAGS\n      - cd ruff/crates/ty\n      - if: unix\n        then:\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ../../../THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/ty generate-shell-completion zsh > $PREFIX/share/zsh/site-functions/_ty\n          - $PREFIX/bin/ty generate-shell-completion bash > $PREFIX/share/bash-completion/completions/ty\n          - $PREFIX/bin/ty generate-shell-completion fish > $PREFIX/share/fish/vendor_completions.d/ty.fish\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    # only needed to build the vendored jemalloc, which is not used on Windows\n    - if: unix\n      then: make\n\ntests:\n  - package_contents:\n      bin:\n        - ty\n      files:\n        - etc/pixi/ty/global-ignore-conda-prefix\n        - if: unix\n          then:\n            - share/zsh/site-functions/_ty\n            - share/bash-completion/completions/ty\n            - share/fish/vendor_completions.d/ty.fish\n      strict: true\n  - script:\n      - ty --help\n      - ty --version\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: An extremely fast Python type checker and language server, written in Rust.\n  homepage: https://github.com/astral-sh/ty\n  documentation: https://docs.astral.sh/ty\n  repository: https://github.com/astral-sh/ty\n\nextra:\n  recipe-maintainers:\n    - pavelzw\n",
