  "linux_64_meta_yaml": {
    "about": {
      "description": "fnox is a flexible secret management tool that supports storing secrets with\nencryption (age, AWS KMS, Azure KMS, GCP KMS) or remotely in cloud providers\n(AWS Secrets Manager, AWS Parameter Store, Azure Key Vault, GCP Secret Manager,\n1Password, Bitwarden, HashiCorp Vault, and more). It provides a unified\ninterface to work with secrets across development, CI, and production,\nand supports shell integration to auto-load secrets on directory change.",
      "dev_url": "https://github.com/jdx/fnox",
      "home": "https://fnox.jdx.dev/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Fort Knox for your secrets — flexible secret management with encryption and cloud providers"
    },
    "build": {
      "number": "1",
      "script": {
        "content": [
          "export LIBCLANG_PATH=\"$BUILD_PREFIX\"/lib",
          "cargo auditable install --path=. --root=\"$PREFIX\" --no-track --locked --bins",
          "mkdir -p \"$PREFIX\"/share/bash-completion/completions \"$PREFIX\"/share/fish/vendor_completions.d \"$PREFIX\"/share/zsh/site-functions",
          "\"$PREFIX\"/bin/fnox completion bash > \"$PREFIX\"/share/bash-completion/completions/fnox",
          "\"$PREFIX\"/bin/fnox completion fish > \"$PREFIX\"/share/fish/vendor_completions.d/fnox.fish",
          "\"$PREFIX\"/bin/fnox completion zsh  > \"$PREFIX\"/share/zsh/site-functions/_fnox",
          "cargo-bundle-licenses --format=yaml --output=./THIRDPARTY.yml"
        ],
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "0",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols",
          "OPENSSL_NO_VENDOR": "1",
          "PKG_CONFIG_ALLOW_CROSS": "1"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "fnox",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "clang",
            "cmake",
            "libclang",
            "make",
            "ninja",
            "perl",
            "pkg-config"
          ],
          "host": [
            "libudev",
