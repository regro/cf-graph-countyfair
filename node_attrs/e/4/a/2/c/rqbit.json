  "raw_meta_yaml": "context:\n  version: \"9.0.1\"\n\npackage:\n  name: rqbit\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/ikatson/rqbit/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 62a42c56259b737eea6580b63061589dc9940b145c40991cfff83470aa783291\n\nbuild:\n  number: 2\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: ${{ \"1\" if win else \"0\" }} # force CMake builder for `aws-lc-sys` native C/C++ code on Windows\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    interpreter: nu\n    content:\n      - let prefix = $env.LIBRARY_PREFIX? | default $env.PREFIX\n      # build main app and generate license data\n      - cd crates/rqbit\n      - cargo auditable install --path=. --root=($prefix) --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../../THIRDPARTY.yml\n      # bundle licenses from webui assets\n      - cd ../../crates/librqbit/webui\n      - pnpm install --ignore-scripts\n      - pnpm-licenses generate-disclaimer --prod --output-file=../../../THIRDPARTY-webui.txt\n      # generate shell completions\n      - if: build_platform == host_platform\n        then:\n          - mkdir ($prefix)/share/bash-completion/completions ($prefix)/share/fish/vendor_completions.d ($prefix)/share/zsh/site-functions\n          - let bin = $prefix | path join bin/rqbit\n          - ^$bin completions bash | save ($prefix | path join share/bash-completion/completions/rqbit)\n          - ^$bin completions fish | save ($prefix | path join share/fish/vendor_completions.d/rqbit.fish)\n          - ^$bin completions zsh  | save ($prefix | path join share/zsh/site-functions/_rqbit)\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - cmake\n    - nodejs\n    - nushell\n    - pkg-config\n    - pnpm\n    - pnpm-licenses\n  host:\n    - if: linux\n      then: openssl\n\ntests:\n  - script:\n      - rqbit --help\n      - rqbit --version\n  - package_contents:\n      bin:\n        - rqbit\n      files:\n        - if: unix and build_platform == host_platform\n          then:\n            - share/bash-completion/completions/rqbit\n            - share/fish/vendor_completions.d/rqbit.fish\n            - share/zsh/site-functions/_rqbit\n        - if: win and build_platform == host_platform\n          then:\n            - Library/share/bash-completion/completions/rqbit\n            - Library/share/fish/vendor_completions.d/rqbit.fish\n            - Library/share/zsh/site-functions/_rqbit\n      strict: true\n\nabout:\n  summary: A bittorrent client with a CLI, server mode, and Web UI\n  description: |\n    rqbit is a bittorrent client written in Rust. It offers a command-line interface\n    for downloading, sharing, and managing torrents, plus an HTTP API and Web UI.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n    - THIRDPARTY-webui.txt\n  homepage: https://github.com/ikatson/rqbit\n  repository: https://github.com/ikatson/rqbit\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
