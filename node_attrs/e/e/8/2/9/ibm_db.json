  "raw_meta_yaml": "# v1 recipe format\n\ncontext:\n  version: \"3.3.0\"\n  build_number: 0\n\npackage:\n  name: ibm_db\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/i/ibm_db/ibm_db-${{ version }}.tar.gz\n  sha256: 75c6749957d202e0b6b37e1e823583bfc37b65293ee123fb287e409d7426b53d\n  patches:\n    - 0001-Omit-GCC-check.patch\n    - 0002-Add-wctype-include.patch\n\nbuild:\n  number: ${{ build_number }}\n  # the osx-64 libdb2.dylib is built using gcc, which is incompatible with the conda-forge ecosystem\n  # otool -L $SP_DIR/clidriver/lib/libdb2.dylib|grep gcc\n  # https://github.com/ibmdb/db2drivers/issues/3#issuecomment-2566168370\n  skip:\n    - if: osx and x86_64\n      then: true\n  script:\n    - if: win\n      then: ${{ PYTHON }} -m pip install . -vv\n      else: build.sh\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n  host:\n    - python\n    - pip\n    - setuptools\n    - if: linux\n      then: libxml2\n    - if: ppc64le\n      then: libnuma\n  run:\n    - python\n    - setuptools\n    - if: linux\n      then: libxcrypt1\n\ntests:\n  - if: win\n    then:\n      - script:\n          - python -c \"import os; os.add_dll_directory(os.environ['SP_DIR'] + '\\\\clidriver\\\\bin'); import ibm_db; import ibm_db_dbi\"\n    else:\n      - python:\n          imports:\n            - ibm_db\n            - ibm_db_dbi\n\nabout:\n  homepage: https://pypi.org/project/ibm-db/\n  license: Apache-2.0\n  license_file: LICENSE\n  summary: Python DBI driver for DB2 (LUW, zOS, i5) and IDS\n  description: |\n    This extension is the implementation of Python Database API Specification v2.0\n    The extension supports DB2 (LUW, zOS, i5) and IDS (Informix Dynamic Server)\n  documentation: https://github.com/ibmdb/python-ibmdb/wiki\n  repository: https://github.com/ibmdb/python-ibmdb\n\nextra:\n  recipe-maintainers:\n    - SabaKauser\n    - xhochy\n    - amukherjee28\n",
