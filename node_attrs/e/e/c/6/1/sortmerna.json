  "raw_meta_yaml": "{% set name = \"sortmerna\" %}\n{% set version = \"7.0.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/{{ name }}/{{ name }}/archive/v{{ version }}.tar.gz\n  sha256: 9bdd087a2b086dbffae5200e6990296231f0b541e391f701727e37ac50f92629\n  patches:\n    # bundled RocksDB v7.10.2 fixes for Apple Silicon:\n    # - PORTABLE=ON: rocksdb adds -march=native unconditionally when PORTABLE=OFF,\n    #   and Apple clang rejects -march=native for arm64 targets\n    # - HAS_ARMV8_CRC=ON: the osx_arm64 build cross-compiles from an osx_64 env, so\n    #   CMAKE_SYSTEM_PROCESSOR=x86_64 and util/crc32c_arm64.cc is excluded, while\n    #   crc32c.cc still references its symbols (via __ARM_FEATURE_CRC32) -> link error\n    - patches/0001-rocksdb-portable.patch  # [osx and arm64]\n\nbuild:\n  number: 1\n  # we decided to skip linux-ppc64le due to lack of maintainer interest\n  # https://github.com/conda-forge/sortmerna-feedstock/pull/7\n  skip: true  # [ppc64le]\n  skip: true  # [win]\n\nrequirements:\n  build:\n    - python                                 # [build_platform != target_platform]\n    - cross-python_{{ target_platform }}     # [build_platform != target_platform]\n    - {{ compiler('c') }}\n    - {{ stdlib('c') }}\n    - {{ compiler('cxx') }}\n    - cmake\n    - ninja\n    - git\n  host:\n    - python\n    - pyyaml\n    - jinja2\n    - requests\n  run:\n    - python\n\ntest:\n  commands:\n    - {{ name }} -h\n\nabout:\n  home: http://bioinfo.lifl.fr/RNA/sortmerna\n  dev_url: https://github.com/sortmerna/sortmerna\n  doc_url: https://sortmerna.readthedocs.io/en/latest/\n  license: GPL-3.0-or-later AND LGPL-3.0-or-later\n  license_file:\n    - LICENSE.txt\n    - LICENSE.LESSER.txt\n    - RocksDB.LICENSE.Apache\n    - ZLib.LICENSE\n  summary: SortMeRNA is a biological sequence analysis tool for filtering, mapping and OTU-picking NGS reads.\n\nextra:\n  recipe-maintainers:\n    - biocodz\n",
