    "about": {
      "description": "This package provides a build backend for pixi that allows building R packages.",
      "dev_url": "https://github.com/prefix-dev/pixi",
      "doc_url": "https://pixi.prefix.dev/latest/build/backends/pixi-build-r/",
      "home": "https://github.com/prefix-dev/pixi",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "A pixi build backend to build R packages."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export OPENSSL_DIR=\"$PREFIX\"",
          "export CMAKE_GENERATOR=Ninja",
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path crates/${{ crate_name }} --no-default-features --features native-tls",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "AWS_LC_SYS_CMAKE_BUILDER": "1",
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "Hofer-Julian",
        "baszalmstra",
        "ruben-arts"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "pixi-build-r",
        "requirements": {
          "build": [
            "rust_compiler_stub",
            "c_stdlib_stub",
            "cmake",
            "ninja",
            "cargo-bundle-licenses",
            "cargo-auditable"
          ],
          "host": [
            "pkg-config",
            "openssl"
          ],
          "run": [
            "pixi-build-api-version >=7,<8"
          ]
        },
        "tests": [
          {
            "script": "${{ name }} --help"
          },
          {
            "package_contents": {
              "bin": [
                "pixi-build-r"
              ]
            }
          }
        ],
        "version": "0.1.7"
      }
