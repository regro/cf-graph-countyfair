  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\n\nschema_version: 1\n\ncontext:\n  name: pixi-build-r\n  crate_name: pixi_build_r\n  version: \"0.1.7\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/prefix-dev/pixi/archive/refs/tags/${{ name }}-v${{ \n    version }}.tar.gz\n  sha256: fd5192e469fdb4184b4a82c39cfa6da98367eb8ff43c8446eb69a04aa96dcbf2\n\nbuild:\n  number: 0\n  script:\n    env:\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n    - if: osx and x86_64\n      then:\n      - unset CARGO_TARGET_X86_64_APPLE_DARWIN_LINKER\n    - if: unix\n      then:\n      - export OPENSSL_DIR=\"$PREFIX\"\n    - if: linux\n      then:\n      - export CMAKE_GENERATOR=Ninja\n    - if: win\n      then:\n      - set CARGO_HOME=C:\\\\.cargo\n      - md %CARGO_HOME%\n    - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} \n      --path crates/${{ crate_name }} --no-default-features --features \n      native-tls\n    - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n  files:\n  - bin/${{ name }}\n  - bin/${{ name }}.exe\n\nrequirements:\n  build:\n  - ${{ compiler(\"rust\") }}\n  - ${{ stdlib(\"c\") }}\n  - cmake\n  - ninja\n  - cargo-bundle-licenses\n  - cargo-auditable\n  host:\n  - if: target_platform != 'win-arm64'\n    then: pkg-config\n  - if: unix\n    then: openssl\n  run:\n  - pixi-build-api-version >=7,<8\n\ntests:\n- script:\n  - if: build_platform == target_platform\n    then: ${{ name }} --help\n- package_contents:\n    bin:\n    - ${{ name }}\n\nabout:\n  homepage: https://github.com/prefix-dev/pixi\n  summary: A pixi build backend to build R packages.\n  description: |\n    This package provides a build backend for pixi that allows building R packages.\n  license: BSD-3-Clause\n  license_file:\n  - LICENSE\n  - THIRDPARTY.yml\n  documentation: https://pixi.prefix.dev/latest/build/backends/pixi-build-r/\n  repository: https://github.com/prefix-dev/pixi\n\nextra:\n  recipe-maintainers:\n  - Hofer-Julian\n  - baszalmstra\n  - ruben-arts\n",
