  "raw_meta_yaml": "context:\n  version: \"0.2.2\"\n\npackage:\n  name: polars-io-tools\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/0e/cd/8dbdd932d0eb89f350f9591587a0889f3a4982291000acb8ea76d18ebc80/polars_io_tools-${{ version }}.tar.gz\n  sha256: 49452212a7c71cffaf3b48508f80e5db8a4a49a6c880940bfe89c719ee02e437\n\nbuild:\n  number: 2\n  python:\n    version_independent: true\n  script:\n    - if: unix\n      then: export PYO3_PYTHON=\"$PYTHON\"\n      else: set \"PYO3_PYTHON=%PYTHON%\"\n    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  skip: is_abi3 and not is_python_min\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python ${{ python_min }}.*\n        - cross-python_${{ target_platform }}\n        - crossenv\n        - hatchling\n        - hatch-rs\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - hatchling\n    - hatch-rs\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python >=${{ python_min }}\n    - arrow_odbc\n    - boto3\n    - cloudpickle\n    - deltalake\n    - duckdb\n    - narwhals\n    - numpy\n    - orjson\n    - packaging\n    - pandas\n    - polars\n    - portion\n    - pyarrow\n    - pyodbc\n    - pydantic\n    - ray-core\n    - requests\n    - sqlglot\n    - tqdm\n\ntests:\n  - python:\n      imports:\n        - polars_io_tools\n      # deltalake 1.5.0 has macOS WHEEL tags for macosx_26_0,\n      # which makes pip check fail on older CI runners despite valid imports.\n      pip_check: ${{ not osx }}\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %SP_DIR%/polars_io_tools/polars_io_tools.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/polars_io_tools/polars_io_tools.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - python >=${{ python_min }}\n          - abi3audit\n\nabout:\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  summary: Custom parsing extensions for lazy polars\n  homepage: https://github.com/Point72/polars-io-tools\n  repository: https://github.com/Point72/polars-io-tools\n\nextra:\n  recipe-maintainers:\n    - hintse\n    - arhamchopra\n    - ptomecek\n    - timkpaine\n",
