  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"1.4.2\"\n  so_version: ${{ \"16.\" ~ (version | split(\".\"))[1] ~ \".\" ~ (version | split(\".\"))[2] }}\n  so_major_version: ${{ (so_version | split(\".\"))[0] }}\n  build: 4\n\nrecipe:\n  name: libavif-split\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/AOMediaCodec/libavif/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 2b645287340ba5a631d268b551dc2d72bd73ac33335962dd36dcdb6d8366921d\n\nbuild:\n  number: ${{ build }}\n\noutputs:\n  # Builds libavif once into the prefix; each package output below inherits\n  # these files and selects its subset with build.files.\n  - staging:\n      name: libavif-split-build\n    build:\n      script:\n        file: build\n    requirements:\n      build:\n        - cmake\n        - ${{ compiler('c') }}\n        - ${{ stdlib('c') }}\n        - ninja\n      host:\n        - aom\n        - dav1d-devel\n        - rav1e\n        - svt-av1\n\n  - package:\n      name: libavif\n    inherit: libavif-split-build\n    build:\n      number: ${{ build }}\n      # Headers, unversioned shared libs, pkgconfig, cmake configs, and the\n      # Windows import library; everything except the versioned shared libs.\n      files:\n        include:\n          - include/**/*\n          - lib/**/*\n          - Library/include/**/*\n          - Library/lib/**/*\n        exclude:\n          - lib/lib*.so.*\n          - lib/lib*.*.dylib\n    requirements:\n      run:\n        - ${{ pin_subpackage('libavif' ~ so_major_version, exact=True) }}\n      run_exports:\n        - ${{ pin_subpackage('libavif' ~ so_major_version) }}\n    tests:\n      # The dev package owns headers, the unversioned shared lib, pkgconfig,\n      # cmake configs (and the Windows import lib) but must NOT contain the\n      # versioned shared libraries (those live in libavif${{ so_major_version }}).\n      - if: linux\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - include/avif/avif.h\n                  - lib/libavif.so\n                  - lib/pkgconfig/libavif.pc\n                  - lib/cmake/libavif/libavif-config.cmake\n                  - lib/cmake/libavif/libavif-config-release.cmake\n                  - lib/cmake/libavif/libavif-config-version.cmake\n                not_exists:\n                  - lib/libavif.so.*\n      - if: osx\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - include/avif/avif.h\n                  - lib/libavif.dylib\n                  - lib/pkgconfig/libavif.pc\n                  - lib/cmake/libavif/libavif-config.cmake\n                  - lib/cmake/libavif/libavif-config-release.cmake\n                  - lib/cmake/libavif/libavif-config-version.cmake\n                not_exists:\n                  - lib/libavif.*.dylib\n      - if: win\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - Library/include/avif/avif.h\n                  - Library/lib/avif.lib\n                  - Library/lib/pkgconfig/libavif.pc\n                  - Library/lib/cmake/libavif/libavif-config.cmake\n                  - Library/lib/cmake/libavif/libavif-config-release.cmake\n                  - Library/lib/cmake/libavif/libavif-config-version.cmake\n                not_exists:\n                  - Library/bin/avif.dll\n\n  - package:\n      name: libavif${{ so_major_version }}\n    inherit: libavif-split-build\n    build:\n      number: ${{ build }}\n      # Only the versioned shared libraries and the Windows DLL.\n      files:\n        include:\n          - lib/lib*.so.*\n          - lib/lib*.*.dylib\n          - bin/*.dll\n          - Library/bin/*.dll\n    requirements:\n      run:\n        - if: win\n          then:\n            - ${{ pin_subpackage('_libavif_api', upper_bound='x.x.x') }}\n      run_exports:\n        - ${{ pin_subpackage('libavif' ~ so_major_version) }}\n    tests:\n      # The runtime package owns ONLY the versioned shared libraries (Windows\n      # DLL) and must NOT contain the dev files (headers, unversioned lib,\n      # pkgconfig, cmake configs, import lib).\n      - if: linux\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - lib/libavif.so.${{ so_major_version }}\n                  - lib/libavif.so.${{ so_version }}\n                not_exists:\n                  - include/avif/avif.h\n                  - lib/libavif.so\n                  - lib/pkgconfig/libavif.pc\n                  - lib/cmake/libavif/*\n      - if: osx\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - lib/libavif.${{ so_major_version }}.dylib\n                  - lib/libavif.${{ so_version }}.dylib\n                not_exists:\n                  - include/avif/avif.h\n                  - lib/libavif.dylib\n                  - lib/pkgconfig/libavif.pc\n                  - lib/cmake/libavif/*\n      - if: win\n        then:\n          - package_contents:\n              files:\n                exists:\n                  - Library/bin/avif.dll\n                not_exists:\n                  - Library/include/avif/avif.h\n                  - Library/lib/avif.lib\n                  - Library/lib/pkgconfig/libavif.pc\n                  - Library/lib/cmake/libavif/*\n\n  # Clobber preventer for Windows; prevents multiple dll files from being\n  # installed simultaneously. This lets us avoid exporting a strict pin on the\n  # API which is not strictly correlated with the ABI.\n  - package:\n      name: _libavif_api\n    build:\n      number: ${{ build }}\n      skip: not win\n    about:\n      summary: >\n        An empty package that prevents multiple ABIs being installed simultaneously on Windows.\n\nabout:\n  homepage: https://github.com/AOMediaCodec/libavif\n  license: BSD-2-Clause\n  license_file: LICENSE\n  summary: A friendly, portable C implementation of the AV1 Image File Format\n  description: |\n    This library aims to be a friendly, portable C implementation of the AV1\n    Image File Format, as described here\n    <https://aomediacodec.github.io/av1-avif/>.\n\nextra:\n  feedstock-name: libavif\n  recipe-maintainers:\n    - carterbox\n    - hmaarrfk\n    - pavelzw\n",
