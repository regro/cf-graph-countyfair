  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  feedstock_name: power-grid-model\n  version: \"1.13.166\"\n\nrecipe:\n  name: power-grid-model\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/PowerGridModel/${{ feedstock_name }}/archive/v${{ version }}.tar.gz\n  sha256: 7917f9f5cb4e856555d6e910038c064f17b7d3d380d660d6790c98ca9dc6b483\n\nbuild:\n  number: 0\n  skip: (python_impl == 'pypy')\n\n\n# multi stage build to build the C++ library and the Python bindings separately\noutputs:\n  # Build the C++ library for all platforms\n  - package:\n      name: \"libpower-grid-model\"\n      version: ${{ version }}\n\n    build:\n      script:\n        file: ${{ \"build_libpower-grid-model.bat\" if win else \"build_libpower-grid-model.sh\" }}\n      variant:\n        # libpower-grid-model is a pure C++ library\n        # so the package is not Python-versioned.\n        ignore_keys:\n          - python\n\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib(\"c\") }}\n        - ninja\n        - cmake\n        - eigen\n        - libboost-devel\n        - msgpack-cxx\n        - nlohmann_json\n\n      # empty host requirements to avoid pinning the header-only dependencies in runtime\n      host:\n\n      run_exports:\n        # pin stable ABI on major version\n        - ${{ pin_subpackage('libpower-grid-model', upper_bound='x') }}\n\n    tests:\n      - files:\n          source:\n            - tests/package_tests\n        requirements:\n          run:\n            - cmake\n            - ninja\n            - ${{ compiler('cxx') }}\n            - ${{ stdlib(\"c\") }}\n\n        # TODO add test\n        script:\n          - if: unix\n            then:\n              - cd tests/package_tests\n              - mkdir build\n              - cmake ${CMAKE_ARGS} -S . -B build -GNinja -DCMAKE_BUILD_TYPE=Release\n              - cmake --build build\n              - ./build/power_grid_model_package_test\n          - if: win\n            then:\n              - cd tests\\package_tests\n              - mkdir build\n              - cmake %CMAKE_ARGS% -S . -B build -GNinja -DCMAKE_BUILD_TYPE=Release\n              - cmake --build build\n              - .\\build\\power_grid_model_package_test.exe\n\n  # Build the Python bindings only once in Linux x86_64, but it is a noarch package that can be installed on any platform.\n  - package:\n      name: \"power-grid-model\"\n      version: ${{ version }}\n\n    build:\n      noarch: python\n      skip: not (linux and x86_64)\n      script:\n        file: \"build_power-grid-model.sh\"\n\n    requirements:\n      # not build requirements\n      build:\n\n      host:\n        - python ${{ python_min }}.*\n        - scikit-build-core\n        - pip\n      run:\n        - python >= ${{ python_min }}\n        - ${{ pin_subpackage('libpower-grid-model', upper_bound='x.x.x') }}\n        - numpy >=2.0.0\n\n    tests:\n      - python:\n          imports:\n            - power_grid_model\n          pip_check: true\n      - files:\n          source:\n            - tests\n            - pyproject.toml\n        requirements:\n          run:\n            - pip\n            - pytest\n            - pytest-cov\n            - msgpack-python\n            - colorama\n        script:\n          - pytest\n\nabout:\n  summary: Python/C++ library for distribution power system analysis\n  license: MPL-2.0\n  license_file: LICENSE\n  homepage: https://lfenergy.org/projects/power-grid-model/\n  repository: https://github.com/PowerGridModel/power-grid-model\n  documentation: https://power-grid-model.readthedocs.io/\n\nextra:\n  recipe-maintainers:\n    - figueroa1395\n    - TonyXiang8787\n    - mgovers\n    - nitbharambe\n    - petersalemink95\n",
