  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  build_number: 0\n  version: \"50.0\"\n  major_version: ${{ (version | split('.'))[0] }}\n\npackage:\n  name: adwaita-icon-theme\n  version: ${{ version }}\n\nsource:\n  url: https://download.gnome.org/sources/adwaita-icon-theme/${{ major_version }}/adwaita-icon-theme-${{ version }}.tar.xz\n  sha256: fac6e0401fca714780561a081b8f7e27c3bc1db34ebda4da175081f26b24d460\n\nbuild:\n  number: ${{ build_number }}\n  string: ${{ \"win\" if win else \"unix\" }}_${{ build_number }}\n  noarch: generic\n  merge_build_and_host_envs: false\n\nrequirements:\n  build:\n    # gtk needed for building icon cache, build OK because cache file is platform-independent\n    - gtk3\n    - meson\n    - ninja\n    - python ${{ python_min }}.*\n  host:\n  # explicitly empty\n  run:\n    - if: unix\n      then: __unix\n    - if: win\n      then: __win\n    - hicolor-icon-theme\n    # librsvg needed at runtime for libpixbufloader-svg.so so svgs can be rendered\n    - librsvg\n\ntests:\n  - package_contents:\n      files:\n        - if: unix\n          then:\n            - share/icons/Adwaita/icon-theme.cache\n            - share/icons/Adwaita/index.theme\n            - share/icons/Adwaita/16x16/devices/audio-headphones.png\n            - share/icons/Adwaita/cursors/cross\n            - share/icons/Adwaita/cursors/default\n            - share/icons/Adwaita/scalable/devices/computer.svg\n        - if: win\n          then:\n            - Library\\share\\icons\\Adwaita\\icon-theme.cache\n            - Library\\share\\icons\\Adwaita\\index.theme\n            - Library\\share\\icons\\Adwaita\\16x16\\devices\\audio-headphones.png\n            - Library\\share\\icons\\Adwaita\\cursors\\crosshair.cur\n            - Library\\share\\icons\\Adwaita\\cursors\\default.cur\n            - Library\\share\\icons\\Adwaita\\scalable\\devices\\computer.svg\n\nabout:\n  license: LGPL-3.0-or-later OR CC-BY-SA-3.0\n  license_file: COPYING\n  summary: The default icon theme used by the GNOME desktop\n  description: |\n    This package contains the default icon theme used by the GNOME desktop.\n    The icons are used in many of the official GNOME applications like eog,\n    Evince, system monitor, and many more.\n  homepage: https://developer.gnome.org\n  repository: https://gitlab.gnome.org/GNOME/adwaita-icon-theme\n\nextra:\n  recipe-maintainers:\n    - ryanvolz\n    - stuarteberg\n    - tschoonj\n",
