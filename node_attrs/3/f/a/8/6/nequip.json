  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: nequip\n  version: \"0.19.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/${{ name[0] }}/${{ name }}/nequip-${{ version }}.tar.gz\n  sha256: 0a6ccb5ec8b7691e6bc4ce74aa48ddffd70d5389f785a173929246d0ce64e0c2\n\nbuild:\n  number: 1\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - nequip-train = nequip.scripts.train:main\n      - nequip-evaluate = nequip.scripts.evaluate:main\n      - nequip-benchmark = nequip.scripts.benchmark:main\n      - nequip-deploy = nequip.scripts.deploy:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - pip\n    - setuptools\n  run:\n    - requests\n    - hydra-core\n    - lightning >=2.6,!=2.6.2,!=2.6.3\n    - lmdb\n    - python-lmdb\n    - matscipy\n    - pytorch >=2.2.0\n    - torchmetrics >=1.6.0\n    - typing_extensions\n    - python >=${{ python_min }}\n    - numpy\n    - ase\n    - tqdm\n    - e3nn >=0.6.0,<0.7.0\n    - pyyaml\n    - importlib-metadata\n    - torch-runstats >=0.2.0\n    - torch-ema >=0.3.0\n\ntests:\n  - python:\n      imports:\n        - nequip\n      pip_check: true\n      python_version:\n        - ${{ python_min }}\n        - \"*\"\n\nabout:\n  summary: NequIP is a code for building E(3)-equivariant interatomic potentials\n  license: MIT\n  license_file: LICENSE\n  homepage: https://github.com/mir-group/nequip\n  repository: https://github.com/mir-group/nequip\n  documentation: https://github.com/mir-group/nequip\n\nextra:\n  recipe-maintainers:\n    - jan-janssen\n",
