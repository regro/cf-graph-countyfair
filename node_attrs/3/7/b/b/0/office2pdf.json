  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"0.6.8\"\n\npackage:\n  name: office2pdf\n  version: ${{ version }}\n\nsource:\n  # office2pdf-cli is the published binary crate that installs the `office2pdf`\n  # command. Build from the crates.io release rather than the GitHub workspace:\n  # the workspace Cargo.toml pins git forks via [patch.crates-io], which cannot\n  # be fetched in an offline build, while the published crate resolves every\n  # dependency from the registry and ships a Cargo.lock for a reproducible build.\n  - url: https://static.crates.io/crates/office2pdf-cli/office2pdf-cli-${{ version }}.crate\n    sha256: 8b60ea6bd5acc1b4fae7c69b11eb18b2d5c9854a0bb627d677a4fa27e1cf1f88\n  # The published crate carries only the SPDX license string, not the license\n  # text, so fetch LICENSE from the matching git tag.\n  - url: https://raw.githubusercontent.com/developer0hye/office2pdf/v${{ version }}/LICENSE\n    sha256: a69f60df4102c74db295b45bdeca8bb300ecaa954a319de94cbe4e8e337e98f9\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # rattler-build does not auto-extract a .crate, so unpack it before building.\n      - if: unix\n        then: |\n          tar -xzf office2pdf-cli-${{ version }}.crate\n          cd office2pdf-cli-${{ version }}\n          cargo-bundle-licenses --format yaml --output \"${SRC_DIR}/THIRDPARTY.yml\"\n          cargo auditable install --locked --no-track --bins --root \"${PREFIX}\" --path .\n        else: |\n          tar -xzf office2pdf-cli-${{ version }}.crate\n          cd office2pdf-cli-${{ version }}\n          cargo-bundle-licenses --format yaml --output \"%SRC_DIR%\\THIRDPARTY.yml\"\n          cargo auditable install --locked --no-track --bins --root \"%LIBRARY_PREFIX%\" --path .\n\nrequirements:\n  build:\n    - ${{ compiler('rust') }}\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n\ntests:\n  - script:\n      - office2pdf --version\n      - office2pdf --help\n  - package_contents:\n      bin:\n        - office2pdf\n      strict: true\n\nabout:\n  homepage: https://github.com/developer0hye/office2pdf\n  repository: https://github.com/developer0hye/office2pdf\n  summary: Convert DOCX, XLSX, and PPTX files to PDF using pure Rust\n  description: |\n    office2pdf converts Microsoft Office documents (DOCX, XLSX, PPTX) to PDF.\n    It is written in pure Rust and renders documents with Typst, so it needs no\n    external office suite or runtime. Fonts embedded in the source documents are\n    extracted automatically, and PDF/A-2b archival output is available.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - killua156\n    - mgorny\n    - rxm7706\n",
