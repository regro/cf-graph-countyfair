  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"0.15.0\"\n\npackage:\n  name: typst-py\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/t/typst/typst-${{ version }}.tar.gz\n  sha256: a60231b55f0a793c2401b26577522dbf7528207407b383de3a7f0cf7fd3ce28a\n\nbuild:\n  number: 1\n  # only build for the minimal python version\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n    content:\n      # Remove this wrapper once https://github.com/conda-forge/rust-activation-feedstock/pull/79 is merged\n      - if: unix\n        then:\n          - mkdir -p ${BUILD_PREFIX}/bin\n          - cp ${RECIPE_DIR}/cargo-auditable-wrapper.sh ${BUILD_PREFIX}/bin/cargo-auditable-wrapper\n          - export CARGO=\"cargo-auditable-wrapper\"\n        else:\n          - copy %RECIPE_DIR%\\cargo-auditable-wrapper.bat %BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\n          - set \"CARGO=cargo-auditable-wrapper.bat\"\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - make\n  host:\n    - python\n    - maturin >=1.0,<2.0\n    - pip\n    - if: is_abi3\n      then: python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - typst\n      pip_check: true\n      python_version:\n        - \"*\"\n        - if: is_abi3\n          then: ${{ python_min }}\n  - if: is_abi3\n    then:\n      script:\n        - if: win\n          then: abi3audit %PREFIX%/Lib/site-packages/typst/_typst.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else: abi3audit $SP_DIR/typst/_typst.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\n\nabout:\n  summary: Python binding to typst\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://github.com/messense/typst-py\n\nextra:\n  recipe-maintainers:\n    - freundTech\n    - pavelzw\n",
