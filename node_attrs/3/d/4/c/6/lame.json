  "raw_meta_yaml": "{% set version = \"4.0\" %}\n\npackage:\n  name: lame\n  version: \"{{ version }}\"\n\nsource:\n  url: https://downloads.sourceforge.net/sourceforge/lame/lame-{{ version }}.tar.gz\n  sha256: 3df5124d5ad3a98312ffd7ba6a9b36230e4f8a3e66d3ce0f425e336c32d216eb\n  patches:\n    - fixup_windows_build.patch\n    # Make the id3tag ucs2 helper prototypes visible to the frontend and give\n    # the id3v2 utf8 helpers matching pointer types, so lame 3.101 builds with\n    # GCC 14 (which promotes these legacy-C warnings to errors).\n    - fix_id3tag_ucs2_decls.patch\n    - fix_id3tag_utf8_casts.patch\n    - fix_id3v2tag_utf8_frontend.patch\n    # parse.c uses setlocale(LC_CTYPE, ...) under HAVE_LANGINFO_H but only\n    # includes <locale.h> under HAVE_ICONV; include it independently.\n    - fix_missing_locale_include.patch\n\nbuild:\n  number: 1\n  run_exports:\n    # seems to be minor version compatibility\n    # https://abi-laboratory.pro/tracker/timeline/lame/\n    - {{ pin_subpackage('lame', max_pin='x.x') }}\n\nrequirements:\n  build:\n    - gnuconfig  # [unix]\n    - {{ compiler('c') }}\n    - {{ stdlib(\"c\") }}\n    - make  # [unix]\n    - nasm  # [win]\n    - pkg-config  # [unix]\n  host:\n    # lame 3.101 dropped the bundled mpglib decoder and now decodes via\n    # libmpg123 (see configure.ac / Makefile.MSVC).\n    - mpg123\n\ntest:\n  commands:\n    - lame --genre-list testcase.mp3\n    - lame --longhelp\n    - test -f $PREFIX/include/lame/lame.h  # [not win]\n    - if not exist %PREFIX%\\\\Library\\\\include\\\\lame\\\\lame.h exit 1  # [win]\n\nabout:\n  home: https://lame.sourceforge.io/\n  license: LGPL-2.0-only\n  license_family: LGPL\n  license_file: COPYING\n  summary: 'High quality MPEG Audio Layer III (MP3) encoder'\n\n  # The remaining entries in this section are optional, but recommended\n  description: |\n    LAME is a high quality MPEG Audio Layer III (MP3) encoder licensed under the LGPL.\n    Today, LAME is considered the best MP3 encoder at mid-high bitrates and at VBR, mostly\n    thanks to the dedicated work of its developers and the open source licensing model\n    that allowed the project to tap into engineering resources from all around the world.\n  doc_url: http://lame.sourceforge.net/using.php\n  dev_url: https://svn.code.sf.net/p/lame/svn/trunk/lame/\n\nextra:\n  recipe-maintainers:\n    - soumith\n    - hmaarrfk\n    - bmcfee\n",
  "req": {
