  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  version: \"1.2.1\"\n  maturin_min: \"1.5.1\"\n  python_check_max: \"3.14\"\n\npackage:\n  name: pyproject-fmt-rust\n  version: ${{ version }}\n\nsource:\n  url: https://files.pythonhosted.org/packages/source/p/pyproject-fmt-rust/pyproject_fmt_rust-${{ version }}.tar.gz\n  sha256: ff4b41f35a1e571ae07a890269c716c202c4d832a427ad2ef488527b55a20fe2\n\nbuild:\n  number: 2\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: ${{ is_abi3 }}\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO: cargo-auditable-wrapper${{ \".bat\" if win }}\n      PYTHONIOENCODING: utf-8\n      PYTHONLEGACYTEXTENCODING: utf-8\n    content:\n      - if: win\n        then:\n          - copy \"%RECIPE_DIR%\\cargo-auditable-wrapper.bat\" \"%BUILD_PREFIX%\\Library\\bin\\cargo-auditable-wrapper.bat\"\n        else:\n          - cp \"${RECIPE_DIR}/cargo-auditable-wrapper.sh\" \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"\n          - chmod 755 \"${BUILD_PREFIX}/bin/cargo-auditable-wrapper\"\n      - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation --disable-pip-version-check\n      - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ compiler(\"c\") }}\n    - ${{ compiler(\"rust\") }}\n    - ${{ stdlib(\"c\") }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n  host:\n    - maturin >=${{ maturin_min }}\n    - pip\n    - python\n    - if: is_abi3\n      then:\n        - python-abi3\n  run:\n    - python\n\ntests:\n  - python:\n      imports: pyproject_fmt_rust\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - ${{ python_check_max }}.*\n  - files:\n      source:\n        - tests/\n    requirements:\n      run:\n        - coverage\n        - pytest >=8.2\n        - if: is_abi3\n          then:\n            - abi3audit\n            - python !=${{ python_min }}.*\n    script:\n      - coverage run --source=pyproject_fmt_rust -m pytest -vv --tb=long --color=yes\n      - coverage report --show-missing --skip-covered --fail-under=100\n      - if: is_abi3\n        then:\n          - cd ${{ \"$SP_DIR\" if unix else \"%SP_DIR%\" }}/pyproject_fmt_rust\n          - abi3audit -s -v --assume-minimum-abi3 ${{ python_min }} _lib.${{ \"abi3.so\" if unix else \"pyd\" }}\n\nabout:\n  summary: Format your pyproject.toml file\n  license: MIT\n  license_file:\n    - LICENSE.txt\n    - THIRDPARTY.yml\n  homepage: https://pypi.org/project/pyproject-fmt-rust\n  repository: https://github.com/tox-dev/pyproject-fmt-rust\n\nextra:\n  recipe-maintainers:\n    - bollwyvl\n",
