  "raw_meta_yaml": "context:\n  name: ghostty\n  version: \"1.3.1\"\n\npackage:\n  name: ${{ name }}\n  version: ${{ version }}\n\nsource:\n  url: https://release.files.ghostty.org/${{ version }}/ghostty-${{ version }}.tar.gz\n  sha256: 3349d25600ffbda281197a18314f7d18791969cffe9474f0ff16a45a9ebfccdb\n  patches:\n    # Mark NSDockTile.setIcon's parameter as `sending` so Xcode 16.4's\n    # Swift 6 compiler accepts the cross-actor transfer to DispatchQueue.main.\n    # Xcode 26 (what upstream targets) infers this; 16.4 doesn't.\n    - patches/dock-tile-plugin-sending.patch\n    # Drop the new Xcode-26 .icon directory (\"Liquid Glass\" icon format)\n    # from the project. Compiling it requires the AssetCatalogAgent helper\n    # daemon, which crashes on the headless conda-forge macOS runner with\n    # IBPlatformToolFailureException (\"The tool closed the connection\").\n    # Without the .icon ref, actool falls back to the legacy AppIcon set\n    # in Assets.xcassets — flat icon, no Liquid Glass effect on macOS 26,\n    # but the build completes cleanly.\n    # TODO: ship a pre-compiled Assets.car (built locally with full GUI)\n    # alongside the recipe so we can keep the Liquid Glass icon.\n    - patches/drop-iconcomposer-icon.patch\n\nbuild:\n  number: 4\n  dynamic_linking:\n    # On osx we ship a self-contained .app bundle with Sparkle.framework\n    # inside Contents/Frameworks/. xcodebuild emits the standard\n    # @rpath = @executable_path/../Frameworks for that case. Without\n    # this opt-out, rattler-build's binary relocator rewrites the\n    # rpath to @executable_path/../../../../lib (conda's standard\n    # lib/), which breaks Sparkle loading at launch:\n    #   dyld: Library not loaded: @rpath/Sparkle.framework/...\n    #         tried: $PREFIX/lib/Sparkle.framework/... (no such file)\n    # We express this as a conditional allowlist instead of `false`:\n    #   - linux: [\"**\"]  → relocate everything (default behaviour)\n    #   - osx:   []      → relocate nothing\n    # If a future maintainer adds a conda host dep on macOS the\n    # resulting binary won't have its rpath rewritten and the test\n    # will fail with \"image not found\" — which is the right signal\n    # to come back and tighten this list.\n    binary_relocation:\n      - if: linux\n        then: \"**\"\n  # Platform support, current state:\n  #   - linux-64: built via zig (see build.sh, linux branch).\n  #   - osx-arm64: built via xcodebuild + ad-hoc codesigning against\n  #     macos/Ghostty.xcodeproj (see build.sh, osx branch). Going native-arm\n  #     first because earlier osx-64 attempts panicked inside zig\n  #     (\"reached unreachable code\" compiling x86_64-macos.13.0 against\n  #     MacOSX15.5.sdk) — we suspected the conda-forge x86_64 zig running\n  #     under Rosetta on an Apple Silicon runner.\n  #   - osx-64: temporarily skipped. With build_platform.osx_64=osx_arm64\n  #     in conda-forge.yml the osx_64 build would cross-compile from arm64,\n  #     but we want osx-arm64 green first before opening up the cross-build.\n  #   - linux-aarch64: skipped — gtk4-layer-shell isn't packaged for it yet.\n  #   - Windows: unsupported upstream.\n  skip:\n    - win\n    - linux and ppc64le\n    - osx and x86_64\n  script:\n    file: build\n\nrequirements:\n  build:\n    # Pin to zig 0.15.2 build 22+ for the stdlib patches that bypass\n    # missing libc symbols (fstat/getrandom/copy_file_range) and remap\n    # absolute paths in linker scripts under a sysroot. We still need\n    # variants.yaml's c_stdlib_version: 2.34 because the comptime gate\n    # in those patches only fires when zig is invoked with an explicit\n    # `-target x86_64-linux-gnu.2.17` and ghostty's build.zig launches\n    # sub-compiles with `native-native` target.\n    # zig is also invoked from the Xcode project's run-script build\n    # phases on macOS, so it's a build dep on both platforms.\n    - 'zig 0.15.2.* [build_number=\">=22\"]'\n    # pandoc is invoked by ghostty's zig build to generate manpages and\n    # HTML docs on every platform — without it: \"error: failed to spawn\n    # and capture stdio from pandoc: FileNotFound\".\n    - pandoc\n    - if: linux\n      then:\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - pkg-config\n        - gettext\n        - libxml2\n        - gobject-introspection\n        - wayland-protocols\n    # macOS: xcodebuild is system-provided on the conda-forge osx_arm64\n    # runner. Additional macOS-only build deps to be discovered via CI.\n  host:\n    - if: linux\n      then:\n        # GTK / GUI\n        - gtk4\n        - libadwaita\n        - gtk4-layer-shell\n        - libxkbcommon\n        - wayland\n        - xorg-libx11\n        - xorg-libxcursor\n        - xorg-libxi\n        - xorg-libxrandr\n        - libgl-devel\n        - gst-plugins-base\n        - gst-plugins-good\n        - gstreamer\n        # System libraries linked dynamically by zig build's\n        # systemIntegrationOption defaults on Linux.\n        - bzip2\n        - expat\n        - fontconfig\n        - freetype\n        - harfbuzz\n        - libpng\n        - libxml2\n        - oniguruma\n        - zlib\n    # macOS host deps live inside the .app bundle (Sparkle, Swift libs)\n    # or come from the system SDK. Start empty; tighten once CI is green.\n  run:\n    - if: linux\n      then:\n        # gtk4-layer-shell doesn't export a run-export, so the .so.0 needs to\n        # be listed explicitly (otherwise: \"ghostty: error while loading shared\n        # libraries: libgtk4-layer-shell.so.0\").\n        - gtk4-layer-shell\n        # GStreamer is dlopened at runtime for video/audio integrations.\n        - gst-plugins-base\n        - gst-plugins-good\n        - gstreamer\n    # macOS run deps: bundled inside Ghostty.app — none required from conda.\n\ntests:\n  - script:\n      - ghostty --version\n      - ghostty +help\n  - package_contents:\n      bin:\n        - ghostty\n      files:\n        - Menu/ghostty.json\n        - if: linux\n          then:\n            - share/applications/com.mitchellh.ghostty.desktop\n            # ghostty installs its terminfo as the canonical xterm-ghostty entry\n            # (with a relative symlink ghostty -> xterm-ghostty that conda strips\n            # and we recreate in build.sh).\n            - share/terminfo/78/xterm-ghostty\n            - share/terminfo/x/xterm-ghostty\n        - if: osx\n          then:\n            - Applications/Ghostty.app/Contents/MacOS/ghostty\n            - Applications/Ghostty.app/Contents/Info.plist\n            # Assets.car is the compiled asset catalog (icons, etc.). On\n            # earlier runs xcodebuild's ibtoold sub-tool crashed during\n            # CompileAssetCatalogVariant — printed \"BUILD FAILED\" but the\n            # overall build still appeared to succeed. Listing it here so\n            # if it's ever missing the package_contents test catches it\n            # instead of silently shipping an iconless bundle.\n            - Applications/Ghostty.app/Contents/Resources/Assets.car\n\nabout:\n  homepage: https://ghostty.org\n  summary: A fast, native, feature-rich terminal emulator\n  description: |\n    Ghostty is a terminal emulator that differentiates itself by being fast,\n    feature-rich, and native. While there are many excellent terminal emulators\n    available, they all force you to choose between speed, features, or native\n    UIs. Ghostty provides all three.\n  license: MIT\n  license_file: LICENSE\n  repository: https://github.com/ghostty-org/ghostty\n  documentation: https://ghostty.org/docs\n\nextra:\n  recipe-maintainers:\n    - tdejager\n",
