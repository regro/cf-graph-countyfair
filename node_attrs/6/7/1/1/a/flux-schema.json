  "raw_meta_yaml": "context:\n  version: \"0.12.1\"\n  grep: ${{ \"grep\" if unix else \"findstr\" }}\n\npackage:\n  name: flux-schema\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/fluxcd/flux-schema/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 33162afbbecf8c2e2c8eeea2941b35265d2a47a63d54063a495d6a40b96b20be\n\nbuild:\n  number: 0\n  script:\n    - go-licenses save ./cmd/flux-schema --save_path ./library_licenses\n    - if: unix\n      then:\n        - go build -v -o $PREFIX/bin/flux-schema -ldflags=\"-s -w -X main.VERSION=${{ version }}\" ./cmd/flux-schema\n        - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n        - $PREFIX/bin/flux-schema completion zsh > $PREFIX/share/zsh/site-functions/_flux-schema\n        - $PREFIX/bin/flux-schema completion bash > $PREFIX/share/bash-completion/completions/flux-schema\n        - $PREFIX/bin/flux-schema completion fish > $PREFIX/share/fish/vendor_completions.d/flux-schema.fish\n      else: go build -v -o %LIBRARY_BIN%\\flux-schema.exe -ldflags=\"-s -w -X main.VERSION=${{ version }}\" ./cmd/flux-schema\nrequirements:\n  build:\n    - ${{ compiler(\"go-nocgo\") }}\n    - go-licenses\n\ntests:\n  - script: flux-schema version | ${{ grep }} \"${{ version }}\"\n  - package_contents:\n      bin:\n        - flux-schema\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/flux-schema\n            - share/fish/vendor_completions.d/flux-schema.fish\n            - share/zsh/site-functions/_flux-schema\n      strict: true\n\nabout:\n  homepage: https://github.com/fluxcd/flux-schema\n  summary: Flux CLI plugin for Kubernetes manifests validation against JSON Schemas and CEL rules\n  description: |\n    Flux Schema is a CLI for validating Kubernetes YAML manifests against JSON\n    Schema and CEL rules using the same evaluation semantics as the Kubernetes\n    API server. It ships as a single Go binary with a built-in catalog\n    covering Kubernetes, OpenShift, Gateway API, and the Flux ecosystem CRDs.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - library_licenses/\n  documentation: https://github.com/fluxcd/flux-schema/tree/main/docs\n  repository: https://github.com/fluxcd/flux-schema\n\nextra:\n  recipe-maintainers:\n    - aaronlionsheep\n",
