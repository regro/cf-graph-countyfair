  "linux_64_meta_yaml": {
    "about": {
      "description": "Xwayland is an X server that runs as a Wayland client, allowing X11\napplications to display on a Wayland compositor without modification.\n\nIt is built here with glamor and DRI3 enabled. GLX is disabled because\nconda-forge ships no dri.pc / dri_interface.h, so X11 clients under\nXwayland use software GL rather than hardware accelerated GLX.",
      "dev_url": "https://gitlab.freedesktop.org/xorg/xserver",
      "doc_url": "https://wayland.freedesktop.org/xserver.html",
      "home": "https://www.x.org/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "COPYING",
      "summary": "Run X11 clients under a Wayland compositor"
    },
    "build": {
      "number": "1",
      "script": "build.sh"
    },
    "extra": {
      "recipe-maintainers": [
        "hmaarrfk"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "xwayland",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "meson",
            "ninja",
            "pkg-config",
            "wayland"
          ],
          "host": [
            "wayland",
            "wayland-protocols",
            "xorg-xorgproto",
            "xorg-libxcvt",
            "xorg-libx11",
            "xorg-libxau",
            "xorg-libxdmcp",
            "xorg-libxshmfence",
            "xorg-xtrans",
            "libxkbfile",
            "libxfont2",
            "libfontenc",
            "libxkbcommon",
            "libdrm",
            "pixman",
            "epoxy",
            "libgbm",
            "libegl-devel",
            "nettle",
            "xkbcomp"
          ],
          "run": [
            "xkbcomp",
            "xkeyboard-config"
          ]
        },
        "tests": [
          {
            "package_contents": {
              "bin": [
                "Xwayland"
              ]
            }
          },
          {
            "requirements": {
              "run": [
                "pkg-config"
              ]
            },
            "script": [
              "Xwayland -version",
              "pkg-config --modversion xwayland",
              "test \"$(pkg-config --variable=xwayland xwayland)\" = \"${PREFIX}/bin/Xwayland\""
            ]
          }
        ],
        "version": "24.1.13"
      }
    ],
