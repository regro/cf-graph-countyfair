  "linux_64_meta_yaml": {
    "about": {
      "description": "ccusage reads the local session logs written by coding agent CLIs -- Claude\nCode, Codex, Copilot CLI, Gemini CLI, OpenCode and others -- and reports the\ntokens they consumed and what those tokens cost. Reports can be grouped by\nday, week, month, session or billing block, printed as tables or JSON, and\nrendered as a compact status line for Claude Code hooks.",
      "dev_url": "https://github.com/ccusage/ccusage",
      "doc_url": "https://ccusage.com/",
      "home": "https://github.com/ccusage/ccusage",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Analyze coding (agent) CLI token usage and costs from local data"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --features fetch-litellm-pricing --root ${{ PREFIX }} --path rust/crates/ccusage",
          "cd rust",
          "cargo-bundle-licenses --format yaml --features fetch-litellm-pricing --output ../THIRDPARTY.yml"
        ]
      }
    },
    "extra": {
      "recipe-maintainers": [
        "pavelzw"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "ccusage",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "ccusage --version",
              "ccusage --help",
              "ccusage daily --help",
              "ccusage claude --help"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "ccusage"
              ],
              "strict": true
            }
          }
        ],
        "version": "20.0.20"
      }
    ],
