  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: giflib\n  version: \"6.1.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  - url: https://downloads.sourceforge.net/project/giflib/giflib-6.x/giflib-${{ version }}.tar.gz\n    sha256: b65b66b99f0424b93525f987386f22fc5efb9da2bfc92ad4a532249aaffbab0e\n    patches:\n      - if: win\n        then:\n          - fix_win.patch\n  - if: win\n    then:\n      - path: getopt.h\n\nbuild:\n  number: 2\n  skip:\n    - win and vc < 14\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - cmake\n    - if: win\n      then:\n        - git\n    - if: unix\n      then:\n        - make\n  run_exports:\n    # SONAME changes at minor revs.\n    # https://abi-laboratory.pro/tracker/timeline/giflib/\n    - ${{ pin_subpackage(\"giflib\", upper_bound=\"x.x\") }}\n\ntests:\n  - script:\n      - if: unix\n        then:\n          - gif2rgb -h\n          - gifbuild -h\n          - gifclrmp -h\n          - giffix -h\n          - giftext -h\n\nabout:\n  homepage: https://giflib.sourceforge.net/\n  license: MIT\n  license_file:\n    - COPYING\n    - if: win\n      then: getopt_LICENSE.txt\n  summary: Library for reading and writing gif images\n\nextra:\n  recipe-maintainers:\n    - ocefpaf\n    - 183amir\n    - msarahan\n    - isuruf\n    - wolfv\n    - katietz\n",
