  "linux_64_meta_yaml": {
    "about": {
      "description": "Litterbox is a Linux sandbox environment for developers. It provides some\nisolation between a containerised development environment and the host\nsystem, while also offering a repeatable and documented environment for\ndevelopment.",
      "dev_url": "https://github.com/Gerharddc/Litterbox",
      "home": "https://litterbox.work/",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "Somewhat isolated development environments"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cd litterbox",
          "sed -i -e '/^name = \"litterbox\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' -e '/^name = \"lbx-init\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' -e '/^name = \"shared\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' Cargo.lock ../lbx-init/Cargo.lock ../shared/Cargo.lock",
          "cargo auditable install --path=.           --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo auditable install --path=../lbx-init --root=\"$PREFIX\" --no-track --locked --bins",
          "cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "salim-b"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "litterbox",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "rust_compiler_stub",
            "cargo-auditable",
            "cargo-bundle-licenses"
          ],
          "host": [],
          "run": []
        },
        "tests": [
          {
            "script": [
              "litterbox --help",
              "litterbox --version",
              "lbx-init --help",
              "lbx-init --version"
            ]
          },
          {
            "package_contents": {
              "bin": [
                "litterbox",
                "lbx-init"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.6.4"
      }
    ],
