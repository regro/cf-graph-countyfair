  "raw_meta_yaml": "context:\n  version: \"0.6.4\"\n\npackage:\n  name: litterbox\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/Gerharddc/Litterbox/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: fdd64fdcdaa340789bce32b56216dd673b294e38c0dff0639abd191ec21b1471\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - cd litterbox\n      # upstream release lockfiles still contain the previous package version, meaning we need to correct them to be usable with `--locked`\n      - sed -i -e '/^name = \"litterbox\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' -e '/^name = \"lbx-init\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' -e '/^name = \"shared\"$/,+1 s/version = \"0.6.1\"/version = \"${{ version }}\"/' Cargo.lock ../lbx-init/Cargo.lock ../shared/Cargo.lock\n      - cargo auditable install --path=.           --root=\"$PREFIX\" --no-track --locked --bins\n      - cargo auditable install --path=../lbx-init --root=\"$PREFIX\" --no-track --locked --bins\n      - cargo-bundle-licenses --format=yaml --output=../THIRDPARTY.yml\n  skip: not linux\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-auditable\n    - cargo-bundle-licenses\n\ntests:\n  - script:\n      - litterbox --help\n      - litterbox --version\n      - lbx-init --help\n      - lbx-init --version\n  - package_contents:\n      bin:\n        - litterbox\n        - lbx-init\n      strict: true\n\nabout:\n  summary: Somewhat isolated development environments\n  description: |\n    Litterbox is a Linux sandbox environment for developers. It provides some\n    isolation between a containerised development environment and the host\n    system, while also offering a repeatable and documented environment for\n    development.\n  license: Apache-2.0\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  homepage: https://litterbox.work/\n  repository: https://github.com/Gerharddc/Litterbox\n\nextra:\n  recipe-maintainers:\n    - salim-b\n",
