  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: \"4.64.1\"\n\npackage:\n  name: nxstools\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/nexdatas/nxstools/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: d608dd7ded25c63966491633a9ba5521aa74b335118954cefb23510dd4f99420\n\nbuild:\n  noarch: python\n  number: 0\n  script:\n    - ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - setuptools >=61\n    - pip\n    - wheel\n  run:\n    - python >=${{ python_min }}\n    - numpy\n    - argcomplete\n    - lxml\n    - pytz\n    - pyyaml\n    - pytango\n    - python-dateutil\n    - pninexus\n    - fabio\n    - h5py\n    - matplotlib-base\n    - blissdata\n    # - blissdata-h5file-detector\n\ntests:\n  - python:\n      imports:\n        - nxstools\n        - nxstools.filewriter\n        - nxstools.filenamegenerator\n        - nxstools.nxsargparser\n        - nxstools.nxsdevicetools\n        - nxstools.nxscollect\n        - nxstools.nxsconfig\n        - nxstools.nxscreate\n        - nxstools.nxscreator\n        - nxstools.nxsdata\n        - nxstools.nxsetup\n        - nxstools.nxsfileinfo\n        - nxstools.nxsfileparser\n        - nxstools.nxsparser\n        - nxstools.nxsxml\n        - nxstools.ontology\n        - nxstools.pyeval.lambdavds\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n  - script:\n      - if: unix or osx\n        then:\n          - test -x \"$PREFIX/bin/nxsconfig\"\n          - test -x \"$PREFIX/bin/nxscreate\"\n          - test -x \"$PREFIX/bin/nxsdata\"\n          - test -x \"$PREFIX/bin/nxsetup\"\n          - test -x \"$PREFIX/bin/nxsfileinfo\"\n          - test -x \"$PREFIX/bin/nxscollect\"\n          - nxsconfig --help\n          - nxscreate --help\n          - nxsdata --help\n          - nxsetup --help\n          - nxsfileinfo --help\n          - nxscollect --help\n    requirements:\n      run:\n        - python ${{