    "about": {
      "description": "Command-line tools for Nexus Data Writer - python3 module\nIt provides command-line tools to communicate with Tango servers:\nNXSDataWriter and NXSConfigServer as well as to create simple \ndatasources and components containing writer's configuration.\nIt contains also python modules used by NXSDataWriter server\nto write NeXus files and publish metadata into blissdata.",
      "dev_url": "https://github.com/nexdatas/nxstools",
      "home": "https://github.com/nexdatas/nxstools",
      "license": "GPL-3.0-or-later",
      "license_family": "GPL-3.0-or-later",
      "license_file": "COPYRIGHT",
      "summary": "NeXDaTaS configuration tools (nxsconfig, nxscreate, nxsdata, nxscollect, nxsetup, nxsfileinfo)"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "jkotan"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "nxstools",
        "requirements": {
          "build": [],
          "host": [
            "python 3.11.*",
            "setuptools >=61",
            "pip",
            "wheel"
          ],
          "run": [
            "python >=3.11",
            "numpy",
            "argcomplete",
            "lxml",
            "pytz",
            "pyyaml",
            "pytango",
            "python-dateutil",
            "pninexus",
            "fabio",
            "h5py",
            "matplotlib-base",
            "blissdata"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "nxstools",
                "nxstools.filewriter",
                "nxstools.filenamegenerator",
                "nxstools.nxsargparser",
                "nxstools.nxsdevicetools",
                "nxstools.nxscollect",
