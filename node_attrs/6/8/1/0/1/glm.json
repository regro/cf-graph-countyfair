  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: GLM\n  version: \"1.0.3\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/g-truc/glm/archive/refs/tags/${{ version }}.tar.gz\n  sha256: 6775e47231a446fd086d660ecc18bcd076531cfedd912fbd66e576b118607001\n  patches:\n    # Upstream enables warnings-as-errors in its tests, which breaks as\n    # compilers add diagnostics. Remove once this can be disabled separately.\n    - patches/disable_warnings_as_errors.patch\n\nbuild:\n  number: 1\n\nrequirements:\n  build:\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - cmake\n    - if: unix\n      then: make\n  run_exports:\n    - ${{ pin_subpackage(\"glm\", upper_bound=\"x.x\") }}\n\ntests:\n  - files:\n      recipe:\n        - test/CMakeLists.txt\n        - test/main.cpp\n    requirements:\n      run:\n        - cmake\n        - cmake-package-check\n        - ninja\n        - ${{ compiler('c') }}\n        - ${{ compiler('cxx') }}\n    script:\n      - if: unix\n        then: test -r \"${PREFIX}/include/glm\"\n      - if: win\n        then: if not exist %LIBRARY_INC%\\glm exit 1\n      - if: linux\n        then: test -f \"${PREFIX}/lib/libglm.so\"\n      - if: osx\n        then: test -f \"${PREFIX}/lib/libglm.dylib\"\n      - if: unix\n        then: test ! -f \"${PREFIX}/lib/libglm.a\"\n      - if: win\n        then: if not exist %LIBRARY_BIN%\\glm.dll exit 1\n      - cmake-package-check glm --targets glm::glm glm::glm-header-only\n      - cmake -S test -B test-build -G Ninja\n      - cmake --build test-build\n      - if: unix\n        then: test-build/glm-test\n      - if: win\n        then: test-build\\glm-test.exe\n\nabout:\n  license: MIT\n  license_file: manual.md\n  summary: OpenGL Mathematics\n  homepage: https://glm.g-truc.net\n  repository: https://github.com/g-truc/glm\n\nextra:\n  recipe-maintainers:\n    - traversaro\n",
