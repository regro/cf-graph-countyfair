  "linux_64_meta_yaml": {
    "about": {
      "description": "Fastpotify is a native Spotify client with local playback, Spotify\nConnect, media-key integration, and system tray support.",
      "dev_url": "https://github.com/crmne/fastpotify",
      "home": "https://fastpotify.rocks/",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Fast, lightweight, native Spotify client"
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "export BINDGEN_EXTRA_CLANG_ARGS=\"--sysroot=$CONDA_BUILD_SYSROOT\"",
          "export CMAKE_TOOLCHAIN_FILE=\"$RECIPE_DIR/projectm-toolchain.cmake\"",
          "LIBCLANG_PATH=\"$BUILD_PREFIX/lib\" cargo auditable install --locked --no-track --bins --root \"${LIBRARY_PREFIX:-$PREFIX}\" --path .",
          "mkdir -p \"$PREFIX/Menu\"",
          "cp \"$RECIPE_DIR/menu.json\" \"$PREFIX/Menu/fastpotify.json\"",
          "cp packaging/macos/icon-1024.png \"$PREFIX/Menu/fastpotify.png\"",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        },
        "interpreter": "brush"
      }
    },
    "extra": {
      "recipe-maintainers": [
        "baszalmstra"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "fastpotify",
        "requirements": {
          "build": [
            "c_stdlib_stub",
            "c_compiler_stub",
            "cxx_compiler_stub",
            "rust_compiler_stub",
            "cmake",
            "brush",
            "cargo-auditable",
            "cargo-bundle-licenses",
            "libclang",
            "clangdev",
            "make",
            "pkg-config"
          ],
          "host": [
            "alsa-lib",
            "libgl-devel",
            "libxkbcommon",
            "pulseaudio-client",
            "wayland",
            "xorg-libx11",
            "xorg-xorgproto"
          ],
          "run": [
            "xorg-libxcursor",
            "xorg-libxi",
            "xorg-libxrandr"
          ]
        },
        "tests": [
          {
            "script": "fastpotify --help"
          },
          {
            "package_contents": {
              "bin": [
                "fastpotify"
              ],
              "files": [
                "Menu/fastpotify.*"
              ],
              "strict": true
            }
          }
        ],
        "version": "0.7.1"
      }
