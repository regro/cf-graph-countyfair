  "raw_meta_yaml": "context:\n  version: \"0.7.1\"\n\npackage:\n  name: fastpotify\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/crmne/fastpotify/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 8b5c54e514a27d8e06dcb3300418d7d9c01588d6f087715299e8b380582df60b\n\nbuild:\n  number: 0\n  script:\n    interpreter: brush\n    env:\n      CARGO_PROFILE_RELEASE_LTO: fat\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n    content:\n      - if: linux\n        then:\n          - export BINDGEN_EXTRA_CLANG_ARGS=\"--sysroot=$CONDA_BUILD_SYSROOT\"\n          - export CMAKE_TOOLCHAIN_FILE=\"$RECIPE_DIR/projectm-toolchain.cmake\"\n      - if: unix\n        then: LIBCLANG_PATH=\"$BUILD_PREFIX/lib\" cargo auditable install --locked --no-track --bins --root \"${LIBRARY_PREFIX:-$PREFIX}\" --path .\n        else: cargo auditable install --locked --no-track --no-default-features --bins --root \"${LIBRARY_PREFIX:-$PREFIX}\" --path .\n      - mkdir -p \"$PREFIX/Menu\"\n      - cp \"$RECIPE_DIR/menu.json\" \"$PREFIX/Menu/fastpotify.json\"\n      - if: linux\n        then: cp packaging/macos/icon-1024.png \"$PREFIX/Menu/fastpotify.png\"\n      - if: osx\n        then:\n          - bash packaging/macos/bundle.sh \"$PREFIX/bin/fastpotify\" Fastpotify.app \"$PKG_VERSION\"\n          - cp Fastpotify.app/Contents/Resources/fastpotify.icns \"$PREFIX/Menu/fastpotify.icns\"\n      - if: win\n        then: cp packaging/windows/fastpotify.ico \"$PREFIX/Menu/fastpotify.ico\"\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('cxx') }}\n    - ${{ compiler('rust') }}\n    - cmake\n    - brush\n    - cargo-auditable\n    - cargo-bundle-licenses\n    - if: unix\n      then: libclang\n    - if: linux\n      then:\n        - clangdev\n        - make\n        - pkg-config\n    - if: win\n      then: uutils-coreutils\n  host:\n    - if: linux\n      then:\n        - alsa-lib\n        - libgl-devel\n        - libxkbcommon\n        - pulseaudio-client\n        - wayland\n        - xorg-libx11\n        - xorg-xorgproto\n  run:\n    - if: linux\n      then:\n        - xorg-libxcursor\n        - xorg-libxi\n        - xorg-libxrandr\n\ntests:\n  - script:\n      - fastpotify --help\n  - package_contents:\n      bin:\n        - fastpotify\n      files:\n        - Menu/fastpotify.*\n      strict: true\n\nabout:\n  homepage: https://fastpotify.rocks\n  summary: Fast, lightweight, native Spotify client\n  description: |\n    Fastpotify is a native Spotify client with local playback, Spotify\n    Connect, media-key integration, and system tray support.\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/crmne/fastpotify\n\nextra:\n  recipe-maintainers:\n    - baszalmstra\n",
