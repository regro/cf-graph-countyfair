  "raw_meta_yaml": "context:\n  version: \"2.3.1\"\n\nrecipe:\n  name: osm2pgsql\n  version: ${{ version }}\n\nsource:\n  - url: https://github.com/osm2pgsql-dev/osm2pgsql/archive/refs/tags/${{ version }}.tar.gz\n    sha256: e90461bd78787fd5cf82f73ac4bc0cfccbc4f498f35dce59eb4d168a380d6ac0\n\nbuild:\n  number: 0\n\noutputs:\n  - package:\n      name: osm2pgsql\n      version: ${{ version }}\n    build:\n      number: 0\n      script:\n        - if: unix\n          then: build.sh\n          else: build.bat\n    requirements:\n      build:\n        - ${{ compiler('cxx') }}\n        - ${{ stdlib('c') }}\n        - cmake\n        - ninja\n        - pkg-config\n      host:\n        - expat\n        - proj\n        - bzip2\n        - zlib\n        - postgresql\n        - lua\n        - protozero\n        - libosmium\n        - cli11\n        - fmt <12\n        - nlohmann_json\n        - libboost-devel\n      run:\n        - lua\n        - osm2pgsql-replication\n    tests:\n      - files:\n          recipe:\n            - test.sh\n            - liechtenstein-2013-08-03.osm.pbf\n        requirements:\n          run:\n            - postgresql\n            - if: unix\n              then: postgis\n        script:\n          - osm2pgsql --version\n          - osm2pgsql --help\n          - if: unix\n            then: bash test.sh\n    about:\n      homepage: https://osm2pgsql.org\n      license: GPL-2.0-only\n      license_file:\n        - COPYING\n      summary: Import OpenStreetMap data into a PostgreSQL/PostGIS database\n      description: osm2pgsql is a tool for loading OpenStreetMap data into a PostgreSQL / PostGIS database suitable for applications like rendering into a map, geocoding with Nominatim, or general analysis.\n      documentation: https://osm2pgsql.org\n      repository: https://github.com/osm2pgsql-dev/osm2pgsql\n\n  - package:\n      name: osm2pgsql-replication\n      version: ${{ version }}\n    build:\n      noarch: python\n      script:\n        - if: unix\n          then: build-replication.sh\n          else: build-replication.bat\n    requirements:\n      host:\n        - python ${{ python_min }}.*\n        - pip\n        - hatchling\n      run:\n        - python >=${{ python_min }}\n        - pyosmium\n        - psycopg\n    tests:\n      - python:\n          python_version: ${{ python_min }}\n      - requirements:\n          run:\n            - python ${{ python_min }}.*\n        script:\n          - if: unix\n            then: osm2pgsql-replication --help 2>&1 | grep -qi \"usage\"\n    about:\n      homepage: https://osm2pgsql.org\n      license: GPL-2.0-only\n      license_file:\n        - COPYING\n      summary: Replication tool for osm2pgsql\n      description: osm2pgsql-replication keeps a database loaded with osm2pgsql up to date with the latest changes from OpenStreetMap.\n      documentation: https://osm2pgsql.org/doc/manual.html#keeping-the-database-up-to-date-with-osm2pgsql-replication\n      repository: https://github.com/osm2pgsql-dev/osm2pgsql\n\nabout:\n  homepage: https://osm2pgsql.org\n  license: GPL-2.0-only\n  license_file:\n    - COPYING\n  summary: Import OpenStreetMap data into a PostgreSQL/PostGIS database\n  description: osm2pgsql is a tool for loading OpenStreetMap data into a PostgreSQL / PostGIS database suitable for applications like rendering into a map, geocoding with Nominatim, or general analysis.\n  documentation: https://osm2pgsql.org\n  repository: https://github.com/osm2pgsql-dev/osm2pgsql\n\nextra:\n  recipe-maintainers:\n    - travishathaway\n",
