    "about": {
      "description": "The Couchbase Python SDK allows Python applications to access a Couchbase\ncluster. It bundles and compiles the couchbase-cxx-client C++ core via CMake\nat install time. It offers synchronous (couchbase), asyncio (acouchbase),\nand Twisted (txcouchbase) APIs for key-value, query, search, analytics, and\ncluster/bucket management operations.",
      "dev_url": "https://github.com/couchbase/couchbase-python-client",
      "doc_url": "https://docs.couchbase.com/python-sdk/current/hello-world/start-using-sdk.html",
      "home": "https://pypi.org/project/couchbase/",
      "license": "Apache-2.0 AND MIT AND BSD-3-Clause AND BSD-2-Clause AND CC0-1.0 AND BSL-1.0",
      "license_family": "Apache-2.0 AND MIT AND BSD-3-Clause AND BSD-2-Clause AND CC0-1.0 AND BSL-1.0",
      "license_file": "LICENSE",
      "summary": "Python Client for Couchbase"
    },
    "build": {
      "number": "0",
      "script": {
        "content": "export PYCBC_OPENSSL_DIR=\"${PREFIX}\"\nexport PYCBC_CMAKE_PARALLEL_THREADS=\"${CPU_COUNT}\"\n${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n",
        "env": {
          "PYCBC_USE_CPM_CACHE": "true"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "rxm7706"
      ]
