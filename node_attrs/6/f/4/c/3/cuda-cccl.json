  "raw_meta_yaml": "{% set name = \"cuda-cccl\" %}\n{% set version = \"13.3.4.2.1\" %}\n{% set cuda_version = \"13.4\" %}\n{% set platform = \"linux-x86_64\" %}  # [linux64]\n{% set platform = \"linux-sbsa\" %}  # [aarch64 and arm_variant_type==\"sbsa\"]\n{% set platform = \"linux-aarch64\" %}  # [aarch64 and arm_variant_type==\"tegra\"]\n{% set platform = \"windows-x86_64\" %}  # [win64]\n{% set platform = \"windows-arm64\" %}  # [win and arm64]\n{% set target_name = \"x86_64-linux\" %}  # [linux64]\n{% set target_name = \"sbsa-linux\" %}  # [aarch64 and arm_variant_type==\"sbsa\"]\n{% set target_name = \"aarch64-linux\" %}  # [aarch64 and arm_variant_type==\"tegra\"]\n{% set target_name = \"x64\" %}  # [win64]\n{% set target_name = \"arm64\" %}  # [win and arm64]\n{% set extension = \"tar.xz\" %}  # [not win]\n{% set extension = \"zip\" %}  # [win]\n\n{% set platform = platform | default(\"linux-x86_64\", true) %}\n{% set major = load_file_regex(load_file=\"lib/cmake/cccl/cccl-config-version.cmake\", regex_pattern=\"CCCL_VERSION_MAJOR[ \\t]+([0-9]+)\") %}\n{% set minor = load_file_regex(load_file=\"lib/cmake/cccl/cccl-config-version.cmake\", regex_pattern=\"CCCL_VERSION_MINOR[ \\t]+([0-9]+)\") %}\n{% set patch = load_file_regex(load_file=\"lib/cmake/cccl/cccl-config-version.cmake\", regex_pattern=\"CCCL_VERSION_PATCH[ \\t]+([0-9]+)\") %}\n{% set cccl_version = (major.group(1) ~ \".\" ~ minor.group(1) ~ \".\" ~ patch.group(1)) if major else \"0.0.0\" %}\n{% set sha256 = \"7c973e70d8f8d732f801fe2297c9cb5a541f22824fa6ad64ac4f0e183f9c4397\" %}  # [linux64]\n{% set sha256 = \"36fe2aa9e58a6c924c609e41b466d4ec5c7f66db2f171a7b0ecdd8482274213e\" %}  # [aarch64 and arm_variant_type==\"sbsa\"]\n#{% set sha256 = \"296248ed702ea9e1a5e43c367d7a09a9ce2fda8a8c21101c428ea79eecf1a46c\" %}  # [aarch64 and arm_variant_type==\"tegra\"]\n{% set sha256 = \"ea3ebdd98d4d98819cc26b66bc5a0931004ed35ff18eea8b93e0bd2c8bfa5d7c\" %}  # [win64]\n{% set sha256 = \"e8a7c96268ae6c52a7b8b07d96e1f84ab8eae5619c3b989024ce712dda5c2cc2\" %}  # [win and arm64]\n\n# CUDA C++ Core Libraries (CCCL) includes thrust, cub, and libcudacxx. These are header-only libraries.\n# The cccl package ships CCCL headers in the environment's include directory for use in downstream recipes that require CCCL. It follows CCCL upstream versioning. Use this package to say, \"I want a specific version of CCCL headers when building my package (which may be newer than the versions shipped in the latest CUDA Toolkit).\"\n# The cuda-cccl_{{ target_platform }} package (e.g. cuda-cccl_linux-64) ships CCCL headers in 'targets/.../include' that can be used by nvcc, the CUDA compiler. It follows CUDA Toolkit versioning. This package should only be a dependency of the cuda-cudart / cuda-nvcc packages that require CCCL to function. It is target-specific to allow for cross-compilation, as a dependency of cuda-nvcc.\n# The cuda-cccl package is a metapackage that depends on cccl and cuda-cccl_{{ target_platform }} to ensure that versions are consistent. Use this package to say, \"I want to build with the thrust headers that shipped with CUDA Toolkit X.Y\" by adding dependencies on `cuda-cccl` and `cuda-version X.Y`.\n\npackage:\n  name: cuda-cccl-split\n  version: {{ version }}\n\nsource:\n  url: https://developer.download.nvidia.com/compute/cuda/redist/cccl/{{ platform }}/cccl-{{ platform }}-{{ version }}-archive.{{ extension }}\n  # Only the platforms with a published hash get the key. A variant with no matching\n  # assignment above (ppc64le, tegra) would otherwise render an empty sha256, which\n  # conda-build rejects -- breaking `conda smithy rerender` even though no such\n  # config is ever built.\n  sha256: {{ sha256 }}  # [linux64 or (aarch64 and arm_variant_type==\"sbsa\") or win]\n\nbuild:\n  number: 1\n  skip: true  # [osx or ppc64le]\n\noutputs:\n  - name: cuda-cccl\n    build:\n      # This metapackage exists to pin `cccl` and `cuda-cccl_{{ target_platform }}` to\n      # consistent versions, but conda-forge has no win-arm64 build of `cccl` -- and\n      # cannot have one yet, since cccl's own recipe needs cuda-nvcc and libcurand-dev\n      # for win-arm64, both of which ship in this release. Without this skip the whole\n      # win-arm64 job fails and cuda-cccl_win-arm64 never uploads, which is what would\n      # let cccl be built in the first place. Drop this once cccl publishes win-arm64.\n      skip: true  # [win and arm64]\n    requirements:\n      build:\n        - arm-variant * {{ arm_variant_type }}  # [aarch64]\n      host:\n        - cuda-version {{ cuda_version }}\n      run:\n        - {{ pin_compatible(\"cuda-version\", max_pin=\"x.x\") }}\n        - cuda-cccl_{{ target_platform }} =={{ version }}\n        - cccl =={{ cccl_version }}\n        - arm-variant * {{ arm_variant_type }}  # [aarch64]\n    test:\n      requires:\n        - cmake  # [linux]\n      files:\n        - verify-version.cmake  # [linux]\n      commands:\n        - test -d $PREFIX/lib/cmake                      # [linux]\n        - test -d $PREFIX/targets/{{ target_name }}/lib  # [linux]\n        - if not exist %LIBRARY_LIB%\\{{ target_name }}\\cmake exit 1    # [win]\n        - if not exist %LIBRARY_INC%\\targets\\{{ target_name }} exit 1  # [win]\n        # Extract the CCCL version from the cuda_cccl archive, and compare to the\n        # version of the cccl conda package.\n        - '[[ \"$(cmake -DCCCL_VERSION_FILE=\"$PREFIX/targets/{{ target_name }}/lib/cmake/cccl/cccl-config-version.cmake\" -P verify-version.cmake)\" == \"{{ cccl_version }}\" ]] || exit 1'  # [linux]\n    about:\n      home: https://developer.nvidia.com/cuda-toolkit\n      license_file: LICENSE\n      license: LicenseRef-NVIDIA-End-User-License-Agreement\n      license_url: https://docs.nvidia.com/cuda/eula/index.html\n      summary: 'CUDA C++ Core Libraries'\n      description: |\n        CUDA C++ Core Libraries\n      doc_url: https://docs.nvidia.com/cuda/index.html\n\n  - name: cuda-cccl_{{ target_platform }}\n    build:\n      noarch: generic\n    files:\n      - targets  # [linux]\n      - Library\\lib\\{{ target_name }}\\cmake        # [win]\n      - Library\\include\\targets\\{{ target_name }}  # [win]\n    requirements:\n      build:\n        - arm-variant * {{ arm_variant_type }}  # [aarch64]\n      host:\n        - cuda-version {{ cuda_version }}\n      run:\n        - {{ pin_compatible(\"cuda-version\", max_pin=\"x.x\") }}\n        - arm-variant * {{ arm_variant_type }}  # [aarch64]\n    test:\n      commands:\n        - test -d $PREFIX/targets/{{ target_name }}/lib      # [linux]\n        - test -d $PREFIX/targets/{{ target_name }}/include  # [linux]\n        - if not exist %LIBRARY_LIB%\\{{ target_name }}\\cmake exit 1    # [win]\n        - if not exist %LIBRARY_INC%\\targets\\{{ target_name }} exit 1  # [win]\n    about:\n      home: https://developer.nvidia.com/cuda-toolkit\n      license_file: LICENSE\n      license: LicenseRef-NVIDIA-End-User-License-Agreement\n      license_url: https://docs.nvidia.com/cuda/eula/index.html\n      summary: 'CUDA C++ Core Libraries'\n      description: |\n        CUDA C++ Core Libraries\n      doc_url: https://docs.nvidia.com/cuda/index.html\n\nabout:\n  home: https://developer.nvidia.com/cuda-toolkit\n  license_file: LICENSE\n  license: LicenseRef-NVIDIA-End-User-License-Agreement\n  license_url: https://docs.nvidia.com/cuda/eula/index.html\n  summary: 'CUDA C++ Core Libraries'\n  description: |\n    CUDA C++ Core Libraries\n  doc_url: https://docs.nvidia.com/cuda/index.html\n\nextra:\n  recipe-maintainers:\n    - conda-forge/cuda\n",
