  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: beets\n  version: \"2.14.0\"\n  build_number: 0\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/beets-${{ version }}.tar.gz\n  sha256: f412c9072ddc0bed04d843546a4222fcd24c9fe64cf233517ddcdb40190feea8\n\nbuild:\n  number: ${{ build_number }}\n  string: python_min${{ python_min }}_pyh${{ hash }}_${{ build_number }}\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n  python:\n    entry_points:\n      - beet = beets.ui:main\n\nrequirements:\n  host:\n    - python ${{ python_min }}.*\n    - hatchling\n    - pip\n  run:\n    - python >=${{ python_min }},<${{ python_max }}\n    - colorama\n    - confuse >=2.2.0\n    - jellyfish\n    - lap >=0.5.12\n    - mediafile >=0.17.0\n    - numpy >=${{ numpy_min }}\n    - packaging >=24.0\n    - platformdirs >=3.5.0\n    - pyyaml\n    - requests >=2.32.5\n    - requests-ratelimiter >=0.7.0\n    - typing_extensions\n    - unidecode >=1.3.6\n    #- scipy >=${{ scipy_min }}\n    #- numba >=${{ numba_min }}\n  run_constraints:\n    # Extra: plexupdate\n    - requests  #\n    # Extra: embedart\n    - Pillow  #\n    # Extra: web\n    - flask\n    - flask_cors  #\n    # Extra: autobpm\n    - librosa >=0.11\n    - resampy >=0.4.3\n    - numba >=0.65.1  #\n    # Extra: tidal\n    - requests-oauthlib >=0.6.1  #\n    # Extra: replaygain\n    - PyGObject\n    # Extra: chroma\n    - pyacoustid >=1.3.1,<2  #\n    # Extra: discogs\n    - python3-discogs-client >=2.3.15  #\n    # Extra: lyrics\n    - beautifulsoup4\n    - langdetect  #\n    # Extra: import\n    - py7zr\n    - rarfile  #\n    # Extra: lastimport\n    - pylast  #\n    # Extra: metasync\n    - dbus-python\n    # Extra: mpdstats\n    - python-mpd2 >=0.4.2  #\n    # Extra: reflink\n    - reflink  #\n    # Extra: scrub\n    - mutagen >=1.33  #\n    # Extra: sonosupdate\n    - soco  #\n    #