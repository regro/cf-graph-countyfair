  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\ncontext:\n  version: \"2.5.1\"\n  # source\n  gh: github.com\n  rgh: raw.githubusercontent.com\n  go_mod: ${{ gh }}/google/osv-scanner\n  go_mod_asm: ${{ gh }}/segmentio/asm\n  go_mod_localereader: ${{ gh }}/mattn/go-localereader\n  go_mod_magic: ${{ gh }}/deitch/magic\n  go_mod_mathutil: modernc.org/mathutil\n  # build\n  go_flags: -s${{ ' -w' if win }}\n  go_path: ${{ '${SRC_DIR}' if unix else '%SRC_DIR%' }}\n  go_bin: ${{ '%LIBRARY_BIN%\\\\osv-scanner.exe' if win else '${PREFIX}/bin/osv-scanner' }}\n  go_licenses_ignore: |-\n    --ignore=${{ go_mod }} --ignore=${{ go_mod_asm }} --ignore=${{ go_mod_localereader }} --ignore=${{ go_mod_magic }} --ignore=${{ go_mod_mathutil }}\n  rm_rf: ${{ 'rm -rf' if unix else 'rd /s /q' }}\n  # test\n  grep: ${{ 'grep -iE' if unix else 'findstr /c' }}\n\npackage:\n  name: osv-scanner\n  version: ${{ version }}\n\nsource:\n  - url: https://${{ go_mod }}/archive/refs/tags/v${{ version }}.tar.gz\n    sha256: 9a81d802aa0c0f667f8a80a045d4bab058fb9d9a6fb21f5cf2f1ea2007f73eef\n    target_directory: ${{ go_mod }}\n  # github.com/segmentio/asm is an unknown license but is \"MIT No Attribution\"-licensed\n  - url: https://${{ go_mod_asm | replace(gh, rgh) }}/refs/heads/main/LICENSE\n    sha256: cca993712df289a5958bdef69031a5dac0f951ac15afeb313f9eeea55ed59443\n    target_directory: manual_licenses/${{ go_mod_asm }}\n  # github.com/mattn/go-localereader is an unknown license but is MIT-licensed\n  - url: https://${{ go_mod_localereader | replace(gh, rgh) }}/refs/heads/master/LICENSE\n    target_directory: manual_licenses/${{ go_mod_localereader }}\n    sha256: dceede03550621e65ec7b79fcba87cf6dbb9d31132a8ae71a8fe8ceec0af7da3\n  # modernc.org/mathutil is a BSD-3-Clause license, but the license file is not present in the source code\n  - url: https://gitlab.com/cznic/mathutil/-/raw/master/LICENSE?ref_type=heads\n    ta