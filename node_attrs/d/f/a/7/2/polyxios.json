  "linux_64_meta_yaml": {
    "about": {
      "description": "polyxios reads and writes 3D mesh and point-cloud files through a single\npair of functions, px.read() and px.write(). Formats (PLY, OBJ, MEDIT\n.mesh, VTK legacy, the VTK XML family including its parallel and\nmultiblock variants, and 3D Gaussian Splat .splat) are provided by\npluggable codecs that third-party packages can extend through the\n\"polyxios.codecs\" entry point group. Meshes are exposed as a PolyData\ncontainer of NumPy arrays, with zero-copy memory mapping where a format\nallows it, and Cython kernels for the hot paths.",
      "dev_url": "https://github.com/fury-gl/polyxios",
      "home": "https://github.com/fury-gl/polyxios",
      "license": "BSD-3-Clause",
      "license_family": "BSD-3-Clause",
      "license_file": "LICENSE",
      "summary": "Fast 3D file format I/O and processing library"
    },
    "build": {
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "skoudoro",
        "ganimtron-10",
        "maharshi-gor"
      ]
    },
    "outputs": [
      {
        "build": null,
        "name": "polyxios",
        "requirements": {
          "build": [
            "c_compiler_stub",
            "c_stdlib_stub",
            "meson >=0.64",
            "ninja"
          ],
          "host": [
            "python",
            "pip",
            "meson-python >=0.15",
            "cython >=3.0",
            "numpy"
          ],
          "run": [
            "python",
            "numpy >=1.24"
          ]
        },
        "tests": [
          {
            "python": {
              "imports": [
                "polyxios",
                "polyxios.codecs",
                "polyxios.transforms"
              ]
            }
          },
          {
            "files": {
              "source": [
                "tests/"
              ]
            },
            "requirements": {
              "run": [
                "pytest"
              ]
            },
            "script": "pytest tests -v -k \"not real and not 3dgs and not high_order_mesh and not unsearchable_directory\""
          }
        ],
        "version": "0.4.1"
      },
