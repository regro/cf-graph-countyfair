  "raw_meta_yaml": "# yaml-language-server: $schema=https://raw.githubusercontent.com/prefix-dev/recipe-format/main/schema.json\nschema_version: 1\n\ncontext:\n  name: uuid-utils\n  version: \"1.0.0\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/${{ name[0] }}/${{ name }}/uuid_utils-${{ version }}.tar.gz\n  sha256: 8ed2e0156d29c4cfa0f931b4b71b35d2705d84054f63ba07a78f7acc2eb09a5c\n\nbuild:\n  number: 0\n  skip: is_abi3 and not is_python_min\n  python:\n    version_independent: true\n\nrequirements:\n  build:\n    - if: build_platform != target_platform\n      then:\n        - python\n        - cross-python_${{ target_platform }}\n        - maturin\n    - ${{ compiler('c') }}\n    - ${{ stdlib('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n  host:\n    - python\n    - if: is_abi3\n      then: python-abi3\n    - maturin\n    - pip\n  run:\n    - python\n\ntests:\n  - python:\n      imports:\n        - uuid_utils\n      python_version:\n        - if: is_abi3\n          then: \"${{ python_min ~ '.*' }}\"\n        - \"*\"\n  - requirements:\n      run:\n        - pip\n    script:\n      - pip check\n  - if: is_abi3 and build_platform == target_platform\n    then:\n      script:\n        - if: win\n          then: abi3audit %PREFIX%/Lib/site-packages/uuid_utils/_uuid_utils.pyd -s -v --assume-minimum-abi3 ${{ python_min }}\n          else:\n            - export SP_DIR=$(python -c \"import site; print(site.getsitepackages()[0])\")\n            - abi3audit $SP_DIR/uuid_utils/_uuid_utils.abi3.so -s -v --assume-minimum-abi3 ${{ python_min }}\n      requirements:\n        run:\n          - abi3audit\n\nabout:\n  homepage: https://github.com/aminalaee/uuid-utils\n  summary: Drop-in replacement for Python UUID in Rust\n  repository: https://github.com/aminalaee/uuid-utils\n  license: BSD-3-Clause\n  license_file:\n    - LICENSE.md\n    - THIRDPARTY.yml\n\nextra:\n  recipe-maintainers:\n    - moritzwilksch\n",
