  "raw_meta_yaml": "context:\n  version: \"0.15.0\"\n  build_number: 0\n\npackage:\n  name: xtensor-io\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/xtensor-stack/xtensor-io/archive/${{ version }}.tar.gz\n  sha256: 8de6bbf58f79dce1ce56da6d79ac01d0f4110aa45d69ca39f40c1f557b55d488\n\nbuild:\n  number: ${{ build_number }}\n\nrequirements:\n  build:\n    - cmake\n    - ${{ compiler('cxx') }}\n    - ${{ stdlib('c') }}\n    - if: unix\n      then:\n        - make\n  host:\n    - xtensor >=0.27.0,<0.28\n  run:\n    # xtensor is header-only\n    # it doesn't have a run_exports section\n    - ${{ pin_compatible('xtensor', upper_bound='x.x') }}\n    - zlib\n    - if: unix\n      then:\n        - openimageio >=3.1,<4\n        - highfive >=3.3,<4\n    # The cmake of Highfive 2.2 and 2.3 does not properly export the libdeps target.\n    # cf. https://github.com/BlueBrain/HighFive/issues/394\n    - libsndfile >=1.2,<2\n    - blosc >=1.21,<2.0\n\ntests:\n  - package_contents:\n      files:\n        exists:\n          - ${{ \"Library/\" if win }}include/xtensor-io/xtensor-io.hpp\n          - ${{ \"Library/\" if win }}lib/cmake/xtensor-io/xtensor-ioConfig.cmake\n          - ${{ \"Library/\" if win }}lib/cmake/xtensor-io/xtensor-ioConfigVersion.cmake\n\nabout:\n  homepage: https://github.com/xtensor-stack/xtensor-io\n  repository:  https://github.com/xtensor-stack/xtensor-io\n  license: BSD-3-Clause\n  license_family: BSD\n  license_file: LICENSE\n  summary: Image/NPZ input/output for xtensor, the C++ tensor algebra library\n  description: This library enables loading of many image formats into xtensor/xarrays and NPZ.\n  documentation: http://xtensor-io.readthedocs.io\n\nextra:\n  recipe-maintainers:\n    - wolfv\n    - SylvainCorlay\n    - JohanMabille\n    - davidbrochart\n    - conda-forge/xtensor\n",
