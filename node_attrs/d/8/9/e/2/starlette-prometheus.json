  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  version: 0.10.0\n\npackage:\n  name: starlette-prometheus\n  version: ${{ version }}\n\nsource:\n  url: https://pypi.org/packages/source/s/starlette-prometheus/starlette_prometheus-${{ version }}.tar.gz\n  sha256: 77d1e9cfad572206e8de242975bd00a62e33685eb330389f2add04e4d719d47d\n\nbuild:\n  number: 0\n  noarch: python\n  script: ${{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation\n\nrequirements:\n  host:\n    # Upstream declares requires = [\"poetry>=0.12\"] with\n    # build-backend = \"poetry.masonry.api\", which lives in poetry proper, not\n    # poetry-core. Mirrored exactly rather than substituted.\n    - python ${{ python_min }}.*\n    - poetry >=0.12\n    - pip\n  run:\n    # requires-python is <4.0,>=3.8; the 3.8 floor is below conda-forge's, so\n    # python_min governs. The <4.0 cap is a no-op and is not carried over.\n    - python >=${{ python_min }}\n    - starlette >=0.12.2\n    - prometheus_client >=0.12\n\ntests:\n  - python:\n      imports:\n        - starlette_prometheus\n      pip_check: true\n      python_version:\n        - ${{ python_min }}.*\n        - \"*\"\n\nabout:\n  summary: Prometheus integration for Starlette\n  # LICENSE reads \"either version 3 ... or (at your option) any later version\",\n  # and PyPI declares GPL-3.0+. That is -or-later, not -only.\n  license: GPL-3.0-or-later\n  license_file: LICENSE\n  homepage: https://github.com/PeRDy/starlette-prometheus\n  repository: https://github.com/PeRDy/starlette-prometheus\n\nextra:\n  recipe-maintainers:\n    - killua156\n",
