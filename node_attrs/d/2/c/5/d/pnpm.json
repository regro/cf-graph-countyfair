  "raw_meta_yaml": "schema_version: 1\n\ncontext:\n  name: pnpm\n  version: \"12.4.1\"\n\npackage:\n  name: ${{ name|lower }}\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/${{ name }}/${{ name }}/archive/refs/tags/v${{ version }}.tar.gz\n  sha256: 7388d1fe40ff2862d97645d4f5fca9f4a2459ac534c005d990717298aeacef6b\n\nbuild:\n  number: 0\n\nrequirements:\n  build:\n    - ${{ compiler('c') }}\n    - ${{ stdlib(\"c\") }}\n    - ${{ compiler('cxx') }}\n    - if: target_platform != \"win-arm64\"\n      then:\n        - make\n    - nodejs\n    - if: not win\n      then:\n        - file\n    - if: win and target_platform != \"win-arm64\"\n      then:\n        - m2-sed\n    - if: not win\n      then:\n        - sed\n  host:\n    - nodejs\n  run:\n    - nodejs\n\ntests:\n  - script:\n      - pnpm --help\n      - if: target_platform == \"win-arm64\"\n        then:\n          - pnpm --version\n          - node -e \"const actual = process.platform + '/' + process.arch; console.log(actual); if (actual !== 'win32/arm64') process.exit(1)\"\n  - package_contents:\n      bin:\n        - if: unix\n          then:\n            - pn\n            - pnpx\n            - pnx\n        - pnpm\n      files:\n        - if: unix\n          then:\n            - lib/node_modules/pnpm/*\n          else:\n            - Library/share/pnpm/*\n      strict: true\n\nabout:\n  license: MIT\n  license_file:\n    - LICENSE\n    - ThirdPartyLicenses.txt\n  summary: 📦🚀 Fast, disk space efficient package manager\n  homepage: https://github.com/pnpm/pnpm\n\nextra:\n  recipe-maintainers:\n    - JaninaWibkerQC\n    - xhochy\n    - pavelzw\n",
