    "about": {
      "description": "FEniCS is a collection of free software for automated, efficient solution of differential equations\n(https://fenicsproject.org). It provides C++ and Python interfaces, and creates effecient solvers via\nexpression of finite variational statements in a domain-specific language that are transformed and\njust-in-time compiled into efficient implementations.",
      "dev_url": "https://bitbucket.org/fenics-project/",
      "doc_url": "https://fenics.readthedocs.io/",
      "home": "https://www.fenicsproject.org/",
      "license": "LGPL-3.0-or-later",
      "license_family": "LGPL-3.0-or-later",
      "license_file": "COPYING",
      "summary": "The FEniCS Form Compiler"
    },
    "build": {
      "noarch": "python",
      "number": "42",
      "script": [
        "${{ PYTHON }} -m pip install . -vv",
        "mkdir -p $PREFIX/include",
        "cp ffc/backends/ufc/*.h $PREFIX/include/"
      ]
    },
    "extra": {
      "recipe-maintainers": [
        "garth-wells",
        "johannesring",
        "mikaem",
        "minrk",
        "jan-janssen",
        "sblauth"
      ]
    },
