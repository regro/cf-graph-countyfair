  "linux_64_meta_yaml": {
    "about": {
      "description": "The purpose of this package is to build a flexible fine-tuning framework for Geospatial Foundation Models (GFMs)\nbased on TorchGeo and Lightning which can be employed at different abstraction levels. It supports models from the Prithvi,\nTerraMind, and Granite series as well as models from TorchGeo and timm.\n\nThis library provides\n\n1. Ease-of-use and all the functionality from Lightning and TorchGeo.\n2. A modular model factory that combines any backbone with different decoders for full flexibility.\n3. Ready-to-use tasks for image segmentation, pixelwise regression, classification, and more.\n4. Multiple abstraction levels and inference pipelines to power enterprise applications.",
      "dev_url": "https://github.com/torchgeo/terratorch",
      "doc_url": "https://torchgeo.org/terratorch",
      "home": "https://torchgeo.org/terratorch",
      "license": "Apache-2.0",
      "license_family": "Apache-2.0",
      "license_file": "LICENSE",
      "summary": "TerraTorch - The geospatial foundation model fine-tuning toolkit"
    },
    "build": {
      "noarch": "python",
      "number": "0",
      "script": "${{ PYTHON }} -m pip install . -vv"
    },
    "extra": {
      "recipe-maintainers": [
        "Joao-L-S-Almeida",
        "giswqs",
        "romeokienzler",
        "weiji14"
      ]
    },
