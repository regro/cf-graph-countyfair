  "raw_meta_yaml": "context:\n  version: \"0.3.7\"\n\npackage:\n  name: cargo-leptos\n  version: ${{ version }}\n\nsource:\n  url: https://github.com/leptos-rs/cargo-leptos/releases/download/v${{ version }}/source.tar.gz\n  sha256: 6e4b72ede0ca23e1023773c2ccac1b8035b3cbb5ddb1fc721d53b181244cdadb\n\nbuild:\n  number: 0\n  script:\n    env:\n      CARGO_PROFILE_RELEASE_STRIP: symbols\n      CARGO_PROFILE_RELEASE_LTO: fat\n      # Use cmake to build aws-lc-sys, because conda's CFLAGS inject -O2 which\n      # overrides the -O0 required by jitterentropy-base.c, causing a build failure.\n      AWS_LC_SYS_CMAKE_BUILDER: \"1\"\n      OPENSSL_NO_VENDOR: \"1\"\n    content:\n      - if: unix\n        then:\n          - export OPENSSL_DIR=\"$PREFIX\"\n          - cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .\n        else:\n          - set OPENSSL_DIR=%LIBRARY_PREFIX%\n          - cargo auditable install --locked --no-track --bins --root %LIBRARY_PREFIX% --path .\n      - cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml\n      - if: unix\n        then:\n          - mkdir -p $PREFIX/share/zsh/site-functions $PREFIX/share/bash-completion/completions $PREFIX/share/fish/vendor_completions.d\n          - $PREFIX/bin/cargo-leptos completions zsh > $PREFIX/share/zsh/site-functions/_cargo-leptos\n          - $PREFIX/bin/cargo-leptos completions bash > $PREFIX/share/bash-completion/completions/cargo-leptos\n          - $PREFIX/bin/cargo-leptos completions fish > $PREFIX/share/fish/vendor_completions.d/cargo-leptos.fish\n\n\nrequirements:\n  build:\n    - ${{ stdlib('c') }}\n    - ${{ compiler('c') }}\n    - ${{ compiler('rust') }}\n    - cargo-bundle-licenses\n    - cargo-auditable\n    - cmake\n    - if: unix\n      then: make\n    - if: osx\n      then: ld64\n  host:\n    - openssl\n\ntests:\n  - script: cargo-leptos --help\n  - package_contents:\n      bin:\n        - cargo-leptos\n      files:\n        - if: unix\n          then:\n            - share/bash-completion/completions/cargo-leptos\n            - share/fish/vendor_completions.d/cargo-leptos.fish\n            - share/zsh/site-functions/_cargo-leptos\n      strict: true\n\nabout:\n  homepage: https://leptos.dev\n  summary: 'Build tool for Leptos (Rust)'\n  license: MIT\n  license_file:\n    - LICENSE\n    - THIRDPARTY.yml\n  repository: https://github.com/leptos-rs/cargo-leptos\n\nextra:\n  recipe-maintainers:\n    - maurosilber\n",
