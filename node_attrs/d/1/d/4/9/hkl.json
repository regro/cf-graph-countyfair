  "raw_meta_yaml": "{% set name = \"hkl\" %}\n# https://repo.or.cz/hkl.git\n# git rev-list --count REFERENCE\n{% set version = \"5.1.9.3843\" %}\n# Git commit hash below.  Pinning the SHA (not the tag) is the\n# conda-forge convention and avoids problems with shallow clones not\n# fetching tags from branches other than the remote default.\n{% set git_rev = \"63a67f242d577fdc49b5c77aa1df7a39d0f1c467\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  # NOTE: repo.or.cz now serves an Anubis anti-bot HTML challenge instead of\n  # tarball snapshots to non-browser clients (conda-forge CI included), so the\n  # tarball SHA256 churns and never matches.  Fetching via git smart-HTTP is\n  # unaffected by Anubis and reproducibly delivers the source tree.\n  git_url: https://repo.or.cz/hkl.git\n  git_rev: {{ git_rev }}\n\nbuild:\n  number: 1\n  skip: True  # [py<39 or win or osx]\n\nrequirements:\n  build:\n    - {{ compiler('c') }}\n    - {{ stdlib('c') }}\n    - autoconf\n    - git\n    - make\n    - pkg-config\n  host:\n    - autoconf-archive\n    - automake\n    - conda-verify\n    - glib\n    - glib-tools\n    - gobject-introspection\n    - gsl\n    - libcblas\n    - libglib\n    - libtool\n    - m4\n    - zlib\n  run:\n    - gobject-introspection\n    - libglib\n    - pygobject\n\ntest:\n  requires:\n    - conda-verify\n    - pip\n    - python <3.12\n  downstreams:\n    # - hklpy  # FIXME: fails due to missing tiled package\n    - hklpy2  # does not fail\n\nabout:\n  home: http://repo.or.cz/w/hkl.git\n  summary: Synchrotron SOLEIL library for diffractometer operations.\n  license: GPL-3.0-or-later\n  license_family: GPL\n  license_file: COPYING\n  doc_url: https://people.debian.org/~picca/hkl/hkl.html\n  dev_url: http://repo.or.cz/w/hkl.git\n\nextra:\n  recipe-maintainers:\n    - mrakitin\n    - prjemian\n",
