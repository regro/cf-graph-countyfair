  "linux_64_meta_yaml": {
    "about": {
      "description": "magicjar turns a Java JAR into a single self-executing file. The input may\nbe a JAR, a symlink to one, a conda/bioconda wrapper script, or a shell\nalias; magicjar resolves any of these down to the underlying JAR, prepends\na portable shell preamble, and writes one executable file. At runtime, JVM\nflags are routed to the JVM and everything else passes through to the\nprogram.",
      "dev_url": "https://github.com/clintval/magicjar",
      "home": "https://github.com/clintval/magicjar",
      "license": "MIT",
      "license_family": "MIT",
      "license_file": "LICENSE",
      "summary": "Make a Java JAR self-executing by prepending a shell preamble."
    },
    "build": {
      "number": "0",
      "script": {
        "content": [
          "cargo auditable install --locked --no-track --bins --root ${{ PREFIX }} --path .",
          "cargo-bundle-licenses --format yaml --output ./THIRDPARTY.yml"
        ],
        "env": {
          "CARGO_PROFILE_RELEASE_LTO": "fat",
          "CARGO_PROFILE_RELEASE_STRIP": "symbols"
        }
      }
    },
    "extra": {
      "recipe-maintainers": [
        "clintval"
      ]
    },
    "outputs": [
      {
        "build": null,
