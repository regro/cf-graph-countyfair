  "raw_meta_yaml": "{% set python_min = \"3.11\" %}\n{% set name = \"pyramids\" %}\n{% set version = \"0.60.0\" %}\n\npackage:\n  name: {{ name|lower }}\n  version: {{ version }}\n\nsource:\n  url: https://github.com/serapeum-org/pyramids/archive/{{ version }}.tar.gz\n  sha256: 3cd68a5a59db1eb72405262999d89182ef358bac716a3482ed605a3d7cc006fd\n\nbuild:\n  number: 0\n  noarch: python\n  script: python -m pip install . -vv\n\nrequirements:\n  host:\n    - python {{ python_min }}\n    - pip >=24.3.1\n    - setuptools >=80.0.0\n    - wheel\n  run:\n    - python >={{ python_min }}\n    - cftime >=1.6.4\n    - geopandas >=1.0.0\n    - hpc >=0.1.5\n    - numpy >=2.0.0\n    - pandas >=2.0.0\n    - pyproj >=3.7.0\n    - PyYAML >=6.0.0\n    - Shapely >=2.1.0\n    - scipy >=1.10.0\n    - gdal >=3.10.0,<4\n    - libgdal-netcdf >=3.10.0,<4\n    - libgdal-hdf4 >=3.10.0,<4\n    # libgdal-grib provides the GRIB driver pyramids.grib.open_grib needs.\n    - libgdal-grib >=3.10.0,<4\n    # conda-forge's geopandas-base no longer pulls a vector-IO backend;\n    # pyogrio is required for GeoDataFrame.to_file / read_file on every env.\n    - pyogrio >=0.7\n\n  run_constrained:\n    # viz — `cleopatra-tiles` is the conda-forge equivalent of the PyPI\n    # `cleopatra[tiles]` extra (pulls cleopatra + mercantile + xyzservices + Pillow).\n    - cleopatra-tiles >=0.31.0\n    # xarray — peer interop dep (no longer a dedicated extra in pyproject 0.33.0)\n    - xarray >=2023.1.0\n    # lazy — now also bundles kerchunk + h5py for the NetCDF/HDF5 lazy path.\n    # h5py 3.16 moved to hdf5 2.x but libgdal-netcdf still links hdf5 1.14.x;\n    # pin both so the env always shares one hdf5 binary.\n    - dask-core >=2024.1.0\n    - distributed >=2024.1.0\n    - zarr >=3\n    - fsspec >=2024.1.0\n    - s3fs >=2024.1.0\n    - kerchunk >=0.2.10\n    - h5py >=3.8.0,<3.16\n    - hdf5 1.14.*\n    # parquet — now also bundles dask-geopandas (the former parquet-lazy extra).\n    - pyarrow >=10.0.0\n    - dask-geopandas >=0.5.0\n    # stac — conda-forge equivalent of the PyPI `stac` extra. The PyPI extra also\n    # pins stac-asset>=0.4.7, which is not yet packaged on conda-forge; add it here\n    # once it lands on the channel.\n    - pystac-client >=0.8.0\n\ntest:\n  requires:\n    - python {{ python_min }}\n  imports:\n    - pyramids\n  commands:\n    # verify the `pyramids` console entry point (pyramids.cli:main) is installed and runnable\n    - pyramids --help\n\noutputs:\n  - name: {{ name }}\n\n  - name: {{ name }}-viz\n    build:\n      noarch: python\n    requirements:\n      run:\n        - {{ pin_subpackage(name, exact=True) }}\n        # conda-forge equivalent of the PyPI `cleopatra[tiles]` extra\n        # (cleopatra + mercantile + xyzservices + Pillow).\n        - cleopatra-tiles >=0.31.0\n    test:\n      imports:\n        - pyramids\n\n  - name: {{ name }}-lazy\n    build:\n      noarch: python\n    requirements:\n      run:\n        - {{ pin_subpackage(name, exact=True) }}\n        - dask-core >=2024.1.0\n        - distributed >=2024.1.0\n        - zarr >=3\n        - fsspec >=2024.1.0\n        - s3fs >=2024.1.0\n        # kerchunk + h5py for the NetCDF/HDF5 lazy (Zarr-reference) path.\n        # h5py 3.16 dragged hdf5 2.x; libgdal-netcdf still links hdf5 1.14.x.\n        # Pin both to keep one hdf5 binary in the env (Windows DLL-shadow risk).\n        - kerchunk >=0.2.10\n        - h5py >=3.8.0,<3.16\n        - hdf5 1.14.*\n    test:\n      imports:\n        - pyramids\n\n  - name: {{ name }}-parquet\n    build:\n      noarch: python\n    requirements:\n      run:\n        - {{ pin_subpackage(name ~ '-lazy', exact=True) }}\n        - pyarrow >=10.0.0\n        - dask-geopandas >=0.5.0\n    test:\n      imports:\n        - pyramids\n\n  - name: {{ name }}-stac\n    build:\n      noarch: python\n    requirements:\n      run:\n        - {{ pin_subpackage(name, exact=True) }}\n        # conda-forge equivalent of the PyPI `stac` extra. stac-asset>=0.4.7 (also\n        # part of the PyPI extra) is not yet on conda-forge; add it once available.\n        - pystac-client >=0.8.0\n    test:\n      imports:\n        - pyramids\n\nabout:\n  home: https://github.com/serapeum-org/pyramids\n  license: GPL-3.0-only\n  license_family: GPL\n  license_file: LICENSE.md\n  summary: GIS utility package\n  description: |\n    GIS utility package.\n  dev_url: https://github.com/serapeum-org/pyramids\n  doc_url: https://serapeum-org.github.io/pyramids\n  doc_source_url: https://github.com/serapeum-org/pyramids/main/README.md\n\nextra:\n  recipe-maintainers:\n    - MAfarrag\n",
