    "about": {
      "description": "digital-rivers is a GIS utility library for Digital Elevation Model (DEM)\nprocessing, terrain analysis, and raster data manipulation. It uses GDAL as\nits geospatial backend and builds on the pyramids library for dataset\noperations, adding hydrology-specific semantics such as sink filling, D8\nflow direction, flow accumulation, stream extraction, watershed\ndelineation, and terrain colour-relief generation.\n",
      "dev_url": "https://github.com/serapeum-org/digital-rivers",
      "doc_url": "https://serapeum-org.github.io/digital-rivers",
      "home": "https://github.com/serapeum-org/digital-rivers",
      "license": "GPL-3.0-only",
      "license_family": "GPL3",
      "license_file": "LICENSE.md",
      "summary": "DEM processing library"
    },
    "build": {
      "noarch": "python",
      "number": "1",
      "script": "python -m pip install . -vv --no-deps --no-build-isolation"
    },
    "extra": {
      "recipe-maintainers": [
        "MAfarrag"
      ]
    },
    "outputs": [
      {
        "name": "digital-rivers"
      },
      {
        "build": {
          "noarch": "python"
        },
        "name": "digital-rivers-all",
